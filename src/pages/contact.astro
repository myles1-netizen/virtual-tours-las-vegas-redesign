---
import { asset } from "../data/site";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { business } from "../data/site";

const title = "Book a Shoot — Las Vegas Real Estate Photography | VTLV";
const description = "Book a Las Vegas real estate photography shoot with Mike Madsen. Call or text (702) 527-2732, or send a booking request. Residential, commercial, vacation rentals, 3D tours, drone, floor plans. 24–48 hour delivery.";
---
<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="Contact & booking"
    title="Book your shoot."
    lead="Fastest path: call or text me directly. Prefer to send details first? Fill out the form and I'll get back to you, usually same day."
    image={asset("/images/portfolio/listing-02.jpg")}
    imageAlt="Spacious Las Vegas property interior, ready to be photographed"
  />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        {/* Quick contact options */}
        <aside class="contact-options" data-reveal>
          <div class="opt-card">
            <p class="eyebrow">Fastest response</p>
            <h2 class="display opt-title">Call or text me.</h2>
            <p class="opt-sub">For a $200–500 service, talking it through is usually quickest. I pick up myself.</p>
            <a href={business.phoneHref} class="btn brass btn-block">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call {business.phone}
            </a>
            <a href={business.smsHref} class="btn outline btn-block">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Text me
            </a>
            <hr class="divider" style="margin-block:1.4rem" />
            <ul class="opt-facts" role="list">
              <li><span>Service area</span><strong>{business.serviceArea.join(" · ")}</strong></li>
              <li><span>Based</span><strong>{business.areaNote}</strong></li>
              <li><span>Hours</span><strong>Mon–Sat, 8a–6p PT</strong></li>
              <li><span>Turnaround</span><strong>{business.turnaround}</strong></li>
              <li><span>Email</span><strong><a href={business.emailHref}>{business.email}</a></strong></li>
            </ul>
          </div>
        </aside>

        {/* Form */}
        <div class="form-wrap" data-reveal data-reveal-delay="1">
          <div class="form-card">
            <p class="eyebrow">Booking request</p>
            <h2 class="display form-title">Send the details.</h2>
            <p class="form-sub">Tell me about the property and what you need, only the fields that actually help me quote and schedule.</p>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section class="section paper-2">
    <div class="container narrow">
      <SectionHeader
        eyebrow="Before you book"
        title="Common questions."
        align="center"
      />
      <FAQAccordion limit={6} />
      <p class="text-center muted" style="margin-top:1.5rem"><a href={asset("/faq/")} class="text-link">All FAQs →</a></p>
    </div>
  </section>
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .opt-card {
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    position: sticky;
    top: 100px;
  }
  .opt-card .eyebrow { color: var(--brass-2); }
  .opt-title { color: var(--on-dark); font-size: var(--step-3); margin-top: 0.4rem; }
  .opt-sub { color: rgba(247,244,239,0.7); font-size: var(--step--1); margin-top: 0.7rem; margin-bottom: 1.4rem; line-height: 1.5; }
  .opt-card .btn { margin-top: 0.6rem; }
  .opt-card .btn.outline { color: var(--on-dark); border-color: rgba(247,244,239,0.4); }
  .opt-card .btn.outline:hover { background: var(--on-dark); color: var(--ink); border-color: var(--on-dark); }
  .opt-facts { display: flex; flex-direction: column; gap: 0.7rem; }
  .opt-facts li {
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: var(--step--1);
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line-dark);
  }
  .opt-facts li:last-child { border-bottom: none; padding-bottom: 0; }
  .opt-facts span { color: rgba(247,244,239,0.6); }
  .opt-facts strong { color: var(--on-dark); font-weight: 600; }
  .opt-facts a:hover { color: var(--brass-2); }

  .form-card {
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    box-shadow: var(--shadow-card);
  }
  .form-title { font-size: var(--step-3); margin-top: 0.4rem; }
  .form-sub { color: var(--stone); font-size: var(--step--1); margin-top: 0.7rem; margin-bottom: 1.8rem; line-height: 1.5; }

  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; }
    .opt-card { position: static; }
  }
</style>
