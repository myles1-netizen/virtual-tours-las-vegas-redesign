---
import { asset, business } from "../../data/site";
import { locations } from "../../data/locations";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";

const title = "Real Estate Photographer Locations — Las Vegas Valley & Beyond | VTLV";
const description =
  "City-by-city real estate photography coverage from Virtual Tours Las Vegas: Henderson, Summerlin, North Las Vegas, Boulder City, Pahrump and Mesquite — with neighborhoods, drive times and what's in demand in each market.";
---
<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="Locations"
    title="City-by-city real estate photography."
    lead="Real landing pages for every city I serve — not doorway keyword spam. Pick yours to see the neighborhoods covered, what's in demand in that market, and how far the drive is."
    image={asset("/images/portfolio/drone-aerial.jpg")}
    imageAlt="Aerial drone photo of a Las Vegas backyard with pool and spa"
  />

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Where I shoot"
        title="Pick your city."
        lead="Each page has unique, real content: the neighborhoods in that city, the services most in demand there, drive time from central Las Vegas, and an area-specific FAQ."
      />
      <div class="loc-grid">
        {locations.map((l, i) => (
          <a class="loc-card" href={asset(`/locations/${l.slug}/`)} data-reveal data-reveal-delay={(i % 3) + 1}>
            <div class="loc-card-head">
              <h2>{l.name}, {l.state}</h2>
              <span class="loc-card-drive">{l.driveTime}</span>
            </div>
            <p class="loc-card-lead">{l.lead}</p>
            <div class="loc-card-areas">
              {l.neighborhoods.slice(0, 5).map((n) => <span class="chip">{n}</span>)}
              {l.neighborhoods.length > 5 && <span class="chip more">+{l.neighborhoods.length - 5} more</span>}
            </div>
            <span class="loc-card-cta">View {l.name} page →</span>
          </a>
        ))}
      </div>

      <div class="also-see" data-reveal>
        Looking for a specific Las Vegas Valley neighborhood (Anthem, Cadence, Lake Las Vegas, etc.)?
        See the full <a href={asset("/neighborhoods/")}>areas-served guide</a>, or
        <a href={business.phoneHref}>call {business.phone}</a> to confirm your address.
      </div>
    </div>
  </section>

  <CTABand
    title={`Book a shoot in your area.`}
    body={`Call or text ${business.phone}. Most shoots are on the calendar within 48 hours.`}
  />
</Base>

<style>
  .loc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .loc-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .loc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); border-color: transparent; }

  .loc-card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .loc-card-head h2 { font-size: var(--step-2); }
  .loc-card-drive {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brass);
    white-space: nowrap;
  }
  .loc-card-lead {
    color: var(--stone);
    font-size: var(--step--1);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .loc-card-areas { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    font-size: 0.74rem;
    color: var(--ink-2);
    padding: 0.25em 0.65em;
    background: var(--paper-2);
    border: 1px solid var(--line-light);
    border-radius: 999px;
  }
  .chip.more { color: var(--stone-2); font-style: italic; }
  .loc-card-cta {
    margin-top: auto;
    color: var(--brass);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .also-see {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--stone);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .also-see a { color: var(--brass); font-weight: 600; }

  @media (max-width: 880px) {
    .loc-grid { grid-template-columns: 1fr; }
  }
</style>
