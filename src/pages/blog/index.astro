---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";
import { business } from "../../data/site";

const title = "Blog — Las Vegas Real Estate Photography Tips & Market | VTLV";
const description = "Real estate photography tips, Las Vegas market insight and guidance on 3D tours, drone and virtual staging from Mike Madsen, a Las Vegas photographer since 2010.";

// Categories that the blog will eventually hold. Each card is a real topic
// Mike is qualified to write about — no invented posts or fake dates.
type Category = {
  slug: string;
  name: string;
  blurb: string;
  icon: string; // inline SVG path
  topics: string[];
  image: string;
  alt: string;
};

const categories: Category[] = [
  {
    slug: "real-estate-photography-tips",
    name: "Real Estate Photography Tips",
    blurb: "Practical, field-tested advice for preparing a property, choosing a photographer and getting MLS-ready imagery.",
    topics: [
      "How to prep a home for a photo shoot (the 24/7 open house checklist)",
      "HDR vs. flash: what actually makes windows look right",
      "How many photos does a Las Vegas listing really need?",
      "Why crooked walls kill a listing's perceived value",
    ],
    icon: "M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z M3.3 7 8.1 4h7.8l4.8 3",
    image: "/images/portfolio/sierra-skye-living.jpg",
    alt: "Sunlit Las Vegas living room captured with professional HDR real estate photography",
  },
  {
    slug: "las-vegas-market",
    name: "Las Vegas Market",
    blurb: "On-the-ground perspective on the Las Vegas Valley real estate market, neighborhoods and what sells here.",
    topics: [
      "Summerlin vs. Henderson: where listing photography differs",
      "What Las Vegas buyers actually click on (and what they skip)",
      "New construction in Cadence and Inspirada: documenting model homes",
      "Luxury enclaves: photographing MacDonald Highlands and Lake Las Vegas",
    ],
    icon: "M3 21h18 M5 21V7l8-4v18 M19 21V11l-6-4 M9 9v.01 M9 12v.01 M9 15v.01 M9 18v.01",
    image: "/images/portfolio/spitze-interior.jpg",
    alt: "Las Vegas Strip skyline view captured from a property's upper level at dusk",
  },
  {
    slug: "virtual-tours",
    name: "Virtual Tours",
    blurb: "Matterport, Zillow 3D Home and 360s: how immersive media pre-qualifies buyers and what to expect.",
    topics: [
      "Matterport vs. Zillow 3D Home: which does your listing need?",
      "How 3D tours cut wasted showings (and why MLS loves them)",
      "What 6 months of free hosting really covers",
      "Embedding a 3D tour on your MLS and agent site",
    ],
    icon: "M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z",
    image: "/images/portfolio/matterport-360.jpg",
    alt: "360-degree virtual tour panorama of a Las Vegas listing",
  },
  {
    slug: "drone-photography",
    name: "Drone Photography",
    blurb: "FAA Part 107 aerial work in controlled Las Vegas airspace: lot, setting and proximity shots that sell.",
    topics: [
      "Flying legally near Harry Reid International: what Part 107 really requires",
      "When drone shots earn their keep on a listing (and when they don't)",
      "Airspace authorizations explained for Las Vegas agents",
      "Why HOAs and neighbors matter on drone shoots",
    ],
    icon: "M12 2 2 7v10l10 5 10-5V7z M12 22V12 M2 7l10 5 10-5",
    image: "/images/portfolio/drone-aerial.jpg",
    alt: "Aerial drone photo of a Las Vegas backyard with pool and spa",
  },
];
---

<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="Blog"
    title="Field notes from a Las Vegas photographer."
    lead="Practical tips, market insight and behind-the-lens perspective from Mike Madsen — on real estate photography, 3D tours, drone and the Las Vegas Valley market. Articles are on the way; here's what's coming."
    image={asset("/images/portfolio/brooklyn-1.jpg")}
    imageAlt="Well-lit residential interior photographed for a property listing"
  />

  {/* ===== COMING SOON BANNER ===== */}
  <section class="section sm">
    <div class="container">
      <div class="comingsoon" data-reveal>
        <p class="eyebrow center">Coming soon</p>
        <p class="comingsoon-body">
          The blog launches shortly. In the meantime, Mike answers real questions every day on the phone —
          <a href={business.phoneHref}>call or text {business.phone}</a> with yours, or browse the
          <a href={asset("/faq/")}> FAQs</a>.
        </p>
      </div>
    </div>
  </section>

  {/* ===== CATEGORY GRID ===== */}
  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="What you'll find here"
        title="Four beats. One photographer's perspective."
        lead="Each category collects the questions Mike fields most often from agents, hosts and sellers across the Las Vegas Valley."
      />
      <div class="cat-grid">
        {categories.map((cat, i) => (
          <article class="cat-card" data-reveal data-reveal-delay={(i % 2) + 1}>
            <div class="cat-img">
              <img src={asset(cat.image)} alt={cat.alt} loading="lazy" width="600" height="400" />
              <span class="cat-badge">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={cat.icon}/></svg>
              </span>
            </div>
            <div class="cat-body">
              <h2 class="cat-name">{cat.name}</h2>
              <p class="cat-blurb">{cat.blurb}</p>
              <p class="cat-topics-label">Topics planned</p>
              <ul class="cat-topics" role="list">
                {cat.topics.map((t) => <li>{t}</li>)}
              </ul>
              <span class="cat-soon">Articles coming soon</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    title="Have a question worth a blog post?"
    body={`Mike would rather answer it directly. Call or text ${business.phone} — same-day replies are the norm.`}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }

  .comingsoon {
    text-align: center;
    max-width: 56ch;
    margin-inline: auto;
    padding: clamp(1.4rem, 1rem + 2vw, 2.2rem);
    background: var(--dark);
    color: var(--paper);
    border-radius: var(--radius-lg);
  }
  .comingsoon .eyebrow { color: var(--brass-2); }
  .comingsoon-body { margin-top: 0.8rem; font-size: var(--step-1); line-height: 1.55; color: rgba(247,244,239,0.85); }
  .comingsoon-body a { color: var(--brass-2); font-weight: 600; }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    margin-top: 2.5rem;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .cat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); border-color: transparent; }

  .cat-img { position: relative; aspect-ratio: 3/2; overflow: hidden; }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .cat-card:hover .cat-img img { transform: scale(1.04); }
  .cat-badge {
    position: absolute;
    bottom: 0.7rem; left: 0.7rem;
    width: 34px; height: 34px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brass);
    color: #fff;
    border-radius: 50%;
    box-shadow: var(--shadow-card);
  }

  .cat-body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.3rem, 1rem + 1vw, 1.7rem);
    flex-grow: 1;
  }
  .cat-name { font-size: var(--step-2); }
  .cat-blurb { color: var(--stone); font-size: var(--step--1); line-height: 1.5; }
  .cat-topics-label {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .cat-topics { display: flex; flex-direction: column; gap: 0.5rem; flex-grow: 1; }
  .cat-topics li {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.4;
    padding-left: 1.1rem;
    position: relative;
  }
  .cat-topics li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.55em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--brass);
  }
  .cat-soon {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--stone-2);
    padding: 0.4em 0.8em;
    background: var(--paper-2);
    border-radius: 999px;
    align-self: flex-start;
  }

  @media (max-width: 820px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
