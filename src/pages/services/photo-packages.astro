---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PriceTable from "../../components/PriceTable.astro";
import PricingCard from "../../components/PricingCard.astro";
import CTABand from "../../components/CTABand.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import { vegasPackages, hdrTiers, hdrAddOns, business } from "../../data/site";
import meta from "../../data/cms/services/photo-packages.json";

const title = meta.title || "Photo Packages for Las Vegas Real Estate | VTLV";
const description = meta.description || "Las Vegas real estate photo packages: à-la-carte HDR pricing from $110, three bundled packages, and every add-on. Free MLS slideshow with every package. 24–48 hour delivery.";

const heroEyebrow = meta.eyebrow || "";
const heroTitle = meta.headline || "";
const heroLead = meta.lead || "";
---
<Base title={title} description={description} heroVariant="dark">
  <ServiceSchema
    slot="head"
    name="Real Estate Photo Packages"
    description="Las Vegas real estate photo packages: à-la-carte HDR pricing from $110, three bundled packages, and add-ons including rush, twilight, sky replacement, virtual staging and slideshow video. Free MLS slideshow with every package."
    serviceType="Real Estate Photography"
    startingPrice={110}
  />
  <PageHero
    eyebrow={heroEyebrow}
    title={heroTitle}
    lead={heroLead}
    image={asset("/images/portfolio/sierra-skye-living.jpg")}
    imageAlt="Sunlit Las Vegas living room captured with professional HDR real estate photography"
  />

  {/* ===== À-LA-CARTE HDR PRICING ===== */}
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="À-la-carte HDR"
        title="Build your own shoot, photo by photo."
        lead="Volume pricing kicks in as you add photos. No minimums, no quote-and-wait. Every tier ships with a free MLS-ready slideshow export."
      />
      <div class="pricing-row">
        <PriceTable title="HDR photography" tiers={hdrTiers} note="Free MLS slideshow included" />
        <div class="addons-card" data-reveal>
          <h3>Add-ons</h3>
          <ul role="list">
            {hdrAddOns.map((a) => <li>{a}</li>)}
          </ul>
          <p class="ao-note">Rush delivery = next morning. Twilight and drone are also available on any HDR shoot.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ===== BUNDLED PACKAGES ===== */}
  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Bundled packages"
        title="Or grab a package and save."
        lead="Three bundles that combine HDR photos with a 3D tour, drone, or floor plan — each at a better price than booking the pieces separately. Residential resale under 3,000 sq ft; size upgrades noted per package."
        align="center"
      />
      <div class="pkg-grid">
        {vegasPackages.map((p) => <PricingCard pkg={p} />)}
      </div>
    </div>
  </section>

  {/* ===== MLS SLIDESHOW ===== */}
  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Free with every package"
        title="The MLS slideshow, on the house."
        lead="When your photos are uploaded to the MLS, a slideshow is generated automatically — and it's free with every HDR package. Need it as a video file? Export the slideshow to video for $10, ready for social or your agent site."
        align="center"
      />
    </div>
  </section>

  {/* ===== CALCULATOR CTA ===== */}
  <section class="section paper-2">
    <div class="container narrow">
      <div class="calc-cta" data-reveal>
        <p class="eyebrow center">Price it yourself</p>
        <h3 class="display">Use the price calculator.</h3>
        <p class="lead" style="margin-inline:auto">Combine HDR, a 3D tour, drone, a floor plan and add-ons to see your total in real time — then book straight from the result.</p>
        <div class="btn-row" style="justify-content:center; margin-top:1.5rem">
          <a href={asset("/pricing/")} class="btn brass">Open the calculator</a>
          <a href={business.phoneHref} class="btn outline">Call {business.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    title="Book your photo package."
    body={`Most residential shoots are on the calendar within 48 hours. Call or text ${business.phone}.`}
    image={asset("/images/portfolio/sierra-skye-kitchen.jpg")}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .pricing-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  .addons-card {
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
  }
  .addons-card h3 {
    font-family: var(--font-body);
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 1rem;
  }
  .addons-card ul { display: flex; flex-direction: column; gap: 0.55rem; }
  .addons-card li {
    font-size: var(--step--1);
    color: var(--ink-2);
    padding-left: 1rem;
    position: relative;
    line-height: 1.4;
  }
  .addons-card li::before { content: "·"; position: absolute; left: 0; color: var(--brass); font-weight: 700; }
  .ao-note { margin-top: 1rem; font-size: 0.82rem; color: var(--stone); padding-top: 0.8rem; border-top: 1px dashed var(--line-light); }

  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: stretch;
  }

  .calc-cta {
    padding: clamp(2rem, 1.5rem + 2vw, 3rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .calc-cta h3 { font-size: var(--step-3); margin-top: 0.4rem; }

  @media (max-width: 880px) {
    .pricing-row { grid-template-columns: 1fr; }
    .pkg-grid { grid-template-columns: 1fr; }
  }
</style>
