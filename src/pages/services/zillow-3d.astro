---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceBlock from "../../components/ServiceBlock.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";
import PriceTable from "../../components/PriceTable.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import { zillowTiers, business } from "../../data/site";

const title = "Zillow 3D Home Tours Las Vegas";
const description =
  "Las Vegas Zillow 3D Home tours — 360 panoramas with Zillow floor plan integration that lift your listing higher in Zillow search. Mike was the photographer for the Zillow Offers program in Las Vegas, with over 1,500 tours completed. Free hosting forever on Zillow.";
---

<Base title={title} description={description} heroVariant="dark">
  <ServiceSchema
    slot="head"
    name="Zillow 3D Home Tours"
    description="Zillow 3D Home tours for Las Vegas real estate: 360 panoramas with Zillow floor plan integration, free hosting on Zillow, and higher Zillow search ranking from a former Zillow Offers program photographer."
    serviceType="Zillow 3D Home Tour"
    startingPrice={50}
  />
  <PageHero
    eyebrow="Zillow 3D Home · over 1,500 tours completed"
    title="Zillow 3D Home tours of your Las Vegas listing."
    lead="Mike was the photographer for the Zillow Offers program in Las Vegas and has completed over 1,500 Zillow 3D Home tours. The 3D tour lives on Zillow, hosts free forever, and lifts your listing higher in Zillow search results."
    image={asset("/images/portfolio/360-tiny-planet.jpg")}
    imageAlt="Tiny-planet 360 panorama from a Las Vegas Zillow 3D Home tour"
  />

  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Why Zillow 3D Home"
        title="The tour that lives where buyers search."
        lead="Zillow is where the buyers are. A Zillow 3D Home tour is a series of 360 panoramas stitched into a walkthrough that lives right on the Zillow listing, with optional Zillow floor plan integration. Listings with a Zillow 3D tour stand out in the map view and get measurably more engagement — more views, more saves, and faster sales — than listings without one."
        align="center"
      />
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <div class="stats-grid">
        <div class="stat" data-reveal>
          <p class="stat-num">1,500+</p>
          <p class="stat-label">Zillow 3D tours completed</p>
          <p class="stat-note">Across the Las Vegas Valley since Mike started the program work for Zillow Offers.</p>
        </div>
        <div class="stat" data-reveal>
          <p class="stat-num">More views</p>
          <p class="stat-label">Higher Zillow engagement</p>
          <p class="stat-note">Listings with a Zillow 3D tour get more views and saves than listings without one.</p>
        </div>
        <div class="stat" data-reveal>
          <p class="stat-num">Free forever</p>
          <p class="stat-label">Hosting on Zillow</p>
          <p class="stat-note">No monthly fees, no expiration — the tour stays on the Zillow listing for the life of the property.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <div class="blocks">
        <ServiceBlock
          image={asset("/images/portfolio/360-tiny-planet.jpg")}
          alt="360-degree Zillow 3D Home tour panorama of a Las Vegas listing"
          title="360 panoramas stitched into a walkthrough"
          body="A Zillow 3D Home tour is a series of 360-degree panoramas shot at key points through the property — usually 10 to 12 per home — that connect into a navigable walkthrough on the Zillow listing. Buyers click through room by room, exactly as they would on the site, no app required."
          bullets={["10–12 connected 360 panoramas", "Shoots on any HDR photo visit", "No app required to view"]}
        />
        <ServiceBlock
          reverse
          image={asset("/images/portfolio/360-tiny-planet.jpg")}
          alt="Tiny-planet 360 panorama from a Las Vegas Zillow 3D Home tour"
          title="Zillow floor plan integration"
          body="Optional Zillow floor plan integration pairs the 3D tour with a schematic floor plan right on the listing. Your property stands out in the Zillow map view, where buyers scrolling listings see the floor plan preview and tour badge before they ever click in."
          bullets={["Floor plan appears on the Zillow listing", "Stands out in the map view", "High-value, low-cost add-on"]}
        />
      </div>
    </div>
  </section>

  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Zillow 3D pricing"
        title="Real, published Zillow 3D pricing."
        lead="Most Zillow 3D Home tours are added to an HDR shoot, but standalone tours are available. Hosting on Zillow is free forever."
        align="center"
      />
      <div class="ptables">
        <PriceTable title="Zillow 3D Home" tiers={zillowTiers} note="Free hosting on Zillow, boosts search ranking" />
      </div>
      <p class="text-center" style="margin-top:2.5rem">
        <a href={asset("/contact/")} class="btn brass">Book a Zillow 3D Tour</a>
      </p>
      <p class="text-center muted" style="margin-top:1.5rem">
        Looking for the full Matterport 3D experience (dollhouse, measurements, 33.6 MP capture)?{" "}
        <a href={asset("/services/matterport/")} class="text-link">See Matterport tours →</a>
      </p>
    </div>
  </section>

  <CTABand
    title="Add a Zillow 3D tour to your listing."
    body={`Free hosting forever, higher Zillow ranking. Call or text ${business.phone}.`}
    image={asset("/images/portfolio/360-tiny-planet.jpg")}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .blocks { display: flex; flex-direction: column; gap: clamp(3rem, 6vw, 5rem); }
  .ptables {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .stat {
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    text-align: center;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: var(--step-4);
    color: var(--brass);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink);
    margin-top: 0.6rem;
  }
  .stat-note {
    font-size: var(--step--1);
    color: var(--stone);
    margin-top: 0.7rem;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .stats-grid { grid-template-columns: 1fr; }
  }
</style>
