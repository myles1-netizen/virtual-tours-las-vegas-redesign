---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceBlock from "../../components/ServiceBlock.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";
import PriceTable from "../../components/PriceTable.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import MatterportEmbed from "../../components/MatterportEmbed.astro";
import MatterportPopup from "../../components/MatterportPopup.astro";
import { matterportTiers, matterportIncludes, business } from "../../data/site";

const title = "Matterport 3D Virtual Tours Las Vegas";
const description =
  "Las Vegas Matterport 3D virtual tours by a certified Matterport Service Partner — dollhouse view, floor plan view, measurement tools, 33.6 megapixel capture, 6 months free hosting and two MLS landing-page links. Book a Matterport tour.";
---

<Base title={title} description={description} heroVariant="dark">
  <ServiceSchema
    slot="head"
    name="Matterport 3D Virtual Tours"
    description="Matterport 3D virtual tours for Las Vegas real estate: dollhouse, floor plan and measurement views, 33.6 megapixel capture, 6 months free hosting and MLS embed links from a certified Matterport Service Partner."
    serviceType="Matterport 3D Virtual Tour"
    startingPrice={225}
  />
  <PageHero
    eyebrow="Matterport Service Partner · the flagship"
    title="Matterport 3D tours of your Las Vegas listing."
    lead="The industry-standard 3D walkthrough. Mike is a certified Matterport Service Partner, capturing properties in true 3D with dollhouse, floor plan and measurement views — the immersive experience that pre-qualifies buyers before they ever tour in person."
    image={asset("/images/portfolio/matterport-360.jpg")}
    imageAlt="360-degree Matterport virtual tour panorama of a Las Vegas listing"
  />

  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Why Matterport"
        title="Not a slideshow. A real 3D model."
        lead="Matterport stitches up to ~200 photo spheres into a single navigable model, captured with the Pro3 camera at 33.6 megapixels per scan. Buyers can walk the property, switch to dollhouse view, drop into floor plan view, and measure walls, doors and fixtures right in the browser — viewable in VR headsets too. This is the most immersive way to show a property online."
        align="center"
      />
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <div class="demo-grid">
        <div class="demo-text">
          <p class="eyebrow">Try it yourself</p>
          <h2 class="display demo-title">Step inside a real Matterport model.</h2>
          <p class="lead demo-lead">
            This is a live Matterport showcase. Click below to load the walkthrough —
            dollhouse view, floor plan and measurement tools all work right in your browser.
            (We don't load the player until you ask, to keep the page fast.)
          </p>
        </div>
        <div class="demo-embed">
          <MatterportEmbed
            modelId="SxL3C8ha5hb"
            title="Matterport 3D walkthrough demo"
            placeholder="/images/portfolio/matterport-360.jpg"
            aspect="16/9"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <SectionHeader
        eyebrow="Tour gallery"
        title="Open a Matterport tour, full-screen."
        lead="Click any thumbnail to launch the Matterport viewer in a pop-up lightbox. The tour only loads once you open it, and stops the moment you close it."
        align="center"
      />
      <MatterportPopup
        triggers={[
          { modelId: "SxL3C8ha5hb", thumbnail: "/images/portfolio/matterport-360.jpg", title: "Showcase Home Walkthrough" },
          { modelId: "ZhM14HXw6ib", thumbnail: "/images/portfolio/360-tiny-planet.jpg", title: "Modern Living Tour" },
          { modelId: "VfWtuD6UqSw", thumbnail: "/images/portfolio/matterport-measurements.jpg", title: "Measurement Demo" },
        ]}
      />
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <div class="blocks">
        <ServiceBlock
          image={asset("/images/portfolio/matterport-360.jpg")}
          alt="360-degree Matterport virtual tour panorama of a Las Vegas listing"
          title="Dollhouse, floor plan & measurement views"
          body="Every Matterport tour ships with the full view suite: the dollhouse for a 3D overview of the whole home, floor plan view for layout at a glance, and the inside-walk for navigating room by room. Buyers get the whole property in one model."
          bullets={["Dollhouse view — full 3D overview", "Floor plan view — layout at a glance", "Inside walk — room-by-room navigation"]}
        />
        <ServiceBlock
          reverse
          image={asset("/images/portfolio/matterport-measurements.jpg")}
          alt="Matterport measurement tool showing precise room dimensions"
          title="Measurement tools & Mattertags"
          body="Buyers can measure walls, doors and fixtures right inside the tour. Add Mattertags to highlight features, embed video, link to docs, or annotate rooms. The measurement data also exports as a Matterpak for BIM and CAD workflows."
          bullets={["Point-and-click measurements in-browser", "Mattertag info hotspots", "Matterpak export for architects & engineers"]}
        />
        <ServiceBlock
          image={asset("/images/portfolio/360-tiny-planet.jpg")}
          alt="Tiny-planet 360 panorama from a Las Vegas Matterport virtual tour"
          title="33.6 megapixel capture, Matterport Service Partner"
          body="Captured on the Matterport Pro3 camera at 33.6 megapixels per scan, with Mike as a certified Matterport Service Partner. Every tour ships with 6 months of free hosting and two MLS landing-page links: one branded, one unbranded — so it drops straight into the MLS."
          bullets={matterportIncludes}
        />
      </div>
    </div>
  </section>

  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Matterport pricing"
        title="Real, published Matterport pricing."
        lead="Two MLS landing-page links included with every Matterport tour. Free hosting for 6 months, then $72 for an additional 6 months per model, cancel any time."
        align="center"
      />
      <div class="ptables">
        <PriceTable title="Matterport Premier 3D" tiers={matterportTiers} note="Includes 2 MLS links + 6 months hosting" />
      </div>
      <p class="text-center" style="margin-top:2.5rem">
        <a href={asset("/contact/")} class="btn brass">Book a Matterport Tour</a>
      </p>
    </div>
  </section>

  <CTABand
    title="Book a Matterport tour of your listing."
    body={`The most immersive way to show a property online. Call or text ${business.phone}.`}
    image={asset("/images/portfolio/matterport-360.jpg")}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .blocks { display: flex; flex-direction: column; gap: clamp(3rem, 6vw, 5rem); }
  .ptables {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    max-width: 1080px;
    margin-inline: auto;
  }
  .demo-embed { width: 100%; min-width: 0; }
  .demo-title { font-size: var(--step-3); margin-top: 0.4rem; }
  .demo-lead { margin-top: 1rem; }
  .demo-note { font-size: var(--step--1); color: var(--stone); margin-top: 1rem; }

  @media (max-width: 820px) {
    .demo-grid { grid-template-columns: 1fr; }
    .demo-embed { order: -1; }
  }
</style>
