---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import { matterportTiers, zillowTiers, business } from "../../data/site";
import meta from "../../data/cms/services/3d-tours.json";

const title = meta.title || "Matterport & Zillow 3D Virtual Tours Las Vegas | VTLV";
const description = meta.description || "Las Vegas Matterport 3D virtual tours and Zillow 3D Home tours by Mike Madsen — the brand's namesake service. Dollhouse, floor plan and measurement views, with free hosting and MLS embed links. Book a 3D tour.";

const heroEyebrow = meta.eyebrow || "";
const heroTitle = meta.headline || "";
const heroLead = meta.lead || "";

const hubCards = [
  {
    title: "Matterport 3D Virtual Tours",
    tag: "The flagship",
    blurb:
      "The industry-standard 3D walkthrough. Dollhouse view, floor plan view, measurement tools and Mattertag hotspots, captured at 33.6 megapixels. 6 months free hosting, two MLS landing-page links.",
    bullets: [
      `From $${matterportTiers[0].price}`,
      "Dollhouse + floor plan + measurement views",
      "33.6 MP Pro3 capture, Matterport Service Partner",
      "6 months free hosting + 2 MLS links",
    ],
    href: "/services/matterport/",
    image: "/images/portfolio/matterport-360.jpg",
    alt: "360-degree Matterport virtual tour panorama of a Las Vegas listing",
    featured: true,
  },
  {
    title: "Zillow 3D Home Tours",
    tag: "Most-booked add-on",
    blurb:
      "360 panoramas that live on Zillow, host free forever, and lift your listing higher in Zillow search. Mike was the photographer for the Zillow Offers program in Las Vegas, with over 1,500 tours completed.",
    bullets: [
      `From $${zillowTiers[0].price}`,
      "10–12 connected 360 panoramas",
      "Optional Zillow floor plan integration",
      "Free hosting forever on Zillow",
    ],
    href: "/services/zillow-3d/",
    image: "/images/portfolio/360-tiny-planet.jpg",
    alt: "Tiny-planet 360 panorama from a Las Vegas Zillow 3D Home tour",
    featured: false,
  },
];
---
<Base title={title} description={description} heroVariant="dark">
  <ServiceSchema
    slot="head"
    name="3D & Virtual Tours"
    description="3D and virtual tours for Las Vegas real estate: Matterport 3D walkthroughs with dollhouse, floor plan and measurement views, plus Zillow 3D Home tours with free hosting and Zillow floor plan integration."
    serviceType="3D Virtual Tour"
    startingPrice={50}
  />
  <PageHero
    eyebrow={heroEyebrow}
    title={heroTitle}
    lead={heroLead}
    image={asset("/images/portfolio/matterport-360.jpg")}
    imageAlt="360-degree virtual tour panorama of a Las Vegas listing"
  />

  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Two 3D tour platforms"
        title="Matterport and Zillow 3D are different tools."
        lead="Traditional 'virtual tours' are just 2D photo galleries dressed up to look panoramic. You can't actually move through the space. A true 3D tour lets a buyer walk the property. There are two leading platforms — pick the one that fits the listing, or run both."
        align="center"
      />
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <div class="hub-grid">
        {hubCards.map((c) => (
          <article class:list={["hub-card", { featured: c.featured }]} data-reveal>
            <div class="hub-img">
              <img src={asset(c.image)} alt={c.alt} loading="lazy" width="700" height="525" />
              {c.featured && <span class="hub-flag">Flagship</span>}
            </div>
            <div class="hub-body">
              <p class="hub-tag">{c.tag}</p>
              <h2 class="display hub-title">{c.title}</h2>
              <p class="hub-blurb">{c.blurb}</p>
              <ul class="hub-bullets" role="list">
                {c.bullets.map((b) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <a href={asset(c.href)} class="btn brass hub-cta">
                Explore {c.title.replace(" Virtual Tours", "").replace(" Tours", "").replace(" 3D", " 3D")}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="text-center muted" style="margin-top:2.5rem">
        Not sure which platform fits your listing?{" "}
        <a href={asset("/contact/")} class="text-link">Ask Mike →</a>
      </p>
    </div>
  </section>

  <CTABand
    title="Book a 3D tour of your listing."
    body={`The most immersive way to show a property online. Call or text ${business.phone}.`}
    image={asset("/images/portfolio/matterport-360.jpg")}
  />
</Base>

<style>
  .hub-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }
  .hub-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .hub-card.featured { border-color: var(--brass); box-shadow: 0 0 0 1px var(--brass), var(--shadow-lift); }
  .hub-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .hub-img {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .hub-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .hub-card:hover .hub-img img { transform: scale(1.04); }
  .hub-flag {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    background: var(--brass);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35em 0.85em;
    border-radius: 999px;
  }
  .hub-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.3rem, 1rem + 1.5vw, 2rem);
    flex: 1;
  }
  .hub-tag {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brass);
  }
  .hub-title { font-size: var(--step-3); color: var(--ink); }
  .hub-blurb { color: var(--stone); line-height: 1.6; font-size: var(--step-0); }
  .hub-bullets { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 0.5rem; }
  .hub-bullets li {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .hub-bullets svg { color: var(--brass); flex-shrink: 0; margin-top: 3px; }
  .hub-cta { margin-top: auto; align-self: flex-start; }

  @media (max-width: 820px) {
    .hub-grid { grid-template-columns: 1fr; }
  }
</style>
