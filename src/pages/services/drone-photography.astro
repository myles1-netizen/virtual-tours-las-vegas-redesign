---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceBlock from "../../components/ServiceBlock.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";
import Gallery from "../../components/Gallery.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import { portfolio, business } from "../../data/site";
import meta from "../../data/cms/services/drone-photography.json";

const droneShots = portfolio.filter((s) => s.category === "Drone");
const neonSkyline = "$250 · 30 HDR photos + 5 drone photos (homes under 3,000 sq ft)";

const title = meta.title || "Drone Photography Las Vegas — FAA Part 107 Aerial | VTLV";
const description = meta.description || "FAA Part 107 certified drone photography in Las Vegas. Aerial imagery showing lot size, setting and proximity to amenities — airspace-approved near McCarran/Harry Reid airport. Residential and commercial aerial photography.";

const heroEyebrow = meta.eyebrow || "";
const heroTitle = meta.headline || "";
const heroLead = meta.lead || "";
---
<Base title={title} description={description} heroVariant="dark">
  <ServiceSchema
    slot="head"
    name="Drone Photography"
    description="FAA Part 107 certified aerial drone photography in Las Vegas: aerial imagery showing lot size, setting and proximity to amenities, airspace-approved near Las Vegas airports."
    serviceType="Drone Photography"
  />
  <PageHero
    eyebrow={heroEyebrow}
    title={heroTitle}
    lead={heroLead}
    image={asset("/images/portfolio/drone-aerial.jpg")}
    imageAlt="Aerial drone photo of a Las Vegas property and surrounding neighborhood"
  />

  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Why drone"
        title="Aerial context sells the location."
        lead="For listings with a pool, a view, acreage, or proximity to the Strip, a drone shot is often the image that earns the click. For commercial properties, aerial imagery documents site layout, parking and infrastructure in a single frame."
        align="center"
      />
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <Gallery shots={droneShots} />
    </div>
  </section>

  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Pricing"
        title="The Neon Skyline package includes drone."
        lead="Standalone drone available on request. The Neon Skyline residential package bundles 30 HDR photos with 5 drone shots, the easiest way to add aerial to a listing."
      />
      <div class="neon-card" data-reveal>
        <div>
          <p class="eyebrow">Residential drone package</p>
          <h3 class="display">Neon Skyline</h3>
          <p class="neon-price">$250</p>
          <ul class="neon-includes" role="list">
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>30 HDR photos</li>
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>5 drone photos</li>
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>FAA Part 107 pilot</li>
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>MLS slideshow</li>
          </ul>
          <p class="neon-note">Homes 3,000 sq ft or less (incl. garage). Weather-dependent: wind, rain or airspace closures may require a revisit or partial refund.</p>
        </div>
        <div class="neon-cta">
          <a href={asset("/contact/")} class="btn brass btn-block">Book Neon Skyline</a>
          <a href={asset("/pricing/")} class="text-link" style="justify-content:center">See all pricing →</a>
        </div>
      </div>

      <ServiceBlock
        reverse
        image={asset("/images/portfolio/warehouse-drone-2.jpg")}
        alt="Industrial property aerial view by an FAA-certified drone pilot"
        title="Commercial drone & insurance"
        body="Commercial-grade aerial for site documentation, marketing, and insurance scope. My Part 107 credentials and experience securing airspace approvals near Las Vegas airports make me a safe choice for commercial and industrial work."
        bullets={["FAA Part 107 certified", "Airspace approval near McCarran/Harry Reid", "Site layout, parking and infrastructure"]}
      />

      {/* Heat considerations — Las Vegas summers are hard on drone hardware.
          Drones overheat, batteries drain fast, and a crashed drone helps no
          one. This sets honest expectations so clients understand a reschedule
          is about safety, not quality. */}
      <section class="heat-card" data-reveal>
        <p class="eyebrow">Las Vegas heat &amp; drone operations</p>
        <h3 class="display heat-title">When it's too hot to fly, we reschedule.</h3>
        <div class="heat-body">
          <p>
            Summer temperatures in Las Vegas regularly exceed 105°F, and drones
            aren't built for that. Above 105°F, the aircraft itself can overheat
            mid-flight and lithium-polymer battery life drops sharply — both of
            which shorten flights and, more importantly, raise the real risk of
            a malfunction or crash.
          </p>
          <p>
            Mike monitors the forecast and weather apps before every aerial
            booking. If it's too hot for safe operation, he'll reach out to
            reschedule for an early-morning or cooler-day slot — no charge. This
            is a <strong>safety issue, not a quality issue</strong>: it's always
            better to get the shots another day than to risk crashing a drone on
            your property. The same applies to high wind, which is common in the
            valley spring afternoons.
          </p>
          <ul class="heat-points" role="list">
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Flights are shortened or rescheduled above 105°F</span></li>
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Battery life is significantly reduced in extreme heat</span></li>
            <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Early-morning slots are the workaround through July &amp; August</span></li>
          </ul>
        </div>
      </section>
    </div>
  </section>

  <CTABand
    title="Add aerial to your next shoot."
    body={`FAA-certified, airspace-approved. Call or text ${business.phone}.`}
    image={asset("/images/portfolio/drone-aerial.jpg")}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .neon-card {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    margin-block: 2.5rem 3rem;
  }
  .neon-card .eyebrow { color: var(--brass-2); }
  .neon-card h3 { color: var(--on-dark); font-size: var(--step-3); margin-top: 0.4rem; }
  .neon-price { font-family: var(--font-display); font-size: var(--step-5); color: var(--brass-2); margin-top: 0.5rem; }
  .neon-includes { display: flex; flex-direction: column; gap: 0.55rem; margin: 1.3rem 0; }
  .neon-includes li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: var(--step--1); color: rgba(247,244,239,0.85); }
  .neon-includes svg { color: var(--brass-2); flex-shrink: 0; margin-top: 3px; }
  .neon-note { font-size: 0.78rem; color: rgba(247,244,239,0.55); }
  .neon-cta { display: flex; flex-direction: column; gap: 1rem; }

  /* Heat-considerations callout — warm-toned card so it reads as a safety
     notice, distinct from the dark Neon Skyline card above. */
  .heat-card {
    margin-block: 3rem 0;
    padding: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-left: 4px solid var(--brass);
    border-radius: var(--radius-lg);
  }
  .heat-card .eyebrow { color: var(--brass); }
  .heat-title { font-size: var(--step-3); margin-top: 0.4rem; color: var(--ink); }
  .heat-body { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .heat-body p { color: var(--stone); line-height: 1.65; }
  .heat-body strong { color: var(--ink-2); }
  .heat-points { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 0.6rem; }
  .heat-points li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: var(--step--1); color: var(--ink-2); }
  .heat-points svg { color: var(--brass); flex-shrink: 0; margin-top: 3px; }

  @media (max-width: 760px) { .neon-card { grid-template-columns: 1fr; } }
</style>
