---
import { asset, getContent } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import CTABand from "../../components/CTABand.astro";
import { portfolio, business } from "../../data/site";

const c = getContent("work", {});
const title = c.seo?.title || "Portfolio — Las Vegas Real Estate Photography & 3D Tours";
const description = c.seo?.description || "Selected Las Vegas real estate photography by Mike Madsen: HDR interiors, drone, virtual staging, Matterport 3D tours, commercial, and floor plans. Filter by category and view full-screen.";
---
<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow={c.hero?.eyebrow || "Selected work"}
    title={c.hero?.title || "A Las Vegas photographer's portfolio."}
    lead={c.hero?.lead || "HDR interiors, aerial drone, virtual staging, Matterport 3D and commercial work, all shot by me across the Las Vegas Valley. Filter by category and click any image to view full-screen."}
    image={asset(c.hero?.image || "/images/portfolio/listing-01.jpg")}
    imageAlt={c.hero?.imageAlt || "Spacious Las Vegas living room with mountain views, professionally photographed"}
    cmsPrefix="hero"
  />

  <section class="section">
    <div class="container">
      <Gallery shots={portfolio} filters={true} />
    </div>
  </section>

  <section class="section sm paper-2">
    <div class="container narrow text-center">
      <p class="eyebrow center">{c.more?.eyebrow || "Need to see more?"}</p>
      <h2 class="display" style="font-size:var(--step-3); margin-bottom:1rem">{c.more?.title || "I've shot thousands of properties."}</h2>
      <p class="lead" style="margin-inline:auto; margin-bottom:1.5rem">{c.more?.lead || "From one-bedroom condos to mansions with indoor basketball gyms. Request a specific type of sample, or book a walkthrough of recent work."}</p>
      <div class="btn-row" style="justify-content:center">
        <a href={business.phoneHref} class="btn brass">{c.more?.callLabel || "Call"} {business.phone}</a>
        <a href={asset("/contact/")} class="btn outline">{c.more?.samplesLabel || "Request samples"}</a>
      </div>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
</style>
