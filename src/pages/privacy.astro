---
import Base from "../layouts/Base.astro";
import { business } from "../data/site";

const title = "Privacy Policy — Virtual Tours Las Vegas | Mike Madsen";
const description =
  "Privacy policy for Virtual Tours Las Vegas: what data the contact and booking forms collect, how it is used, your rights under Nevada (NRS 603A) and California (CCPA/CPRA) law, and how to request access or deletion.";

const lastUpdated = "July 24, 2026";
---

<Base title={title} description={description} heroVariant="light">
  <section class="section">
    <div class="container narrow legal">
      <p class="eyebrow">Legal</p>
      <h1 class="display legal-title">Privacy Policy</h1>
      <p class="legal-meta">Last updated {lastUpdated} · {business.name}</p>

      <p class="legal-intro">
        I collect the minimum information needed to respond to your inquiry, schedule your photography
        session, and deliver your photos and tours. I don't sell or share your information, and I don't
        use tracking cookies. This policy explains what I collect, how I use it, and the rights you have.
      </p>

      <h2 id="what-i-collect">What data I collect</h2>
      <ul class="legal-list">
        <li><strong>Contact form submissions</strong> — your name, email, phone number, and the message you send me.</li>
        <li><strong>Booking requests</strong> — your name, email, phone number, property details (address, type, square footage), and your preferred date and time.</li>
      </ul>
      <p>That's it. I do not run analytics or advertising cookies on this site unless I have explicitly enabled Google Analytics, and even then it runs in a privacy-friendly, cookieless configuration by default.</p>

      <h2 id="what-i-dont-collect">What I don't collect</h2>
      <ul class="legal-list">
        <li>I don't use tracking cookies.</li>
        <li>I don't sell or share your personal information.</li>
        <li>I don't have user accounts — there is no login system on the public site.</li>
      </ul>

      <h2 id="how-i-use">How I use your data</h2>
      <ul class="legal-list">
        <li>To respond to your inquiry.</li>
        <li>To schedule and complete your photography session.</li>
        <li>To deliver your photos and tours.</li>
        <li>I keep our correspondence until your project is complete, then I delete it.</li>
      </ul>

      <h2 id="nevada">Nevada privacy law (NRS 603A)</h2>
      <p>
        Under Nevada Revised Statutes Chapter 603A, Nevada residents have the following rights regarding
        the personal information I collect:
      </p>
      <ul class="legal-list">
        <li>The right to request to know what personal information I have collected about you.</li>
        <li>The right to request deletion of your personal information.</li>
      </ul>
      <p>
        To make a request, email <a href={business.emailHref}>{business.email}</a> or call
        <a href={business.phoneHref}>{business.phone}</a>. I will respond within 30 days.
      </p>

      <h2 id="california">California (CCPA / CPRA)</h2>
      <p>
        If you are a California resident, the California Consumer Privacy Act (CCPA), as amended by the
        California Privacy Rights Act (CPRA), gives you the same rights described above — Nevada and
        California have similar requirements. You may request to know what personal information I have
        collected about you and request its deletion.
      </p>
      <p><strong>I do not sell personal information.</strong> No opt-out is needed.</p>

      <h2 id="children">Children's privacy</h2>
      <p>
        I do not knowingly collect personal information from anyone under 13. If you believe a child has
        submitted information through this site, contact me and I will delete it.
      </p>

      <h2 id="contact">Contact</h2>
      <p>
        Questions about this policy or any privacy request? Contact me directly:
      </p>
      <ul class="legal-list">
        <li><strong>{business.owner}</strong>, {business.name}</li>
        <li>Phone / text: <a href={business.phoneHref}>{business.phone}</a></li>
        <li>Email: <a href={business.emailHref}>{business.email}</a></li>
      </ul>

      <h2 id="changes">Changes to this policy</h2>
      <p>
        I may update this policy from time to time; the "Last updated" date above reflects the most recent
        revision.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal-title { font-size: var(--step-5); margin-block: 0.5rem 0.2rem; }
  .legal-meta { color: var(--stone-2); font-size: var(--step--1); margin-bottom: 2rem; }
  .legal-intro { color: var(--stone); line-height: 1.65; margin-bottom: 1.5rem; padding: 1rem 1.2rem; background: var(--paper-2); border-left: 3px solid var(--brass); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .legal h2 {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brass);
    margin-top: 2.2rem;
    margin-bottom: 0.6rem;
    scroll-margin-top: 6rem;
  }
  .legal p { color: var(--stone); line-height: 1.65; margin-bottom: 0.7rem; }
  .legal strong { color: var(--ink); }
  .legal a { color: var(--brass); font-weight: 600; }
  .legal-list { list-style: none; padding: 0; margin: 0.5rem 0 1rem; }
  .legal-list li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--stone);
    line-height: 1.6;
    margin-bottom: 0.45rem;
  }
  .legal-list li::before {
    content: "·";
    position: absolute;
    left: 0.3rem;
    color: var(--brass);
    font-weight: 700;
    font-size: 1.2em;
    line-height: 1;
  }
  .legal-list li strong { color: var(--ink); }
</style>
