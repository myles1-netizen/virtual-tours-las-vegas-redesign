---
import { asset } from "../data/site";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { business, vegasPackages, process } from "../data/site";

const title = "Book a Shoot — Las Vegas Real Estate Photography | VTLV";
const description = "Book a Las Vegas real estate photography or 3D tour shoot. Self-serve scheduling, or call and text Mike directly. Residential, commercial, vacation rentals, drone, floor plans. 24–48 hour delivery.";

// Cal.com embed configuration placeholder.
// When wired up: replace CAL_USERNAME with the real Cal.com user/event slug and
// UNCOMMENT the Cal.com <script> + <div> in the booking widget below. The CSP in
// Base.astro will also need `frame-src https://*.cal.com` and the Cal.com script
// host added to `script-src` — see the TODO note in the widget.
const CAL_USERNAME = ""; // e.g. "virtual-tours-las-vegas"
const calReady = CAL_USERNAME.length > 0;
---

<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="Booking"
    title="Pick a time. Get it shot."
    lead="Self-serve scheduling is coming. In the meantime, the fastest path is calling or texting Mike directly — he handles every booking himself and most shoots are on the calendar within 48 hours."
    image={asset("/images/portfolio/listing-02.jpg")}
    imageAlt="Spacious Las Vegas property interior, ready to be photographed"
  />

  <section class="section">
    <div class="container">
      <div class="book-grid">
        {/* ===== LEFT: booking widget ===== */}
        <div class="book-widget-wrap" data-reveal>
          <div class="book-widget" data-cal-embed>
            <p class="eyebrow">Schedule online</p>
            <h2 class="display book-widget-title">Self-serve calendar.</h2>

            {calReady ? (
              /* TODO: when CAL_USERNAME is set, this block renders the live Cal.com embed.
                 Requires CSP update in Base.astro:
                   script-src  ... https://app.cal.com  (and the embed CDN)
                   frame-src   https://*.cal.com
              */
              <div
                class="cal-embed"
                data-cal-namespace="vtlv"
                data-cal-link={CAL_USERNAME}
                data-cal-config='{"layout":"month_view"}'
              >
                {/* Cal.com embed script loads here once CSP is updated:
                    <script type="module" src="https://app.cal.com/embed/embed.js" is:inline></script> */}
              </div>
            ) : (
              <div class="cal-placeholder" role="status" aria-live="polite">
                <div class="cal-mock" aria-hidden="true">
                  <div class="cal-mock-bar">
                    <span class="cal-mock-dot"></span>
                    <span class="cal-mock-dot"></span>
                    <span class="cal-mock-dot"></span>
                  </div>
                  <div class="cal-mock-body">
                    <div class="cal-mock-line w70"></div>
                    <div class="cal-mock-grid">
                      {Array.from({ length: 14 }).map(() => <span class="cal-mock-cell"></span>)}
                    </div>
                    <div class="cal-mock-line w40"></div>
                  </div>
                </div>
                <p class="cal-placeholder-text">
                  Online self-scheduling is being configured. For now, the fastest way to book is direct.
                </p>
                <div class="cal-placeholder-actions">
                  <a href={business.phoneHref} class="btn brass btn-block">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    Call {business.phone}
                  </a>
                  <a href={business.smsHref} class="btn outline btn-block">Text Mike</a>
                  <a href={asset("/contact/")} class="text-link">or send a booking request →</a>
                </div>
              </div>
            )}
          </div>
        </div>

        {/* ===== RIGHT: context — packages & how it works ===== */}
        <aside class="book-context" data-reveal data-reveal-delay="1">
          <div class="context-card">
            <p class="eyebrow">Packages at a glance</p>
            <h2 class="display context-title">Know what you're booking.</h2>
            <ul class="context-pkgs" role="list">
              {vegasPackages.map((p) => (
                <li>
                  <span class="cpkg-name">{p.name}</span>
                  <span class="cpkg-price">${p.price}</span>
                  <span class="cpkg-note">{p.tag}</span>
                </li>
              ))}
            </ul>
            <a href={asset("/pricing/")} class="text-link">Full pricing &amp; build a quote →</a>
          </div>

          <ol class="context-process" role="list">
            {process.map((step) => (
              <li>
                <span class="step-num">{step.step}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .book-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .book-widget {
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.2rem);
    box-shadow: var(--shadow-card);
    position: sticky;
    top: 100px;
  }
  .book-widget-title { font-size: var(--step-3); margin-top: 0.3rem; }

  .cal-placeholder { display: flex; flex-direction: column; gap: 1.2rem; margin-top: 1.4rem; }
  .cal-mock {
    border: 1px solid var(--line-light);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
  }
  .cal-mock-bar {
    display: flex; gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line-light);
  }
  .cal-mock-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--paper-3); }
  .cal-mock-body { padding: 1.1rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .cal-mock-line { height: 10px; background: var(--paper-3); border-radius: 4px; }
  .cal-mock-line.w70 { width: 70%; }
  .cal-mock-line.w40 { width: 40%; }
  .cal-mock-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }
  .cal-mock-cell {
    aspect-ratio: 1;
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: 4px;
  }
  .cal-mock-cell:nth-child(3n) { background: var(--brass-soft); border-color: transparent; }
  .cal-placeholder-text { font-size: var(--step--1); color: var(--stone); line-height: 1.5; }
  .cal-placeholder-actions { display: flex; flex-direction: column; gap: 0.7rem; align-items: stretch; }
  .cal-placeholder-actions .text-link { align-self: center; }

  /* Context column */
  .book-context { display: flex; flex-direction: column; gap: 1.5rem; }
  .context-card {
    background: var(--dark);
    color: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 1.2rem + 1.5vw, 2rem);
  }
  .context-card .eyebrow { color: var(--brass-2); }
  .context-title { color: var(--paper); font-size: var(--step-2); margin-top: 0.3rem; }
  .context-pkgs { display: flex; flex-direction: column; gap: 0.7rem; margin: 1.2rem 0 1rem; }
  .context-pkgs li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "name price" "note note";
    gap: 0.1rem 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--line-dark);
  }
  .context-pkgs li:last-child { border-bottom: none; }
  .cpkg-name { grid-area: name; font-family: var(--font-display); font-size: var(--step-1); color: var(--paper); }
  .cpkg-price { grid-area: price; font-family: var(--font-display); font-size: var(--step-2); color: var(--brass-2); }
  .cpkg-note { grid-area: note; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(247,244,239,0.55); }
  .context-card .text-link { color: var(--brass-2); }

  .context-process { display: flex; flex-direction: column; gap: 1.2rem; }
  .context-process li { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--brass);
    line-height: 1;
    flex-shrink: 0;
    min-width: 2ch;
  }
  .context-process h3 { font-size: var(--step-1); }
  .context-process p { margin-top: 0.3rem; font-size: var(--step--1); color: var(--stone); line-height: 1.5; }

  @media (max-width: 880px) {
    .book-grid { grid-template-columns: 1fr; }
    .book-widget { position: static; }
  }
</style>
