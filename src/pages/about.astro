---
import { asset } from "../data/site";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import TrustBar from "../components/TrustBar.astro";
import CTABand from "../components/CTABand.astro";
import { business, trust } from "../data/site";

const title = "About Mike Madsen — Las Vegas Real Estate Photographer | VTLV";
const description = "Meet Mike Madsen, the photographer behind Virtual Tours Las Vegas. Licensed real estate agent since 2006, sole photographer for the Zillow Offers program and sole Matterport provider for Lennar Homes in Las Vegas. FAA Part 107 drone pilot and Google Trusted Photographer.";
---
<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="About"
    title="You're hiring Mike. Not a middleman."
    lead="Most real estate photo companies are middlemen who outsource your listing to whoever's closest. Virtual Tours Las Vegas is one photographer, Mike Madsen, and he shoots, edits and delivers every property himself."
    image={asset("/images/portfolio/sierra-skye-kitchen.jpg")}
    imageAlt="Modern Las Vegas kitchen photographed by Mike Madsen"
  />

  {/* ===== STORY ===== */}
  <section class="section">
    <div class="container">
      <div class="story-grid">
        <div class="story-text" data-reveal>
          <p class="eyebrow">The story</p>
          <h2 class="display story-title">From bank-owned listings to Zillow's flagship program.</h2>
          <div class="story-body">
            <p>Mike's been in real estate since {business.realEstateSince} — first as a licensed agent, then as the marketing lead overseeing the sale of bank-owned properties through the recession. That work earned him Sales &amp; Marketing recognition from the Wall Street Journal and Realtor.com, and it's where he learned what actually moves a listing.</p>
            <p>When the bank-owned market wound down, Mike launched Virtual Tours Las Vegas in {business.since}. He shot thousands of properties, from one-bedroom condos to mansions with indoor basketball gyms, and built a reputation serious enough that <strong>Zillow tapped him as the sole photographer for the Zillow Offers program in Las Vegas</strong>, and <strong>Lennar Homes, a top-3 US homebuilder, named him their sole Matterport provider</strong>.</p>
            <p>Once, he shot HDR photos and 360s for eight houses in a single day. He's also spent two straight days documenting a single mansion. Every property gets the same standard: straight walls, real colors, no blown-out windows.</p>
            <p>Mike shoots on a mirrorless DSLR, holds a Part 107 drone license, and is a Google Trusted Photographer. He still holds his real estate license too, and started the business with his wife Michelle Sproul, a licensed Realtor. He understands listings because he's been on that side of the desk.</p>
          </div>
        </div>
        <aside class="story-side" data-reveal data-reveal-delay="2">
          <div class="creds-card">
            <p class="eyebrow">At a glance</p>
            <ul class="creds-list" role="list">
              {trust.map((t) => (
                <li>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
            <hr class="divider" style="margin-block:1.4rem" />
            <ul class="facts-list" role="list">
              <li><span>In real estate</span><strong>Since {business.realEstateSince}</strong></li>
              <li><span>Shooting Vegas</span><strong>Since {business.since}</strong></li>
              <li><span>Properties shot</span><strong>Thousands</strong></li>
              <li><span>Turnaround</span><strong>{business.turnaround}</strong></li>
              <li><span>Based in</span><strong>{business.areaNote}</strong></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ===== APPROACH ===== */}
  <section class="section dark approach">
    <div class="container">
      <SectionHeader
        eyebrow="The approach"
        title='"I get behind my mirrorless DSLR and let the camera tell me what it wants to see."'
        lead="Mike's philosophy is simple: everything starts with the photos. A great 3D tour, social reel, or floor plan only matters if the underlying imagery is right. He treats every shoot like a 24/7 open house, because that's what it is to the buyer who clicks through at midnight."
      />
      <div class="approach-grid">
        <article data-reveal><h3>One photographer, one standard</h3><p>No rotating cast of subcontractors. Mike captures and delivers every shoot himself: the same eye, the same edit, the same accountability, every time.</p></article>
        <article data-reveal data-reveal-delay="1"><h3>Real-estate native</h3><p>A licensed agent who's marketed and sold real estate. He understands MLS workflow, listing strategy and what actually makes a buyer click, because he's done it himself.</p></article>
        <article data-reveal data-reveal-delay="2"><h3>Equipment &amp; craft</h3><p>Mirrorless DSLR capture, professional HDR processing, Matterport 3D scanning, FAA-certified aerial work. He keeps refining the craft, the same approach he picked up studying photography fundamentals years ago.</p></article>
        <article data-reveal data-reveal-delay="3"><h3>Fast &amp; reliable</h3><p>24–48 hour standard delivery, MLS-ready formats, embed codes included. Rush next-morning delivery when a listing needs to go live fast.</p></article>
      </div>
    </div>
  </section>

  {/* ===== TRUSTED BY ===== */}
  <section class="section sm">
    <div class="container">
      <TrustBar />
    </div>
  </section>

  {/* ===== CREDENTIALS STRIP ===== */}
  <section class="section paper-2 creds-strip">
    <div class="container">
      <SectionHeader
        eyebrow="Certifications"
        title="Licensed, certified & trusted."
        align="center"
      />
      <div class="cred-imgs">
        <div class="cred-img" data-reveal>
          <img src={asset("/images/services/faa-certified.jpg")} alt="FAA Part 107 Certified Drone Pilot credential" loading="lazy" />
          <p>FAA Part 107<br />Drone Pilot</p>
        </div>
        <div class="cred-img" data-reveal data-reveal-delay="1">
          <img src={asset("/images/services/google-trusted.jpg")} alt="Google Trusted Photographer credential" loading="lazy" />
          <p>Google Trusted<br />Photographer</p>
        </div>
        <div class="cred-img" data-reveal data-reveal-delay="2">
          <img src={asset("/images/services/credentials.png")} alt="Real estate photography credentials" loading="lazy" />
          <p>Real Estate<br />Industry Credentials</p>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    title="Work with the photographer Zillow & Lennar trusted."
    body={`Same standard, every shoot. Call or text ${business.phone}.`}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .story-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .story-title { font-size: var(--step-4); margin-top: 0.3rem; margin-bottom: 1.5rem; }
  .story-body { display: flex; flex-direction: column; gap: 1rem; color: var(--stone); line-height: 1.65; }
  .story-body strong { color: var(--ink); }
  .story-body em { font-style: italic; }

  .creds-card {
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    position: sticky;
    top: 100px;
  }
  .creds-list { display: flex; flex-direction: column; gap: 0.85rem; margin-top: 0.8rem; }
  .creds-list li {
    display: flex; gap: 0.65rem; align-items: flex-start;
    font-size: var(--step--1); color: var(--ink-2); line-height: 1.4;
  }
  .creds-list svg { color: var(--brass); flex-shrink: 0; margin-top: 2px; }
  .facts-list { display: flex; flex-direction: column; gap: 0.7rem; }
  .facts-list li {
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: var(--step--1);
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line-light);
  }
  .facts-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .facts-list span { color: var(--stone); }
  .facts-list strong { color: var(--ink); font-weight: 600; }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    margin-top: 2.5rem;
  }
  .approach-grid article { display: flex; flex-direction: column; gap: 0.6rem; }
  .approach-grid h3 { color: var(--on-dark); font-size: var(--step-1); }
  .approach-grid p { color: rgba(247,244,239,0.7); font-size: var(--step--1); line-height: 1.5; }

  .cred-imgs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 2.5rem;
    max-width: 900px;
    margin-inline: auto;
  }
  .cred-img {
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
    text-align: center;
  }
  .cred-img img {
    width: 100%;
    max-width: 200px;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .cred-img p { font-size: var(--step--1); color: var(--stone); font-weight: 600; line-height: 1.4; }

  @media (max-width: 980px) {
    .approach-grid { grid-template-columns: repeat(2, 1fr); }
    .creds-card { position: static; }
  }
  @media (max-width: 820px) {
    .story-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .approach-grid { grid-template-columns: 1fr; }
    .cred-imgs { grid-template-columns: 1fr; }
  }
</style>
