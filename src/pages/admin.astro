      function parseFrontmatter(raw) {
        const m = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
        if (!m) return { title: "", description: "", body: raw };
        const fm = {};
        for (const line of m[1].split("\n")) {
          const mm = line.match(/^(\w+):\s*"?(.*?)"?\s*$/);
          if (mm) fm[mm[1]] = mm[2];
        }
        fm.body = m[2];
        return fm;
      }
      function buildFrontmatter(fm) {
        const lines = ["---"];
        for (const [k, v] of Object.entries(fm)) {
          if (k === "body") continue;
          const val = v == null ? "" : String(v).replace(/"/g, '\\"');
          lines.push(`${k}: "${val}"`);
        }
        lines.push("---", "");
        return lines.join("\n");
      }

      async function blogEditor(post) {
        const isNew = !post;
        const data = post || { title: "", description: "", slug: "", date: new Date().toISOString().slice(0, 10), category: "Real Estate", author: "Mike Madsen", heroImage: "", draft: false, body: "" };
        const slug = data.slug || (data.filename || "").replace(".md", "");
        const root = $("#content");
        root.innerHTML = "";
        root.appendChild(pageHead(isNew ? "New post" : data.title, slug ? `Editing ${slug}.md` : "", [
          el("button", { class: "btn btn-ghost", onclick: () => navigate("posts"), text: "← Back" }),
          el("button", { class: "btn btn-primary", onclick: () => savePost(data, isNew), text: "Save & publish" }),
        ]));

        // Post settings card
        const w = el("div", { class: "form-grid" });
        const titleI = textInput({ value: data.title });
        titleI.oninput = () => data.title = titleI.value;
        w.appendChild(field("Title", titleI));
        const slugI = textInput({ value: slug });
        slugI.oninput = () => { data.slug = slugI.value; data.filename = slugI.value.replace(/[^a-z0-9-]/g, "-") + ".md"; };
        w.appendChild(field("URL slug", slugI, "Lowercase, dashes only"));
        const descT = textarea();
        descT.value = data.description || "";
        descT.oninput = () => data.description = descT.value;
        w.appendChild(field("Meta description", descT, "Shown in search results (150-160 chars)"));
        const cats = ["Real Estate", "Photography", "Las Vegas", "Tips", "News"];
        const catS = selectInput(cats.map(c => ({ value: c, label: c })));
        catS.value = data.category || "Real Estate";
        catS.onchange = () => data.category = catS.value;
        w.appendChild(field("Category", catS));
        const dateI = textInput({ type: "date", value: data.date });
        dateI.oninput = () => data.date = dateI.value;
        w.appendChild(field("Date", dateI));
        const authorI = textInput({ value: data.author || "" });
        authorI.oninput = () => data.author = authorI.value;
        w.appendChild(field("Author", authorI));
        const heroI = textInput({ value: data.heroImage || "", placeholder: "/images/blog/..." });
