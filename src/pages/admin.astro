      async function toggleBlogDraft(p) {
        showLoading(p.draft ? "Publishing\u2026" : "Unpublishing\u2026");
        try {
          p.draft = !p.draft;
          const md = stringifyFrontmatter({ title: p.title, description: p.description, publishDate: p.publishDate, author: p.author, category: p.category, draft: p.draft, heroImage: p.heroImage, heroAlt: p.heroAlt }) + (p.body && p.body.startsWith("\n") ? p.body : "\n" + (p.body || ""));
          await writeFile(`${BLOG_DIR}/${p.name}`, md, `${p.draft ? "Unpublish" : "Publish"} ${p.name}`);
          hideLoading();
          toast(`"${p.title}" is now ${p.draft ? "a draft" : "published"}.`, "success", "Updated");
          await drawBlog();
        } catch (e) { hideLoading(); toast(e.message, "error", "Update failed"); }
      }

      function parseFrontmatter(md) {
        const m = md.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
        if (!m) return { body: md, title: "", description: "", draft: false, publishDate: "", author: "Mike Madsen", category: "", heroImage: "", heroAlt: "" };
        const raw = m[1]; const body = m[2];
        const out = { body };
        for (const line of raw.split("\n")) {
          const mm = line.match(/^([a-zA-Z]+):\s*(.*)$/);
          if (!mm) continue;
          let v = mm[2].trim();
          if (v.startsWith('"') && v.endsWith('"')) v = v.slice(1, -1);
          if (mm[1] === "draft") out[mm[1]] = v === "true";
          else if (mm[1] === "publishDate") out[mm[1]] = v;
          else out[mm[1]] = v;
        }
        return out;
      }

      function stringifyFrontmatter(fm) {
        const lines = ["---"];
        const order = ["title", "description", "publishDate", "author", "category", "draft", "heroImage", "heroAlt"];
        for (const k of order) {
          if (fm[k] === undefined || fm[k] === null || fm[k] === "") continue;
          let v = fm[k];
          if (k === "draft") v = v ? "true" : "false";
          else v = `"${String(v).replace(/"/g, '\\"')}"`;
          lines.push(`${k}: ${v}`);
        }
        lines.push("---", "");
        return lines.join("\n");
      }

      function newBlogPost() { editBlogPost(null); }

      function editBlogPost(name) {
        openModalLoading(name ? "Edit Post" : "New Post");
        (async () => {
          let fm = { title: "", description: "", publishDate: new Date().toISOString().slice(0, 10), author: "Mike Madsen", category: "real-estate-photography-tips", draft: true, heroImage: "/images/portfolio/sierra-skye-living.jpg", heroAlt: "" };
          let body = "";
          const originalName = name;
          if (name) {
            const file = await readFile(`${BLOG_DIR}/${name}`);
            const parsed = parseFrontmatter(file.content);
            fm = {
              title: parsed.title || "", description: parsed.description || "",
              publishDate: parsed.publishDate || "", author: parsed.author || "Mike Madsen",
              category: parsed.category || "", draft: !!parsed.draft,
              heroImage: parsed.heroImage || "", heroAlt: parsed.heroAlt || "",
            };
            body = parsed.body || "";
          }
          drawBlogEditor(fm, body, originalName);
        })().catch((e) => { closeModal(); toast(e.message, "error", "Could not open post"); });
      }

      function drawBlogEditor(fm, body, originalName) {
        const slugInput = el("input", { value: originalName ? originalName.replace(/\.md$/, "") : "", placeholder: "auto-from-title" });
        const titleInput = el("input", { type: "text", value: fm.title });
        const updateSlug = () => { if (!originalName) slugInput.value = slugify(fm.title); };
        titleInput.addEventListener("input", () => { fm.title = titleInput.value; updateSlug(); });

        const descArea = el("textarea", {});
        descArea.value = fm.description;
        descArea.addEventListener("input", () => { fm.description = descArea.value; });

        const bodyArea = el("textarea", { placeholder: "Write your post in Markdown\u2026" });
        bodyArea.value = body;
        bodyArea.style.cssText = "min-height:380px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13.5px;line-height:1.6";
        const preview = el("div", { class: "md-preview" });
        const renderPreview = () => { preview.innerHTML = simpleMarkdown(bodyArea.value); };
        bodyArea.addEventListener("input", renderPreview);
        renderPreview();

        const catInput = el("input", { type: "text", value: fm.category });
        catInput.addEventListener("input", () => { fm.category = catInput.value; });
        const authorInput = el("input", { type: "text", value: fm.author });
        authorInput.addEventListener("input", () => { fm.author = authorInput.value; });
        const heroInput = el("input", { type: "text", value: fm.heroImage });
        heroInput.addEventListener("input", () => { fm.heroImage = heroInput.value; });
        const heroAltInput = el("input", { type: "text", value: fm.heroAlt });
        heroAltInput.addEventListener("input", () => { fm.heroAlt = heroAltInput.value; });
        const dateI = el("input", { type: "date", value: fm.publishDate ? String(fm.publishDate).slice(0, 10) : "" });
        dateI.addEventListener("input", () => { fm.publishDate = dateI.value; });

        const draftLbl = el("label", { class: "row-check", style: { margin: "8px 0 16px" } });
        const draftCb = el("input", { type: "checkbox" });
        if (fm.draft) draftCb.setAttribute("checked", "checked");
        draftCb.addEventListener("change", () => { fm.draft = draftCb.checked; });
        draftLbl.appendChild(draftCb);
        draftLbl.appendChild(el("span", {}, "Draft (hidden from the live site until unchecked)"));

        const body_ = el("div", {},
          el("div", { class: "form-grid" },
            wrapField("Title", titleInput, "full"),
            wrapField("Description", descArea, "full", "Used as the SEO meta description and the post excerpt."),
          ),
          el("div", { class: "form-grid" },
            wrapField("URL Slug", slugInput),
            wrapField("Category", catInput, null, "e.g. real-estate-photography-tips"),
            wrapField("Publish Date", dateI),
            wrapField("Author", authorInput),
            wrapField("Hero Image Path", heroInput, null, "Path under /images/."),
            wrapField("Hero Alt Text", heroAltInput),
          ),
          draftLbl,
          el("label", { style: { display: "block", fontWeight: "700", fontSize: "13px", margin: "0 0 6px" } }, "Content (Markdown)"),
          el("div", { class: "md-split" }, bodyArea, preview),
        );

        openModal(originalName ? "Edit Post" : "New Post", body_, [
          originalName ? el("button", { class: "btn btn-danger", onclick: () => { if (confirm("Delete this post permanently?")) deleteBlogPost({ name: originalName }); } }, "Delete") : null,
          el("div", { style: { flex: "1" } }),
          el("button", { class: "btn btn-ghost", onclick: closeModal }, "Cancel"),
          el("button", { class: "btn", onclick: () => {
