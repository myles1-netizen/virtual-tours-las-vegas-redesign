      function buildVisitorChart() {
        // Deterministic pseudo-random bar heights so the chart is stable.
        const data = Array.from({ length: 28 }, (_, i) => 30 + Math.round(40 * Math.abs(Math.sin(i * 0.7)) + 10 * Math.abs(Math.cos(i * 1.3))));
        const max = Math.max(...data);
        const wrap = el("div", { style: { display: "flex", alignItems: "flex-end", gap: "3px", height: "120px", marginTop: "10px" } });
        data.forEach((v, i) => {
          wrap.appendChild(el("div", {
            style: { flex: "1", height: `${(v / max) * 100}%`, background: "var(--brass)", borderRadius: "3px 3px 0 0", minHeight: "4px", opacity: i === data.length - 1 ? "1" : "0.7" },
            title: `Day ${i + 1}: ${v} visitors`,
          }));
        });
        return wrap;
      }

      // ============================================================
      //  Card builder + Modal helpers
      // ============================================================
      function sectionCard(title, subtitle, contentNodes) {
        const card = el("div", { class: "card" });
        card.appendChild(el("div", { style: { display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: "16px", flexWrap: "wrap" } },
          el("div", {}, el("h2", {}, title), subtitle ? el("p", { class: "sub", style: { marginBottom: "0" } }, subtitle) : null),
        ));
        if (contentNodes && contentNodes.length) card.appendChild(el("hr"));
        for (const n of contentNodes) card.appendChild(n);
        return card;
      }

      function openModal(title, bodyNode, footerNodes, size) {
        const modal = $("#modal");
        if (size === "lg") modal.classList.add("lg"); else modal.classList.remove("lg");
        clear(modal);
        modal.appendChild(el("div", { class: "mhead" }, el("h2", {}, title), el("button", { class: "x", onclick: closeModal }, "\u00d7")));
        modal.appendChild(el("div", { class: "mbody" }, bodyNode));
        modal.appendChild(el("div", { class: "mfoot" }, ...(footerNodes.filter(Boolean))));
        $("#overlay").classList.add("show");
      }
      function openModalLoading(title) {
        const modal = $("#modal");
        clear(modal);
        modal.appendChild(el("div", { class: "mhead" }, el("h2", {}, title), el("button", { class: "x", onclick: closeModal }, "\u00d7")));
        modal.appendChild(el("div", { class: "mbody" }, el("div", { class: "empty" }, el("div", { class: "spinner", style: { margin: "0 auto" } }))));
        $("#overlay").classList.add("show");
      }
      function closeModal() { $("#overlay").classList.remove("show"); }

      // ============================================================
      //  Dirty tracking + global Save bar
      //  Tracks which in-memory models have unsaved edits. The top-bar
      //  Save button writes every dirty model back to GitHub in one pass.
      // ============================================================
      const SAVE_HANDLERS = {
        settings: () => models.settings && saveSettings(models.settings),
        pricing: () => models.pricing && savePricing(models.pricing),
      };
      const dirty = new Set();

      function markDirty(key) {
        if (SAVE_HANDLERS[key]) { dirty.add(key); updateSaveBar(); }
      }
      function markClean(key) { dirty.delete(key); updateSaveBar(); }
      function updateSaveBar() {
        const btn = $("#save-btn");
        const state = $("#save-state");
        const has = dirty.size > 0;
        btn.disabled = !has;
        if (has) { state.textContent = `Unsaved changes (${dirty.size})`; state.classList.add("dirty"); }
        else { state.textContent = "All changes saved"; state.classList.remove("dirty"); }
      }

      // ============================================================
      //  Shared list helpers
      // ============================================================
      function moveItem(arr, index, dir, after) {
        const j = index + dir;
        if (j < 0 || j >= arr.length) return;
        const tmp = arr[index]; arr[index] = arr[j]; arr[j] = tmp;
        after();
      }

      // ============================================================
      //  Wire up login + menu + boot
      // ============================================================
      $("#login-form").addEventListener("submit", (e) => {
        e.preventDefault();
        const tok = $("#li-token").value.trim();
        const pass = $("#li-pass").value;
        const remember = $("#li-remember").checked;
        if (!tok || !pass) return;
        attemptLogin(tok, pass, remember);
      });

      $("#menu-toggle").addEventListener("click", () => {
        const sb = $("#sidebar");
        const open = sb.classList.toggle("open");
        $("#sb-backdrop").style.display = open ? "block" : "none";
      });
      $("#sb-backdrop").addEventListener("click", () => {
        $("#sidebar").classList.remove("open");
        $("#sb-backdrop").style.display = "none";
      });

      $("#save-btn").addEventListener("click", async () => {
        if (!dirty.size) return;
        for (const key of Array.from(dirty)) {
          const h = SAVE_HANDLERS[key];
          if (h) await h();
        }
      });

      $("#overlay").addEventListener("click", (e) => { if (e.target.id === "overlay") closeModal(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

      // Restore remembered token into the form for convenience.
      (function prefill() {
        const rememberedToken = localStorage[LS.token];
        if (rememberedToken) {
          $("#li-token").value = rememberedToken;
          $("#li-remember").checked = true;
          $("#li-pass").focus();
        }
      })();

      // Apply saved CMS theme + custom CSS. Dark is the default.
      applyCmsTheme(localStorage[LS.theme] || "dark");
      applyCustomCss(localStorage.getItem("vtlv_custom_css") || "");

      // Auto-login if session/localStorage still holds a token.
      if (isLoggedIn()) {
        verifyToken(token())
          .then(() => enterApp())
          .catch(() => {
            sessionStorage.removeItem(LS.token); localStorage.removeItem(LS.token);
          });
      }
