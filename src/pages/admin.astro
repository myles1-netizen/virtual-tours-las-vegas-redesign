      function telHref(phone) {
        const digits = String(phone || "").replace(/[^\d+]/g, "");
        return digits.startsWith("+") ? `tel:${digits}` : `tel:+1${digits.replace(/\D/g, "")}`;
      }

      function tagsInput(items, onChange) {
        const wrap = el("div", { class: "tags", tabindex: "0" });
        const input = el("input", { placeholder: "Add and press Enter\u2026" });
        const draw = () => {
          $$("span.tag", wrap).forEach((n) => n.remove());
          items.forEach((val, idx) => {
            const chip = el("span", { class: "tag" }, esc(val),
              el("button", { type: "button", title: "Remove", onclick: () => { items.splice(idx, 1); draw(); onChange(items.slice()); } }, "\u00d7"));
            wrap.insertBefore(chip, input);
          });
        };
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === ",") {
            e.preventDefault();
            const v = input.value.trim().replace(/,$/, "");
            if (v && !items.includes(v)) { items.push(v); onChange(items.slice()); }
            input.value = "";
            draw();
          } else if (e.key === "Backspace" && !input.value && items.length) {
            items.pop(); onChange(items.slice()); draw();
          }
        });
        wrap.appendChild(input);
        draw();
        return wrap;
      }

