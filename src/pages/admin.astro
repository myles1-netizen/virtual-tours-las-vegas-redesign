      //=====================================================================
      // AUTH FLOW — server-side JWT issuance
      // The browser NEVER knows the password. It sends credentials to
      // /api/cms/auth, which returns a signed JWT. The JWT is the only thing
      // stored in the browser and it's cryptographically useless without the
      // server's JWT_SECRET.
      //=====================================================================
      async function attemptLogin(user, pass, remember) {
        showLoading();
        try {
          // 1. Authenticate against the server.
          const res = await fetch("/api/cms/auth", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username: user, password: pass }),
          });
          const data = await res.json().catch(() => ({ error: "No response from server." }));
          if (!res.ok) {
            throw new Error(data.error || "Invalid username or password.");
          }
          // 2. Store the JWT (NOT the password). In localStorage if "remember",
          //    otherwise sessionStorage (cleared when the tab closes).
          const store = remember ? localStorage : sessionStorage;
          store[LS.token] = data.token;
          localStorage[LS.remember] = remember ? "1" : "";
          hideLoading();
          enterApp();
          toast("Welcome back!", "success", "Signed in");
        } catch (e) {
          hideLoading();
          const box = $("#login-error");
          box.textContent = e.message;
          box.style.display = "block";
        }
      }

      function enterApp() {
        $("#login").style.display = "none";
        $("#app").classList.add("active");
        buildSidebar();
        navigate("dashboard");
      }

      function logout() {
        sessionStorage.removeItem(LS.token);
        localStorage.removeItem(LS.token);
        localStorage.removeItem(LS.remember);
        location.reload();
      }

      // Called when the proxy rejects a request (JWT expired/invalid).
      function forceReauth() {
        if ($("#app").classList.contains("active")) {
          sessionStorage.removeItem(LS.token);
          localStorage.removeItem(LS.token);
          toast("Your session expired. Please sign in again.", "error", "Session ended");
          setTimeout(() => location.reload(), 1500);
        }
      }

      // Validate that the stored JWT is still good (server-side check).
      async function verifySession() {
        const token = getToken();
        if (!token) return false;
        try {
          const res = await fetch("/api/cms/auth", {
            headers: { "Authorization": "Bearer " + token },
          });
          return res.ok;
        } catch { return false; }
      }

      //=====================================================================
      // BOOT
      //=====================================================================
      $("#login-form").addEventListener("submit", (e) => {
        e.preventDefault();
        const user = $("#li-user").value.trim();
        const pass = $("#li-pass").value;
        const remember = $("#li-remember").checked;
        if (!user || !pass) return;
        attemptLogin(user, pass, remember);
      });

      $("#menu-toggle").addEventListener("click", () => {
        const sb = $("#sidebar");
        const open = sb.classList.toggle("open");
        $("#sb-backdrop").classList.toggle("open", open);
      });
      $("#sb-backdrop").addEventListener("click", () => {
        $("#sidebar").classList.remove("open");
        $("#sb-backdrop").classList.remove("open");
      });

      // Topbar buttons (delegated)
      document.addEventListener("click", (e) => {
        if (e.target.closest("#view-site")) window.open("/", "_blank");
        if (e.target.closest("#logout-btn")) logout();
      });

      // Auto-login if a valid JWT is already in storage (resumes session).
      (async function () {
        if (isLoggedIn()) {
          const valid = await verifySession();
          if (valid) {
            enterApp();
          } else {
            // JWT expired or revoked — clear it so the login form shows.
            sessionStorage.removeItem(LS.token);
            localStorage.removeItem(LS.token);
          }
        }
      })();
    </script>
  </body>
</html>

