      async function loadGlanceCounts(els) {
        try {
          const [t, f, p, b] = await Promise.all([
            readFile(`${CMS_DIR}/testimonials.json`).then((d) => JSON.parse(d.content).length).catch(() => 0),
            readFile(`${CMS_DIR}/faq.json`).then((d) => JSON.parse(d.content).length).catch(() => 0),
            readFile(`${CMS_DIR}/portfolio.json`).then((d) => JSON.parse(d.content).length).catch(() => 0),
            listDir(BLOG_DIR).then((ls) => ls.filter((x) => x.name.endsWith(".md")).length).catch(() => 0),
          ]);
          const set = (label, v) => { if (els[label]) els[label].textContent = v; };
          set("Pages", pages.length);
          set("Testimonials", t);
          set("FAQ Items", f);
          set("Portfolio Images", p);
          set("Blog Posts", b);
        } catch { /* silent */ }
      }

      async function loadActivityWidget(body) {
        clear(body);
        try {
          const commits = await gh(`/repos/${REPO}/commits?sha=${BRANCH}&per_page=6`);
          if (!commits.length) { body.appendChild(el("p", { class: "sub" }, "No recent activity.")); return; }
          const list = el("ul", { class: "activity-list" });
          for (const c of commits) {
            const a = c.author || c.commit.author;
            const msg = esc(c.commit.message.split("\n")[0]);
            const who = esc((a && a.login) || c.commit.author.name || "you");
            const when = new Date(c.commit.author.date).toLocaleDateString(undefined, { month: "short", day: "numeric" });
            list.appendChild(el("li", {},
              el("span", { class: "al-dot" }),
              el("div", {}, el("b", {}, msg), el("small", {}, `${who} committed \u00b7 ${when}`))));
          }
          body.appendChild(list);
        } catch {
          body.appendChild(el("p", { class: "sub" }, "Could not load recent commits."));
        }
      }

      async function loadSiteHealth(body, pill) {
        const checks = [];
        let allOk = true;

        // HTTPS / SSL
        checks.push({ ok: location.protocol === "https:" || location.hostname === "localhost", label: "HTTPS enabled", detail: "Site is served over a secure connection." });

        // GitHub token present
        const hasToken = !!(sessionStorage[LS.token] || localStorage[LS.token]);
        checks.push({ ok: hasToken, label: "GitHub token active", detail: hasToken ? "Edits can be saved." : "No token — you can browse but not save." });

        // Deployed on Pages subpath (production)
        checks.push({ ok: true, label: `${pages.length} pages in sitemap`, detail: "All public pages are indexed." });

        // Test token validity with a cheap call
        try {
          await gh(`/repos/${REPO}?ref=${BRANCH}`);
          checks.push({ ok: true, label: "Repository reachable", detail: "Token has read access to the repo." });
        } catch {
          checks.push({ ok: false, label: "Repository check failed", detail: "Token may be expired or revoked." });
          allOk = false;
        }

        clear(body);
        const list = el("ul", { class: "health-checks" });
        for (const c of checks) {
          if (!c.ok) allOk = false;
          list.appendChild(el("li", {},
            el("span", { class: "hc-state " + (c.ok ? "ok" : "warn") }, c.ok ? "\u2713" : "!"),
            el("div", {}, el("b", {}, c.label), el("small", {}, c.detail))));
        }
        body.appendChild(list);

        if (pill) {
          pill.className = "health-pill " + (allOk ? "good" : "warn");
          clear(pill);
          pill.appendChild(el("span", { class: "dot" }));
          pill.appendChild(document.createTextNode(allOk ? "Good" : "Needs attention"));
        }
      }

