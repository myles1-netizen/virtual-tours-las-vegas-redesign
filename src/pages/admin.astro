      function setMeter(node, len, target) {
        const ratio = len / target;
        const color = len === 0 ? "var(--muted)" : ratio > 1.15 ? "var(--red)" : ratio > 0.95 ? "var(--amber)" : "var(--green)";
        const label = len === 0 ? "empty" : ratio > 1.15 ? "too long" : ratio > 0.95 ? "good length" : len < target * 0.5 ? "short" : "good";
        node.innerHTML = `<span>${len} / ${target}</span><span class="bar"><i style="width:${Math.min(100, ratio * 100)}%;background:${color}"></i></span><span style="color:${color}">${label}</span>`;
      }

