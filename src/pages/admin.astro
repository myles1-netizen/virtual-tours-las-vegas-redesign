              itemField("avatar", "Avatar image path", "/images/team/");
            container.appendChild(div);
            var item = div;
            item.querySelector("[data-move='-1']").addEventListener("click", function () { var p = item.previousElementSibling; if (p) container.insertBefore(item, p); });
            item.querySelector("[data-move='1']").addEventListener("click", function () { var n = item.nextElementSibling; if (n) container.insertBefore(n, item); });
            item.querySelector("[data-remove]").addEventListener("click", function () { if (confirm("Remove this testimonial?")) item.remove(); });
