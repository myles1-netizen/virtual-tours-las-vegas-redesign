        }
        function addonListRenderer(title, file, path, items) {
          var h = "<h3>" + esc(title) + "</h3>";
          h += '<div class="field"><textarea data-edit="' + esc(file + "::" + path) + '" data-list="true" rows="' + Math.max(3, items.length) + '">' + esc((items || []).join("\n")) + '</textarea><span class="hint">One add-on per line.</span></div>';
          return h;
        }
        function buildPricing() {
