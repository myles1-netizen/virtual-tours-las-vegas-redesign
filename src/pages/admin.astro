---
// ===== Full CMS admin panel (download-based workflow) =====
// Replaces the read-only dashboard. Mike can now actually EDIT every piece of
// site content through the browser, then download the updated JSON file(s) and
// email them to his son (or drag them into the GitHub web UI). The site
// rebuilds automatically via GitHub Actions. This is the static-site
// equivalent of WordPress's export — simpler, no backend, no OAuth.
//
// PASSWORD: defaults to "VTLV-admin-2026" when ADMIN_PASSWORD env var is not
// set, so the panel works out of the box. The default is shown on first login
// with a clear "change this" note. To set a real password, define
// ADMIN_PASSWORD in the GitHub Pages deploy environment (or .env for local).
//
// SECURITY: only the SHA-256 hash of the password is shipped to the browser,
// never the plaintext. Verification happens client-side via Web Crypto. This
// is a soft gate (the content is already public) — it stops casual edits, not
// a determined attacker. Sensitive operations happen via downloadable files.

import nodeCrypto from "node:crypto";
import {
  business, vegasPackages, hdrTiers, hdrAddOns, matterportTiers,
  floorPlanTiers, floorPlanAddOns, virtualStagingTiers, videoTiers,
  zillowTiers, commercialHdr, commercialPanoramas, googlePackage,
  testimonials, faqs, portfolio, serviceBuyers, clients,
} from "../data/site";
import { seoCatalog } from "../data/seo-catalog";
import { redirects } from "../data/redirects";
import { seoKeywords, allKeywords } from "../data/seo-keywords";
import { locations } from "../data/locations";

// Pull the raw JSON the CMS actually edits, so downloads match the file shape
// the maintainer drops back into src/data/cms/.
import settings from "../data/cms/settings.json";
import pricing from "../data/cms/pricing.json";
import testimonialsJson from "../data/cms/testimonials.json";
import faqJson from "../data/cms/faq.json";
import portfolioJson from "../data/cms/portfolio.json";
import services3dTours from "../data/cms/services/3d-tours.json";
import servicesAsBuilt from "../data/cms/services/as-built.json";
import servicesCommercial from "../data/cms/services/commercial.json";
import servicesDrone from "../data/cms/services/drone-photography.json";
import servicesFloorPlans from "../data/cms/services/floor-plans.json";
import servicesGoogleBusinessView from "../data/cms/services/google-business-view.json";
import servicesHdr from "../data/cms/services/hdr-photography.json";
import servicesPhotoPackages from "../data/cms/services/photo-packages.json";
import servicesResidential from "../data/cms/services/residential.json";
import servicesTwilight from "../data/cms/services/twilight-photography.json";
import servicesVacationRentals from "../data/cms/services/vacation-rentals.json";
import servicesVirtualStaging from "../data/cms/services/virtual-staging.json";

// ===== Password =====
// Default password if no env var set — Mike can change later via env.
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD ?? "VTLV-admin-2026";
const PASSWORD_HASH = nodeCrypto.createHash("sha256").update(ADMIN_PASSWORD).digest("hex");
// Whether we're running on the default password (so we can show the warning).
const USING_DEFAULT_PASSWORD = !import.meta.env.ADMIN_PASSWORD;

const CHANGES_EMAIL = import.meta.env.CHANGES_EMAIL ?? business.email;

// Map of service slug → editable JSON (title/description/eyebrow/headline/lead).
const servicesMap: Record<string, object> = {
  "3d-tours": services3dTours,
  "as-built": servicesAsBuilt,
  commercial: servicesCommercial,
  "drone-photography": servicesDrone,
  "floor-plans": servicesFloorPlans,
  "google-business-view": servicesGoogleBusinessView,
  "hdr-photography": servicesHdr,
  "photo-packages": servicesPhotoPackages,
  residential: servicesResidential,
  "twilight-photography": servicesTwilight,
  "vacation-rentals": servicesVacationRentals,
  "virtual-staging": servicesVirtualStaging,
};

// Blog posts (frontmatter + body) for the Blog Manager. Imported via the
// content collection so the list stays in sync with what's actually published.
let blogPosts: { slug: string; title: string; description: string; publishDate: string; author: string; category: string; draft: boolean; heroImage: string; heroAlt: string; body: string }[] = [];
try {
  const { getCollection } = await import("astro:content");
  const posts = await getCollection("blog");
  blogPosts = posts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    publishDate: p.data.publishDate.toISOString().slice(0, 10),
    author: p.data.author,
    category: p.data.category,
    draft: p.data.draft,
    heroImage: p.data.heroImage,
    heroAlt: p.data.heroAlt,
    body: p.body ?? "",
  }));
} catch (e) {
  // If the content layer isn't available at build time, the blog manager
  // still works for creating NEW posts.
}

// Default integrations config (a virtual, downloadable file). Mirrors the
// values currently hardcoded around the codebase so Mike sees what's live.
const integrationsDefault = {
  formsubmitEmail: "virtualtourslasvegas@gmail.com",
  ga4MeasurementId: (import.meta.env.GA4_MEASUREMENT_ID as string) ?? "",
  paypalLink: "",
  googleCalendarEmbedUrl: "",
  defaultMatterportId: "SxL3C8ha5hb",
  youtubeChannelUrl: settings.social?.youtube ?? "",
  youtubeEmbedCode: "",
  googleBusinessProfileUrl: "https://www.google.com/search?q=Virtual+Tours+Las+Vegas",
};

// The complete editable content snapshot. Each key maps to a downloadable file.
const files: Record<string, unknown> = {
  "settings.json": settings,
  "pricing.json": pricing,
  "testimonials.json": testimonialsJson,
  "faq.json": faqJson,
  "portfolio.json": portfolioJson,
  ...Object.fromEntries(
    Object.entries(servicesMap).map(([slug, data]) => [`services/${slug}.json`, data])
  ),
  "integrations.json": integrationsDefault,
};

// Read-only reference data the panels display (SEO catalog, redirects,
// keywords, locations, clients) — not all editable, but shown for context.
const reference = {
  seo: seoCatalog.map((p) => ({
    path: p.path,
    title: p.title,
    description: p.description,
    titleLen: p.title.length,
    descLen: p.description.length,
    schema: (p.schema ?? []).join(", ") || "—",
    noindex: !!p.noindex,
  })),
  redirects: redirects.map((r) => ({
    from: "/" + r.from.replace(/\/index$/, "") + "/",
    to: r.to,
  })),
  keywordGroups: seoKeywords.map((g) => ({ slug: g.slug, label: g.label, note: g.note, terms: g.terms })),
  locations: locations.map((l) => ({ slug: l.slug, name: l.name })),
  clients: clients.map((c) => c.name),
  serviceBuyers: serviceBuyers.map((s) => ({ slug: s.slug, label: s.label, audience: s.audience })),
};

const snapshotJson = JSON.stringify({
  files,
  blogPosts,
  reference,
  business: {
    name: business.name,
    shortName: business.shortName,
    owner: business.owner,
    email: business.email,
    phone: business.phone,
    changesEmail: CHANGES_EMAIL,
  },
});

// Pricing summary numbers shown at a glance (so Mike sees the live figures).
const pkgCount = vegasPackages.length;
const tierCount = [hdrTiers, matterportTiers, floorPlanTiers, virtualStagingTiers, videoTiers, zillowTiers, commercialHdr]
  .reduce((n, arr) => n + arr.length, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — {business.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #0f0e0c;
        --fg: #f7f4ef;
        --muted: rgba(247, 244, 239, 0.65);
        --muted-2: rgba(247, 244, 239, 0.45);
        --brass: #c9a572;
        --brass-soft: rgba(201, 165, 114, 0.18);
        --card: #1a1814;
        --card-2: #211e19;
        --line: rgba(247, 244, 239, 0.12);
        --line-2: rgba(247, 244, 239, 0.22);
        --ok: #4ecca3;
        --warn: #e8b94a;
        --danger: #e57373;
        --input-bg: #100f0d;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--fg); font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; line-height: 1.5; }
      a { color: var(--brass); }
      code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

      /* ===== Password gate ===== */
      .gate { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
      .gate-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 2rem; max-width: 400px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.4); }
      .gate-card h1 { font-size: 1.3rem; margin: 0 0 0.3rem; }
      .gate-card p { color: var(--muted); font-size: 0.9rem; margin: 0 0 1.4rem; }
      .gate-card label { display: block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; color: var(--muted); margin-bottom: 0.4rem; }
      .gate-card input { width: 100%; padding: 0.75rem 0.9rem; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; color: var(--fg); font-size: 1rem; font-family: inherit; }
      .gate-card input:focus { outline: none; border-color: var(--brass); box-shadow: 0 0 0 3px var(--brass-soft); }
      .gate-card button { width: 100%; margin-top: 1rem; padding: 0.8rem; background: var(--brass); color: #1a1814; border: none; border-radius: 8px; font-size: 0.95rem; font-weight: 700; cursor: pointer; font-family: inherit; }
      .gate-card button:hover { filter: brightness(1.08); }
      .gate-error { color: var(--danger); font-size: 0.85rem; margin-top: 0.8rem; min-height: 1em; }
      .default-pw-note { margin-top: 1.2rem; padding: 0.8rem 1rem; background: rgba(232, 185, 74, 0.12); border: 1px solid rgba(232, 185, 74, 0.4); border-radius: 8px; font-size: 0.82rem; color: var(--warn); line-height: 1.5; }
      .default-pw-note strong { color: var(--fg); }
      .default-pw-note code { color: var(--brass); }

      /* ===== Dashboard ===== */
      .dash[hidden] { display: none; }
      .dash-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
      .dash-head h1 { font-size: 1.6rem; margin: 0; }
      .dash-head .sub { color: var(--muted); font-size: 0.9rem; }
      .logout { background: none; border: 1px solid var(--line); color: var(--muted); padding: 0.4em 0.9em; border-radius: 7px; cursor: pointer; font-family: inherit; font-size: 0.82rem; }
      .logout:hover { color: var(--fg); border-color: var(--muted); }

      .intro { background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--brass); border-radius: 10px; padding: 1rem 1.2rem; margin: 1.4rem 0; color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
      .intro strong { color: var(--fg); }
      .intro ol { margin: 0.6rem 0 0; padding-left: 1.2rem; }
      .intro ol li { margin-bottom: 0.3rem; }

      .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; margin: 1.4rem 0; }
      .stat { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 0.9rem 1rem; }
      .stat .n { font-family: ui-monospace, monospace; font-size: 1.6rem; font-weight: 700; color: var(--brass); line-height: 1; }
      .stat .l { font-size: 0.76rem; color: var(--muted); margin-top: 0.35rem; }

      .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.2rem 0 2rem; border-bottom: 1px solid var(--line); padding-bottom: 0.6rem; }
      .tab { font-size: 0.82rem; padding: 0.4em 0.9em; border: 1px solid var(--line); border-radius: 999px; cursor: pointer; background: none; color: var(--muted); font-family: inherit; transition: all 0.15s; }
      .tab:hover { color: var(--fg); border-color: var(--muted); }
      .tab.active { background: var(--brass); color: #1a1814; border-color: var(--brass); font-weight: 600; }

      .panel { display: none; }
      .panel.active { display: block; }
      section[id], .panel { scroll-margin-top: 1rem; }

      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.3rem 1.4rem; margin-bottom: 1.2rem; }
      .card h2 { font-size: 1.1rem; margin: 0 0 0.9rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .card h2 .count { font-size: 0.72rem; font-weight: 600; color: var(--brass); background: var(--brass-soft); padding: 0.15em 0.6em; border-radius: 999px; }
      .card h3 { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--brass); margin: 1.4rem 0 0.6rem; }

      /* ===== Form controls ===== */
      .field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.9rem; }
      .field > label { font-size: 0.76rem; font-weight: 600; letter-spacing: 0.03em; color: var(--muted); }
      .field input, .field select, .field textarea {
        width: 100%; padding: 0.6rem 0.75rem; background: var(--input-bg); border: 1px solid var(--line);
        border-radius: 7px; color: var(--fg); font-size: 0.9rem; font-family: inherit; transition: border-color 0.15s, box-shadow 0.15s;
      }
      .field textarea { resize: vertical; min-height: 70px; line-height: 1.5; }
      .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--brass); box-shadow: 0 0 0 3px var(--brass-soft); }
      .field .hint { font-size: 0.74rem; color: var(--muted-2); line-height: 1.4; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
      .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 1rem; }
      @media (max-width: 640px) { .grid2, .grid3 { grid-template-columns: 1fr; } }

      .char-count { font-size: 0.72rem; color: var(--muted-2); align-self: flex-end; }
      .char-count.over { color: var(--danger); font-weight: 600; }

      /* ===== Buttons ===== */
      .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55em 1.1em; border-radius: 7px; font-family: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: 1px solid transparent; text-decoration: none; transition: filter 0.15s, background 0.15s, border-color 0.15s; }
      .btn-primary { background: var(--brass); color: #1a1814; }
      .btn-primary:hover { filter: brightness(1.08); }
      .btn-ghost { background: none; color: var(--muted); border-color: var(--line); }
      .btn-ghost:hover { color: var(--fg); border-color: var(--muted); }
      .btn-sm { padding: 0.3em 0.7em; font-size: 0.76rem; }
      .btn-danger { background: none; color: var(--danger); border-color: rgba(229,115,115,0.3); }
      .btn-danger:hover { background: rgba(229,115,115,0.12); }
      .btn-row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.4rem; }
      .save-status { font-size: 0.82rem; color: var(--ok); }

      /* ===== Array items ===== */
      .item { border: 1px solid var(--line); border-radius: 9px; padding: 1rem; margin-bottom: 0.8rem; background: var(--card-2); }
      .item-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.7rem; }
      .item-head .item-title { font-weight: 600; font-size: 0.9rem; color: var(--fg); }
      .item-tools { display: flex; gap: 0.3rem; flex-wrap: wrap; }
      .item-tools button { padding: 0.25em 0.55em; font-size: 0.72rem; background: var(--input-bg); color: var(--muted); border: 1px solid var(--line); border-radius: 5px; cursor: pointer; font-family: inherit; }
      .item-tools button:hover { color: var(--fg); border-color: var(--muted); }
      .item-tools button.danger:hover { color: var(--danger); border-color: rgba(229,115,115,0.4); }

      table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
      th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; }
      td.num, th.num { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
      .scroll-x { display: block; overflow-x: auto; }
      .muted { color: var(--muted); }
      .warn { color: var(--warn); }
      .tag { display: inline-block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted-2); border: 1px solid var(--line); border-radius: 999px; padding: 0.1em 0.5em; margin-left: 0.4rem; }

      /* SERP preview */
      .serp { background: #fff; color: #202124; border-radius: 8px; padding: 0.9rem 1rem; margin-top: 0.6rem; max-width: 600px; }
      .serp .url { font-size: 0.78rem; color: #5f6368; }
      .serp .title { font-size: 1.05rem; color: #1a0dab; margin: 0.1rem 0; cursor: pointer; }
      .serp .desc { font-size: 0.84rem; color: #4d5156; line-height: 1.4; }

      .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .chip { font-size: 0.76rem; padding: 0.25em 0.7em; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }

      .foot { margin-top: 2.5rem; color: var(--muted-2); font-size: 0.8rem; text-align: center; }

      /* Toast */
      .toast { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%); background: var(--ok); color: #0f0e0c; padding: 0.8em 1.4em; border-radius: 8px; font-weight: 600; font-size: 0.88rem; box-shadow: 0 8px 30px rgba(0,0,0,0.4); z-index: 1000; opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s; }
      .toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }
    </style>
  </head>
  <body>
    {/* ===== Password gate ===== */}
    <div class="gate" id="gate" hidden>
      <form class="gate-card" id="gate-form">
        <h1>{business.shortName} Admin</h1>
        <p>Enter the admin password to edit site content.</p>
        <label for="pwd">Password</label>
        <input id="pwd" type="password" autocomplete="current-password" autofocus required />
        <button type="submit">Unlock</button>
        <p class="gate-error" id="gate-error" role="alert"></p>
        {USING_DEFAULT_PASSWORD && (
          <div class="default-pw-note">
            <strong>Default password in use:</strong> <code>VTLV-admin-2026</code><br />
            This site is running on the default admin password. To change it, ask your son to set the
            <code>ADMIN_PASSWORD</code> environment variable in GitHub. Until then, anyone with this link
            can view the editor — the content is already public, but you'll want your own password.
          </div>
        )}
      </form>
    </div>

    {/* ===== Dashboard ===== */}
    <div class="dash" id="dash" hidden>
      <div class="wrap">
        <div class="dash-head">
          <div>
            <h1>{business.name} — Content Editor</h1>
            <p class="sub">Edit any section, then download the updated file and send it to your son to publish.</p>
          </div>
          <button class="logout" id="logout" type="button">Lock</button>
        </div>

        <div class="intro">
          <strong>How editing works (download-based):</strong> This is a static site, so changes save as files
          you send to your son — there's no live database.
          <ol>
            <li>Edit the section you want (prices, testimonials, FAQ, etc.).</li>
            <li>Click <strong>Download JSON</strong> — the updated file saves to your computer.</li>
            <li>Email the file to your son, or drag it into the GitHub website (he'll show you once).</li>
            <li>The site rebuilds automatically. Your change is live in a few minutes.</li>
          </ol>
          Every save creates an automatic backup on GitHub, so nothing is ever lost.
        </div>

        <div class="stats">
          <div class="stat"><div class="n">{pkgCount}</div><div class="l">Packages</div></div>
          <div class="stat"><div class="n">{tierCount}</div><div class="l">Price tiers</div></div>
          <div class="stat"><div class="n">{testimonials.length}</div><div class="l">Testimonials</div></div>
          <div class="stat"><div class="n">{portfolio.length}</div><div class="l">Portfolio images</div></div>
        </div>

        <div class="tabs" role="tablist" aria-label="Editor sections">
          <button class="tab active" data-tab="settings" role="tab">Site Settings</button>
          <button class="tab" data-tab="pricing" role="tab">Pricing</button>
          <button class="tab" data-tab="testimonials" role="tab">Testimonials</button>
          <button class="tab" data-tab="faq" role="tab">FAQ</button>
          <button class="tab" data-tab="portfolio" role="tab">Portfolio</button>
          <button class="tab" data-tab="services" role="tab">Services</button>
          <button class="tab" data-tab="blog" role="tab">Blog</button>
          <button class="tab" data-tab="seo" role="tab">SEO</button>
          <button class="tab" data-tab="redirects" role="tab">Redirects</button>
          <button class="tab" data-tab="integrations" role="tab">Integrations</button>
          <button class="tab" data-tab="backup" role="tab">Backup</button>
        </div>

        {/* ===== A. Site Settings ===== */}
        <div class="panel active" id="panel-settings" data-panel="settings">
          <div class="card">
            <h2>Site Settings <span class="count">settings.json</span></h2>
            <p class="muted" style="font-size:0.84rem;margin:-0.5rem 0 1rem">Business name, contact details, hours and social links. These appear in the header, footer and contact forms.</p>
            <div id="settings-form"></div>
            <div class="btn-row">
              <button class="btn btn-primary" data-download="settings.json">Download settings.json</button>
              <button class="btn btn-ghost btn-sm" data-reset="settings.json">Reset changes</button>
              <span class="save-status" data-status="settings.json"></span>
            </div>
          </div>
        </div>

        {/* ===== B. Pricing ===== */}
        <div class="panel" id="panel-pricing" data-panel="pricing">
          <div class="card">
            <h2>Pricing Editor <span class="count">pricing.json</span></h2>
            <p class="muted" style="font-size:0.84rem;margin:-0.5rem 0 1rem">Every price on the site. Edit package names, prices, tier brackets and add-ons. Empty price + a note becomes "Custom quote".</p>
            <div id="pricing-form"></div>
            <div class="btn-row">
              <button class="btn btn-primary" data-download="pricing.json">Download pricing.json</button>
              <button class="btn btn-ghost btn-sm" data-reset="pricing.json">Reset changes</button>
              <span class="save-status" data-status="pricing.json"></span>
            </div>
          </div>
        </div>

        {/* ===== C. Testimonials ===== */}
