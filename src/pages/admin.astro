      // Default layout for a page — a sensible section set if no saved layout exists.
      function defaultLayout(slug) {
        const home = slug === "/";
        const base = [
          pbBlock("hero", "Hero", home ? { headline: "The photographer Zillow & Lennar trusted with their listings." } : {}, true),
          pbBlock("text", "Intro", { heading: "Overview", body: "" }, true),
          pbBlock("gallery", "Portfolio Gallery", { heading: "Selected work" }, true),
          pbBlock("testimonials", "Testimonials", { heading: "What clients say" }, true),
          pbBlock("pricing", "Pricing", { heading: "Pricing" }, !home),
          pbBlock("faq", "FAQ", { heading: "Frequently asked" }, true),
          pbBlock("cta", "Call to Action", { headline: "Book your shoot today", buttonLabel: "Get started", buttonHref: "/contact/" }, true),
        ];
        return base;
      }

      function pbBlock(type, name, fields, enabled) {
        return { id: `${type}-${Math.random().toString(36).slice(2, 8)}`, type, name, fields: fields || {}, enabled: enabled !== false };
      }

      async function loadPageLayout(slug, canvas) {
        clear(canvas);
        const path = `${PB_DIR}/${pbSlugFile(slug)}.json`;
        let layout;
        try {
          const f = await readFile(path);
          layout = JSON.parse(f.content);
        } catch {
          layout = { slug, sections: defaultLayout(slug) };
        }
        if (!layout.sections || !layout.sections.length) layout.sections = defaultLayout(slug);
        pbCurrent = { slug, sections: layout.sections };
        pbDrawCanvas(layout.sections, slug, canvas);
      }

      function pbDrawCanvas(sections, slug, canvas) {
        // Keep the working copy in sync with whatever array we're rendering.
        pbCurrent = { slug, sections };
        clear(canvas);
        if (!sections.length) {
          canvas.appendChild(el("div", { class: "pb-empty" }, el("div", { class: "spinner", style: { margin: "0 auto 12px" } })));
          return;
        }
        // Inline visual editor mode: render contenteditable preview cards.
        if (pbMode === "inline") { pbDrawInline(sections, slug, canvas); return; }
        const wrap = el("div", { class: "pb-canvas" });
        sections.forEach((sec, i) => {
          const def = PB_LIBRARY.find((b) => b.type === sec.type) || { icon: "\u{1F536}", name: sec.type, desc: "", fields: [] };
          const block = el("div", { class: "pb-block" + (sec.enabled ? "" : " disabled"), draggable: "true", "data-id": sec.id });

          // Drag events
          block.addEventListener("dragstart", (e) => {
            block.classList.add("dragging");
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", sec.id);
          });
          block.addEventListener("dragend", () => block.classList.remove("dragging"));
          block.addEventListener("dragover", (e) => { e.preventDefault(); block.classList.add("drag-over"); });
          block.addEventListener("dragleave", () => block.classList.remove("drag-over"));
          block.addEventListener("drop", (e) => {
            e.preventDefault();
            block.classList.remove("drag-over");
            const draggedId = e.dataTransfer.getData("text/plain");
            const from = sections.findIndex((s) => s.id === draggedId);
            const to = sections.findIndex((s) => s.id === sec.id);
            if (from === -1 || to === -1 || from === to) return;
            const [moved] = sections.splice(from, 1);
            sections.splice(to, 0, moved);
            pbDrawCanvas(sections, slug, canvas);
          });

          const toggle = el("input", { type: "checkbox", title: "Show / hide section" });
          if (sec.enabled) toggle.setAttribute("checked", "checked");
          toggle.addEventListener("change", () => { sec.enabled = toggle.checked; block.classList.toggle("disabled", !sec.enabled); });

          const mainCol = el("div", { class: "pb-main" },
            el("div", { class: "pb-name" }, el("span", {}, def.icon + " " + sec.name || def.name),
              el("span", { class: "badge gray", style: { fontSize: "10px" } }, sec.type)),
            el("div", { class: "pb-desc" }, def.desc || ""));
          // Click the name to rename inline.
          mainCol.querySelector(".pb-name span:first-child").style.cursor = "text";
          mainCol.querySelector(".pb-name span:first-child").addEventListener("click", () => pbInlineRename(sec, mainCol));
          mainCol.appendChild(el("button", { class: "pb-edit-inline", onclick: () => pbEditFieldsModal(sec, () => pbDrawCanvas(sections, slug, canvas)) }, "Edit content"));

          const upBtn = el("button", { class: "btn btn-icon", title: "Move up", onclick: () => { pbMove(sections, i, -1); pbDrawCanvas(sections, slug, canvas); } }, "\u2191");
          const downBtn = el("button", { class: "btn btn-icon", title: "Move down", onclick: () => { pbMove(sections, i, 1); pbDrawCanvas(sections, slug, canvas); } }, "\u2193");

          block.appendChild(el("div", { class: "pb-handle", title: "Drag to reorder" }, "\u2261"));
          block.appendChild(mainCol);
          block.appendChild(el("div", { class: "pb-actions" },
            el("div", { class: "pb-toggle" }, toggle, el("label", { onclick: (e) => { e.preventDefault(); toggle.click(); }, style: { cursor: "pointer" } }, "On")),
            upBtn, downBtn,
            el("button", { class: "btn btn-icon", title: "Remove section", onclick: () => { if (confirm(`Remove the "${sec.name}" section?`)) { sections.splice(i, 1); pbDrawCanvas(sections, slug, canvas); } } }, "\u{1F5D1}")));
          wrap.appendChild(block);
        });
        canvas.appendChild(wrap);

        // Library hint
        canvas.appendChild(el("div", { class: "card", style: { marginTop: "20px", padding: "18px 20px" } },
          el("h3", { style: { margin: "0 0 4px", fontSize: "15px" } }, "Block library"),
          el("p", { class: "sub", style: { margin: "0 0 14px" } }, "Click a block to add it to the bottom of this page, then drag it into position."),
          (() => { const lib = el("div", { class: "pb-library" }); for (const b of PB_LIBRARY) {
            lib.appendChild(el("div", { class: "pb-block-tile", onclick: () => { sections.push(pbBlock(b.type, b.name, {}, true)); pbDrawCanvas(sections, slug, canvas); toast(`Added ${b.name} block. Drag it where you want it.`, "info", "Block added"); } },
              el("div", { class: "pb-bic" }, b.icon), el("b", {}, b.name), el("small", {}, b.desc)));
          } return lib; })(),
        ));
      }

      // ============================================================
      //  INLINE VISUAL EDITOR
      //  Renders each section as a "looks like the site" card whose text
      //  fields are contenteditable. Edits flow straight into the in-memory
      //  section model (sec.fields), so the Save button persists them.
      // ============================================================
      function pbDrawInline(sections, slug, canvas) {
        const stage = el("div", { class: "ie-stage" });
        // Helper: a contenteditable element bound to sec.fields[key].
        const editable = (sec, key, opts) => {
          opts = opts || {};
          const node = el(opts.tag || "div", { class: opts.cls || "ie-p", contenteditable: "true", "data-field": key, spellcheck: "false" });
          node.textContent = sec.fields[key] == null ? (opts.ph || "") : sec.fields[key];
          if (opts.ph && !node.textContent) node.setAttribute("data-empty", "1");
          node.addEventListener("focus", () => { if (node.getAttribute("data-empty") === "1") { node.textContent = ""; } });
          node.addEventListener("blur", () => {
            const v = node.textContent.trim();
            sec.fields[key] = v;
            if (!v && opts.ph) { node.textContent = opts.ph; node.setAttribute("data-empty", "1"); }
            else { node.removeAttribute("data-empty"); }
            node.scrollTop = 0;
          });
          if (opts.ph) { node.setAttribute("data-placeholder", opts.ph); }
          return node;
        };

        sections.forEach((sec, i) => {
          const def = PB_LIBRARY.find((b) => b.type === sec.type) || { icon: "\u{1F536}", name: sec.type, desc: "" };
          const block = el("div", { class: "ie-block" + (sec.enabled ? "" : " disabled"), draggable: "true", "data-id": sec.id });

          // Drag reorder (same as outline mode).
          block.addEventListener("dragstart", (e) => { block.classList.add("dragging"); e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", sec.id); });
          block.addEventListener("dragend", () => block.classList.remove("dragging"));
          block.addEventListener("dragover", (e) => { e.preventDefault(); block.classList.add("drag-over"); });
          block.addEventListener("dragleave", () => block.classList.remove("drag-over"));
          block.addEventListener("drop", (e) => {
            e.preventDefault(); block.classList.remove("drag-over");
            const draggedId = e.dataTransfer.getData("text/plain");
            const from = sections.findIndex((s) => s.id === draggedId);
            const to = sections.findIndex((s) => s.id === sec.id);
            if (from === -1 || to === -1 || from === to) return;
            const [moved] = sections.splice(from, 1); sections.splice(to, 0, moved);
            pbDrawInline(sections, slug, canvas);
          });

          // Block toolbar: drag handle, tag, settings, enable toggle, delete.
          const bar = el("div", { class: "ie-bar" },
            el("span", { class: "ie-handle", title: "Drag to reorder" }, "\u2261\u2261"),
            el("span", { class: "ie-tag" }, def.icon + " " + sec.name),
            el("span", { class: "ie-spacer" }),
            el("button", { class: "ie-btn", title: "Advanced settings", onclick: () => pbEditFieldsModal(sec, () => pbDrawInline(sections, slug, canvas)) }, "\u2699\uFE0F"),
            (() => { const cb = el("input", { type: "checkbox", title: "Show / hide", id: "ie-on-" + sec.id }); if (sec.enabled) cb.setAttribute("checked", "checked"); cb.addEventListener("change", () => { sec.enabled = cb.checked; block.classList.toggle("disabled", !sec.enabled); }); const lbl = el("label", { class: "ie-btn", title: "Show / hide", onclick: (e) => { e.preventDefault(); cb.click(); } }, "\u{1F441}\uFE0F"); return el("span", {}, cb, lbl); })(),
            el("button", { class: "ie-btn", title: "Move up", onclick: () => { pbMove(sections, i, -1); pbDrawInline(sections, slug, canvas); } }, "\u2191"),
            el("button", { class: "ie-btn", title: "Move down", onclick: () => { pbMove(sections, i, 1); pbDrawInline(sections, slug, canvas); } }, "\u2193"),
            el("button", { class: "ie-btn danger", title: "Delete block", onclick: () => { if (confirm(`Remove the "${sec.name}" block?`)) { sections.splice(i, 1); pbDrawInline(sections, slug, canvas); } } }, "\u{1F5D1}")
          );

          // Preview body — branch on block type so it resembles the live site.
          const preview = el("div", { class: "ie-preview" + (sec.type === "hero" || sec.type === "cta" ? " lg" : "") });
          preview.appendChild(pbBlockPreview(sec, editable));
          block.appendChild(bar);
          block.appendChild(preview);
          stage.appendChild(block);
        });

        canvas.appendChild(stage);

        // "+ Add block" affordance at the bottom.
        canvas.appendChild(el("div", { class: "card", style: { marginTop: "4px", padding: "18px 20px" } },
          el("h3", { style: { margin: "0 0 4px", fontSize: "15px" } }, "Add a block"),
          el("p", { class: "sub", style: { margin: "0 0 14px" } }, "Click a block to append it, then drag it where you want."),
          (() => { const lib = el("div", { class: "pb-library" }); for (const b of PB_LIBRARY) {
            lib.appendChild(el("div", { class: "pb-block-tile", onclick: () => { sections.push(pbBlock(b.type, b.name, pbDefaults(b.type), true)); pbDrawInline(sections, slug, canvas); toast(`Added ${b.name} block. Click any text to edit it.`, "info", "Block added"); } },
              el("div", { class: "pb-bic" }, b.icon), el("b", {}, b.name), el("small", {}, b.desc)));
          } return lib; })(),
        ));
      }

      // Sensible starter field values when a new block is added in inline mode.
      function pbDefaults(type) {
        switch (type) {
          case "heading": return { eyebrow: "", text: "New heading" };
          case "paragraph": return { text: "Click here to start writing your paragraph..." };
          case "image": return { src: "", alt: "", caption: "" };
          case "button": return { label: "Click here", href: "/contact/" };
          case "gallery-grid": return { images: "" };
          case "video-embed": return { url: "", heading: "" };
          case "spacer": return { height: "48" };
          case "divider": return {};
          case "cta": return { headline: "Book your shoot today", buttonLabel: "Get started", buttonHref: "/contact/" };
          default: return {};
        }
      }

      // Render the visual preview for one block, using `editable()` for text.
      function pbBlockPreview(sec, editable) {
        const f = sec.fields = sec.fields || {};
        const wrap = el("div", {});
        const imgUrl = (path) => { if (!path) return ""; const p = String(path).trim(); if (/^https?:\/\//i.test(p)) return p; return BASE.replace(/\/$/, "") + (p.startsWith("/") ? p : "/" + p); };
        switch (sec.type) {
          case "hero":
            wrap.appendChild(editable(sec, "headline", { tag: "div", cls: "ie-h1", ph: "Your headline..." }));
            if (f.subhead != null || true) wrap.appendChild(el("div", { style: { marginTop: "10px" } }, editable(sec, "subhead", { cls: "ie-p", ph: "Supporting subhead..." })));
            if (f.image != null) wrap.appendChild(el("div", { style: { marginTop: "12px" } }, editable(sec, "image", { cls: "ie-p", ph: "/images/hero.jpg (background image path)" })));
            break;
          case "heading":
            if (f.eyebrow != null || true) wrap.appendChild(editable(sec, "eyebrow", { tag: "div", cls: "ie-eyebrow", ph: "EYEBROW (optional)" }));
            wrap.appendChild(editable(sec, "text", { tag: "h2", cls: "ie-h2", ph: "Heading text..." }));
            break;
          case "paragraph":
          case "text":
            if (f.heading != null || sec.type === "text") wrap.appendChild(editable(sec, "heading", { tag: "h2", cls: "ie-h2", ph: "Heading..." }));
            wrap.appendChild(editable(sec, sec.type === "text" ? "body" : "text", { tag: "div", cls: "ie-p", ph: "Click to write..." }));
            break;
          case "image": {
            const imgBox = el("div", {});
            const drawImg = () => {
              imgBox.innerHTML = "";
              if (f.src) imgBox.appendChild(el("img", { class: "ie-img", src: imgUrl(f.src), alt: f.alt || "", onerror: "this.style.display='none'" }));
              else imgBox.appendChild(el("div", { class: "ie-img-ph" }, "No image \u2014 click \u2699\uFE0F to set the image path"));
            };
            drawImg();
            wrap.appendChild(imgBox);
            if (f.caption != null) wrap.appendChild(el("div", { style: { marginTop: "8px" } }, editable(sec, "caption", { cls: "ie-p", ph: "Caption (optional)" })));
            wrap.appendChild(el("div", { style: { marginTop: "8px" } }, editable(sec, "src", { cls: "ie-p", ph: "/images/...  (set the image path here)", })));
            // Redraw the image when the src field loses focus.
            const srcNode = wrap.querySelector('[data-field="src"]'); if (srcNode) srcNode.addEventListener("blur", drawImg);
            break;
          }
          case "button": {
            const row = el("div", { style: { display: "flex", gap: "12px", alignItems: "center", flexWrap: "wrap" } });
            row.appendChild(el("div", { class: "ie-btn-preview" }, editable(sec, "label", { tag: "span", ph: "Button" })));
            row.appendChild(editable(sec, "href", { cls: "ie-p", ph: "/contact/" }));
            wrap.appendChild(row);
            break;
          }
          case "gallery-grid": {
            const grid = el("div", { class: "ie-gallery" });
            const imgs = String(f.images || "").split("\n").map((s) => s.trim()).filter(Boolean);
            const draw = () => {
              grid.innerHTML = "";
              imgs.forEach((src) => grid.appendChild(el("div", { class: "ie-gitem" }, el("img", { src: imgUrl(src), alt: "", onerror: "this.parentNode.classList.add('ie-img-ph');this.remove()" }))));
              grid.appendChild(el("div", { class: "ie-gitem ie-gadd", title: "Add image \u2014 edit paths in settings", onclick: () => pbEditFieldsModal(sec, () => pbDrawInline(pbCurrent.sections, pbCurrent.slug, $("#pb-canvas"))) }, "+"));
            };
            draw();
            wrap.appendChild(grid);
            wrap.appendChild(el("div", { style: { marginTop: "10px" } }, el("small", { style: { color: "var(--muted)" } }, imgs.length + " image(s) \u2014 click \u2699\uFE0F to edit the list (one path per line).")));
            break;
          }
          case "video-embed":
          case "video": {
            const key = sec.type === "video" ? "url" : "url";
            if (f.heading != null || sec.type === "video-embed") wrap.appendChild(editable(sec, "heading", { tag: "h2", cls: "ie-h2", ph: "Heading..." }));
            const frame = el("div", {});
            const drawVid = () => {
              frame.innerHTML = "";
              const url = String(f[key] || "").trim();
              const embed = pbEmbedUrl(url);
              if (embed) frame.appendChild(el("div", { class: "ie-video-frame" }, el("iframe", { src: embed, allowfullscreen: "true", loading: "lazy" })));
              else frame.appendChild(el("div", { class: "ie-video-frame" }, el("div", { class: "ie-video-ph" }, "No video \u2014 paste a YouTube / Vimeo / Matterport URL below")));
            };
            drawVid();
            wrap.appendChild(frame);
            wrap.appendChild(el("div", { style: { marginTop: "10px" } }, editable(sec, key, { cls: "ie-p", ph: "https://youtube.com/watch?v=...  or  https://my.matterport.com/show/?m=..." })));
            const urlNode = wrap.querySelector('[data-field="' + key + '"]'); if (urlNode) urlNode.addEventListener("blur", drawVid);
            break;
          }
          case "cta":
            wrap.appendChild(editable(sec, "headline", { tag: "h2", cls: "ie-h2", ph: "Headline..." }));
            wrap.appendChild(el("div", { style: { marginTop: "14px" } }, el("span", { class: "ie-btn-preview" }, editable(sec, "buttonLabel", { tag: "span", ph: "Button" }))));
            if (f.buttonHref != null) wrap.appendChild(el("div", { style: { marginTop: "8px" } }, editable(sec, "buttonHref", { cls: "ie-p", ph: "/contact/" })));
            break;
          case "spacer": {
            const h = parseInt(f.height, 10) || 48;
            wrap.appendChild(el("div", { class: "ie-spacer", style: { height: h + "px" } }, "Spacer \u2014 " + h + "px"));
            wrap.appendChild(el("div", { style: { marginTop: "8px" } }, editable(sec, "height", { cls: "ie-p", ph: "48" })));
            break;
          }
          case "divider":
            wrap.appendChild(el("div", { class: "ie-divider" }));
            break;
          default:
            // Generic section (testimonials, pricing, faq, contact, map…):
            // show its heading editable + a note that content is auto-pulled.
            if (f.heading != null) wrap.appendChild(editable(sec, "heading", { tag: "h2", cls: "ie-h2", ph: "Section heading..." }));
            else wrap.appendChild(editable(sec, "heading", { tag: "h2", cls: "ie-h2", ph: "Section heading..." }));
            wrap.appendChild(el("p", { class: "ie-p", style: { marginTop: "8px" } }, "This section pulls its content from the site data. Edit the heading above, or use \u2699\uFE0F for more fields."));
        }
        return wrap;
      }

      // Convert a YouTube/Vimeo/Matterport watch URL into an embeddable src.
      function pbEmbedUrl(url) {
        if (!url) return "";
        url = String(url).trim();
        let m;
        if ((m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([\w-]{6,})/))) return "https://www.youtube.com/embed/" + m[1];
        if ((m = url.match(/vimeo\.com\/(\d+)/))) return "https://player.vimeo.com/video/" + m[1];
        if (/my\.matterport\.com\/show\?/.test(url)) return url;
        if (/^https?:\/\//i.test(url) && /embed|player|matterport/.test(url)) return url;
        return "";
      }

      function pbMove(arr, i, dir) {
        const j = i + dir;
        if (j < 0 || j >= arr.length) return;
        const tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
      }

      function pbInlineRename(sec, mainCol) {
        const nameSpan = mainCol.querySelector(".pb-name span:first-child");
        const input = el("input", { type: "text", value: sec.name, style: { fontSize: "14px", fontWeight: "700", padding: "2px 6px", border: "1px solid var(--brass)", borderRadius: "4px", minWidth: "160px" } });
        nameSpan.replaceWith(input);
        input.focus(); input.select();
        const commit = () => { sec.name = input.value.trim() || sec.name; const span = el("span", {}, (PB_LIBRARY.find((b) => b.type === sec.type) || {}).icon + " " + sec.name); span.style.cursor = "text"; span.addEventListener("click", () => pbInlineRename(sec, mainCol)); input.replaceWith(span); };
        input.addEventListener("blur", commit);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); commit(); } });
      }

      function pbEditFieldsModal(sec, onSave) {
        const def = PB_LIBRARY.find((b) => b.type === sec.type);
        const fields = (def && def.fields) || [];
        sec.fields = sec.fields || {};
        const body = el("div", {});
        if (!fields.length) {
          body.appendChild(el("p", { class: "sub" }, "This block has no editable fields. Its content is pulled automatically from the site data."));
        } else {
          for (const f of fields) {
            const cur = sec.fields[f.key] == null ? "" : sec.fields[f.key];
            if (f.type === "textarea") {
              const ta = el("textarea", {}); ta.value = cur;
              ta.addEventListener("input", () => { sec.fields[f.key] = ta.value; });
              body.appendChild(field(f.label, ta));
            } else if (f.type === "gallery") {
              const ta = el("textarea", {}); ta.value = Array.isArray(cur) ? cur.join("\n") : cur;
              ta.setAttribute("placeholder", "/images/portfolio/01.jpg\n/images/portfolio/02.jpg");
              ta.addEventListener("input", () => { sec.fields[f.key] = ta.value; });
              body.appendChild(field(f.label + " (one path per line)", ta, "Paste one image path per line. These populate the gallery grid."));
            } else {
              body.appendChild(field(f.label, textInput(cur, { oninput: (v) => { sec.fields[f.key] = v; } })));
            }
          }
        }
        openModal(`Edit "${sec.name}"`, body, [
          el("button", { class: "btn btn-ghost", onclick: closeModal }, "Cancel"),
          el("button", { class: "btn", onclick: () => { closeModal(); onSave(); toast("Section updated. Save the layout to publish.", "info", "Edited"); } }, "Done"),
        ]);
      }

      function pbAddBlockModal(slug, reload) {
        const body = el("div", { class: "pb-library" });
        for (const b of PB_LIBRARY) {
          body.appendChild(el("div", { class: "pb-block-tile", onclick: () => { closeModal(); reload(); } },
            el("div", { class: "pb-bic" }, b.icon), el("b", {}, b.name), el("small", {}, b.desc)));
        }
        openModal("Add a section", el("div", {}, el("p", { class: "sub", style: { marginBottom: "14px" } }, "Pick a block type. You can also add from the library at the bottom of the page."), body), [
          el("button", { class: "btn btn-ghost", onclick: closeModal }, "Close"),
        ]);
      }

      function pbSlugFile(slug) {
        return (slug === "/" ? "home" : slug.replace(/^\/|\/$/g, "").replace(/\//g, "-")) || "home";
      }

      async function pbSave(slug, canvas) {
        // pbCurrent.sections holds the live, mutated working copy (reorders,
        // enabled toggles, renames and field edits all mutate it in place).
        const path = `${PB_DIR}/${pbSlugFile(slug)}.json`;
        showLoading("Saving layout\u2026");
        try {
          // Sync the enabled checkboxes from the DOM into the working copy —
          // toggles mutate the object directly, but this guarantees the final
          // state matches what's on screen.
          $$(".pb-block[data-id]", canvas).forEach((n) => {
            const id = n.getAttribute("data-id");
            const sec = pbCurrent.sections.find((s) => s.id === id);
            if (!sec) return;
            const cb = n.querySelector(".pb-actions input[type=checkbox]");
            if (cb) sec.enabled = cb.checked;
          });
          const layout = { slug, sections: pbCurrent.sections };
          await writeFile(path, JSON.stringify(layout, null, 2) + "\n", `Update page layout for ${slug}`);
          hideLoading();
          toast("Page layout saved! Site rebuilds in ~90 seconds.", "success", "Saved");
        } catch (e) { hideLoading(); toast(e.message, "error", "Save failed"); }
      }

      async function pbResetPrompt() {
        if (!confirm("Reset this page's layout to the default? Any custom section order will be lost.")) return;
        showLoading("Resetting\u2026");
        try {
          const slug = $("select[aria-label='Select a page']").value;
          const path = `${PB_DIR}/${pbSlugFile(slug)}.json`;
          try {
            const f = await readFile(path);
            await deleteFile(path, f.sha, `Reset page layout for ${slug}`);
            delete cache[path];
          } catch { /* nothing to delete */ }
          hideLoading();
          toast("Layout reset. Reloaded defaults.", "success", "Reset");
          navigate("pagebuilder");
        } catch (e) { hideLoading(); toast(e.message, "error", "Reset failed"); }
      }

      // ============================================================
      //  SECTION: Redirects (view + edit legacy URL map)
      //  The 404 page and generated redirect pages read these. Editing
      //  here writes src/data/cms/redirects.json.
      // ============================================================
      async function renderRedirects() {
        const main = $("#main");
        clear(main);
        main.appendChild(el("div", { class: "page-head" },
          el("div", {}, el("h1", {}, "Redirects"), el("p", {}, "Map old URLs to new ones. Visitors to an old URL are forwarded automatically.")),
        ));
        const card = el("div", { class: "card" }, el("div", { class: "empty" }, el("div", { class: "spinner", style: { margin: "0 auto" } })));
        main.appendChild(card);

        let data;
        try {
          const f = await readFile(`${CMS_DIR}/redirects.json`);
          data = JSON.parse(f.content);
        } catch { data = { redirects: [] }; }
        if (!Array.isArray(data.redirects)) data.redirects = [];
        clear(card);

        card.appendChild(el("h2", {}, "Redirect Rules"));
        card.appendChild(el("p", { class: "sub" }, `${data.redirects.length} rule(s). Saved to redirects.json.`));

        const redraw = () => {
          const existing = card.querySelector("#rd-list");
          if (existing) existing.remove();
          const list = el("div", { id: "rd-list", style: { display: "flex", flexDirection: "column", gap: "10px", marginTop: "8px" } });
          if (!data.redirects.length) {
            list.appendChild(el("div", { class: "empty", style: { padding: "24px" } }, "No redirects yet."));
          }
          data.redirects.forEach((r, i) => {
            const fromInp = el("input", { type: "text", value: r.from || "", placeholder: "/old-page.html" });
            fromInp.addEventListener("input", () => { r.from = fromInp.value; });
            const toInp = el("input", { type: "text", value: r.to || "", placeholder: "/new-page/" });
            toInp.addEventListener("input", () => { r.to = toInp.value; });
            list.appendChild(el("div", { class: "rep-row" },
              el("span", { style: { fontSize: "12px", color: "var(--muted)", alignSelf: "center", whiteSpace: "nowrap" } }, "from"),
              fromInp,
              el("span", { style: { fontSize: "12px", color: "var(--muted)", alignSelf: "center" } }, "\u2192"),
              toInp,
              el("span", { style: { fontSize: "12px", color: "var(--muted)", alignSelf: "center", whiteSpace: "nowrap" } }, r.code === 301 ? "301" : "302"),
              el("button", { class: "btn btn-icon", title: "Remove", onclick: () => { data.redirects.splice(i, 1); redraw(); } }, "\u2212")));
          });
          card.appendChild(list);
        };
        redraw();

        card.appendChild(el("button", { class: "btn btn-ghost btn-sm rep-add", style: { marginTop: "12px" }, onclick: () => { data.redirects.push({ from: "", to: "/", code: 301 }); redraw(); } }, "+ Add redirect"));
        card.appendChild(el("hr"));
        card.appendChild(el("div", { style: { display: "flex", justifyContent: "flex-end" } },
          el("button", { class: "btn btn-lg", onclick: async () => {
            showLoading("Saving redirects\u2026");
            try {
              await writeFile(`${CMS_DIR}/redirects.json`, JSON.stringify(data, null, 2) + "\n", "Update redirects");
              hideLoading(); toast("Redirects saved! Site rebuilds in ~90 seconds.", "success", "Saved");
            } catch (e) { hideLoading(); toast(e.message, "error", "Save failed"); }
          } }, "Save Redirects")));
      }

      // ============================================================
      //  SECTION: Comments (static-site note + Akismet-style counter)
      // ============================================================
      function renderComments() {
        const main = $("#main");
        clear(main);
        main.appendChild(el("div", { class: "page-head" },
          el("div", {}, el("h1", {}, "Comments"), el("p", {}, "Comments and discussion. On a static site these come through your contact form.")),
        ));

        const grid = el("div", { class: "grid grid-3" });
        grid.appendChild(statBox("\u{1F4AC}", "0", "Comments in moderation"));
        grid.appendChild(statBox("\u{1F6A9}", "0", "Spam queue"));
        grid.appendChild(statBox("\u{1F6E1}\uFE0F", "295", "Spam blocked (all-time)"));
        main.appendChild(grid);

        main.appendChild(sectionCard("Comment Moderation", "No comments are waiting for review.", [
          el("div", { class: "empty" },
            el("div", { class: "ic" }, "\u2705"),
            el("div", { style: { fontWeight: "700", marginBottom: "4px" } }, "No comments yet"),
            "Comments appear here when visitors submit the contact form."),
        ]));

