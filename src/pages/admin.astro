        // Generic array renderer — returns HTML for an array container.
        function renderArray(arr, itemRenderer, opts) {
          opts = opts || {};
          arr = Array.isArray(arr) ? arr : [];
          var h = '<div class="array-container" data-array-nested>';
          arr.forEach(function (item, i) {
            h += '<div class="item" data-array-item>' + itemRenderer(item, i) + "</div>";
          });
          h += "</div>";
          if (opts.addLabel) h += '<div class="btn-row"><button type="button" class="btn btn-ghost btn-sm" data-add-array>' + esc(opts.addLabel) + "</button></div>";
          return h;
        }
        function itemField(key, label, value) {
          return '<div class="field"><label>' + esc(label) + '</label><input data-item-field="' + esc(key) + '" type="text" value="' + esc(value == null ? "" : value) + '" /></div>';
        }

        // Bind ↑/↓/✕ and "+ add" buttons within a container.
        function bindArrayControls(root) {
          root.querySelectorAll(".array-container").forEach(function (container) {
            // add button (sibling after container)
            var addBtn = container.nextElementSibling ? container.nextElementSibling.querySelector("[data-add-array]") : null;
            if (addBtn && !addBtn.dataset.bound) {
              addBtn.dataset.bound = "1";
              addBtn.addEventListener("click", function () {
                var firstItem = container.querySelector("[data-array-item]");
                if (!firstItem) return;
                var template = firstItem.cloneNode(true);
                template.querySelectorAll("[data-item-field]").forEach(function (f) {
                  if (f.dataset.list === "true") f.value = "";
                  else if (f.type === "checkbox") f.checked = false;
                  else if (f.tagName === "SELECT") { /* leave default */ }
                  else f.value = "";
                });
                container.appendChild(template);
                template.scrollIntoView({ behavior: "smooth", block: "center" });
                var firstInput = template.querySelector("[data-item-field]");
                if (firstInput) firstInput.focus();
              });
            }
            container.querySelectorAll("[data-array-item]").forEach(function (item) {
              var up = item.querySelector("[data-move='-1']");
              var down = item.querySelector("[data-move='1']");
              var rm = item.querySelector("[data-remove]");
              if (up && !up.dataset.bound) { up.dataset.bound = "1"; up.addEventListener("click", function () { var prev = item.previousElementSibling; if (prev) container.insertBefore(item, prev); }); }
              if (down && !down.dataset.bound) { down.dataset.bound = "1"; down.addEventListener("click", function () { var next = item.nextElementSibling; if (next) container.insertBefore(next, item); }); }
              if (rm && !rm.dataset.bound) { rm.dataset.bound = "1"; rm.addEventListener("click", function () { if (confirm("Remove this item?")) item.remove(); }); }
            });
          });
        }

