---
// =============================================================================
//  Virtual Tours Las Vegas — Content Manager (WordPress-style CMS)
// =============================================================================
//  A full client-side CMS that reads from and writes to this repo directly
//  through the GitHub REST Contents API. Mike logs in with a fine-grained
//  GitHub PAT (Contents: Read+Write) plus the site password; his edits are
//  committed to `main`, which triggers a GitHub Actions rebuild — so every
//  save goes live automatically (~90 seconds).
//
//  Why client-side? The site is static on GitHub Pages, so there is no server
//  runtime. The browser talks to api.github.com using a token Mike pastes in.
//  The token is kept in localStorage only. Sensitive content is already public
//  (it's the marketing site), so this is a convenience layer, not a security
//  boundary — the token is the real credential and must be a fine-grained PAT
//  scoped to this repo only.
//
//  All editable content lives in src/data/cms/*.json (settings, pricing,
//  testimonials, faq, portfolio) plus individual Markdown files under
//  src/content/blog/. The CMS edits those exact files.
// =============================================================================

import { seoCatalog } from "../data/seo-catalog";

// Default site password (overridable with ADMIN_PASSWORD at build time).
// Only a SHA-256 hash is ever shipped to the browser.
const SITE_PASSWORD = process.env.ADMIN_PASSWORD || "VTLV-admin-2026";
async function sha256(s) {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s));
  return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
}
const passwordHash = await sha256(SITE_PASSWORD);

// Page list for the Pages + SEO sections. Comes from the hand-maintained
// SEO catalog so the admin matches what Google actually sees.
const pages = seoCatalog
  .filter((p) => p.path !== "/404")
  .map((p) => ({ path: p.path, title: p.title, description: p.description, noindex: !!p.noindex }));

// Repo coordinates. These match the GitHub Pages deployment.
const REPO = "MylesThePro1/virtual-tours-las-vegas-redesign";
const BRANCH = "main";

// Asset base path (GitHub Pages project site). Mirrors astro.config.mjs.
const isDev = import.meta.env.DEV;
const BASE = isDev ? "/" : "/virtual-tours-las-vegas-redesign/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Content Manager — Virtual Tours Las Vegas</title>
    <link rel="icon" href={BASE + "favicon.svg"} type="image/svg+xml" />
    <script is:inline>
      // Apply the saved CMS theme BEFORE first paint to prevent a flash of the
      // wrong theme. Dark is the default; light mode opts in via .cms-light.
      (function () {
        try {
          var t = localStorage.getItem("vtlv_cms_theme");
          if (t === "light") document.documentElement.classList.add("cms-light");
        } catch (e) { /* private mode etc. — keep dark default */ }
      })();
    </script>
    <style is:global>
      /* ============================================================
         THEME TOKENS — DARK is the default (black bg, white text).
         A .cms-light class on <html> flips the whole admin to light.
         Toggle lives in Appearance and is applied before first paint
         by the inline head script below to avoid FOUC.
         ============================================================ */
      :root {
        /* Dark (default) */
        --bg: #0a0a0a;
        --panel: #1a1a1a;
        --panel-2: #161616;     /* alt row / input background */
        --ink: #f0f0f0;
        --ink-soft: #c4c4c4;
        --muted: #8a8a8a;
        --line: #2a2a2a;
        --line-strong: #3a3a3a;
        --hover: #2a2a2a;        /* card / list hover */
        --input-bg: #222222;
        --sidebar: #121212;
        --sidebar-soft: #1f1f1f;
        --sidebar-line: #2a2a2a;
        --sidebar-ink: #f0f0f0;
        --sidebar-muted: #9a9a9a;
        --brass: #b08d57;
        --brass-dark: #c9a572;   /* brass-light reads on dark bg */
        --brass-soft: rgba(176, 141, 87, 0.18);
        --green: #4caf64;
        --green-soft: rgba(76, 175, 100, 0.16);
        --red: #e0584a;
        --red-soft: rgba(224, 88, 74, 0.16);
        --amber: #e0a93b;
        --amber-soft: rgba(224, 169, 59, 0.16);
        --blue: #5b9fe0;
        --radius: 10px;
        --radius-sm: 6px;
        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
        --shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
        --shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.65);
        --topbar-h: 60px;
        color-scheme: dark;
      }
      /* Light override — opt in via <html class="cms-light"> */
      .cms-light {
        --bg: #f7f4ef;
        --panel: #ffffff;
        --panel-2: #ffffff;
        --ink: #1a1814;
        --ink-soft: #524a40;
        --muted: #8a8074;
        --line: #e0e0e0;
        --line-strong: #c9c0b1;
        --hover: #faf8f3;
        --input-bg: #ffffff;
        --sidebar: #1a1814;
        --sidebar-soft: #2a2620;
        --sidebar-line: #3a342c;
        --sidebar-ink: #f0ece4;
        --sidebar-muted: #9a9080;
        --brass: #b08d57;
        --brass-dark: #8f7042;
        --brass-soft: #f1e7d6;
        --green: #3f8a52;
        --green-soft: #e3f2e6;
        --red: #c0392b;
        --red-soft: #fbe5e2;
        --amber: #c98a14;
        --amber-soft: #fbeed1;
        --blue: #2c6fb3;
        --shadow-sm: 0 1px 2px rgba(26, 24, 20, 0.06);
        --shadow: 0 6px 20px rgba(26, 24, 20, 0.12);
        --shadow-lg: 0 24px 60px rgba(26, 24, 20, 0.28);
        color-scheme: light;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-size: 15px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      button { font-family: inherit; cursor: pointer; }
      input, textarea, select { font-family: inherit; }
      a { color: var(--brass-dark); }
      h1, h2, h3, h4 { color: #ffffff; }
      .cms-light h1, .cms-light h2, .cms-light h3, .cms-light h4 { color: var(--ink); }

      /* ============================================================
         LOGIN SCREEN
         ============================================================ */
      #login {
        position: fixed; inset: 0;
        display: flex; align-items: center; justify-content: center;
        background:
          radial-gradient(1200px 600px at 50% -10%, #2a2620 0%, transparent 60%),
          linear-gradient(180deg, #1a1814 0%, #100e0b 100%);
        padding: 24px;
      }
      .login-card {
        width: 100%; max-width: 440px;
        background: var(--panel);
        border-radius: 16px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
      }
      .login-head {
        padding: 32px 32px 8px;
        text-align: center;
        border-bottom: 1px solid var(--line);
      }
      .login-logo {
        height: 56px; width: auto; max-width: 220px; margin: 0 auto 16px;
        object-fit: contain;
      }
      .login-head h1 { margin: 0 0 4px; font-size: 22px; font-weight: 800; letter-spacing: -0.01em; }
      .login-head p { margin: 0; color: var(--muted); font-size: 14px; }
      .login-body { padding: 24px 32px 32px; }
      .field { margin-bottom: 16px; }
      .field label {
        display: block; font-weight: 700; font-size: 13px;
        margin-bottom: 6px; color: var(--ink);
      }
      .field .hint { font-weight: 400; color: var(--muted); font-size: 12px; margin-top: 6px; }
      .field input[type="text"], .field input[type="password"], .field input[type="url"],
      .field input[type="email"], .field input[type="tel"], .field input[type="number"],
      .field select, .field textarea {
        width: 100%;
        min-height: 52px; /* 52px — comfortably tappable, well above the 48px minimum */
        padding: 12px 14px;
        font-size: 16px; /* 16px prevents iOS zoom */
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-sm);
        background: var(--input-bg);
        color: var(--ink);
        transition: border-color .15s, box-shadow .15s;
      }
      .field input:focus, .field select:focus, .field textarea:focus {
        outline: none;
        border-color: var(--brass);
        box-shadow: 0 0 0 3px var(--brass-soft);
      }
      .field textarea { min-height: 110px; resize: vertical; line-height: 1.55; }
      /* Read-only/disabled inputs share the same dimmed surface in both themes */
      input[readonly], input[disabled], select[disabled] { background: var(--panel-2) !important; color: var(--muted) !important; }
      /* Site-wide text-control floor: every text input/select gets at least 16px
         font and 52px height; every textarea gets at least 120px / 4 rows. This
         catches inputs built outside .field (table cells, repeaters, modals). */
      input[type="text"], input[type="password"], input[type="url"],
      input[type="email"], input[type="tel"], input[type="number"],
      input[type="date"], input[type="search"], select {
        min-height: 52px; font-size: 16px;
      }
      textarea { min-height: 120px; font-size: 16px; line-height: 1.5; resize: vertical; }
      .row-check {
        display: flex; align-items: center; gap: 10px;
        margin: 16px 0; font-size: 14px; color: var(--ink-soft);
      }
      .row-check input { width: 18px; height: 18px; accent-color: var(--brass); }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 44px; padding: 0 18px;
        font-size: 14px; font-weight: 700;
        border: 1px solid transparent; border-radius: var(--radius-sm);
        background: var(--brass); color: #fff;
        transition: background .15s, transform .05s, box-shadow .15s;
      }
      .btn:hover { background: var(--brass-dark); }
      .btn:active { transform: translateY(1px); }
      .btn:disabled { opacity: .5; cursor: not-allowed; }
      .btn-block { width: 100%; }
      .btn-lg { min-height: 50px; font-size: 15px; }
      .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line-strong); }
      .btn-ghost:hover { background: var(--hover); }
      .btn-danger { background: var(--red); }
      .btn-danger:hover { background: #a52f23; }
      .btn-sm { min-height: 34px; padding: 0 12px; font-size: 13px; }
      .btn-icon {
        min-height: 36px; min-width: 36px; padding: 0 8px;
        background: var(--panel); color: var(--ink-soft); border: 1px solid var(--line-strong);
      }
      .btn-icon:hover { background: var(--hover); color: var(--ink); }
      .login-error {
        background: var(--red-soft); color: var(--red);
        border: 1px solid #f0c8c2; border-radius: var(--radius-sm);
        padding: 10px 12px; font-size: 13px; margin-bottom: 16px;
        display: none;
      }
      .login-help {
        margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line);
        font-size: 12.5px; color: var(--muted); line-height: 1.6;
      }
      .login-help summary { cursor: pointer; font-weight: 700; color: var(--ink-soft); }
      .login-help code {
        background: var(--brass-soft); padding: 1px 6px; border-radius: 4px;
        font-size: 12px; color: var(--brass-dark);
      }

      /* ============================================================
         APP SHELL
         ============================================================ */
      #app { display: none; min-height: 100vh; }

      .topbar {
        position: sticky; top: 0; z-index: 40;
        height: var(--topbar-h);
        background: var(--sidebar);
        color: var(--sidebar-ink);
        display: flex; align-items: center; gap: 16px;
        padding: 0 20px;
        border-bottom: 1px solid var(--sidebar-line);
      }
      .topbar .menu-toggle {
        display: none;
        background: transparent; border: 0; color: var(--sidebar-ink);
        font-size: 22px; padding: 6px; line-height: 1;
      }
      .topbar .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: -0.01em; }
      .topbar .brand .brand-logo { height: 38px; width: auto; display: block; }
      .topbar .brand .brand-text small { display: block; font-weight: 500; font-size: 11px; color: var(--sidebar-muted); letter-spacing: 0; margin-top: 2px; }
      .topbar .spacer { flex: 0 0 16px; }
      .topbar .save-state { font-size: 12.5px; color: var(--sidebar-muted); display: flex; align-items: center; gap: 6px; }
      .topbar .save-state.dirty { color: var(--brass); }

      .shell { display: flex; align-items: flex-start; }

      .sidebar {
        position: sticky; top: var(--topbar-h);
        width: 248px; flex: 0 0 248px;
        height: calc(100vh - var(--topbar-h));
        background: var(--sidebar);
        color: var(--sidebar-ink);
        overflow-y: auto;
        padding: 16px 12px;
        border-right: 1px solid var(--sidebar-line);
      }
      .nav-section { margin-bottom: 18px; }
      .nav-section h3 {
        font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--sidebar-muted); margin: 8px 12px; font-weight: 700;
      }
      .nav-item {
        display: flex; align-items: center; gap: 12px;
        width: 100%; text-align: left;
        padding: 10px 12px; margin-bottom: 2px;
        background: transparent; border: 0; color: var(--sidebar-ink);
        font-size: 14px; font-weight: 600; border-radius: 8px;
        transition: background .12s, color .12s;
      }
      .nav-item:hover { background: var(--sidebar-soft); }
      .nav-item.active { background: var(--brass); color: #fff; }
      .nav-item .ic { width: 20px; text-align: center; font-size: 16px; }
      .nav-item.danger { color: #e0a39a; }
      .nav-item.danger:hover { background: rgba(192, 57, 43, 0.18); color: #fff; }

      .main { flex: 1; min-width: 0; padding: 28px 32px 80px; max-width: 1100px; }
      .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
      .page-head h1 { margin: 0 0 4px; font-size: 26px; font-weight: 800; letter-spacing: -0.01em; }
      .page-head p { margin: 0; color: var(--muted); font-size: 14px; }
      .page-head .actions { display: flex; gap: 10px; flex-wrap: wrap; }

      .card {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: var(--radius); box-shadow: var(--shadow-sm);
        padding: 24px; margin-bottom: 24px;
      }
      .card h2 { margin: 0 0 4px; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; }
      .card .sub { margin: 0 0 20px; color: var(--muted); font-size: 13px; }
      .card hr { border: 0; border-top: 1px solid var(--line); margin: 24px -24px; }

      .grid { display: grid; gap: 16px; }
      .grid-2 { grid-template-columns: repeat(2, 1fr); }
      .grid-3 { grid-template-columns: repeat(3, 1fr); }
      .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .form-grid .full { grid-column: 1 / -1; }

      .stat {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: var(--radius); padding: 20px;
        box-shadow: var(--shadow-sm);
      }
      .stat .n { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
      .stat .l { font-size: 13px; color: var(--muted); margin-top: 2px; font-weight: 600; }
      .stat .ic { font-size: 22px; margin-bottom: 8px; }

      .badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 9px; border-radius: 999px; font-size: 11.5px; font-weight: 700;
        background: var(--brass-soft); color: var(--brass-dark);
      }
      .badge.green { background: var(--green-soft); color: var(--green); }
      .badge.red { background: var(--red-soft); color: var(--red); }
      .badge.gray { background: var(--panel-2); color: var(--ink-soft); border: 1px solid var(--line); }

      /* Tags / chip input */
      .tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 9px 10px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); min-height: 52px; background: var(--input-bg); align-items: center; }
      .tags:focus-within { border-color: var(--brass); box-shadow: 0 0 0 3px var(--brass-soft); }
      .tag { display: inline-flex; align-items: center; gap: 6px; background: var(--brass-soft); color: var(--brass-dark); padding: 5px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
      .tag button { background: transparent; border: 0; color: var(--brass-dark); font-size: 15px; line-height: 1; padding: 0; }
      .tags input { flex: 1; min-width: 120px; border: 0; outline: none; font-size: 16px; padding: 4px; background: transparent; color: var(--ink); }

      /* Repeating rows (features, tiers, add-ons) */
      .repeater { display: flex; flex-direction: column; gap: 10px; }
      .rep-row { display: flex; gap: 10px; align-items: center; }
      .rep-row input, .rep-row select { flex: 1; min-height: 52px; padding: 10px 12px; font-size: 16px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--input-bg); color: var(--ink); }
      .rep-row input:focus { outline: none; border-color: var(--brass); box-shadow: 0 0 0 3px var(--brass-soft); }
      .rep-add { align-self: flex-start; }

      /* Tables */
      .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
      .tbl th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); padding: 12px; border-bottom: 1px solid var(--line); background: var(--panel); }
      .tbl td { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
      .tbl tbody tr:nth-child(odd) { background: var(--panel-2); }
      .tbl tr:last-child td { border-bottom: 0; }
      .tbl input, .tbl select { min-height: 42px; padding: 8px 10px; font-size: 15px; border: 1px solid var(--line-strong); border-radius: 5px; width: 100%; background: var(--input-bg); color: var(--ink); }
      .tbl input:focus { outline: none; border-color: var(--brass); box-shadow: 0 0 0 2px var(--brass-soft); }
      /* Editable table rows stay readable. */
      .tbl input[type="number"] { font-weight: 700; }

      /* Testimonial / FAQ / portfolio cards */
      .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
      .tile { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; display: flex; flex-direction: column; }
      .tile .body { padding: 18px; flex: 1; }
      .tile .body p { margin: 0 0 12px; font-size: 13.5px; color: var(--ink-soft); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
      .tile .meta { display: flex; align-items: center; gap: 10px; }
      .tile .meta img, .tile .meta .av { width: 36px; height: 36px; border-radius: 50%; background: var(--brass-soft); object-fit: cover; display: flex; align-items: center; justify-content: center; color: var(--brass-dark); font-weight: 700; }
      .tile .meta b { font-size: 14px; }
      .tile .meta small { display: block; color: var(--muted); font-size: 12px; }
      .tile .foot { display: flex; gap: 8px; padding: 12px 18px; border-top: 1px solid var(--line); background: var(--panel-2); }
      .stars { color: var(--brass); font-size: 14px; letter-spacing: 1px; }

      .faq-item { border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 12px; background: var(--panel); overflow: hidden; }
      .faq-item .qh { display: flex; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; }
      .faq-item .qh b { flex: 1; font-size: 14.5px; }
      .faq-item .qh .chev { color: var(--muted); transition: transform .15s; }
      .faq-item.open .qh .chev { transform: rotate(90deg); }
      .faq-item .qbody { padding: 0 16px 16px 44px; display: none; color: var(--ink-soft); font-size: 13.5px; }
      .faq-item.open .qbody { display: block; }

      /* Portfolio grid */
      .pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
      .ptile { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel); position: relative; }
      .ptile img { width: 100%; height: 140px; object-fit: cover; display: block; background: var(--panel-2); }
      .ptile .meta { padding: 10px 12px; }
      .ptile .meta b { display: block; font-size: 12.5px; margin-bottom: 3px; }
      .ptile .meta small { color: var(--muted); font-size: 11.5px; }
      .ptile .pacts { position: absolute; top: 8px; right: 8px; display: flex; gap: 6px; opacity: 0; transition: opacity .15s; }
      .ptile:hover .pacts { opacity: 1; }
      .add-tile {
        border: 2px dashed var(--line-strong); border-radius: var(--radius);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        min-height: 200px; gap: 8px; color: var(--muted); background: transparent;
        cursor: pointer; transition: border-color .15s, color .15s;
      }
      .add-tile:hover { border-color: var(--brass); color: var(--brass-dark); }
      .add-tile .big { font-size: 30px; }

      /* SERP preview */
      .serp { border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; background: var(--panel); max-width: 600px; }
      .serp .u { font-size: 12px; color: var(--ink-soft); display: flex; align-items: center; gap: 6px; }
      .serp .u .dots { color: var(--muted); }
      .serp .t { font-size: 19px; color: #8ab4f8; margin: 3px 0 1px; line-height: 1.3; cursor: pointer; }
      .cms-light .serp .t { color: #1a0dab; }
      .serp .t.trunc { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .serp .d { font-size: 14px; color: var(--ink-soft); line-height: 1.4; }

      .meter { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; }
      .meter .bar { width: 120px; height: 6px; background: var(--line-strong); border-radius: 999px; overflow: hidden; }
      .meter .bar i { display: block; height: 100%; background: var(--green); transition: width .2s; }

      /* Commit list */
      .commit { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .commit:last-child { border-bottom: 0; }
      .commit .av { width: 36px; height: 36px; border-radius: 50%; flex: 0 0 36px; }
      .commit b { font-size: 14px; }
      .commit .cmsg { margin: 0 0 3px; }
      .commit small { color: var(--muted); }

      /* Modal */
      .overlay { position: fixed; inset: 0; background: rgba(26,24,20,.55); display: none; align-items: flex-start; justify-content: center; padding: 40px 20px; z-index: 100; overflow-y: auto; }
      .overlay.show { display: flex; }
      .modal { background: var(--panel); border-radius: 14px; box-shadow: var(--shadow-lg); width: 100%; max-width: 680px; margin: auto; }
      .modal.lg { max-width: 900px; }
      .modal .mhead { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--panel); border-radius: 14px 14px 0 0; z-index: 1; }
      .modal .mhead h2 { margin: 0; font-size: 18px; }
      .modal .mbody { padding: 24px; max-height: 70vh; overflow-y: auto; }
      .modal .mfoot { display: flex; justify-content: flex-end; gap: 8px; padding: 16px 24px; border-top: 1px solid var(--line); background: var(--panel-2); border-radius: 0 0 14px 14px; }
      .x { background: transparent; border: 0; font-size: 24px; line-height: 1; color: var(--muted); padding: 4px 8px; border-radius: 6px; }
      .x:hover { background: var(--hover); color: var(--ink); }

      /* Blog md editor */
      .md-split { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .md-split textarea { min-height: 380px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13.5px; line-height: 1.6; }
      .md-preview { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 16px; min-height: 380px; overflow-y: auto; background: var(--panel); font-size: 14px; line-height: 1.6; color: var(--ink); }
      .md-preview h1,.md-preview h2,.md-preview h3 { margin: 0 0 8px; }
      .md-preview p { margin: 0 0 12px; }
      .md-preview img { max-width: 100%; border-radius: 6px; }

      /* Toast */
      #toasts { position: fixed; bottom: 24px; right: 24px; z-index: 200; display: flex; flex-direction: column; gap: 10px; max-width: 380px; }
      .toast { background: var(--ink); color: #fff; padding: 14px 18px; border-radius: var(--radius); box-shadow: var(--shadow); display: flex; gap: 12px; align-items: flex-start; animation: slidein .25s ease; }
      .toast.success { background: var(--green); }
      .toast.error { background: var(--red); }
      .toast.info { background: var(--blue); }
      .toast .tx { flex: 1; font-size: 13.5px; }
      .toast b { display: block; margin-bottom: 2px; }
      @keyframes slidein { from { transform: translateX(120%); opacity: 0; } to { transform: none; opacity: 1; } }

      /* Loading overlay */
      #loading { position: fixed; inset: 0; background: rgba(0,0,0,.72); display: none; align-items: center; justify-content: center; z-index: 300; backdrop-filter: blur(2px); }
      #loading.show { display: flex; }
      .spinner { width: 46px; height: 46px; border: 4px solid var(--brass-soft); border-top-color: var(--brass); border-radius: 50%; animation: spin 1s linear infinite; }
      .loading-label { margin-top: 16px; font-weight: 700; color: var(--ink); }
      @keyframes spin { to { transform: rotate(360deg); } }

      .empty { text-align: center; padding: 48px 20px; color: var(--muted); }
      .empty .ic { font-size: 42px; margin-bottom: 10px; }

      /* Backdrop for mobile sidebar */
      #sb-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 45; }

      /* Responsive */
      @media (max-width: 860px) {
        .topbar .menu-toggle { display: block; }
        .topbar .brand .brand-text { display: none; }
        .sidebar {
          position: fixed; top: var(--topbar-h); left: 0; bottom: 0;
          height: auto; z-index: 50;
          transform: translateX(-100%); transition: transform .2s;
          box-shadow: var(--shadow-lg);
        }
        .sidebar.open { transform: none; }
        .sidebar.open ~ #sb-backdrop { display: block; }
        .main { padding: 20px 16px 80px; }
        .form-grid { grid-template-columns: 1fr; }
        .grid-2, .grid-3 { grid-template-columns: 1fr; }
        .md-split { grid-template-columns: 1fr; }
        .topbar .save-state { display: none; }
        .topbar .new-menu, .topbar .notif-btn, .topbar .topbar-search { display: none; }
      }

      /* ============================================================
         WORDPRESS-STYLE ADMIN BAR EXTRAS (+ New, search, notif, howdy)
         ============================================================ */
      .topbar .topbar-search {
        display: flex; align-items: center; gap: 6px;
        background: rgba(255,255,255,0.08);
        border: 1px solid var(--sidebar-line);
        border-radius: 999px; padding: 4px 12px;
        flex: 1 1 300px; min-width: 300px; max-width: 520px;
      }
      .topbar .topbar-search input {
        background: transparent; border: 0; outline: none; color: var(--sidebar-ink);
        font-size: 14px; min-height: 32px; width: 100%;
      }
      .topbar .topbar-search input::placeholder { color: var(--sidebar-muted); }
      .topbar .topbar-search .ic { color: var(--sidebar-muted); font-size: 14px; }

      .topbar .new-menu { position: relative; }
      .topbar .new-toggle {
        background: var(--brass); color: #fff; border: 1px solid var(--brass-dark);
        border-radius: 6px; padding: 0 12px; min-height: 36px; font-weight: 700; font-size: 13px;
        display: inline-flex; align-items: center; gap: 6px;
      }
      .topbar .new-toggle:hover { background: var(--brass-dark); }
      .topbar .new-toggle .caret { font-size: 10px; opacity: .9; }
      .topbar .new-list {
        position: absolute; top: calc(100% + 6px); right: 0; min-width: 180px;
        background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
        box-shadow: var(--shadow); padding: 6px; display: none; z-index: 60;
      }
      .topbar .new-menu.open .new-list { display: block; }
      .topbar .new-list button {
        display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
        background: transparent; border: 0; color: var(--ink); font-size: 13.5px; font-weight: 600;
        padding: 10px 12px; border-radius: 6px;
      }
      .topbar .new-list button:hover { background: var(--brass-soft); color: var(--brass-dark); }
      .topbar .new-list button .ic { width: 18px; text-align: center; }

      .topbar .notif-btn, .topbar .howdy {
        position: relative; background: transparent; border: 0; color: var(--sidebar-ink);
        font-size: 13.5px; font-weight: 600; min-height: 36px; padding: 0 8px; border-radius: 6px;
        display: inline-flex; align-items: center; gap: 8px;
      }
      .topbar .notif-btn:hover, .topbar .howdy:hover { background: var(--sidebar-soft); }
      .topbar .notif-btn .ic { font-size: 17px; }
      .topbar .notif-dot {
        position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; border-radius: 50%;
        background: var(--brass); border: 1.5px solid var(--sidebar);
      }
      .topbar .howdy .av {
        width: 26px; height: 26px; border-radius: 50%; object-fit: cover; background: var(--brass-soft);
      }
      .topbar .howdy .caret { font-size: 10px; opacity: .7; }

      /* ============================================================
         DASHBOARD WIDGETS — WordPress "dashboard" look
         ============================================================ */
      .welcome-banner {
        background: linear-gradient(135deg, var(--panel) 0%, var(--brass-soft) 100%);
        border: 1px solid var(--line);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius);
        padding: 22px 26px; margin-bottom: 24px;
        display: flex; align-items: center; gap: 22px; flex-wrap: wrap;
      }
      .welcome-banner .wb-logo {
        width: 56px; height: 56px; border-radius: 14px; flex: 0 0 56px;
        background: linear-gradient(135deg, var(--brass), var(--brass-dark));
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 20px; box-shadow: 0 6px 16px rgba(176,141,87,.35);
      }
      .welcome-banner h1 { margin: 0 0 4px; font-size: 24px; font-weight: 800; letter-spacing: -0.01em; }
      .welcome-banner p { margin: 0; color: var(--ink-soft); font-size: 14px; }

      .widget-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: start;
      }
      .widget {
        background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
        box-shadow: var(--shadow-sm); margin-bottom: 0; overflow: hidden;
      }
      .widget .w-head {
        display: flex; align-items: center; gap: 10px; padding: 14px 20px;
        border-bottom: 1px solid var(--line); background: var(--panel-2);
      }
      .widget .w-head h3 { margin: 0; font-size: 14px; font-weight: 700; flex: 1; }
      .widget .w-head .w-ic { font-size: 16px; }
      .widget .w-head .w-sub { font-size: 12px; color: var(--muted); font-weight: 500; }
      .widget .w-body { padding: 18px 20px; }
      .widget .w-body.compact { padding: 0; }

      /* At a Glance widget — WordPress style count list */
      .at-glance { list-style: none; padding: 0; margin: 0; }
      .at-glance li {
        display: flex; align-items: center; gap: 12px; padding: 12px 20px;
        border-bottom: 1px solid var(--line); font-size: 14px; cursor: pointer;
        transition: background .12s;
      }
      .at-glance li:last-child { border-bottom: 0; }
      .at-glance li:hover { background: var(--hover); }
      .at-glance .ag-ic {
        width: 34px; height: 34px; border-radius: 8px; flex: 0 0 34px;
        display: flex; align-items: center; justify-content: center; font-size: 16px;
        background: var(--brass-soft); color: var(--brass-dark);
      }
      .at-glance .ag-text { flex: 1; }
      .at-glance .ag-text b { display: block; font-size: 14px; color: var(--ink); }
      .at-glance .ag-text small { color: var(--muted); font-size: 12px; }
      .at-glance .ag-n { font-family: var(--font-display, Georgia, serif); font-size: 22px; font-weight: 700; color: var(--brass-dark); }

      /* Site Health pill */
      .health-pill {
        display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700;
        padding: 6px 12px; border-radius: 999px;
      }
      .health-pill.good { background: var(--green-soft); color: var(--green); }
      .health-pill.warn { background: var(--amber-soft); color: var(--amber); }
      .health-pill .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }

      .health-checks { list-style: none; padding: 0; margin: 0; }
      .health-checks li {
        display: flex; align-items: center; gap: 10px; padding: 10px 0;
        border-bottom: 1px solid var(--line); font-size: 13.5px;
      }
      .health-checks li:last-child { border-bottom: 0; }
      .health-checks .hc-state { width: 22px; height: 22px; border-radius: 50%; flex: 0 0 22px;
        display: flex; align-items: center; justify-content: center; font-size: 12px; color: #fff; font-weight: 700; }
      .health-checks .hc-state.ok { background: var(--green); }
      .health-checks .hc-state.warn { background: var(--amber); }
      .health-checks b { font-size: 13.5px; }
      .health-checks small { display: block; color: var(--muted); font-size: 12px; }

      /* Activity / Quick Draft */
      .activity-list, .draft-list { list-style: none; padding: 0; margin: 0; }
      .activity-list li, .draft-list li {
        display: flex; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 13.5px;
      }
      .activity-list li:last-child, .draft-list li:last-child { border-bottom: 0; }
      .activity-list .al-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brass); margin-top: 7px; flex: 0 0 8px; }
      .activity-list b { font-size: 13.5px; }
      .activity-list small { color: var(--muted); font-size: 12px; }
      .quick-draft textarea { min-height: 120px; }

      /* WordPress-style list table (filter/search/bulk bar) */
      .list-toolbar {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;
      }
      .list-toolbar .lt-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .list-toolbar select {
        min-height: 38px; padding: 6px 28px 6px 10px; font-size: 13.5px;
        border: 1px solid var(--line-strong); border-radius: 5px; background: var(--input-bg); color: var(--ink);
      }
      .list-toolbar .lt-search {
        display: flex; align-items: center; gap: 6px; margin-left: auto;
      }
      .list-toolbar .lt-search input {
        min-height: 38px; padding: 6px 12px; font-size: 13.5px;
        border: 1px solid var(--line-strong); border-radius: 5px; width: 200px;
      }
      .row-cb { width: 18px; height: 18px; accent-color: var(--brass); }
      .wp-row-actions { display: flex; gap: 10px; font-size: 12px; }
      .wp-row-actions button { background: transparent; border: 0; color: var(--brass-dark); font-weight: 600; cursor: pointer; padding: 0; }
      .wp-row-actions button:hover { text-decoration: underline; }
      .wp-row-actions .sep { color: var(--line-strong); }
      .pagination {
        display: flex; align-items: center; gap: 4px; justify-content: flex-end; margin-top: 14px;
      }
      .pagination button, .pagination span {
        min-width: 34px; min-height: 34px; padding: 0 10px; border: 1px solid var(--line-strong);
        background: var(--panel); color: var(--ink); border-radius: 5px; font-size: 13px; font-weight: 600;
      }
      .pagination button:hover { background: var(--hover); }
      .pagination .current { background: var(--brass); color: #fff; border-color: var(--brass-dark); }
      .pagination .dots { border: 0; background: transparent; }

      /* ============================================================
         PAGE BUILDER
         ============================================================ */
      .pb-toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 20px; }
      .pb-page-select { display: flex; align-items: center; gap: 10px; }
      .pb-page-select select { min-width: 280px; }
      .pb-canvas { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); overflow: hidden; box-shadow: var(--shadow-sm); }
      .pb-block {
        display: flex; align-items: stretch; border-bottom: 1px solid var(--line);
        transition: background .12s; position: relative;
      }
      .pb-block:last-child { border-bottom: 0; }
      .pb-block:hover { background: var(--hover); }
      .pb-block.dragging { opacity: .4; }
      .pb-block.drag-over { box-shadow: inset 0 3px 0 var(--brass); }
      .pb-block.disabled { opacity: .5; }
      .pb-handle {
        width: 44px; flex: 0 0 44px; display: flex; align-items: center; justify-content: center;
        cursor: grab; color: var(--muted); font-size: 18px; background: var(--panel-2); border-right: 1px solid var(--line);
        user-select: none;
      }
      .pb-handle:active { cursor: grabbing; }
      .pb-main { flex: 1; padding: 14px 18px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
      .pb-main .pb-name { font-weight: 700; font-size: 14.5px; display: flex; align-items: center; gap: 8px; }
      .pb-main .pb-desc { font-size: 12.5px; color: var(--muted); }
      .pb-main .pb-edit-inline { background: transparent; border: 0; color: var(--brass-dark); font-weight: 600; font-size: 12.5px; cursor: pointer; padding: 0; align-self: flex-start; }
      .pb-main .pb-edit-inline:hover { text-decoration: underline; }
      .pb-actions { display: flex; align-items: center; gap: 6px; padding: 0 14px; border-left: 1px solid var(--line); }
      .pb-actions .pb-toggle { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-soft); }
      .pb-actions input { accent-color: var(--brass); }

      .pb-library { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
      .pb-block-tile {
        border: 1.5px solid var(--line-strong); border-radius: var(--radius); padding: 16px;
        background: var(--panel); cursor: pointer; text-align: center;
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        transition: border-color .15s, box-shadow .15s, transform .1s;
      }
      .pb-block-tile:hover { border-color: var(--brass); box-shadow: 0 0 0 3px var(--brass-soft); transform: translateY(-2px); }
      .pb-block-tile .pb-bic { font-size: 26px; }
      .pb-block-tile b { font-size: 13px; }
      .pb-block-tile small { font-size: 11px; color: var(--muted); line-height: 1.3; }

      .pb-empty { text-align: center; padding: 48px 20px; color: var(--muted); }

      /* ============================================================
         INLINE VISUAL EDITOR (Divi/WordPress-style)
         Each block renders as a "preview" card that mimics the live
         site. Text fields are contenteditable so Mike can click and
         type directly. Hover = dashed outline; editing = blue outline.
         ============================================================ */
      .ie-stage { display: flex; flex-direction: column; gap: 16px; }
      .ie-block {
        position: relative; background: var(--panel); border: 1px solid var(--line);
        border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden;
        transition: border-color .15s, box-shadow .15s;
      }
      .ie-block:hover { border-color: var(--brass); box-shadow: 0 0 0 1px var(--brass-soft); }
      .ie-block.dragging { opacity: .4; }
      .ie-block.drag-over { box-shadow: inset 0 3px 0 var(--brass); }
      .ie-block.disabled { opacity: .45; }
      .ie-bar {
        display: flex; align-items: center; gap: 8px; padding: 8px 12px;
        background: var(--panel-2); border-bottom: 1px solid var(--line);
        font-size: 12px; color: var(--muted);
      }
      .ie-bar .ie-handle { cursor: grab; padding: 2px 6px; font-size: 16px; line-height: 1; user-select: none; color: var(--muted); }
      .ie-bar .ie-handle:active { cursor: grabbing; }
      .ie-bar .ie-tag { font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .05em; font-size: 10.5px; }
      .ie-bar .ie-spacer { flex: 1; }
      .ie-bar .ie-btn { background: transparent; border: 0; color: var(--muted); cursor: pointer; padding: 4px 6px; border-radius: 4px; font-size: 14px; line-height: 1; }
      .ie-bar .ie-btn:hover { background: var(--hover); color: var(--ink); }
      .ie-bar .ie-btn.danger:hover { background: var(--red-soft); color: var(--red); }
      .ie-preview { padding: 24px; }
      .ie-preview.lg { padding: 32px 28px; }
      /* contenteditable elements */
      [contenteditable] { outline: none; border-radius: 4px; transition: box-shadow .12s, background .12s; padding: 2px 4px; }
      [contenteditable]:hover { box-shadow: 0 0 0 1px var(--brass); }
      [contenteditable]:focus { box-shadow: 0 0 0 2px var(--blue); background: rgba(91,159,224,.08); }
      .cms-light [contenteditable]:focus { background: rgba(44,111,179,.08); }
      [contenteditable][data-empty="1"]::before { content: attr(data-placeholder); color: var(--muted); font-style: italic; pointer-events: none; }
      .ie-h1 { font-family: var(--font-display, Georgia, serif); font-size: 30px; font-weight: 700; line-height: 1.15; color: #fff; letter-spacing: -0.01em; }
      .cms-light .ie-h1 { color: var(--ink); }
      .ie-h2 { font-family: var(--font-display, Georgia, serif); font-size: 22px; font-weight: 700; line-height: 1.2; color: #fff; }
      .cms-light .ie-h2 { color: var(--ink); }
      .ie-p { font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
      .ie-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--brass-dark); margin-bottom: 8px; }
      .ie-btn-preview { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 20px; background: var(--brass); color: #fff; border-radius: 6px; font-weight: 700; font-size: 14px; }
      .ie-img { width: 100%; max-width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--line); background: var(--panel-2); }
      .ie-img-ph { display: flex; align-items: center; justify-content: center; height: 160px; background: var(--panel-2); border: 1px dashed var(--line-strong); border-radius: 8px; color: var(--muted); font-size: 13px; }
      .ie-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; }
      .ie-gallery .ie-gitem { position: relative; aspect-ratio: 4/3; border-radius: 6px; overflow: hidden; background: var(--panel-2); border: 1px solid var(--line); }
      .ie-gallery .ie-gitem img { width: 100%; height: 100%; object-fit: cover; }
      .ie-gallery .ie-gadd { display: flex; align-items: center; justify-content: center; border: 1px dashed var(--line-strong); color: var(--muted); cursor: pointer; font-size: 22px; }
      .ie-gallery .ie-gadd:hover { border-color: var(--brass); color: var(--brass-dark); }
      .ie-video-frame { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; border: 1px solid var(--line); background: var(--panel-2); }
      .ie-video-frame iframe, .ie-video-frame .ie-video-ph { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      .ie-video-ph { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 13px; }
      .ie-spacer { background: repeating-linear-gradient(45deg, var(--panel-2), var(--panel-2) 8px, transparent 8px, transparent 16px); border: 1px dashed var(--line); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 12px; }
      .ie-divider { height: 1px; background: var(--line-strong); margin: 8px 0; }
      .ie-mode-tabs { display: inline-flex; background: var(--panel-2); border: 1px solid var(--line); border-radius: 8px; padding: 3px; gap: 2px; }
      .ie-mode-tabs button { background: transparent; border: 0; color: var(--muted); font-size: 13px; font-weight: 600; padding: 6px 14px; border-radius: 6px; cursor: pointer; }
      .ie-mode-tabs button.active { background: var(--brass); color: #fff; }

      @media (max-width: 860px) {
        .widget-grid { grid-template-columns: 1fr; }
        .pb-page-select select { min-width: 0; flex: 1; }
        .pb-actions { flex-direction: column; align-items: flex-end; padding: 10px; }
        .list-toolbar .lt-search { margin-left: 0; width: 100%; }
        .list-toolbar .lt-search input { width: 100%; }
      }
    </style>
  </head>
  <body>
    <!-- ===================== LOGIN ===================== -->
    <div id="login">
      <div class="login-card">
        <div class="login-head">
          <img class="login-logo" src={BASE + "images/logo-white.png"} alt="Virtual Tours Las Vegas" />
          <h1>Content Manager</h1>
          <p>Virtual Tours Las Vegas</p>
        </div>
        <form class="login-body" id="login-form">
          <div class="login-error" id="login-error"></div>
          <div class="field">
            <label for="li-token">GitHub Token</label>
            <input type="password" id="li-token" autocomplete="off" placeholder="github_pat_..." required />
            <div class="hint">A fine-grained PAT with <b>Contents: Read &amp; Write</b> on this repo.</div>
          </div>
          <div class="field">
            <label for="li-pass">Site Password</label>
            <input type="password" id="li-pass" autocomplete="off" required />
          </div>
          <label class="row-check">
            <input type="checkbox" id="li-remember" checked />
            Remember me on this device
          </label>
          <button type="submit" class="btn btn-block btn-lg" id="li-submit">Log in</button>
          <details class="login-help">
            <summary>How do I get a GitHub token?</summary>
            <p style="margin: 12px 0 8px;">
              1. Open
              <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">github.com → Settings → Developer settings → Fine-grained tokens</a>.
            </p>
            <p style="margin: 0 0 8px;">2. Click <b>Generate new token</b>. Use your own GitHub account as the resource owner.</p>
            <p style="margin: 0 0 8px;">3. Under <b>Repository access</b> choose <i>Only select repositories</i> → pick this site's repository.</p>
            <p style="margin: 0 0 8px;">4. Under <b>Permissions → Repository permissions → Contents</b> set <b>Read and write</b>.</p>
            <p style="margin: 0;">5. Generate, copy the <code>github_pat_...</code> value, paste it above.</p>
          </details>
        </form>
      </div>
    </div>

    <!-- ===================== APP ===================== -->
    <div id="app">
      <div class="topbar">
        <button class="menu-toggle" id="menu-toggle" aria-label="Menu">&#9776;</button>
        <div class="brand">
          <img src={BASE + "images/logo-white.png"} alt="Virtual Tours Las Vegas" class="brand-logo" />
          <span class="brand-text">
            <small>Content Manager</small>
          </span>
        </div>
        <div class="spacer"></div>
        <div class="topbar-search">
          <span class="ic">&#128269;</span>
          <input type="search" id="topbar-search-input" placeholder="Search content…" autocomplete="off" aria-label="Search content" />
        </div>
        <div class="new-menu" id="new-menu">
          <button class="new-toggle" id="new-toggle" aria-haspopup="true" aria-expanded="false">+ New <span class="caret">&#9660;</span></button>
          <div class="new-list" role="menu" aria-label="Create new">
            <button role="menuitem" data-new="page"><span class="ic">&#128196;</span> New Page</button>
            <button role="menuitem" data-new="post"><span class="ic">&#9999;&#65039;</span> New Post</button>
            <button role="menuitem" data-new="media"><span class="ic">&#128247;</span> New Media</button>
            <button role="menuitem" data-new="testimonial"><span class="ic">&#11088;</span> New Testimonial</button>
          </div>
        </div>
        <button class="notif-btn" id="notif-btn" aria-label="Notifications" title="Notifications">
          <span class="ic">&#128276;</span>
          <span class="notif-dot" id="notif-dot"></span>
        </button>
        <button class="howdy" id="howdy-btn" aria-haspopup="true" aria-expanded="false">
          <span class="av" id="howdy-av">M</span>
          <span>Howdy, <b id="howdy-name">Mike</b></span>
          <span class="caret">&#9660;</span>
        </button>
        <div class="save-state" id="save-state">All changes saved</div>
        <a class="btn btn-ghost btn-sm" id="view-site" href="#" target="_blank" rel="noopener noreferrer">View Site &#8599;</a>
        <button class="btn btn-sm" id="save-btn" disabled>Save Changes</button>
      </div>

      <div class="shell">
        <aside class="sidebar" id="sidebar"></aside>
        <div id="sb-backdrop"></div>
        <main class="main" id="main"></main>
      </div>
    </div>

    <!-- Modal mount -->
    <div class="overlay" id="overlay"><div class="modal" id="modal"></div></div>

    <!-- Toasts -->
    <div id="toasts"></div>

    <!-- Popover layer for howdy menu + notifications -->
    <div id="popover-layer"></div>

    <!-- Loading -->
    <div id="loading"><div style="text-align:center"><div class="spinner"></div><div class="loading-label" id="loading-label">Working…</div></div></div>

    <!-- ===================== SCRIPT ===================== -->
    <script is:inline define:vars={{ passwordHash, pages, REPO, BRANCH, BASE }}>
      "use strict";
      // ============================================================
      //  Config & state
      // ============================================================
      const API = "https://api.github.com";
      const CMS_DIR = "src/data/cms";
      const BLOG_DIR = "src/content/blog";

      const LS = {
        token: "vtlv_cms_token",
        pass: "vtlv_cms_pass",
        remember: "vtlv_cms_remember",
        user: "vtlv_cms_user",
        theme: "vtlv_cms_theme",
      };

      // In-memory cache of loaded files: { path: { content, sha } }
      const cache = Object.create(null);

      // Editor models held in memory while a section is open.
      const models = {
        settings: null,
        pricing: null,
        testimonials: null,
        faq: null,
        portfolio: null,
        seo: {}, // path -> {title, description, keyword}
      };

      let currentSection = "dashboard";

      // ============================================================
      //  DOM helpers
      // ============================================================
      const $ = (sel, root = document) => root.querySelector(sel);
      const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
      function el(tag, attrs, ...kids) {
        const n = document.createElement(tag);
        for (const [k, v] of Object.entries(attrs || {})) {
          if (v === null || v === undefined || v === false) continue;
          if (k === "class") n.className = v;
          else if (k === "html") n.innerHTML = v;
          else if (k === "style" && typeof v === "object") n.setAttribute("style", Object.entries(v).map(([a, b]) => `${a.replace(/[A-Z]/g, (m) => "-" + m.toLowerCase())}:${b}`).join(";"));
          else if (k.startsWith("on") && typeof v === "function") n.addEventListener(k.slice(2), v);
          else n.setAttribute(k, v);
        }
        for (const kid of kids) {
          if (kid == null || kid === false) continue;
          n.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
        }
        return n;
      }
      const clear = (n) => { while (n.firstChild) n.removeChild(n.firstChild); return n; };
      const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      // ============================================================
      //  Base64 (UTF-8 safe) — GitHub Contents API requirement
      // ============================================================
      function b64encode(str) {
        const bytes = new TextEncoder().encode(str);
        let bin = "";
        for (const b of bytes) bin += String.fromCharCode(b);
        return btoa(bin);
      }
      function b64decode(b64) {
        const bin = atob(String(b64).replace(/\n/g, ""));
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        return new TextDecoder().decode(bytes);
      }
      function fileToB64(file) {
        return new Promise((resolve, reject) => {
          const r = new FileReader();
          r.onload = () => {
            const dataUrl = r.result;
            resolve(dataUrl.slice(dataUrl.indexOf(",") + 1));
          };
          r.onerror = reject;
          r.readAsDataURL(file);
        });
      }

      // ============================================================
      //  GitHub API helpers
      // ============================================================
      function token() {
        return sessionStorage[LS.token] || localStorage[LS.token] || "";
      }
      function authHeaders() {
        return {
          Authorization: `Bearer ${token()}`,
          Accept: "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28",
        };
      }

      async function gh(path, opts) {
        opts = opts || {};
        const res = await fetch(`${API}${path}`, { ...opts, headers: { ...authHeaders(), ...(opts.headers || {}) } });
        const txt = await res.text();
        let data = null;
        try { data = txt ? JSON.parse(txt) : null; } catch { data = txt; }
        if (!res.ok) {
          const msg = (data && (data.message || data)) || res.statusText;
          const err = new Error(typeof msg === "string" ? msg : JSON.stringify(msg));
          err.status = res.status;
          err.data = data;
          throw err;
        }
        return data;
      }

      // Read a file, with in-memory caching.
      async function readFile(path) {
        if (cache[path]) return cache[path];
        const data = await gh(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
        const obj = { content: b64decode(data.content), sha: data.sha };
        cache[path] = obj;
        return obj;
      }

      // Write a file. Updates the cached sha on success.
      async function writeFile(path, content, message) {
        const existing = cache[path];
        const body = { message: message || `CMS: update ${path}`, content: b64encode(content), branch: BRANCH };
        if (existing && existing.sha) body.sha = existing.sha;
        const data = await gh(`/repos/${REPO}/contents/${path}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (cache[path]) cache[path].sha = data.content.sha;
        else cache[path] = { content, sha: data.content.sha };
        return data;
      }

      // Upload a brand-new binary file (no sha). Used for portfolio images.
      async function uploadFile(path, b64, message) {
        return gh(`/repos/${REPO}/contents/${path}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: message || `CMS: upload ${path}`, content: b64, branch: BRANCH }),
        });
      }

      async function deleteFile(path, sha, message) {
        return gh(`/repos/${REPO}/contents/${path}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: message || `CMS: delete ${path}`, sha, branch: BRANCH }),
        });
      }

      // List directory contents.
      async function listDir(path) {
        return gh(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
      }

      // ============================================================
      //  Loading overlay & toasts
      // ============================================================
      function showLoading(label) {
        $("#loading-label").textContent = label || "Working…";
        $("#loading").classList.add("show");
      }
      function hideLoading() { $("#loading").classList.remove("show"); }

      function toast(message, type, title) {
        const t = el("div", { class: `toast ${type || "success"}` },
          el("div", { class: "tx" }, title ? el("b", {}, title) : null, document.createTextNode(message)),
          el("button", { class: "x", style: { color: "#fff" }, onclick: () => t.remove() }, "\u00d7"),
        );
        $("#toasts").appendChild(t);
        setTimeout(() => t.remove(), 5200);
      }

      // ============================================================
      //  Auth
      // ============================================================
      async function verifyToken(tok) {
        const res = await fetch(`${API}/user`, { headers: { Authorization: `Bearer ${tok}`, Accept: "application/vnd.github+json" } });
        if (!res.ok) throw new Error(res.status === 401 ? "Invalid or expired GitHub token" : `GitHub rejected the token (HTTP ${res.status})`);
        return res.json();
      }

      async function sha256Hex(s) {
        const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s));
        return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
      }

      async function attemptLogin(tok, pass, remember) {
        showLoading("Verifying credentials…");
        try {
          const hash = await sha256Hex(pass);
          if (hash !== passwordHash) throw new Error("Wrong site password. Check the credentials you were given.");
          const user = await verifyToken(tok);

          const store = remember ? localStorage : sessionStorage;
          store[LS.token] = tok;
          store[LS.pass] = pass;
          store[LS.user] = JSON.stringify({ login: user.login, name: user.name || user.login, avatar: user.avatar_url });
          if (remember) localStorage[LS.remember] = "1"; else localStorage.removeItem(LS.remember);

          hideLoading();
          enterApp();
          toast(`Logged in as ${user.login}`, "success", "Welcome back!");
        } catch (e) {
          hideLoading();
          const box = $("#login-error");
          box.textContent = e.message;
          box.style.display = "block";
        }
      }

      function isLoggedIn() {
        return !!(sessionStorage[LS.token] || localStorage[LS.token]);
      }

      function logout() {
        [sessionStorage, localStorage].forEach((s) => {
          s.removeItem(LS.token); s.removeItem(LS.pass); s.removeItem(LS.user);
        });
        localStorage.removeItem(LS.remember);
        Object.keys(cache).forEach((k) => delete cache[k]);
        location.reload();
      }

      function enterApp() {
        $("#login").style.display = "none";
        $("#app").style.display = "block";
        $("#view-site").setAttribute("href", BASE || "/");

        // Populate the "Howdy" chip from the stored GitHub user.
        const u = JSON.parse(sessionStorage[LS.user] || localStorage[LS.user] || "{}");
        const firstName = (u.name || u.login || "Mike").split(" ")[0];
        $("#howdy-name").textContent = firstName;
        const av = $("#howdy-av");
        if (u.avatar) {
          const img = el("img", { src: u.avatar, alt: "", style: { width: "100%", height: "100%", borderRadius: "50%", objectFit: "cover" } });
          clear(av); av.appendChild(img);
        } else {
          av.textContent = (firstName[0] || "M").toUpperCase();
        }

        wireTopbar();
        buildSidebar();
        navigate("dashboard");
      }

      // ============================================================
      //  Topbar: + New dropdown, notifications popover, howdy menu,
      //  global content search. WordPress admin-bar behavior.
      // ============================================================
      let notifSeen = false;
      function wireTopbar() {
        // --- + New dropdown ---
        const newMenu = $("#new-menu");
        const newToggle = $("#new-toggle");
        newToggle.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = newMenu.classList.toggle("open");
          newToggle.setAttribute("aria-expanded", open ? "true" : "false");
          closePopovers();
        });
        $$("[data-new]", newMenu).forEach((btn) => {
          btn.addEventListener("click", () => {
            newMenu.classList.remove("open");
            const kind = btn.getAttribute("data-new");
            if (kind === "post") { navigate("blog"); setTimeout(() => newBlogPost(), 150); }
            else if (kind === "testimonial") { navigate("testimonials"); setTimeout(() => testimonialModal(null), 150); }
            else if (kind === "media") { navigate("portfolio"); setTimeout(() => portfolioUploadModal(), 150); }
            else if (kind === "page") { navigate("pagebuilder"); }
          });
        });

        // --- Notifications bell ---
        const notifBtn = $("#notif-btn");
        notifBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          newMenu.classList.remove("open");
          togglePopover(notifBtn, buildNotifications(), () => { notifSeen = true; $("#notif-dot").style.display = "none"; });
        });

        // --- Howdy menu ---
        const howdy = $("#howdy-btn");
        howdy.addEventListener("click", (e) => {
          e.stopPropagation();
          newMenu.classList.remove("open");
          togglePopover(howdy, buildHowdyMenu());
        });

        // --- Global content search ---
        const searchInput = $("#topbar-search-input");
        searchInput.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          const q = searchInput.value.trim().toLowerCase();
          if (!q) return;
          // Route to the most likely section based on the query.
          if (/price|cost|\$/.test(q)) navigate("pricing");
          else if (/review|testimonial|quote/.test(q)) navigate("testimonials");
          else if (/faq|question/.test(q)) navigate("faq");
          else if (/blog|post|article/.test(q)) navigate("blog");
          else if (/image|photo|portfolio/.test(q)) navigate("portfolio");
          else if (/seo|google|search|meta/.test(q)) navigate("seo");
          else if (/setting|phone|email|contact|business/.test(q)) navigate("settings");
          else navigate("pages");
        });

        // Click-away closes dropdowns + popovers.
        document.addEventListener("click", () => { newMenu.classList.remove("open"); closePopovers(); });
      }

      function buildNotifications() {
        const items = [
          { ic: "\u2705", title: "Site is live", body: "Latest deploy completed successfully.", time: "just now" },
          { ic: "\u{1F4C4}", title: pages.length + " pages indexed", body: "All public pages are in the sitemap.", time: "today" },
          { ic: "\u26A0\uFE0F", title: "Token tip", body: "Fine-grained PATs expire. Re-login if edits stop saving.", time: "this week" },
        ];
        const card = el("div", { style: { minWidth: "300px", maxWidth: "360px" } },
          el("div", { style: { fontWeight: "700", fontSize: "13px", padding: "10px 14px 6px", color: "var(--ink)" } }, "Notifications"));
        for (const n of items) {
          card.appendChild(el("div", { style: { display: "flex", gap: "10px", padding: "10px 14px", borderTop: "1px solid var(--line)" } },
            el("span", { style: { fontSize: "16px" } }, n.ic),
            el("div", { style: { flex: "1", minWidth: "0" } },
              el("div", { style: { fontWeight: "700", fontSize: "13px" } }, n.title),
              el("div", { style: { fontSize: "12px", color: "var(--ink-soft)", lineHeight: "1.4" } }, n.body),
              el("div", { style: { fontSize: "11px", color: "var(--muted)", marginTop: "2px" } }, n.time))));
        }
        return card;
      }

      function buildHowdyMenu() {
        const u = JSON.parse(sessionStorage[LS.user] || localStorage[LS.user] || "{}");
        const card = el("div", { style: { minWidth: "220px" } });
        const item = (label, onclick) => el("button", {
          style: { display: "flex", alignItems: "center", gap: "10px", width: "100%", textAlign: "left", background: "transparent", border: "0", color: "var(--ink)", fontSize: "13.5px", fontWeight: "600", padding: "10px 14px", cursor: "pointer" },
          onmouseover: function () { this.style.background = "var(--brass-soft)"; },
          onmouseout: function () { this.style.background = "transparent"; },
          onclick: () => { closePopovers(); onclick(); },
        }, label);
        card.appendChild(el("div", { style: { padding: "12px 14px", borderBottom: "1px solid var(--line)" } },
          el("div", { style: { fontWeight: "700", fontSize: "13px" } }, esc(u.name || u.login || "Mike")),
          el("div", { style: { fontSize: "12px", color: "var(--muted)" } }, esc(u.login ? "@" + u.login : "Content Manager"))));
        card.appendChild(item("Edit my profile", () => window.open("https://github.com/settings/profile", "_blank", "noopener,noreferrer")));
        card.appendChild(item("Site settings", () => navigate("settings")));
        card.appendChild(item("Appearance", () => navigate("appearance")));
        card.appendChild(el("div", { style: { height: "1px", background: "var(--line)", margin: "4px 0" } }));
        card.appendChild(item("Log out", () => { if (confirm("Log out of the Content Manager?")) logout(); }));
        return card;
      }

      // Generic popover anchored below a trigger element.
      let activePopover = null;
      function togglePopover(trigger, contentNode, onOpen) {
        closePopovers();
        const pop = el("div", {
          style: {
            position: "absolute", background: "var(--panel)", border: "1px solid var(--line)",
            borderRadius: "8px", boxShadow: "var(--shadow)", zIndex: "90", overflow: "hidden",
          },
        }, contentNode);
        const rect = trigger.getBoundingClientRect();
        pop.style.top = (rect.bottom + window.scrollY + 6) + "px";
        // Default left-align under the trigger; shift right if it would overflow.
        const width = 360;
        let left = rect.left + window.scrollX;
        if (left + width > window.scrollX + window.innerWidth - 12) left = window.scrollX + window.innerWidth - width - 12;
        pop.style.left = Math.max(12, left) + "px";
        $("#popover-layer").appendChild(pop);
        activePopover = pop;
        if (onOpen) setTimeout(onOpen, 0);
      }
      function closePopovers() {
        if (activePopover) { activePopover.remove(); activePopover = null; }
      }
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") { closePopovers(); $("#new-menu").classList.remove("open"); } });

      // ============================================================
      //  Sidebar / navigation
      // ============================================================
      // WordPress admin sidebar order. Groups mirror WP's separator-delimited
      // sections: Dashboard | Posts/Media/Pages | Comments | Projects |
      // Appearance/Plugins/Users/Tools | Plugins (Meow, Yoast, Site Kit, …).
      const sections = {
        // Top
        dashboard: { label: "Dashboard", icon: "\u{1F4CA}", group: "Dashboard", render: renderDashboard },
        // Content group
        posts: { label: "Posts", icon: "\u270D\uFE0F", group: "Content", render: renderBlog, alias: "Blog" },
        media: { label: "Media", icon: "\u{1F5BC}\uFE0F", group: "Content", render: renderMedia, alias: "Library" },
        pages: { label: "Pages", icon: "\u{1F4C4}", group: "Content", render: renderPages },
        // Comments
        comments: { label: "Comments", icon: "\u{1F4AC}", group: "Discussion", render: renderComments },
        // Projects
        projects: { label: "Projects", icon: "\u{1F4F8}", group: "Projects", render: renderProjects, alias: "Portfolio" },
        // Core configure
        appearance: { label: "Appearance", icon: "\u{1F3A8}", group: "Configure", render: renderAppearance },
        plugins: { label: "Plugins", icon: "\u{1F50C}", group: "Configure", render: renderPlugins },
        users: { label: "Users", icon: "\u{1F465}", group: "Configure", render: renderUsers },
        tools: { label: "Tools", icon: "\u{1F527}", group: "Configure", render: renderTools },
        // VTLV extras (kept for deep links from plugins)
        pagebuilder: { label: "Page Builder", icon: "\u{1F9E9}", group: "Configure", render: renderPageBuilder },
        pricing: { label: "Pricing", icon: "\u{1F4B2}", group: "Content", render: renderPricing },
        testimonials: { label: "Testimonials", icon: "\u2B50", group: "Content", render: renderTestimonials },
        faq: { label: "FAQ", icon: "\u2753", group: "Content", render: renderFAQ },
        // Integrations / plugins block (WordPress plugin menu items)
        meowapps: { label: "Meow Apps", icon: "\u{1F408}", group: "Plugins", render: renderMeowApps, alias: "Media tools" },
        easysmtp: { label: "Easy WP SMTP", icon: "\u2709\uFE0F", group: "Plugins", render: renderEasySMTP, alias: "Email" },
        yoast: { label: "Yoast SEO", icon: "\u{1F50D}", group: "Plugins", render: renderYoast, alias: "SEO dashboard" },
        matterport: { label: "WP Matterport", icon: "\u{1F9ED}", group: "Plugins", render: renderMatterport, alias: "Embeds" },
        updraft: { label: "UpdraftPlus", icon: "\u{1F4E4}", group: "Plugins", render: renderUpdraft, alias: "Backups" },
        latepoint: { label: "LatePoint", icon: "\u{1F4C5}", group: "Plugins", render: renderLatePoint, alias: "Bookings" },
        divi: { label: "Divi", icon: "\u{1F9ED}", group: "Plugins", render: renderDivi, alias: "Theme builder" },
        litespeed: { label: "LiteSpeed Cache", icon: "\u26A1", group: "Plugins", render: renderLiteSpeed, alias: "Performance" },
        masterslider: { label: "Master Slider", icon: "\u{1F3AC}", group: "Plugins", render: renderMasterSlider, alias: "Sliders" },
        sitekit: { label: "Site Kit", icon: "\u{1F4CA}", group: "Plugins", render: renderSiteKit, alias: "Analytics" },
        imagify: { label: "Imagify", icon: "\u{1F5BC}\uFE0F", group: "Plugins", render: renderImagify, alias: "Image optimization" },
        // Legacy aliases for topbar +New + search routing + howdy menu
        blog: { label: "Blog", icon: "\u270D\uFE0F", group: "Content", render: renderBlog, hidden: true },
        portfolio: { label: "Portfolio", icon: "\u{1F4F8}", group: "Content", render: renderPortfolio, hidden: true },
        seo: { label: "SEO", icon: "\u{1F50D}", group: "Plugins", render: renderSEO, hidden: true },
        settings: { label: "Settings", icon: "\u2699\uFE0F", group: "Configure", render: renderSettings, hidden: true },
        integrations: { label: "Integrations", icon: "\u{1F50C}", group: "Configure", render: renderIntegrations, hidden: true },
        redirects: { label: "Redirects", icon: "\u{1F4CB}", group: "Tools", render: renderRedirects, hidden: true },
        backup: { label: "Backup", icon: "\u{1F4E4}", group: "Tools", render: renderBackup, hidden: true },
      };

      function buildSidebar() {
        const sb = $("#sidebar");
        clear(sb);
        const groups = {};
        for (const [key, s] of Object.entries(sections)) {
          if (s.hidden) continue;
          (groups[s.group] = groups[s.group] || []).push({ key, ...s });
        }
        // WordPress admin group order (separators in WP map to these headers).
        const order = ["Dashboard", "Content", "Discussion", "Projects", "Configure", "Plugins"];
        for (const g of order) {
          if (!groups[g]) continue;
          sb.appendChild(el("div", { class: "nav-section" }, el("h3", {}, g)));
          for (const s of groups[g]) {
            const label = s.alias ? `${s.label} (${s.alias})` : s.label;
            sb.appendChild(el("button", {
              class: "nav-item", "data-section": s.key,
              onclick: () => navigate(s.key),
            }, el("span", { class: "ic" }, s.icon), el("span", {}, label)));
          }
        }
        sb.appendChild(el("div", { class: "nav-section" }, el("h3", {}, "Account")));
        sb.appendChild(el("button", { class: "nav-item danger", onclick: () => { if (confirm("Log out of the Content Manager?")) logout(); } },
          el("span", { class: "ic" }, "\u{1F511}"), el("span", {}, "Log Out")));
      }

