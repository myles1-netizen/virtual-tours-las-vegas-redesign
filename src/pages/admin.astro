      async function loadMediaGrid(grid, folderFilter, query) {
        clear(grid);
        grid.appendChild(el("div", { class: "empty", style: { gridColumn: "1/-1" } }, el("div", { class: "spinner", style: { margin: "0 auto" } })));
        try {
          const folders = folderFilter ? [folderFilter] : MEDIA_FOLDERS;
          const files = [];
          for (const f of folders) {
            try {
              const ls = await listDir(`public/images/${f}`);
              for (const item of ls) {
                if (item.type === "file" && IMG_EXT.test(item.name)) {
                  files.push({ ...item, folder: f, path: `/images/${f}/${item.name}` });
                }
              }
            } catch { /* folder may be empty */ }
          }
          const filtered = query ? files.filter((x) => x.name.toLowerCase().includes(query)) : files;
          clear(grid);
          if (!filtered.length) {
            grid.appendChild(el("div", { class: "empty", style: { gridColumn: "1/-1" } },
              el("div", { class: "ic" }, "\u{1F5BC}\uFE0F"),
              query ? "No images match your search." : "No images in this folder yet. Upload with \u201cAdd Media File\u201d."));
            return;
          }
          filtered.forEach((img) => {
            const tile = el("div", { class: "ptile" },
              el("img", { src: BASE.replace(/\/$/, "") + img.path, alt: img.name, loading: "lazy", style: "background:#eee", onerror: "this.style.background='#eee';this.removeAttribute('src')" }),
              el("div", { class: "pacts" },
                el("button", { class: "btn btn-icon", title: "Edit alt / details", onclick: () => mediaDetailsModal(img) }, "\u270E"),
                el("button", { class: "btn btn-icon", title: "Delete file", onclick: () => mediaDelete(img) }, "\u{1F5D1}"),
              ),
              el("div", { class: "meta" },
                el("b", {}, esc(img.name)),
                el("small", {}, `${img.folder}/ \u00b7 ${(img.size / 1024).toFixed(1)} KB`)),
            );
            grid.appendChild(tile);
          });
        } catch (e) {
          clear(grid);
          grid.appendChild(renderErrorCard(e, () => loadMediaGrid(grid, folderFilter, query)));
        }
      }

