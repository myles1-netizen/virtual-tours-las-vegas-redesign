            toast("Page created! Edit the content, then add it to the site navigation.", "success", "New page ready");
            closeModal();
            // Load it in the editor
            setTimeout(() => loadPageContent(slug), 200);
          } catch (e) {
            hideLoading();
            toast(e.message, "error", "Could not create page");
