          el("pre", { style: { background: "#fbe5e2", color: "#c0392b", padding: "12px", borderRadius: "6px", overflow: "auto", fontSize: "12.5px", whiteSpace: "pre-wrap" } }, esc(e.message || String(e))),
          el("div", { style: { marginTop: "14px" } }, el("button", { class: "btn", onclick: retry || (() => location.reload()) }, "Try again")),
        );
