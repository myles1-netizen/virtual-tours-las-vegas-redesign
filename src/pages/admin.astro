        const tb = el("tbody", {});
        const redraw = () => {
          clear(tb);
          rows.forEach((row, idx) => {
            const tds = cols.map((c) => {
              const inp = el("input", { type: c.type || "text", placeholder: c.ph || "", value: row[c.k] == null ? "" : row[c.k] });
