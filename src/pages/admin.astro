            "3d-tours": "3D & Virtual Tours", "as-built": "As-Built & Construction Docs", commercial: "Commercial",
            "drone-photography": "Drone Photography", "floor-plans": "Floor Plans", "google-business-view": "Google Business View",
            "hdr-photography": "HDR Photography", "photo-packages": "Photo Packages", residential: "Residential",
            "twilight-photography": "Twilight Photography", "vacation-rentals": "Vacation Rentals", "virtual-staging": "Virtual Staging",
          };
          var h = "";
          slugs.forEach(function (file) {
            var s = files[file];
            var slug = file.replace("services/", "").replace(".json", "");
            var label = labels[slug] || slug;
            h += '<div class="item"><div class="item-head"><span class="item-title">' + esc(label) + '</span>' +
              '<button type="button" class="btn btn-primary btn-sm" data-download="' + esc(file) + '">Download ' + esc(file.split("/")[1]) + '</button></div>';
            h += textField(file, "title", "SEO title (≤60 chars)", s.title, { charLimit: 60 });
            h += textareaField(file, "description", "Meta description (≤160 chars)", s.description, { charLimit: 160, rows: 2 });
            h += '<div class="grid2">';
