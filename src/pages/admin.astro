          h += itemField("sizeNote", "Size note", item.sizeNote);
          h += '<div class="field"><label>Includes (one per line)</label><textarea data-item-field="includes" data-list="true" rows="4">' + esc((item.includes || []).join("\n")) + '</textarea></div>';
