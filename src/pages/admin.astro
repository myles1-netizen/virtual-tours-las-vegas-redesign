      async function loadBackupFileList(node) {
        clear(node);
        const files = ["settings.json", "pricing.json", "testimonials.json", "faq.json", "portfolio.json", "integrations.json", "redirects.json"];
        const ul = el("ul", { class: "at-glance", style: { borderTop: "1px solid var(--line)" } });
        for (const f of files) {
          let ok = false, size = "—";
          try {
            const data = await readFile(`${CMS_DIR}/${f}`);
            ok = true;
            size = (data.content.length / 1024).toFixed(1) + " KB";
          } catch { /* missing */ }
          ul.appendChild(el("li", {},
            el("span", { class: "ag-ic", style: { background: ok ? "var(--green-soft)" : "var(--red-soft)", color: ok ? "var(--green)" : "var(--red)" } }, ok ? "\u2713" : "!"),
            el("span", { class: "ag-text" }, el("b", {}, f), el("small", {}, ok ? size : "not present"))));
