      // A simple repeater of string rows. onChange fires with the current array.
      function stringRepeater(items, opts) {
        opts = opts || {};
        const wrap = el("div", { class: "repeater" });
        const placeholder = opts.placeholder || "";
        const addLabel = opts.addLabel || "+ Add row";
        const render = () => {
          clear(wrap);
          items.forEach((val, idx) => {
            const inp = el("input", { value: val, placeholder });
            inp.addEventListener("input", () => { items[idx] = inp.value; opts.onChange(items.slice()); });
            wrap.appendChild(el("div", { class: "rep-row" }, inp,
              el("button", { class: "btn btn-icon", title: "Remove", onclick: (e) => { e.preventDefault(); items.splice(idx, 1); render(); opts.onChange(items.slice()); } }, "\u2212"),
            ));
          });
          wrap.appendChild(el("button", { class: "btn btn-ghost btn-sm rep-add", onclick: (e) => { e.preventDefault(); items.push(""); render(); opts.onChange(items.slice()); } }, addLabel));
        };
        render();
        return wrap;
      }

