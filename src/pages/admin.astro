        ));
        container.appendChild(el("div", { style: { display: "flex", justifyContent: "flex-end" } },
          el("button", { class: "btn", onclick: () => saveSEO(path, model, seoPath) }, "Save This Page"),
        ));
      }

      function seoFileName(path) {
        return (path === "/" ? "home" : path.replace(/^\/|\/$/g, "").replace(/\//g, "-")) || "home";
      }

      function setMeter(node, len, target) {
        const ratio = len / target;
        const color = len === 0 ? "var(--muted)" : ratio > 1.15 ? "var(--red)" : ratio > 0.95 ? "var(--amber)" : "var(--green)";
        const label = len === 0 ? "empty" : ratio > 1.15 ? "too long" : ratio > 0.95 ? "good length" : len < target * 0.5 ? "short" : "good";
        node.innerHTML = `<span>${len} / ${target}</span><span class="bar"><i style="width:${Math.min(100, ratio * 100)}%;background:${color}"></i></span><span style="color:${color}">${label}</span>`;
      }

      async function saveSEO(path, model, seoPath) {
        showLoading("Saving SEO\u2026");
        try {
          const content = JSON.stringify(model, null, 2) + "\n";
          await writeFile(seoPath, content, `Update SEO for ${path}`);
          hideLoading();
          toast("SEO saved! Site rebuilds in ~90 seconds.", "success", "Saved");
        } catch (e) { hideLoading(); toast(e.message, "error", "Save failed"); }
      }

      // ============================================================
      //  SECTION: Appearance
      // ============================================================
      async function renderAppearance() {
        const main = $("#main");
        clear(main);
        main.appendChild(el("div", { class: "page-head" },
          el("div", {}, el("h1", {}, "Appearance"), el("p", {}, "CMS-only display preferences. Site theme is set in code.")),
        ));
        const card = sectionCard("Display", "These affect this Content Manager only.", []);
        const theme = localStorage[LS.theme] || "light";
        const stateSpan = el("b", { id: "theme-state" }, theme === "dark" ? "Dark" : "Light");
        const tg = el("button", { class: "btn btn-ghost", onclick: () => {
          const next = (localStorage[LS.theme] || "light") === "light" ? "dark" : "light";
          localStorage[LS.theme] = next;
          applyCmsTheme(next);
          stateSpan.textContent = next === "dark" ? "Dark" : "Light";
        } }, "\u{1F313} Toggle CMS Theme");
        card.appendChild(el("div", { class: "form-grid" },
          wrapField("Manager Theme", el("div", {}, tg, el("div", { style: { marginTop: "8px", color: "var(--muted)", fontSize: "13px" } }, "Current: ", stateSpan)), null, "Switches this admin panel between light and dark."),
        ));

        card.appendChild(el("hr"));
        card.appendChild(el("h2", {}, "Site Identity"));
        card.appendChild(el("p", { class: "sub" }, "The live site uses a fixed brass-on-cream theme. Logo and colors are managed in code; ask your developer to change them."));
        card.appendChild(el("div", { class: "form-grid" },
          wrapField("Color Scheme", el("div", { style: { display: "flex", gap: "8px", alignItems: "center", padding: "10px", border: "1px solid var(--line)", borderRadius: "6px" } },
            swatch("#1a1814", "Sidebar"), swatch("#f7f4ef", "Canvas"), swatch("#b08d57", "Brass"),
          ), "full"),
          wrapField("Header Style", (() => { const s = el("select", { style: { minHeight: "48px", padding: "10px 12px", fontSize: "15px", border: "1px solid var(--line-strong)", borderRadius: "6px" }, disabled: "" }); s.appendChild(el("option", {}, "Sticky brass bar (current)")); return s; })(), "full", "Header style is fixed in the layout. Contact your developer to change it."),
        ));

        main.appendChild(card);
      }

      function swatch(color, label) {
        return el("div", { style: { display: "flex", alignItems: "center", gap: "6px", fontSize: "12px", color: "var(--ink-soft)" } },
          el("span", { style: { width: "20px", height: "20px", borderRadius: "4px", background: color, border: "1px solid rgba(0,0,0,.1)" } }),
          label);
      }

      function applyCmsTheme(theme) {
        let style = document.getElementById("cms-dark");
        if (theme === "dark") {
          if (!style) {
            style = document.createElement("style");
            style.id = "cms-dark";
            style.textContent = "body{background:#15130f;color:#e8e2d6}.card,.tile,.stat,.modal,.faq-item,.serp,.ptile{background:#211e18;border-color:#3a342c;color:#e8e2d6}.card .sub,.tile .meta small,.muted,.ptile .meta small{color:#9a9080}.field input,.field select,.field textarea,.tags,.rep-row input,.tbl input{background:#15130f;border-color:#3a342c;color:#e8e2d6}.btn-ghost{background:transparent;color:#e8e2d6;border-color:#3a342c}.tile .foot,.modal .mfoot{background:#1a1814}.serp .t{color:#8ab4f8}.serp .d{color:#bdc1c6}.serp .u{color:#aab}.tbl th{color:#9a9080}.md-preview{background:#15130f;border-color:#3a342c}.btn-icon{background:#211e18;color:#e8e2d6;border-color:#3a342c}.btn-icon:hover{background:#2a2620}";
            document.head.appendChild(style);
          }
        } else if (style) { style.remove(); }
      }

      // ============================================================
      //  SECTION: Integrations
      // ============================================================
      async function renderIntegrations() {
        const main = $("#main");
        clear(main);
        main.appendChild(el("div", { class: "page-head" },
          el("div", {}, el("h1", {}, "Integrations"), el("p", {}, "Third-party IDs and links. Saved to integrations.json.")),
        ));
        const card = el("div", { class: "card" }, el("div", { class: "empty" }, el("div", { class: "spinner", style: { margin: "0 auto" } })));
        main.appendChild(card);

        let data;
        try {
          const f = await readFile(`${CMS_DIR}/integrations.json`);
          data = JSON.parse(f.content);
        } catch {
          data = {
            googleAnalyticsId: "", paypalLink: "", googleCalendarEmbed: "", matterportDefaultId: "",
            youtubeChannel: "", googleBusinessProfile: "", social: {},
          };
        }

        clear(card);
        card.appendChild(el("h2", {}, "Tracking & Payments"));
        card.appendChild(el("p", { class: "sub" }, "Used by the site footer, booking flow and analytics."));
        card.appendChild(el("hr"));

        const mkInput = (key, ph) => { const i = el("input", { type: "text", value: data[key] || "", placeholder: ph }); i.addEventListener("input", () => { data[key] = i.value; }); return i; };
        const fg = el("div", { class: "form-grid" });
        fg.appendChild(wrapField("Google Analytics ID", mkInput("googleAnalyticsId", "G-XXXXXXX"), "full"));
        fg.appendChild(wrapField("PayPal Link", mkInput("paypalLink", "https://paypal.me/..."), "full"));
        fg.appendChild(wrapField("Google Calendar Embed URL", mkInput("googleCalendarEmbed", "https://calendar.google.com/..."), "full"));
        fg.appendChild(wrapField("Matterport Default Model ID", mkInput("matterportDefaultId", "SxL3C8ha5hb")));
        fg.appendChild(wrapField("YouTube Channel URL", mkInput("youtubeChannel", "https://youtube.com/@...")));
        fg.appendChild(wrapField("Google Business Profile", mkInput("googleBusinessProfile", "https://business.google.com/..."), "full"));
        card.appendChild(fg);

        card.appendChild(el("hr"));
        card.appendChild(el("h2", {}, "Social Media"));
        card.appendChild(el("p", { class: "sub" }, "Also editable from the Settings section."));
        data.social = data.social || {};
        const sg = el("div", { class: "form-grid" });
        for (const [k, label] of [["facebook", "Facebook"], ["instagram", "Instagram"], ["youtube", "YouTube"], ["twitter", "X / Twitter"], ["linkedin", "LinkedIn"], ["yelp", "Yelp"]]) {
          const i = el("input", { type: "url", value: data.social[k] || "", placeholder: `https://${k}.com/...` });
          i.addEventListener("input", () => { data.social[k] = i.value; });
          sg.appendChild(wrapField(label, i));
        }
        card.appendChild(sg);

        card.appendChild(el("hr"));
        card.appendChild(el("div", { style: { display: "flex", justifyContent: "flex-end" } },
          el("button", { class: "btn btn-lg", onclick: () => saveIntegrations(data) }, "Save Changes"),
        ));
      }

      async function saveIntegrations(data) {
        showLoading("Saving integrations\u2026");
        try {
          const content = JSON.stringify(data, null, 2) + "\n";
          await writeFile(`${CMS_DIR}/integrations.json`, content, "Update integrations");
          hideLoading();
          toast("Integrations saved! Site rebuilds in ~90 seconds.", "success", "Saved");
        } catch (e) { hideLoading(); toast(e.message, "error", "Save failed"); }
      }

      // ============================================================
      //  Card builder + Modal helpers
      // ============================================================
      function sectionCard(title, subtitle, contentNodes) {
        const card = el("div", { class: "card" });
        card.appendChild(el("div", { style: { display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: "16px", flexWrap: "wrap" } },
          el("div", {}, el("h2", {}, title), subtitle ? el("p", { class: "sub", style: { marginBottom: "0" } }, subtitle) : null),
        ));
        if (contentNodes && contentNodes.length) card.appendChild(el("hr"));
        for (const n of contentNodes) card.appendChild(n);
        return card;
      }

      function openModal(title, bodyNode, footerNodes, size) {
        const modal = $("#modal");
        if (size === "lg") modal.classList.add("lg"); else modal.classList.remove("lg");
        clear(modal);
        modal.appendChild(el("div", { class: "mhead" }, el("h2", {}, title), el("button", { class: "x", onclick: closeModal }, "\u00d7")));
        modal.appendChild(el("div", { class: "mbody" }, bodyNode));
        modal.appendChild(el("div", { class: "mfoot" }, ...(footerNodes.filter(Boolean))));
        $("#overlay").classList.add("show");
      }
      function openModalLoading(title) {
        const modal = $("#modal");
        clear(modal);
        modal.appendChild(el("div", { class: "mhead" }, el("h2", {}, title), el("button", { class: "x", onclick: closeModal }, "\u00d7")));
        modal.appendChild(el("div", { class: "mbody" }, el("div", { class: "empty" }, el("div", { class: "spinner", style: { margin: "0 auto" } }))));
        $("#overlay").classList.add("show");
      }
      function closeModal() { $("#overlay").classList.remove("show"); }

      // ============================================================
      //  Dirty tracking + global Save bar
      //  Tracks which in-memory models have unsaved edits. The top-bar
      //  Save button writes every dirty model back to GitHub in one pass.
      // ============================================================
      const SAVE_HANDLERS = {
        settings: () => models.settings && saveSettings(models.settings),
        pricing: () => models.pricing && savePricing(models.pricing),
      };
      const dirty = new Set();

      function markDirty(key) {
        if (SAVE_HANDLERS[key]) { dirty.add(key); updateSaveBar(); }
      }
      function markClean(key) { dirty.delete(key); updateSaveBar(); }
      function updateSaveBar() {
        const btn = $("#save-btn");
        const state = $("#save-state");
        const has = dirty.size > 0;
        btn.disabled = !has;
        if (has) { state.textContent = `Unsaved changes (${dirty.size})`; state.classList.add("dirty"); }
        else { state.textContent = "All changes saved"; state.classList.remove("dirty"); }
      }

      // ============================================================
      //  Shared list helpers
      // ============================================================
      function moveItem(arr, index, dir, after) {
        const j = index + dir;
        if (j < 0 || j >= arr.length) return;
        const tmp = arr[index]; arr[index] = arr[j]; arr[j] = tmp;
        after();
      }

      // ============================================================
      //  Wire up login + menu + boot
      // ============================================================
      $("#login-form").addEventListener("submit", (e) => {
        e.preventDefault();
        const tok = $("#li-token").value.trim();
        const pass = $("#li-pass").value;
        const remember = $("#li-remember").checked;
        if (!tok || !pass) return;
        attemptLogin(tok, pass, remember);
      });

      $("#menu-toggle").addEventListener("click", () => {
        const sb = $("#sidebar");
        const open = sb.classList.toggle("open");
        $("#sb-backdrop").style.display = open ? "block" : "none";
      });
      $("#sb-backdrop").addEventListener("click", () => {
        $("#sidebar").classList.remove("open");
        $("#sb-backdrop").style.display = "none";
      });

      $("#save-btn").addEventListener("click", async () => {
        if (!dirty.size) return;
        for (const key of Array.from(dirty)) {
          const h = SAVE_HANDLERS[key];
          if (h) await h();
        }
      });

      $("#overlay").addEventListener("click", (e) => { if (e.target.id === "overlay") closeModal(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

      // Restore remembered token into the form for convenience.
      (function prefill() {
        const rememberedToken = localStorage[LS.token];
        if (rememberedToken) {
          $("#li-token").value = rememberedToken;
          $("#li-remember").checked = true;
          $("#li-pass").focus();
        }
      })();

      // Apply saved CMS theme.
      applyCmsTheme(localStorage[LS.theme] || "light");

      // Auto-login if session/localStorage still holds a token.
      if (isLoggedIn()) {
        verifyToken(token())
          .then(() => enterApp())
          .catch(() => {
            sessionStorage.removeItem(LS.token); localStorage.removeItem(LS.token);
          });
      }
    </script>
  </body>
</html>
