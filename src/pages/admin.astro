            h += '<span class="save-status" data-status="' + esc(file) + '"></span>';
            h += "</div>";
          });
          document.getElementById("services-form").innerHTML = h;
          wireCharCounters(document.getElementById("services-form"));
        }
        // Live character counters: update on input.
        function wireCharCounters(root) {
          root.querySelectorAll("[data-char-limit]").forEach(function (cc) {
            var limit = parseInt(cc.dataset.charLimit, 10);
            var field = cc.closest(".field");
            var input = field ? field.querySelector("input, textarea") : null;
            if (input) {
              input.addEventListener("input", function () {
                var len = input.value.length;
                cc.textContent = len + " / " + limit;
                cc.classList.toggle("over", len > limit);
              });
            }
          });
        }

        // ===== G. Blog =====
        function buildBlogList() {
          var list = document.getElementById("blog-list");
          if (!blogPosts.length) { list.innerHTML = '<p class="muted">No posts yet. Create one above.</p>'; return; }
          var h = "";
          blogPosts.forEach(function (p) {
            h += '<div class="item"><div class="item-head"><span class="item-title">' + esc(p.title) + (p.draft ? ' <span class="tag">draft</span>' : "") + '</span><div class="item-tools">' +
              '<button type="button" data-edit-post="' + esc(p.slug) + '">Edit</button>' +
              '<button type="button" data-toggle-draft="' + esc(p.slug) + '">' + (p.draft ? "Publish" : "Unpublish") + '</button>' +
              '<button type="button" data-del-post="' + esc(p.slug) + '" class="danger">Delete</button></div></div>';
            h += '<p class="muted" style="font-size:0.82rem;margin:0">' + esc(p.publishDate) + " · " + esc(p.category) + " · " + esc(p.description) + "</p>";
            h += "</div>";
          });
          list.innerHTML = h;
        }
        document.addEventListener("click", function (e) {
          var editBtn = e.target.closest("[data-edit-post]");
          var toggleBtn = e.target.closest("[data-toggle-draft]");
          var delBtn = e.target.closest("[data-del-post]");
          if (editBtn) {
            var slug = editBtn.dataset.editPost;
            var p = blogPosts.find(function (b) { return b.slug === slug; });
            if (p) openPostEditor(p);
          }
          if (toggleBtn) {
            var slug2 = toggleBtn.dataset.toggleDraft;
            var p2 = blogPosts.find(function (b) { return b.slug === slug2; });
            if (p2) {
              p2.draft = !p2.draft;
              openPostEditor(p2);
            }
          }
          if (delBtn) {
            var slug3 = delBtn.dataset.delPost;
            if (confirm("Delete '" + slug3 + "'? This downloads a delete instruction file for your son — the original post isn't removed until he applies it.")) {
              download("DELETE-" + slug3 + ".md", "# This file tells your son to DELETE the post: src/content/blog/" + slug3 + ".md\n", "text/markdown;charset=utf-8");
              showToast("Downloaded delete instruction for " + slug3);
            }
          }
        });
        function openPostEditor(p) {
          var overlay = document.createElement("div");
          overlay.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:500;display:flex;align-items:center;justify-content:center;padding:1.5rem;";
          var box = document.createElement("div");
          box.style.cssText = "background:var(--card);border:1px solid var(--line);border-radius:12px;padding:1.4rem;max-width:760px;width:100%;max-height:90vh;overflow:auto;";
          box.innerHTML =
            '<h2 style="margin:0 0 1rem;font-size:1.1rem">Edit post: ' + esc(p.slug) + '</h2>' +
            '<div class="field"><label>Title</label><input id="pe-title" type="text" value="' + esc(p.title) + '" /></div>' +
            '<div class="grid2"><div class="field"><label>Description</label><input id="pe-desc" type="text" value="' + esc(p.description) + '" /></div>' +
            '<div class="field"><label>Category</label><input id="pe-cat" type="text" value="' + esc(p.category) + '" /></div></div>' +
            '<div class="grid2"><div class="field"><label>Publish date</label><input id="pe-date" type="date" value="' + esc(p.publishDate) + '" /></div>' +
            '<div class="field"><label>Author</label><input id="pe-author" type="text" value="' + esc(p.author) + '" /></div></div>' +
            '<div class="grid2"><div class="field"><label>Hero image</label><input id="pe-hero" type="text" value="' + esc(p.heroImage) + '" /></div>' +
            '<div class="field"><label>Hero alt text</label><input id="pe-heroalt" type="text" value="' + esc(p.heroAlt) + '" /></div></div>' +
            '<div class="field"><label>Draft?</label><select id="pe-draft"><option value="true"' + (p.draft ? " selected" : "") + '>Yes — hide</option><option value="false"' + (!p.draft ? " selected" : "") + '>No — publish</option></select></div>' +
            '<div class="field"><label>Body (Markdown)</label><textarea id="pe-body" rows="12">' + esc(p.body || "") + '</textarea></div>' +
            '<div class="btn-row"><button class="btn btn-primary" id="pe-save">Download updated .md</button><button class="btn btn-ghost" id="pe-close">Close</button></div>';
          overlay.appendChild(box);
          document.body.appendChild(overlay);
          overlay.querySelector("#pe-close").onclick = function () { document.body.removeChild(overlay); };
          overlay.addEventListener("click", function (ev) { if (ev.target === overlay) document.body.removeChild(overlay); });
          overlay.querySelector("#pe-save").onclick = function () {
            var front = [
              "---",
              'title: ' + jsonStr(overlay.querySelector("#pe-title").value),
              'description: ' + jsonStr(overlay.querySelector("#pe-desc").value),
              "publishDate: " + overlay.querySelector("#pe-date").value,
              'author: ' + jsonStr(overlay.querySelector("#pe-author").value),
              'category: ' + jsonStr(overlay.querySelector("#pe-cat").value),
              "draft: " + overlay.querySelector("#pe-draft").value,
              'heroImage: ' + jsonStr(overlay.querySelector("#pe-hero").value),
              'heroAlt: ' + jsonStr(overlay.querySelector("#pe-heroalt").value),
              "---",
              "",
            ].join("\n");
            var body = overlay.querySelector("#pe-body").value;
            download(p.slug + ".md", front + body + "\n", "text/markdown;charset=utf-8");
            showToast("Downloaded " + p.slug + ".md");
          };
        }
        function jsonStr(s) { return JSON.stringify(s); }
        document.getElementById("create-post").addEventListener("click", function () {
          var title = document.getElementById("new-post-title").value.trim();
          var desc = document.getElementById("new-post-desc").value.trim();
          var cat = document.getElementById("new-post-category").value;
          var date = document.getElementById("new-post-date").value || new Date().toISOString().slice(0, 10);
          var draft = document.getElementById("new-post-draft").value === "true";
          var body = document.getElementById("new-post-body").value;
          if (!title) { showToast("Add a title first."); return; }
          var slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60);
          var front = [
            "---",
            'title: ' + jsonStr(title),
            'description: ' + jsonStr(desc || title),
            "publishDate: " + date,
            'author: "Mike Madsen"',
            'category: ' + jsonStr(cat),
            "draft: " + draft,
            'heroImage: "/images/portfolio/sierra-skye-living.jpg"',
            'heroAlt: "Las Vegas real estate photography"',
            "---",
            "",
          ].join("\n");
          download(slug + ".md", front + body + "\n", "text/markdown;charset=utf-8");
          showToast("Downloaded " + slug + ".md — drop into src/content/blog/");
        });

        // ===== H. SEO =====
        var seoEdits = {}; // path -> {title, description}
        function buildSeoList() {
          var list = document.getElementById("seo-list");
          var h = "";
          reference.seo.forEach(function (p) {
            var titleNow = seoEdits[p.path] ? seoEdits[p.path].title : p.title;
            var descNow = seoEdits[p.path] ? seoEdits[p.path].description : p.description;
            h += '<div class="item" data-seo-path="' + esc(p.path) + '">';
            h += '<div class="item-head"><span class="item-title mono">' + esc(p.path) + (p.noindex ? ' <span class="tag">noindex</span>' : "") + '</span><span class="muted" style="font-size:0.74rem">schema: ' + esc(p.schema) + '</span></div>';
            h += '<div class="serp"><div class="url">' + esc(("virtualtourslasvegas.com" + (p.path === "/" ? "/" : p.path)).replace(/\/$/, "")) + '</div>';
            h += '<div class="title" data-serp-title>' + esc(titleNow) + '</div>';
            h += '<div class="desc" data-serp-desc>' + esc(descNow) + '</div></div>';
            h += '<div class="field" style="margin-top:0.8rem"><label>Title (≤60)</label><input data-seo-field="title" type="text" value="' + esc(titleNow) + '" />' + charCount(titleNow, 60) + "</div>";
            h += '<div class="field"><label>Description (≤160)</label><textarea data-seo-field="description" rows="2">' + esc(descNow) + '</textarea>' + charCount(descNow, 160) + "</div>";
            h += "</div>";
          });
          list.innerHTML = h;
          wireSeoLive();
        }
        function wireSeoLive() {
          document.querySelectorAll("[data-seo-path]").forEach(function (item) {
            var path = item.dataset.seoPath;
            var titleInput = item.querySelector('[data-seo-field="title"]');
            var descInput = item.querySelector('[data-seo-field="description"]');
            var serpTitle = item.querySelector("[data-serp-title]");
            var serpDesc = item.querySelector("[data-serp-desc]");
            var tcc = titleInput.closest(".field").querySelector(".char-count");
            var dcc = descInput.closest(".field").querySelector(".char-count");
            function upd() {
              var t = titleInput.value, d = descInput.value;
              serpTitle.textContent = t; serpDesc.textContent = d;
              tcc.textContent = t.length + " / 60"; tcc.classList.toggle("over", t.length > 60);
              dcc.textContent = d.length + " / 160"; dcc.classList.toggle("over", d.length > 160);
              if (t !== originalSeo(path).title || d !== originalSeo(path).description) {
                seoEdits[path] = { title: t, description: d };
              } else {
                delete seoEdits[path];
              }
            }
            titleInput.addEventListener("input", upd); descInput.addEventListener("input", upd);
          });
        }
        function originalSeo(path) {
          var e = reference.seo.find(function (s) { return s.path === path; });
          return e ? { title: e.title, description: e.description } : { title: "", description: "" };
        }
        function collectSeoEdits() {
          var out = { _note: "Apply these title/description edits to src/data/seo-catalog.ts AND the matching page frontmatter. Generated by the admin SEO panel.", edits: [] };
          Object.keys(seoEdits).forEach(function (path) {
            out.edits.push({ path: path, title: seoEdits[path].title, description: seoEdits[path].description });
          });
          if (!out.edits.length) out._note += " (No changes were made — this is the current catalog.)";
          return out;
        }
        function buildKeywordGroups() {
          var h = "";
          reference.keywordGroups.forEach(function (g) {
            h += "<h3>" + esc(g.label) + " <span class='muted' style='font-weight:400;text-transform:none;letter-spacing:0'>(" + g.terms.length + ")</span></h3>";
            h += '<p class="muted" style="font-size:0.82rem;margin:-0.3rem 0 0.6rem">' + esc(g.note) + "</p>";
            h += '<div class="chips">' + g.terms.map(function (t) { return '<span class="chip">' + esc(t) + "</span>"; }).join("") + "</div>";
          });
          document.getElementById("keyword-groups").innerHTML = h;
        }

        // ===== I. Redirects =====
        function buildRedirectsTable() {
          var tb = document.getElementById("redirects-tbody");
          var h = "";
          reference.redirects.forEach(function (r) {
            h += "<tr><td><code>" + esc(r.from) + "</code></td><td><code>" + esc(r.to) + "</code></td></tr>";
          });
          tb.innerHTML = h;
        }
        document.getElementById("add-redirect").addEventListener("click", function () {
          var from = document.getElementById("new-redir-from").value.trim();
          var to = document.getElementById("new-redir-to").value.trim();
          if (!from || !to) { showToast("Fill in both URLs."); return; }
          // Strip leading slash + trailing for the `from` form expected by redirects.ts.
          var fromNorm = from.replace(/^\/+|\/+$/g, "").replace(/\/index$/, "") || "index";
          var existing = reference.redirects.map(function (r) {
            return { from: r.from.replace(/^\//, "").replace(/\/$/, ""), to: r.to };
          });
          existing.push({ from: fromNorm + "/index", to: to });
          var payload = {
            _note: "Merge these redirects into src/data/redirects.ts and run `npm run gen:redirects`. Each `from` is without leading slash and should end in '/index'.",
            redirects: existing.map(function (r) { return { from: r.from, to: r.to }; }),
          };
          download("redirects.json", prettyJson(payload));
          showToast("Downloaded redirects.json with your new redirect.");
        });

        // ===== J. Integrations =====
        function buildIntegrations() {
          var i = files["integrations.json"];
          var h = "";
          h += "<h3>Formsubmit (contact form)</h3>";
          h += textField("integrations.json", "formsubmitEmail", "Email that receives form submissions", i.formsubmitEmail, { hint: "First submission triggers a one-time confirmation email from Formsubmit." });
          h += "<h3>Google Analytics 4</h3>";
          h += textField("integrations.json", "ga4MeasurementId", "GA4 Measurement ID (G-XXXXXXXXXX)", i.ga4MeasurementId, { hint: "Your son sets this as the GA4_MEASUREMENT_ID env var." });
          h += "<h3>PayPal</h3>";
          h += textField("integrations.json", "paypalLink", "PayPal.me link or button HTML", i.paypalLink);
          h += "<h3>Google Calendar</h3>";
          h += textareaField("integrations.json", "googleCalendarEmbedUrl", "Calendar embed URL (the iframe src)", i.googleCalendarEmbedUrl, { hint: "From Google Calendar → Settings → Integrate calendar → Embed code." });
          h += "<h3>Matterport</h3>";
          h += textField("integrations.json", "defaultMatterportId", "Default Matterport model ID", i.defaultMatterportId);
          h += "<h3>YouTube</h3>";
          h += textField("integrations.json", "youtubeChannelUrl", "YouTube channel URL", i.youtubeChannelUrl);
          h += textareaField("integrations.json", "youtubeEmbedCode", "Featured video embed code (optional)", i.youtubeEmbedCode, { rows: 2 });
          h += "<h3>Google Business Profile</h3>";
          h += textField("integrations.json", "googleBusinessProfileUrl", "Google Business Profile URL", i.googleBusinessProfileUrl);
          document.getElementById("integrations-form").innerHTML = h;
        }
        document.getElementById("test-formsubmit").addEventListener("click", function () {
          var email = (collectAll()["integrations.json"] || {}).formsubmitEmail;
          var statusEl = document.getElementById("formsubmit-test-status");
          statusEl.textContent = "Sending test…"; statusEl.style.color = "var(--muted)";
          fetch("https://formsubmit.co/ajax/" + encodeURIComponent(email), {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ name: "VTLV Admin", _subject: "Admin panel test submission", message: "This is a test from the admin Integrations panel. If you see this, Formsubmit is working.", _template: "table" }),
          }).then(function (r) {
            if (r.ok) { statusEl.textContent = "Test sent — check " + email + " (first send may need a one-time confirmation)."; statusEl.style.color = "var(--ok)"; }
            else { statusEl.textContent = "Formsubmit returned an error. Check the email address."; statusEl.style.color = "var(--danger)"; }
          }).catch(function () {
            statusEl.textContent = "Couldn't reach Formsubmit (network/CORS). This is expected on some networks; the live form still works.";
            statusEl.style.color = "var(--warn)";
          });
        });

        // ===== K. Backup / Restore =====
        // Minimal STORE-method (no compression) ZIP — pure JS, no deps.
        function crc32Table() {
          var t = new Uint32Array(256);
          for (var n = 0; n < 256; n++) {
            var c = n;
            for (var k = 0; k < 8; k++) c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
            t[n] = c >>> 0;
          }
          return t;
        }
        var CRC_TABLE = crc32Table();
        function crc32(bytes) {
          var c = 0xffffffff;
          for (var i = 0; i < bytes.length; i++) c = CRC_TABLE[(c ^ bytes[i]) & 0xff] ^ (c >>> 8);
          return (c ^ 0xffffffff) >>> 0;
        }
        function strBytes(s) { return new TextEncoder().encode(s); }
        function u16(n) { return String.fromCharCode(n & 0xff, (n >>> 8) & 0xff); }
        function u32(n) { return String.fromCharCode((n & 0xff), (n >>> 8) & 0xff, (n >>> 16) & 0xff, (n >>> 24) & 0xff); }
        function makeZip(fileList) {
          // STORE-method ZIP (no compression), pure JS, no deps. Emits one local
          // file header + data per entry, a central directory, and an EOCD record.
          // All offsets are computed in BYTES (UTF-8) so multi-byte filenames and
          // content lengths match what the spec expects.
          var chunks = [];
          var centralParts = [];
          var offset = 0;
          fileList.forEach(function (f) {
            var dataBytes = strBytes(f.text);
            var nameBytes = strBytes(f.name);
            var crc = crc32(dataBytes);
            var size = dataBytes.length;
            var namelen = nameBytes.length;
            // Local file header (signature 0x04034b50), version 2.0, no flags.
            var localHeader =
              "\x50\x4b\x03\x04" + u16(20) + u16(0) + u16(0) + u16(0) +
              u32(crc) + u32(size) + u32(size) + u16(namelen) + u16(0) + f.name;
            chunks.push(strBytes(localHeader));
            chunks.push(dataBytes);
            // Central directory header (signature 0x02014b50).
            var centralHeader =
              "\x50\x4b\x01\x02" + u16(20) + u16(20) + u16(0) + u16(0) + u16(0) +
              u32(crc) + u32(size) + u32(size) + u16(namelen) + u16(0) + u16(0) + u16(0) + u16(0) + u16(0) + u32(0) + u32(offset) + f.name;
            centralParts.push(centralHeader);
            offset += strBytes(localHeader).length + size;
          });
          var centralAll = centralParts.join("");
          var cdSize = strBytes(centralAll).length;
          // End of central directory record (signature 0x06054b50).
          var eocd = "\x50\x4b\x05\x06" + u16(0) + u16(0) + u16(fileList.length) + u16(fileList.length) +
            u32(cdSize) + u32(offset) + u16(0);
          chunks.push(strBytes(centralAll));
          chunks.push(strBytes(eocd));
          var total = 0; chunks.forEach(function (c) { total += c.length; });
          var out = new Uint8Array(total);
          var pos = 0;
          chunks.forEach(function (c) { out.set(c, pos); pos += c.length; });
          return new Blob([out], { type: "application/zip" });
        }
        document.getElementById("download-all-zip").addEventListener("click", function () {
          var all = collectAll();
          var fileList = Object.keys(all).filter(function (k) { return k !== "seo-edits.json"; }).map(function (k) {
            return { name: k, text: prettyJson(all[k]) };
          });
          fileList.push({ name: "README.txt", text: "Virtual Tours Las Vegas — content backup\nDownloaded " + new Date().toISOString() + "\n\nEach JSON file goes into src/data/cms/ (services into src/data/cms/services/).\nDrop them into the GitHub repo (or email to your son) and the site rebuilds.\n" });
          var blob = makeZip(fileList);
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url; a.download = "vtlv-content-backup-" + new Date().toISOString().slice(0, 10) + ".zip";
          document.body.appendChild(a); a.click(); document.body.removeChild(a);
          setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
          showToast("Downloaded content backup (.zip)");
        });
        document.getElementById("download-all-json").addEventListener("click", function () {
          var all = collectAll();
          var bundle = { _note: "VTLV content bundle. Each key is a file path under src/data/cms/.", generated: new Date().toISOString(), files: all };
          download("vtlv-content-backup-" + new Date().toISOString().slice(0, 10) + ".json", prettyJson(bundle));
          showToast("Downloaded content bundle (.json)");
        });

        // Upload + diff preview.
        document.getElementById("upload-input").addEventListener("change", function (e) {
          var file = e.target.files && e.target.files[0];
          if (!file) return;
          var preview = document.getElementById("upload-preview");
          preview.innerHTML = '<p class="muted">Reading ' + esc(file.name) + "…</p>";
          var reader = new FileReader();
          reader.onload = function () {
            var uploaded = {};
            if (/\.zip$/i.test(file.name)) {
              showToast("ZIP parsing isn't supported in-browser yet — please upload the .json bundle or an individual content JSON.");
              preview.innerHTML = '<p class="warn">Could not preview a ZIP here. Use the .json bundle download instead, or unzip locally and upload an individual JSON file.</p>';
              return;
            }
            try {
              var parsed = JSON.parse(reader.result);
              if (parsed.files && typeof parsed.files === "object") uploaded = parsed.files;
              else uploaded = { "(uploaded file)": parsed };
            } catch (err) {
              preview.innerHTML = '<p class="warn">That file isn\'t valid JSON.</p>';
              return;
            }
            renderUploadDiff(uploaded, preview);
          };
          reader.readAsText(file);
        });
        function renderUploadDiff(uploaded, container) {
          var current = files;
          var html = '<h3 style="margin-top:1rem">Preview: ' + Object.keys(uploaded).length + ' file(s)</h3>';
          Object.keys(uploaded).forEach(function (name) {
            var before = current[name];
            var after = uploaded[name];
            var changed = before ? JSON.stringify(before) !== JSON.stringify(after) : true;
            html += '<div class="item"><div class="item-head"><span class="item-title mono">' + esc(name) + (changed ? ' <span class="tag" style="color:var(--warn);border-color:var(--warn)">' + (before ? "changed" : "new") + '</span>' : ' <span class="tag">unchanged</span>') + '</span></div>';
            if (changed && before) {
              // Simple top-level field diff.
              var diffs = diffObjects(before, after);
              if (diffs.length) {
                html += '<table class="scroll-x" style="margin-top:0.4rem"><thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody>';
                diffs.slice(0, 25).forEach(function (d) {
                  html += "<tr><td><code>" + esc(d.key) + '</code></td><td class="muted">' + esc(trunc(d.before)) + "</td><td>" + esc(trunc(d.after)) + "</td></tr>";
                });
                if (diffs.length > 25) html += '<tr><td colspan="3" class="muted">…and ' + (diffs.length - 25) + " more changes</td></tr>";
                html += "</tbody></table>";
              }
            }
            html += "</div>";
          });
          html += '<p class="muted" style="font-size:0.82rem">To apply: download the file(s) from the relevant section above using these values, or send the uploaded file directly to your son. Nothing is changed on the live site from this preview.</p>';
          container.innerHTML = html;
        }
        function diffObjects(a, b) {
          var out = [];
          if (Array.isArray(a) || Array.isArray(b)) {
            var alen = Array.isArray(a) ? a.length : 0;
            var blen = Array.isArray(b) ? b.length : 0;
            if (alen !== blen) out.push({ key: "(array length)", before: alen, after: blen });
            else {
              for (var i = 0; i < alen; i++) {
                if (JSON.stringify(a[i]) !== JSON.stringify(b[i])) out.push({ key: "[" + i + "]", before: JSON.stringify(a[i]), after: JSON.stringify(b[i]) });
              }
            }
            return out;
          }
          if (typeof a !== "object" || typeof b !== "object") {
            if (JSON.stringify(a) !== JSON.stringify(b)) out.push({ key: "(value)", before: a, after: b });
            return out;
          }
          var keys = Object.keys(Object.assign({}, a, b));
          keys.forEach(function (k) {
            var av = a[k], bv = b[k];
            if (JSON.stringify(av) !== JSON.stringify(bv)) out.push({ key: k, before: av, after: bv });
          });
          return out;
        }
        function trunc(v) {
          var s = typeof v === "string" ? v : JSON.stringify(v);
          return s.length > 60 ? s.slice(0, 60) + "…" : s;
        }

        // ===== Panel (re)builders, keyed by file for reset =====
        function buildPanel(file) {
          if (file === "settings.json") buildSettings();
          else if (file === "pricing.json") buildPricing();
          else if (file === "testimonials.json") buildTestimonials();
          else if (file === "faq.json") buildFaq();
          else if (file === "portfolio.json") buildPortfolio();
          else if (file === "integrations.json") buildIntegrations();
        }
        function buildAll() {
          buildSettings();
          buildPricing();
          buildTestimonials();
          buildFaq();
          buildPortfolio();
          buildServices();
          buildBlogList();
          buildSeoList();
          buildKeywordGroups();
          buildRedirectsTable();
          buildIntegrations();
        }

        // Boot.
        tryUnlock();
      })();
    </script>
  </body>
</html>
