            wrap.appendChild(el("div", { class: "empty" }, el("div", { class: "ic" }, "\u270D\uFE0F"), "No posts yet."));
            return;
          }
          const posts = [];
          for (const f of mdFiles) {
            try {
              const file = await readFile(`${BLOG_DIR}/${f.name}`);
              const fm = parseFrontmatter(file.content);
              posts.push({ name: f.name, sha: file.sha, ...fm });
            } catch { posts.push({ name: f.name, title: f.name, draft: false, publishDate: "" }); }
          }
          posts.sort((a, b) => new Date(b.publishDate || 0) - new Date(a.publishDate || 0));
          models.blogPosts = posts;
          renderBlogTable(posts, "");
        } catch (e) {
          wrap.appendChild(renderErrorCard(e, () => navigate("blog")));
