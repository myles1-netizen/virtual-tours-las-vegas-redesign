      async function saveBlogPost(fm, body, originalName, newName) {
        showLoading("Saving post\u2026");
        try {
          const md = stringifyFrontmatter(fm) + (body.startsWith("\n") ? body : "\n" + body);
          if (originalName && originalName !== newName) {
            const old = cache[`${BLOG_DIR}/${originalName}`];
            if (old && old.sha) {
              try { await deleteFile(`${BLOG_DIR}/${originalName}`, old.sha, `Remove renamed post ${originalName}`); } catch {}
              delete cache[`${BLOG_DIR}/${originalName}`];
            }
          }
          await writeFile(`${BLOG_DIR}/${newName}`, md, `${originalName ? "Update" : "Create"} blog post ${newName}`);
          hideLoading(); closeModal();
          await drawBlog();
          toast("Post saved! Site rebuilds in ~90 seconds.", "success", "Saved");
        } catch (e) {
          hideLoading();
          toast(e.message, "error", "Save failed");
        }
      }

      async function deleteBlogPost(post) {
        if (!confirm(`Delete "${post.title || post.name}"? This cannot be undone.`)) return;
        showLoading("Deleting post\u2026");
        try {
          const file = await readFile(`${BLOG_DIR}/${post.name}`);
          await deleteFile(`${BLOG_DIR}/${post.name}`, file.sha, `Delete blog post ${post.name}`);
          delete cache[`${BLOG_DIR}/${post.name}`];
          hideLoading(); closeModal();
          await drawBlog();
          toast("Post deleted.", "success");
        } catch (e) { hideLoading(); toast(e.message, "error", "Delete failed"); }
      }

      function slugify(s) {
        return String(s || "").toLowerCase().trim()
          .replace(/['"]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 80) || "post";
      }

      // Tiny, safe Markdown renderer (headings, bold, italic, links, images, lists).
      function simpleMarkdown(md) {
        const escMd = (s) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
        const lines = escMd(md).split("\n");
        let html = ""; let inList = false; let para = [];
        const flushPara = () => { if (para.length) { html += `<p>${para.join(" ")}</p>`; para = []; } };
        const closeList = () => { if (inList) { html += "</ul>"; inList = false; } };
        const inline = (s) => s
          .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img alt="$1" src="$2">')
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
          .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
          .replace(/\*([^*]+)\*/g, "<em>$1</em>")
          .replace(/`([^`]+)`/g, "<code>$1</code>");
        for (const raw of lines) {
          const line = raw.replace(/\s+$/, "");
          if (!line.trim()) { flushPara(); closeList(); continue; }
          let m;
          if ((m = line.match(/^###\s+(.*)$/))) { flushPara(); closeList(); html += `<h3>${inline(m[1])}</h3>`; continue; }
          if ((m = line.match(/^##\s+(.*)$/))) { flushPara(); closeList(); html += `<h2>${inline(m[1])}</h2>`; continue; }
          if ((m = line.match(/^#\s+(.*)$/))) { flushPara(); closeList(); html += `<h1>${inline(m[1])}</h1>`; continue; }
          if ((m = line.match(/^[-*]\s+(.*)$/))) { flushPara(); if (!inList) { html += "<ul>"; inList = true; } html += `<li>${inline(m[1])}</li>`; continue; }
          para.push(inline(line));
        }
        flushPara(); closeList();
        return html;
      }

