      async function runMediaCleanerScan(resultNode) {
        clear(resultNode);
        resultNode.appendChild(el("div", { class: "empty" }, el("div", { class: "spinner", style: { margin: "0 auto" } })));
        try {
          // Gather all referenced image paths from CMS JSON + blog md.
          const refs = new Set();
          const jsonFiles = ["portfolio.json", "testimonials.json", "pricing.json"];
          for (const f of jsonFiles) {
            try { const d = await readFile(`${CMS_DIR}/${f}`); (d.content.match(/\/images\/[^\s"',)\]]+/gi) || []).forEach((p) => refs.add(p)); } catch {}
          }
          try {
            const ls = await listDir(BLOG_DIR);
            for (const file of ls.filter((x) => x.name.endsWith(".md"))) {
              const d = await readFile(`${BLOG_DIR}/${file.name}`);
              (d.content.match(/\/images\/[^\s"',)\]]+/gi) || []).forEach((p) => refs.add(p));
            }
          } catch {}
          // List all images.
          const all = [];
          for (const f of MEDIA_FOLDERS) {
            try { const ls = await listDir(`public/images/${f}`); ls.forEach((x) => { if (x.type === "file" && IMG_EXT.test(x.name)) all.push({ folder: f, name: x.name, path: `/images/${f}/${x.name}` }); }); } catch {}
          }
          const unused = all.filter((img) => !refs.has(img.path));
          clear(resultNode);
          if (!unused.length) {
            resultNode.appendChild(el("div", { class: "empty", style: { padding: "20px" } },
              el("div", { class: "ic", style: { color: "var(--green)" } }, "\u2705"),
              el("div", { style: { fontWeight: "700" } }, "All images are referenced"),
              `Scanned ${all.length} image(s) across ${MEDIA_FOLDERS.length} folders \u2014 none appear orphaned.`));
            return;
          }
          const thead = el("thead", {}, el("tr", {}, el("th", {}, "Image"), el("th", {}, "Folder"), el("th", {}, "Path")));
          const tb = el("tbody", {});
          for (const img of unused) {
            tb.appendChild(el("tr", {},
              el("td", {}, esc(img.name)),
              el("td", {}, img.folder + "/"),
              el("td", {}, el("code", { style: { fontSize: "12px", color: "var(--muted)" } }, img.path))));
          }
          const tbl = el("table", { class: "tbl" }, thead, tb);
          resultNode.appendChild(el("p", { class: "sub", style: { marginTop: "0" } }, `${unused.length} image(s) not referenced in any CMS or blog file. Review before deleting \u2014 some may be used in code.`));
          resultNode.appendChild(tbl);
        } catch (e) { clear(resultNode); resultNode.appendChild(renderErrorCard(e, () => runMediaCleanerScan(resultNode))); }
      }

