      function quickSEOScore(p) {
        let score = 0;
        const titleLen = (p.title || "").length;
        const descLen = (p.description || "").length;
        if (titleLen >= 30 && titleLen <= 60) score += 2; else if (titleLen > 0) score += 1;
        if (descLen >= 70 && descLen <= 160) score += 2; else if (descLen > 0) score += 1;
        if (p.focusKeyphrase) score += 2;
        return score;
      }

      function seoFileName(path) {
        if (path === "/") return "home";
        return path.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, "-");
      }

      async function drawSEOEditor(parent, path) {
        const p = pages.find(x => x.path === path) || { path, title: "", description: "", focusKeyphrase: "" };
        // Remove old editor
        const old = parent.querySelector("#seo-editor");
        if (old) old.remove();
        const editor = el("div", { id: "seo-editor" });

        // Load saved SEO data
        let seo = {};
        try { seo = JSON.parse(await readFile(`${SEO_DIR}/${seoFileName(path)}.json`)); } catch (e) {}
        const data = {
          title: seo.title || p.title || "",
          description: seo.description || p.description || "",
          focusKeyphrase: seo.focusKeyphrase || p.focusKeyphrase || focusByPath[path] || "",
        };

        // SERP preview
        const serpCard = card("Google preview", el("div", { class: "serp", id: "seo-serp" }), { sub: "How your page looks in search results" });
        editor.appendChild(serpCard);

        // Fields
        const grid = el("div", {});
        const titleInput = textInput({ value: data.title, maxlength: 60 });
        const descInput = textarea({ maxlength: 160 });
        descInput.value = data.description;
        const kwInput = textInput({ value: data.focusKeyphrase, placeholder: "e.g. las vegas real estate photography" });
        grid.appendChild(field("SEO title", titleInput, `<span id="title-meter">0/60 — Google shows ~60 characters</span>`));
        grid.appendChild(field("Meta description", descInput, `<span id="desc-meter">0/160 — Google shows ~160 characters</span>`));
        grid.appendChild(field("Focus keyphrase", kwInput, "The main phrase you want this page to rank for"));
        editor.appendChild(card("Content", grid, { sub: "Optimize for your focus keyphrase" }));

        // Score
        const scoreCard = card("SEO score", el("div", { id: "seo-score" }), { sub: "Real-time analysis" });
        editor.appendChild(scoreCard);

        // Save button
        const saveBtn = el("button", { class: "btn btn-primary btn-lg btn-block", text: "Save SEO settings", onclick: async () => {
          showLoading();
          try {
            await writeFile(`${SEO_DIR}/${seoFileName(path)}.json`, JSON.stringify(data, null, 2) + "\n", `CMS: SEO for ${path}`);
            hideLoading();
            toast("SEO saved! Rebuilding…", "success", "Optimized");
          } catch (e) { hideLoading(); toast(e.message, "error", "Save failed"); }
        }});
        editor.appendChild(saveBtn);

        parent.appendChild(editor);

        // Wire up live updates
        function updatePreview() {
          data.title = titleInput.value;
          data.description = descInput.value;
          data.focusKeyphrase = kwInput.value;
          // SERP
          const serp = $("#seo-serp");
          serp.innerHTML = `
            <div class="serp-url"><span class="dot">V</span> virtualtourslasvegas.com › ${path === "/" ? "" : path.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, " › ")}</div>
            <div class="serp-title">${esc(data.title || "Your page title")}</div>
            <div class="serp-desc">${esc(data.description || "Your meta description appears here.")}</div>`;
          // Meters
          const tl = data.title.length;
          $("#title-meter").textContent = `${tl}/60 ${tl > 60 ? "⚠️ too long" : tl < 30 ? "⚠️ too short" : "✓ good"}`;
          $("#title-meter").style.color = tl > 60 || tl < 30 ? "var(--amber)" : "var(--green)";
          const dl = data.description.length;
          $("#desc-meter").textContent = `${dl}/160 ${dl > 160 ? "⚠️ too long" : dl < 70 ? "⚠️ add more" : "✓ good"}`;
          $("#desc-meter").style.color = dl > 160 || dl < 70 ? "var(--amber)" : "var(--green)";
          // Score
          const score = quickSEOScore(data);
          const sc = $("#seo-score");
          const pct = Math.round((score / 6) * 100);
          const cls = score >= 5 ? "badge-green" : score >= 3 ? "badge-amber" : "badge-red";
          const label = score >= 5 ? "Good" : score >= 3 ? "OK" : "Needs work";
          sc.innerHTML = `<div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
            <span class="badge ${cls}" style="font-size:13px;padding:6px 14px">${label}</span>
            <span style="font-size:28px;font-weight:700">${pct}<span style="font-size:16px;color:var(--muted)">/100</span></span>
          </div>
          <div style="line-height:1.8">
            <div>${check(data.title.length >= 30 && data.title.length <= 60)} Title length is ${data.title.length} chars (ideal: 30-60)</div>
            <div>${check(data.description.length >= 70 && data.description.length <= 160)} Description length is ${data.description.length} chars (ideal: 70-160)</div>
            <div>${check(!!data.focusKeyphrase)} Focus keyphrase is set</div>
            <div>${check(data.focusKeyphrase && data.title.toLowerCase().includes(data.focusKeyphrase.toLowerCase().split(" ")[0]))} Keyphrase appears in title</div>
          </div>`;
        }
        function check(ok) { return ok ? '<span style="color:var(--green)">✓</span>' : '<span style="color:var(--red)">✗</span>'; }
        titleInput.oninput = updatePreview;
        descInput.oninput = updatePreview;
        kwInput.oninput = updatePreview;
        updatePreview();
      }

