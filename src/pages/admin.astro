      // WordPress-style list table with bulk actions + search box.
      function renderBlogTable(allPosts, query) {
        const wrap = $("#blog-list");
        clear(wrap);
        const selected = new Set();
        const q = query.trim().toLowerCase();
        const posts = q
          ? allPosts.filter((p) => (p.title || p.name).toLowerCase().includes(q) || (p.category || "").toLowerCase().includes(q))
          : allPosts.slice();

        // Toolbar: bulk actions + filter + search
        const bulkSel = el("select", { "aria-label": "Bulk actions" },
          el("option", { value: "" }, "Bulk actions"),
          el("option", { value: "publish" }, "Publish"),
          el("option", { value: "draft" }, "Set as draft"),
          el("option", { value: "delete" }, "Delete"));
        const applyBulk = el("button", { class: "btn btn-sm", onclick: async () => {
          const action = bulkSel.value;
          if (!action) { toast("Pick a bulk action first.", "error", "Choose an action"); return; }
          const targets = posts.filter((_, i) => selected.has(i));
          if (!targets.length) { toast("Select one or more posts using the checkboxes.", "error", "Nothing selected"); return; }
          if (action === "delete" && !confirm(`Delete ${targets.length} post(s)? This cannot be undone.`)) return;
          showLoading("Applying bulk action\u2026");
          try {
            for (const p of targets) {
              if (action === "delete") {
                const f = await readFile(`${BLOG_DIR}/${p.name}`);
                await deleteFile(`${BLOG_DIR}/${p.name}`, f.sha, `Delete blog post ${p.name}`);
                delete cache[`${BLOG_DIR}/${p.name}`];
              } else {
                p.draft = action !== "publish";
                const md = stringifyFrontmatter({ title: p.title, description: p.description, publishDate: p.publishDate, author: p.author, category: p.category, draft: p.draft, heroImage: p.heroImage, heroAlt: p.heroAlt }) + (p.body && p.body.startsWith("\n") ? p.body : "\n" + (p.body || ""));
                await writeFile(`${BLOG_DIR}/${p.name}`, md, `Bulk ${action}: ${p.name}`);
              }
            }
            hideLoading();
            toast(`${targets.length} post(s) ${action === "delete" ? "deleted" : "updated"}.`, "success", "Done");
            await drawBlog();
          } catch (e) { hideLoading(); toast(e.message, "error", "Bulk action failed"); }
        } }, "Apply");

        const searchInput = el("input", { type: "search", placeholder: "Search posts\u2026", value: query, "aria-label": "Search posts" });
        searchInput.addEventListener("input", () => renderBlogTable(allPosts, searchInput.value));

        wrap.appendChild(el("div", { class: "list-toolbar" },
          el("div", { class: "lt-left" }, bulkSel, applyBulk),
          el("div", { class: "lt-search" }, searchInput)));

        if (!posts.length) {
          wrap.appendChild(el("div", { class: "empty" }, el("div", { class: "ic" }, "\u{1F50D}"), q ? "No posts match your search." : "No posts yet."));
          return;
        }

        const headerCb = el("input", { type: "checkbox", class: "row-cb", "aria-label": "Select all", title: "Select all" });
        headerCb.addEventListener("change", () => {
          const on = headerCb.checked;
          posts.forEach((_, i) => on ? selected.add(i) : selected.delete(i));
          $$("input.row-cb", tb).forEach((cb, idx) => { cb.checked = on; });
        });
        const tbl = el("table", { class: "tbl" },
          el("thead", {}, el("tr", {},
            el("th", { style: { width: "32px" } }, headerCb),
            el("th", {}, "Title"), el("th", {}, "Date"), el("th", {}, "Status"), el("th", {}, ""))),
        );
        const tb = el("tbody", {});
        posts.forEach((p, i) => {
          const cb = el("input", { type: "checkbox", class: "row-cb", "aria-label": "Select " + (p.title || p.name) });
          cb.addEventListener("change", () => { cb.checked ? selected.add(i) : selected.delete(i); });
          tb.appendChild(el("tr", {},
            el("td", {}, cb),
            el("td", {}, el("b", {}, esc(p.title || p.name)), el("small", { style: { display: "block", color: "var(--muted)", fontSize: "11.5px" } }, p.name)),
            el("td", {}, p.publishDate ? new Date(p.publishDate).toLocaleDateString() : "\u2014"),
            el("td", {}, p.draft ? el("span", { class: "badge gray" }, "Draft") : el("span", { class: "badge green" }, "Published")),
            el("td", {}, el("div", { class: "wp-row-actions", style: { justifyContent: "flex-end" } },
              el("button", { onclick: () => editBlogPost(p.name) }, "Edit"),
