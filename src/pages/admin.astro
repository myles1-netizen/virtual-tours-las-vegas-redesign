            if (item.size !== undefined) h += itemField("size", "Size bracket", item.size);
            if (item.item !== undefined) h += itemField("item", "Item label", item.item);
            h += '<div class="grid2">';
            h += '<div class="field"><label>Price ($)</label><input data-item-field="price" data-type="number" type="number" step="any" value="' + (item.price == null ? "" : item.price) + '" /><span class="hint">Leave empty for "Custom quote".</span></div>';
            h += '<div class="field"><label>Note (for custom quote)</label><input data-item-field="note" type="text" value="' + esc(item.note || "") + '" /></div>';
            h += "</div>";
            return h;
          };
        }
        function packageItemRenderer(item, idx) {
          var h = '<div class="item-head"><span class="item-title">' + esc(item.name || ("Package " + (idx + 1))) + '</span><div class="item-tools">' +
            '<button type="button" data-move="-1">↑</button><button type="button" data-move="1">↓</button>' +
            '<button type="button" class="danger" data-remove>✕</button></div></div>';
          h += '<div class="grid2">';
          h += itemField("name", "Package name", item.name);
          h += itemField("tag", "Tag line", item.tag);
          h += "</div>";
          h += '<div class="grid2">';
          h += '<div class="field"><label>Price ($)</label><input data-item-field="price" data-type="number" type="number" step="any" value="' + (item.price == null ? "" : item.price) + '" /></div>';
          h += '<div class="field"><label>Featured?</label><select data-item-field="featured"><option value="false"' + (item.featured ? "" : " selected") + '>No</option><option value="true"' + (item.featured ? " selected" : "") + '>Yes — highlight</option></select></div>';
          h += "</div>";
