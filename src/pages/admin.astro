              title: parsed.title || "", description: parsed.description || "",
              publishDate: parsed.publishDate || "", author: parsed.author || "Mike Madsen",
              category: parsed.category || "", draft: !!parsed.draft,
              heroImage: parsed.heroImage || "", heroAlt: parsed.heroAlt || "",
            };
            body = parsed.body || "";
          }
          drawBlogEditor(fm, body, originalName);
        })().catch((e) => { closeModal(); toast(e.message, "error", "Could not open post"); });
