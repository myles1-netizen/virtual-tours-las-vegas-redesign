      async function saveBlogPost(fm, body, originalName, newName) {
        showLoading("Saving post\u2026");
        try {
          const md = stringifyFrontmatter(fm) + (body.startsWith("\n") ? body : "\n" + body);
          if (originalName && originalName !== newName) {
            const old = cache[`${BLOG_DIR}/${originalName}`];
            if (old && old.sha) {
              try { await deleteFile(`${BLOG_DIR}/${originalName}`, old.sha, `Remove renamed post ${originalName}`); } catch {}
              delete cache[`${BLOG_DIR}/${originalName}`];
            }
          }
          await writeFile(`${BLOG_DIR}/${newName}`, md, `${originalName ? "Update" : "Create"} blog post ${newName}`);
          hideLoading(); closeModal();
          await drawBlog();
          toast("Post saved! Site rebuilds in ~90 seconds.", "success", "Saved");
        } catch (e) {
          hideLoading();
          toast(e.message, "error", "Save failed");
        }
