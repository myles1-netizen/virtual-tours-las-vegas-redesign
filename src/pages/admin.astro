      }

      async function savePost(data, isNew) {
        if (!data.title) { toast("Title is required.", "error"); return; }
        let filename = (data.slug || data.title.toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-|-$/g, "")) + ".md";
        data.filename = filename;
        const fm = { title: data.title, description: data.description || "", date: data.date, category: data.category || "Real Estate", author: data.author || "Mike Madsen", heroImage: data.heroImage || "", draft: data.draft ? "true" : "" };
        const content = buildFrontmatter(fm) + (data.body || "");
        showLoading();
        try {
          await writeFile(`${BLOG_DIR}/${filename}`, content, `CMS: ${isNew ? "new post" : "edit"} ${filename}`);
          hideLoading();
          toast("Post saved! Rebuilding…", "success", "Published");
          navigate("posts");
        } catch (e) { hideLoading(); toast(e.message, "error", "Save failed"); }
      }

