    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline define:vars={{ snapshot: snapshotJson, usingDefaultPassword: USING_DEFAULT_PASSWORD, adminPassword: ADMIN_PASSWORD }}>
      (function () {
        "use strict";
        var DATA = JSON.parse(snapshot);
        var files = DATA.files;
        var blogPosts = DATA.blogPosts;
        var reference = DATA.reference;
        var businessInfo = DATA.business;

        // ===== Password gate =====
        var gate = document.getElementById("gate");
        var dash = document.getElementById("dash");
        var gateForm = document.getElementById("gate-form");
        var pwdInput = document.getElementById("pwd");
        var gateError = document.getElementById("gate-error");
        var logoutBtn = document.getElementById("logout");
        var STORAGE_KEY = "vtlv_admin_unlocked";
        var FIRST_LOGIN_KEY = "vtlv_admin_first_login_seen";

        function showDash() { gate.hidden = true; dash.hidden = false; buildAll(); }

        function tryUnlock() {
          var saved = "no";
          try { saved = localStorage.getItem(STORAGE_KEY) || "no"; } catch (e) {}
          if (saved === "yes") { showDash(); return; }
          gate.hidden = false; dash.hidden = true;
        }
        function tryUnlock() {
          var saved = "no";
          try { saved = localStorage.getItem(STORAGE_KEY) || "no"; } catch (e) {}
          if (saved === "yes") { showDash(); return; }
          gate.hidden = false; dash.hidden = true;
        }
        if (gateForm) {
          gateForm.addEventListener("submit", function (e) {
            e.preventDefault();
            gateError.textContent = "";
            var value = pwdInput ? pwdInput.value : "";
            if (!value) { gateError.textContent = "Please enter the password."; return; }
            // Direct comparison — this is a client-side gate on a static site.
            // The content shown is already public; the password just hides the editor UI.
            if (value === adminPassword) {
              try { localStorage.setItem(STORAGE_KEY, "yes"); } catch (e) {}
              if (usingDefaultPassword) {
                try { if (!localStorage.getItem(FIRST_LOGIN_KEY)) { showToast("Default password is VTLV-admin-2026 — change it via ADMIN_PASSWORD env var."); localStorage.setItem(FIRST_LOGIN_KEY, "yes"); } } catch (e) {}
              }
              showDash();
            } else {
              gateError.textContent = "That password isn't right.";
              if (pwdInput) { pwdInput.value = ""; pwdInput.focus(); }
            }
          });
        }

        if (logoutBtn) {
          logoutBtn.addEventListener("click", function () {
            try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
            dash.hidden = true; gate.hidden = false;
            if (pwdInput) { pwdInput.value = ""; pwdInput.focus(); }
          });
        }

        // ===== Tabs =====
        document.querySelectorAll(".tab").forEach(function (tab) {
          tab.addEventListener("click", function () {
            var name = tab.dataset.tab;
            document.querySelectorAll(".tab").forEach(function (t) { t.classList.toggle("active", t === tab); });
            document.querySelectorAll(".panel").forEach(function (p) { p.classList.toggle("active", p.dataset.panel === name); });
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        });

        // ===== Helpers =====
        function esc(s) {
          return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }
        function deepClone(o) { return JSON.parse(JSON.stringify(o)); }

        // Build a single-line text field bound to file::path.
        function textField(file, path, label, value, opts) {
          opts = opts || {};
          var type = opts.numeric ? "number" : "text";
          var extra = opts.numeric ? ' step="any"' : "";
          var hint = opts.hint ? '<span class="hint">' + esc(opts.hint) + '</span>' : "";
          var cc = opts.charLimit ? charCount(value, opts.charLimit) : "";
          return '<div class="field"><label>' + esc(label) + '</label>' +
            '<input type="' + type + '"' + extra + ' data-edit="' + esc(file + "::" + path) + '" value="' + esc(value) + '" />' +
            (cc || hint) + '</div>';
        }
        function textareaField(file, path, label, value, opts) {
          opts = opts || {};
          var isList = opts.list ? '" data-list="true' : "";
          var attr = ' data-edit="' + esc(file + "::" + path) + isList + '"';
          var hint = opts.hint ? '<span class="hint">' + esc(opts.hint) + '</span>' : "";
          var cc = opts.charLimit ? charCount(value, opts.charLimit) : "";
          var ph = opts.placeholder ? ' placeholder="' + esc(opts.placeholder) + '"' : "";
          var rows = opts.rows ? ' rows="' + opts.rows + '"' : ' rows="3"';
          return '<div class="field"><label>' + esc(label) + '</label>' +
            '<textarea' + attr + rows + ph + '>' + esc(value) + '</textarea>' +
            (cc || hint) + '</div>';
        }
        function charCount(value, limit) {
          var len = String(value == null ? "" : value).length;
          var over = len > limit ? " over" : "";
          return '<span class="char-count' + over + '" data-char-limit="' + limit + '">' + len + ' / ' + limit + '</span>';
        }

        // ===== Collect all edits back into a file map =====
        function collectAll() {
          var out = deepClone(files);
          // scalar/path fields (not inside an array item)
          document.querySelectorAll("[data-edit]").forEach(function (el) {
            if (el.closest("[data-array-item]")) return;
            var parts = el.getAttribute("data-edit").split("::");
            var file = parts[0], path = parts[1];
            if (!out[file] || !path) return;
            var val;
            if (el.dataset.list === "true") {
              val = el.value.split("\n").map(function (s) { return s.trim(); }).filter(Boolean);
            } else if (el.type === "checkbox") {
              val = el.checked;
            } else if (el.dataset.type === "number") {
              val = el.value === "" ? null : Number(el.value);
            } else {
              val = el.value;
            }
            setPath(out[file], path, val);
          });
          // arrays (root-level arrays + nested)
          document.querySelectorAll("[data-array]").forEach(function (container) {
            var parts = container.getAttribute("data-array").split("::");
            var file = parts[0], path = parts[1];
            if (!out[file]) return;
            var items = Array.prototype.slice.call(container.querySelectorAll(":scope > [data-array-item]"));
            var arr = items.map(function (item) {
              var obj = {};
              item.querySelectorAll("[data-item-field]").forEach(function (f) {
                var key = f.getAttribute("data-item-field");
                var val;
                if (f.dataset.list === "true") {
                  val = f.value.split("\n").map(function (s) { return s.trim(); }).filter(Boolean);
                } else if (f.type === "checkbox") {
                  val = f.checked;
                } else if (f.dataset.type === "number") {
                  val = f.value === "" ? null : Number(f.value);
                } else {
                  val = f.value;
                }
                setPath(obj, key, val);
              });
              return obj;
            });
            if (path === "__root__") out[file] = arr;
            else setPath(out[file], path, arr);
          });
          return out;
        }
        function setPath(obj, path, value) {
          if (path === "__root__") return;
          var keys = path.split(".");
          var cur = obj;
          for (var i = 0; i < keys.length - 1; i++) {
            if (cur[keys[i]] == null || typeof cur[keys[i]] !== "object") cur[keys[i]] = {};
            cur = cur[keys[i]];
          }
          cur[keys[keys.length - 1]] = value;
        }

        // ===== Downloads =====
        function download(filename, content, mime) {
          var blob = new Blob([content], { type: mime || "application/json;charset=utf-8" });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url; a.download = filename;
          document.body.appendChild(a); a.click();
          document.body.removeChild(a);
          setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
        }
        function prettyJson(obj) { return JSON.stringify(obj, null, 2) + "\n"; }

        function status(file, msg, ok) {
          var el = document.querySelector('[data-status="' + file + '"]');
          if (!el) return;
          el.textContent = msg;
          el.style.color = ok === false ? "var(--danger)" : "var(--ok)";
          setTimeout(function () { if (el.textContent === msg) el.textContent = ""; }, 4000);
        }
        function showToast(msg) {
          var t = document.getElementById("toast");
          t.textContent = msg; t.classList.add("show");
          setTimeout(function () { t.classList.remove("show"); }, 3200);
        }

        // Download buttons (per-file JSON).
        document.addEventListener("click", function (e) {
          var btn = e.target.closest("[data-download]");
          if (!btn) return;
          var file = btn.dataset.download;
          var all = collectAll();
          if (file === "seo-edits.json") {
            download("seo-edits.json", prettyJson(collectSeoEdits()), "application/json;charset=utf-8");
            status("seo-edits.json", "Downloaded seo-edits.json — send to your son.");
            return;
          }
          if (!all[file]) { showToast("Nothing to download for " + file); return; }
          download(file, prettyJson(all[file]));
          status(file, "Downloaded " + file + " — email it to your son.");
          showToast("Downloaded " + file);
        });
        // Reset buttons restore the build-time snapshot for a file.
        document.addEventListener("click", function (e) {
          var btn = e.target.closest("[data-reset]");
          if (!btn) return;
          var file = btn.dataset.reset;
          if (!confirm("Reset " + file + " to the version currently on the live site? Your edits in this section will be lost.")) return;
          buildPanel(file);
          status(file, "Reset to live version.");
        });

        // ===== A. Settings =====
        function buildSettings() {
          var s = files["settings.json"];
          var h = "";
          h += '<div class="grid2">';
          h += textField("settings.json", "name", "Business name", s.name);
          h += textField("settings.json", "shortName", "Short name", s.shortName);
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "owner", "Owner", s.owner);
          h += textField("settings.json", "since", "Operating since (year)", s.since, { numeric: true });
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "phone", "Phone (display)", s.phone);
          h += textField("settings.json", "phoneHref", "Phone link (tel:)", s.phoneHref);
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "email", "Email (display)", s.email);
          h += textField("settings.json", "emailHref", "Email link (mailto:)", s.emailHref);
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "smsHref", "Text link (sms:)", s.smsHref);
          h += textField("settings.json", "turnaround", "Turnaround", s.turnaround);
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "realEstateSince", "In real estate since", s.realEstateSince, { numeric: true });
          h += textField("settings.json", "url", "Website URL", s.url);
          h += "</div>";
          h += textareaField("settings.json", "serviceArea", "Service areas (one per line)", (s.serviceArea || []).join("\n"), { list: true, hint: "Cities/areas you serve." });
          h += textField("settings.json", "areaNote", "Area note", s.areaNote);

          h += "<h3>Social media links</h3>";
          var so = s.social || {};
          h += '<div class="grid2">';
          h += textField("settings.json", "social.facebook", "Facebook", so.facebook);
          h += textField("settings.json", "social.instagram", "Instagram", so.instagram);
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "social.youtube", "YouTube", so.youtube);
          h += textField("settings.json", "social.x", "X / Twitter", so.x);
          h += "</div>";
          h += '<div class="grid2">';
          h += textField("settings.json", "social.linkedin", "LinkedIn", so.linkedin);
          h += textField("settings.json", "social.yelp", "Yelp", so.yelp);
          h += "</div>";
          document.getElementById("settings-form").innerHTML = h;
        }

        // ===== B. Pricing =====
        function tierItemRenderer(labelHeading) {
          return function (item, idx) {
            var title = item.count || item.size || item.item || (labelHeading + " " + (idx + 1));
            var h = '<div class="item-head"><span class="item-title">' + esc(title) + '</span><div class="item-tools">' +
              '<button type="button" data-move="-1" title="Move up">↑</button>' +
