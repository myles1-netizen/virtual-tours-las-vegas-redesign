      function seoScore(fm, keyword) {
        let pts = 0;
        const title = (fm.title || "").length;
        const desc = (fm.description || "").length;
        if (title >= 30 && title <= 60) pts += 2; else if (title > 0) pts += 1;
        if (desc >= 70 && desc <= 160) pts += 2; else if (desc > 0) pts += 1;
        if (keyword) pts += 2;
        if (pts >= 5) return { level: "good", pts };
        if (pts >= 3) return { level: "ok", pts };
        return { level: "bad", pts };
      }

