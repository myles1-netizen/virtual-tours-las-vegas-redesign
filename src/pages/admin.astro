      async function drawSEOEditor(path, container) {
        clear(container);
        const page = pages.find((p) => p.path === path);
        const seoPath = `${CMS_DIR}/seo/${seoFileName(path)}.json`;
        let model = models.seo[path];
        if (!model) {
          try {
            const f = await readFile(seoPath);
            model = JSON.parse(f.content);
          } catch {
            model = { title: page.title, description: page.description, keyword: "" };
          }
          models.seo[path] = model;
        }

        const titleInput = el("input", { type: "text", value: model.title || "" });
        const titleMeter = el("div", { class: "meter" });
        const descArea = el("textarea", {});
        descArea.value = model.description || "";
        const descMeter = el("div", { class: "meter" });
        const kwInput = el("input", { type: "text", value: model.keyword || "" });

        const serpTitle = el("div", { class: "t trunc" });
