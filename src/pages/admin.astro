        const redraw = () => {
          const t = titleInput.value;
          const d = descArea.value;
          setMeter(titleMeter, t.length, 60);
          setMeter(descMeter, d.length, 160);
          serpTitle.textContent = t || "(no title)";
          serpTitle.title = t;
          serpUrl.innerHTML = `<span>virtualtourslasvegas.com</span><span class="dots"> \u203a </span><span>${esc(path.replace(/^\//, "").replace(/\//g, " \u203a ")) || "(home)"}</span>`;
          serpDesc.textContent = d || "(no description)";
        };
        titleInput.addEventListener("input", () => { model.title = titleInput.value; redraw(); });
        descArea.addEventListener("input", () => { model.description = descArea.value; redraw(); });
        kwInput.addEventListener("input", () => { model.keyword = kwInput.value; });
        redraw();

        const titleLbl = el("label", { style: { display: "flex", justifyContent: "space-between", fontWeight: "700", fontSize: "13px", marginBottom: "6px" } },
          el("span", {}, "SEO Title"), titleMeter);
        const descLbl = el("label", { style: { display: "flex", justifyContent: "space-between", fontWeight: "700", fontSize: "13px", marginBottom: "6px" } },
          el("span", {}, "Meta Description"), descMeter);

        container.appendChild(el("div", { class: "form-grid", style: { alignItems: "flex-start" } },
