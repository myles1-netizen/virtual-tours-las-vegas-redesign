      }

      async function loadPageContent(slug, mode) {
        pbSlug = slug;
        cleanupVisualEditor();
        showLoading();
        try {
          let raw;
          // Service pages use a different directory
          const isService = SERVICE_SLUGS.includes(slug);
          pbContentPath = isService ? `${CMS_DIR}/services/${slug}.json` : `${CONTENT_DIR}/${slug}.json`;
          try {
            raw = await readFile(pbContentPath);
            pbContent = JSON.parse(raw);
          } catch (e) {
            // No content file yet — start with empty structure
            pbContent = { _page: slug, _slug: slug };
          }
          hideLoading();
          if (mode === "visual") {
            // Resolve the page path for the iframe
            const pageInfo = pages.find(p => {
              const s = p.path === "/" ? "home" : p.path.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, "-");
              return s === slug;
            });
            const pagePath = pageInfo ? pageInfo.path : (slug === "home" ? "/" : "/" + slug.replace(/-/g, "/") + "/");
            startVisualEditor(slug, pagePath, pbContent);
          } else {
            drawContentEditor();
          }
        } catch (e) {
          hideLoading();
          toast(e.message, "error", "Could not load page");
        }
      }

      let pbContentPath = "";

      // Recursively renders an editable form for every field in the content JSON.
      // Each top-level key (hero, why, services, etc.) = one section panel.
      function drawContentEditor() {
        const area = $("#pb-editor-area");
        if (!area) return;
        area.innerHTML = "";

        const pageInfo = pages.find(p => {
          const s = p.path === "/" ? "home" : p.path.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, "-");
          return s === pbSlug;
        });
        const pageTitle = pageInfo?.title || pbSlug;

        area.appendChild(pageHead(pageTitle, `Editing ${pbSlug}.json — every field below appears on the live page.`, [
          el("button", { class: "btn btn-ghost", onclick: () => togglePreview(pageInfo?.path || "/"), html: '👁 Preview' }),
          el("a", { class: "btn btn-ghost", href: pageInfo?.path || "/", target: "_blank", text: "Open ↗" }),
          el("button", { class: "btn btn-primary", onclick: () => savePageContent(), html: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Save changes' }),
        ]));

        // Render each section as a collapsible card
        for (const [sectionKey, sectionValue] of Object.entries(pbContent)) {
          if (sectionKey.startsWith("_")) continue; // skip metadata
          const sectionCard = renderSectionPanel(sectionKey, sectionValue);
          area.appendChild(sectionCard);
        }
      }

      // Toggle a live preview overlay showing the actual rendered page.
      function togglePreview(path) {
        let overlay = $("#pb-preview-overlay");
        if (overlay) { overlay.remove(); return; }
        overlay = el("div", { id: "pb-preview-overlay", style: "position:fixed;inset:0;z-index:8000;background:rgba(0,0,0,0.9);display:flex;flex-direction:column" });
        const bar = el("div", { style: "background:var(--panel);padding:10px 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line)" });
        bar.appendChild(el("span", { text: "Live preview — " + path, style: "color:var(--ink);font-weight:600;font-size:13px" }));
        bar.appendChild(el("span", { class: "badge badge-amber", text: "Note: preview shows the currently live version. Saved changes appear after rebuild (~90s)." }));
        const closeBtn = el("button", { class: "btn btn-outline btn-sm", text: "Close", style: "margin-left:auto", onclick: () => overlay.remove() });
        bar.appendChild(closeBtn);
        overlay.appendChild(bar);
        const frameWrap = el("div", { style: "flex:1;overflow:hidden" });
        const frame = el("iframe", { src: path, style: "width:100%;height:100%;border:0;background:#fff" });
        frameWrap.appendChild(frame);
        overlay.appendChild(frameWrap);
        document.body.appendChild(overlay);
      }

      // A section panel: collapsible, shows all fields inside.
      function renderSectionPanel(key, value) {
        const card = el("div", { class: "card" });
        const head = el("div", { class: "card-head", style: "cursor:pointer" });
        const titleWrap = el("div");
        titleWrap.appendChild(el("h2", { text: prettifyKey(key) }));
        titleWrap.appendChild(el("span", { class: "card-sub", text: typeof value === "object" ? `${Object.keys(value).length} fields` : "text" }));
        head.appendChild(titleWrap);
        head.appendChild(el("span", { class: "badge badge-muted", text: "▾", style: "font-size:14px" }));
        card.appendChild(head);

        const body = el("div", { class: "card-body" });
        renderValueEditor(body, value, [key]);
        card.appendChild(body);

        // Toggle collapse
        head.onclick = () => {
          const hidden = body.style.display === "none";
          body.style.display = hidden ? "" : "none";
          head.querySelector(".badge").textContent = hidden ? "▾" : "▸";
        };

        return card;
      }

      // Recursively renders the right editor for a value (string → text/textarea,
      // array → repeater, object → nested fields). Path is used for nested access.
      function renderValueEditor(container, value, path) {
        if (value === null || value === undefined) {
          container.appendChild(field(prettifyKey(path[path.length - 1]), textInput({ value: "" })));
          return;
        }
        if (typeof value === "string") {
          // Image path fields get an image picker
          const isImage = /\.(jpg|jpeg|png|webp|gif|svg)$/i.test(value) || path[path.length - 1].toLowerCase().includes("image");
          // Long strings get a textarea
          if (value.length > 80 || value.includes("\n")) {
            const ta = textarea({ style: "min-height:80px" });
            ta.value = value;
            ta.oninput = () => setNested(pbContent, path, ta.value);
            container.appendChild(field(prettifyKey(path[path.length - 1]), ta));
          } else if (isImage) {
            const wrap = el("div");
            const input = textInput({ value });
            input.oninput = () => setNested(pbContent, path, input.value);
            wrap.appendChild(input);
            if (value) {
              const preview = el("img", { src: value, alt: "", style: "width:100%;max-height:120px;object-fit:cover;border-radius:var(--radius-sm);margin-top:8px" });
              wrap.appendChild(preview);
            }
            const pickBtn = btn("Choose image", "outline sm", () => openImagePicker((url) => {
              input.value = url;
              setNested(pbContent, path, url);
              // Update preview
              let img = wrap.querySelector("img");
              if (img) img.src = url;
              else { img = el("img", { src: url, alt: "", style: "width:100%;max-height:120px;object-fit:cover;border-radius:var(--radius-sm);margin-top:8px" }); input.after(img); }
            }));
            pickBtn.style.marginTop = "6px"; pickBtn.style.width = "100%";
            wrap.appendChild(pickBtn);
            container.appendChild(field(prettifyKey(path[path.length - 1]), wrap));
          } else {
            const input = textInput({ value });
            input.oninput = () => setNested(pbContent, path, input.value);
            container.appendChild(field(prettifyKey(path[path.length - 1]), input));
          }
        } else if (typeof value === "number") {
          const input = textInput({ type: "number", value: String(value) });
          input.oninput = () => setNested(pbContent, path, parseFloat(input.value) || 0);
          container.appendChild(field(prettifyKey(path[path.length - 1]), input));
        } else if (typeof value === "boolean") {
          const check = el("input", { type: "checkbox" });
          if (value) check.checked = true;
          check.onchange = () => setNested(pbContent, path, check.checked);
          const lbl = el("label", { class: "row-check", style: "margin-bottom:0" });
          lbl.appendChild(check);
          lbl.appendChild(el("span", { text: " " + prettifyKey(path[path.length - 1]) }));
          container.appendChild(lbl);
        } else if (Array.isArray(value)) {
          // Array → repeater (cards with add/remove/reorder)
          const arrLabel = el("div", { class: "field" });
          arrLabel.appendChild(el("label", { text: prettifyKey(path[path.length - 1]) }));
          container.appendChild(arrLabel);
          for (let i = 0; i < value.length; i++) {
            const itemWrap = el("div", { style: "border:1px solid var(--line);border-radius:var(--radius-sm);padding:14px;margin-bottom:10px;position:relative" });
            // Item number + delete button
            const itemHead = el("div", { style: "display:flex;justify-content:space-between;align-items:center;margin-bottom:8px" });
            itemHead.appendChild(el("span", { class: "badge badge-blue", text: `#${i + 1}` }));
            const delBtn = el("button", { class: "btn btn-danger btn-sm", text: "Remove", onclick: () => { value.splice(i, 1); drawContentEditor(); } });
            itemHead.appendChild(delBtn);
            itemWrap.appendChild(itemHead);
            // Render the item's fields
            renderValueEditor(itemWrap, value[i], [...path, i]);
            container.appendChild(itemWrap);
          }
          // Add button
          const addBtn = el("button", { class: "btn btn-outline btn-sm btn-block", text: "+ Add item", onclick: () => {
            // Clone the structure of the last item, or add a blank string
            if (value.length > 0 && typeof value[0] === "object") {
              value.push(JSON.parse(JSON.stringify(value[value.length - 1])));
            } else {
              value.push("");
            }
            drawContentEditor();
          }});
          container.appendChild(addBtn);
        } else if (typeof value === "object") {
          // Nested object → render each field
          for (const [k, v] of Object.entries(value)) {
            if (k.startsWith("_")) continue;
            renderValueEditor(container, v, [...path, k]);
          }
        }
      }

      // Set a value at a nested path in the content object.
      // path can contain string keys AND integer array indices.
      function setNested(obj, path, val) {
        let cur = obj;
        for (let i = 0; i < path.length - 1; i++) {
          cur = cur[path[i]];
        }
        cur[path[path.length - 1]] = val;
      }

      // "whyTitle" → "Why title", "heroImage" → "Hero image"
      function prettifyKey(key) {
        if (typeof key === "number") return String(key);
        return key
          .replace(/([A-Z])/g, " $1")
          .replace(/^./, (s) => s.toUpperCase())
          .replace(/\bId\b/gi, "ID");
      }

      async function savePageContent() {
        showLoading();
        try {
          await writeFile(pbContentPath || `${CONTENT_DIR}/${pbSlug}.json`, JSON.stringify(pbContent, null, 2) + "\n", `CMS: edit ${pbSlug} page content`);
          hideLoading();
          toast("Page saved! Site rebuilds in ~90 seconds.", "success", "Published");
        } catch (e) {
          hideLoading();
          toast(e.message, "error", "Save failed");
        }
      }

      // Open page builder for a specific page (called from Pages list)
      async function openPageBuilderFor(path) {
        navigate("pagebuilder");
        const slug = path === "/" ? "home" : path.replace(/^\//, "").replace(/\/$/, "").replace(/\//g, "-");
        setTimeout(() => loadPageContent(slug, "visual"), 100);
      }

      //=====================================================================
      // SECTION: MEDIA
      //=====================================================================
      async function renderMedia(root) {
        root.appendChild(pageHead("Media Library", "Upload and manage images across your site.", [
          el("button", { class: "btn btn-primary", onclick: () => mediaUploadModal(), html: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Upload' }),
        ]));
        const wrap = el("div", { id: "media-wrap" });
        root.appendChild(wrap);
        showLoading();
        await loadMediaGrid(wrap);
        hideLoading();
      }

      async function loadMediaGrid(wrap) {
        wrap.innerHTML = "";
        // Folder filter
        const folderSel = el("select", { id: "media-folder", style: "max-width:200px;margin-bottom:16px" });
        folderSel.appendChild(el("option", { value: "all", text: "All folders" }));
        for (const f of MEDIA_FOLDERS) folderSel.appendChild(el("option", { value: f, text: f }));
        folderSel.onchange = () => loadMediaGrid(wrap);
        wrap.appendChild(folderSel);

        const grid = el("div", { class: "img-picker", id: "media-grid", style: "max-height:none" });
        wrap.appendChild(grid);
        grid.innerHTML = '<div class="empty" style="grid-column:1/-1">Loading…</div>';

        const selFolder = folderSel.value;
        const folders = selFolder === "all" ? MEDIA_FOLDERS : [selFolder];
        const all = [];
        for (const folder of folders) {
          try {
            const res = await listDir(`public/images/${folder}`);
            if (res.items) for (const it of res.items) {
              if (IMG_EXT.test(it.name)) all.push({ ...it, folder, url: `/images/${folder}/${it.name}` });
            }
          } catch (e) {}
        }
        if (!all.length) {
          grid.innerHTML = '<div class="empty" style="grid-column:1/-1"><h3>No images yet</h3><p>Click Upload to add some.</p></div>';
          return;
        }
        grid.innerHTML = "";
        for (const img of all) {
          const item = el("div", { class: "img-picker-item", title: img.name });
          item.appendChild(el("img", { src: img.url, alt: img.name, loading: "lazy" }));
          item.onclick = () => mediaDetailsModal(img, () => loadMediaGrid(wrap));
          grid.appendChild(item);
        }
      }

      function mediaUploadModal() {
        showModal(`<div class="modal-head"><h2>Upload images</h2><button class="modal-close" onclick="closeModal()">&times;</button></div>
          <div class="modal-body">
            <div class="upload-zone" id="mu-zone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <div><b>Click to browse</b> or drag &amp; drop</div>
              <input type="file" id="mu-file" accept="image/*" multiple style="display:none" />
            </div>
            <div class="field" style="margin-top:16px">
              <label>Destination folder</label>
              <select id="mu-folder"></select>
            </div>
            <div id="mu-preview"></div>
          </div>
          <div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal()">Close</button></div>`, { size: "lg" });

        const folderSel = $("#mu-folder");
        for (const f of MEDIA_FOLDERS) folderSel.appendChild(el("option", { value: f, text: `images/${f}/` }));

        const zone = $("#mu-zone");
        const fileInput = $("#mu-file");
        zone.onclick = () => fileInput.click();
        zone.ondragover = (e) => { e.preventDefault(); zone.classList.add("drag"); };
        zone.ondragleave = () => zone.classList.remove("drag");
        zone.ondrop = (e) => { e.preventDefault(); zone.classList.remove("drag"); doUpload(e.dataTransfer.files); };
        fileInput.onchange = () => doUpload(fileInput.files);

        async function doUpload(files) {
          if (!files || !files.length) return;
          showLoading();
          const folder = folderSel.value;
          try {
            for (const file of Array.from(files)) {
              if (!file.type.startsWith("image/")) continue;
              const b64 = await fileToB64(file);
              const safeName = file.name.toLowerCase().replace(/[^a-z0-9.-]/g, "-").replace(/-+/g, "-");
              await uploadFile(`public/images/${folder}/${safeName}`, b64, `CMS: upload ${safeName}`);
            }
            hideLoading();
            toast("Upload complete! Rebuilding…", "success", "Images added");
            closeModal();
            navigate("media");
