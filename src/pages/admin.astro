      function newPageModal() {
        let html = `<div class="modal-head"><h2>Create a new page</h2><button class="modal-close" onclick="closeModal()">&times;</button></div>
          <div class="modal-body">
            <div class="field">
              <label>Page title</label>
              <input type="text" id="np-title" placeholder="e.g. Summerlin Photography Special" />
            </div>
            <div class="field">
              <label>URL slug</label>
              <input type="text" id="np-slug" placeholder="summerlin-special" />
              <div class="hint">The page will live at <b>/slug/</b>. Lowercase letters and dashes only.</div>
            </div>
            <div class="field">
              <label>Choose a starting template</label>
            </div>
            <div class="stats" id="np-presets" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));margin-bottom:0"></div>
          </div>
          <div class="modal-foot">
            <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
            <button class="btn btn-primary" id="np-create">Create page</button>
          </div>`;
        showModal(html, { size: "lg" });

        const grid = $("#np-presets");
        let chosenPreset = "Real Estate Service";
        const presetKeys = Object.keys(PAGE_PRESETS);
        for (const key of presetKeys) {
          const preset = PAGE_PRESETS[key];
          const opt = el("div", { class: "stat", style: "cursor:pointer", "data-preset": key });
          opt.appendChild(el("div", { text: key, style: "font-size:14px;font-weight:600;margin-bottom:4px" }));
          opt.appendChild(el("div", { text: preset.desc, style: "font-size:12px;color:var(--muted);line-height:1.4" }));
          if (key === chosenPreset) opt.style.borderColor = "var(--brass)";
          opt.onclick = () => {
            chosenPreset = key;
            $$("#np-presets .stat").forEach(s => s.style.borderColor = "var(--line)");
            opt.style.borderColor = "var(--brass)";
          };
          grid.appendChild(opt);
        }

        // Auto-generate slug from title
        $("#np-title").oninput = () => {
          const slug = $("#np-title").value.toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
          $("#np-slug").value = slug;
        };

        $("#np-create").onclick = async () => {
          const title = $("#np-title").value.trim();
          let slug = $("#np-slug").value.trim().toLowerCase().replace(/[^a-z0-9-]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
          if (!title || !slug) { toast("Enter a title and slug.", "error"); return; }

          const preset = PAGE_PRESETS[chosenPreset];
          const content = JSON.parse(JSON.stringify(preset.content));
          content._page = title;
          content._slug = slug;
          if (content.seo) content.seo.title = content.seo.title.replace("New Service", title).replace("Location", title).replace("New Page", title);

          showLoading();
          try {
            // Save the content JSON
            pbContentPath = `${CONTENT_DIR}/${slug}.json`;
            await writeFile(pbContentPath, JSON.stringify(content, null, 2) + "\n", `CMS: create new page ${slug}`);
