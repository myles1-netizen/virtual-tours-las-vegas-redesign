        // Shared controls for a root-level array container (testimonials/faq/portfolio).
        function bindRootArrayControls(container, templateFn) {
          container.querySelectorAll("[data-array-item]").forEach(function (item) {
            wireRootItem(container, item);
          });
          container._template = templateFn;
        }
        function wireRootItem(container, item) {
          var up = item.querySelector("[data-move='-1']");
          var down = item.querySelector("[data-move='1']");
          var rm = item.querySelector("[data-remove]");
          if (up) up.onclick = function () { var p = item.previousElementSibling; if (p) container.insertBefore(item, p); };
          if (down) down.onclick = function () { var n = item.nextElementSibling; if (n) container.insertBefore(n, item); };
          if (rm) rm.onclick = function () { if (confirm("Remove this item?")) item.remove(); };
        }
        function addRootArrayitem(containerId, innerHtml) {
          var container = document.getElementById(containerId);
          var div = document.createElement("div");
          div.className = "item";
          div.setAttribute("data-array-item", "");
          div.innerHTML = '<div class="item-head"><span class="item-title">New entry</span><div class="item-tools">' +
            '<button type="button" data-move="-1">↑</button><button type="button" data-move="1">↓</button>' +
            '<button type="button" class="danger" data-remove>✕</button></div></div>' + innerHtml;
          container.appendChild(div);
          wireRootItem(container, div);
          div.scrollIntoView({ behavior: "smooth", block: "center" });
          var first = div.querySelector("[data-item-field]");
          if (first) first.focus();
        }

        // ===== F. Services =====
        function buildServices() {
