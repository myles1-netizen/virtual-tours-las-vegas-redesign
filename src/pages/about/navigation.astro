---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CTABand from "../../components/CTABand.astro";
import { business } from "../../data/site";

const title = "How to Navigate a Virtual Tour — Controls Help | VTLV";
const description = "Having trouble moving through a 3D virtual tour? Mike Madsen's quick guide to Matterport tour controls on phone, tablet and desktop — touch gestures, mouse, keyboard, dollhouse and floor plan views.";

const devices = [
  {
    title: "Touch devices",
    sub: "Phone & tablet",
    icon: "M5 4h4v16H5z M15 4h4v16h-4z M5 4h14 M5 20h14",
    steps: [
      "Drag one finger up or down to tilt the viewing angle.",
      "Pinch with two fingers to zoom in and out.",
      "Swipe or move in a circular motion with one finger to rotate the view and look around.",
      "Tap a floor marker or navigation point to walk to that spot.",
    ],
  },
  {
    title: "Desktop & laptop",
    sub: "Mouse & keyboard",
    icon: "M2 12h20 M12 2a10 10 0 0 0 0 20 10 10 0 0 0 0-20z M5 8h14 M5 16h14",
    steps: [
      "Click and drag with the mouse to look around — it mirrors the touch gestures.",
      "Scroll the mouse wheel to zoom in and out.",
      "Use the keyboard arrow keys to move forward, back, left and right through the space.",
      "Click a navigation circle on the floor to walk to that position.",
    ],
  },
];

const views = [
  {
    title: "Dollhouse view",
    body: "The miniature 3D model of the whole property. Rotate it to see every level and room at once, then click any room to drop straight in. Great for understanding the full layout at a glance.",
    icon: "M3 21h18 M5 21V7l7-4 7 4v14 M9 21v-5h6v5",
  },
  {
    title: "Floor plan view",
    body: "A top-down, two-dimensional layout of each level. Switch floors with the level selector and click any room to navigate there. The cleanest way to compare room sizes and flow.",
    icon: "M3 3h18v18H3z M3 9h18 M9 21V9 M15 21V9",
  },
  {
    title: "Measurement tools",
    body: "On supported tours, click the measure icon to dimension walls, doors and fixtures right inside the model. Useful for checking whether your furniture will fit before the showing.",
    icon: "M21.3 8.7 8.7 21.3a1 1 0 0 1-1.4 0l-4.6-4.6a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4z M14 7l3 3",
  },
];
---
<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="Help"
    title="Having trouble navigating a tour?"
    lead="The 3D virtual tours on this site work on any device — phones, tablets, laptops and desktops. Here's how to move through them. If a tour still won't cooperate, Mike's a phone call away."
    image={asset("/images/portfolio/matterport-360.jpg")}
    imageAlt="360-degree virtual tour panorama of a Las Vegas listing"
  />

  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Basic controls"
        title="Move through the space the way you'd move through a home."
        lead="The tour is a real walkthrough, not a slideshow. Once you're inside, you can look around, walk between rooms, and switch to bird's-eye views of the whole property."
        align="center"
      />
    </div>
  </section>

  <section class="section sm">
    <div class="container">
      <div class="device-grid">
        {devices.map((d, i) => (
          <article class="device-card" data-reveal data-reveal-delay={(i % 2) + 1}>
            <div class="device-head">
              <span class="device-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={d.icon}/></svg>
              </span>
              <div>
                <h2 class="device-title">{d.title}</h2>
                <p class="device-sub">{d.sub}</p>
              </div>
            </div>
            <ol class="device-steps">
              {d.steps.map((s) => (
                <li>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{s}</span>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Views & tools"
        title="Three views, one model."
        lead="Beyond walking through room by room, every Matterport tour offers three powerful ways to understand the property. Find them in the toolbar at the bottom left of the tour."
        align="center"
      />
      <div class="view-grid">
        {views.map((v, i) => (
          <article class="view-card" data-reveal data-reveal-delay={(i % 3) + 1}>
            <span class="view-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={v.icon}/></svg>
            </span>
            <h3 class="view-title">{v.title}</h3>
            <p class="view-body">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Still stuck?"
        title="Mike's happy to walk you through it."
        lead={`Tours are designed to be intuitive, but every now and then a device or browser needs a nudge. Call or text ${business.phone} and I'll talk you through it in a minute or two.`}
        align="center"
      />
      <div class="btn-row" style="justify-content:center; margin-top:1.5rem">
        <a href={business.phoneHref} class="btn brass">Call {business.phone}</a>
        <a href={asset("/contact/")} class="btn outline">Send a message</a>
      </div>
    </div>
  </section>

  <CTABand
    title="Want to see a tour in action?"
    body="Open a live 3D walkthrough and try the controls yourself."
    image={asset("/images/portfolio/matterport-measurements.jpg")}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .device-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }
  .device-card {
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.2rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
  }
  .device-head { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.4rem; }
  .device-badge {
    flex-shrink: 0;
    width: 48px; height: 48px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brass-soft);
    color: var(--brass);
    border-radius: var(--radius);
  }
  .device-title { font-size: var(--step-2); }
  .device-sub { font-size: var(--step--1); color: var(--stone); }
  .device-steps { display: flex; flex-direction: column; gap: 0.8rem; counter-reset: step; }
  .device-steps li {
    display: flex; gap: 0.7rem; align-items: flex-start;
    font-size: var(--step--1); color: var(--ink-2); line-height: 1.5;
    padding-left: 0;
  }
  .device-steps svg { color: var(--brass); flex-shrink: 0; margin-top: 3px; }

  .view-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .view-card {
    padding: clamp(1.4rem, 1.1rem + 1.5vw, 2rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column; gap: 0.7rem;
  }
  .view-icon {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brass-soft);
    color: var(--brass);
    border-radius: var(--radius);
  }
  .view-title { font-size: var(--step-1); }
  .view-body { font-size: var(--step--1); color: var(--stone); line-height: 1.55; }

  @media (max-width: 820px) {
    .device-grid { grid-template-columns: 1fr; }
    .view-grid { grid-template-columns: 1fr; }
  }
</style>
