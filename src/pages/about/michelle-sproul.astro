---
import { asset } from "../../data/site";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import TrustBar from "../../components/TrustBar.astro";
import CTABand from "../../components/CTABand.astro";
import { business } from "../../data/site";

const title = "Michelle Sproul — Licensed Las Vegas Realtor & Co-Founder | VTLV";
const description = "Michelle Sproul is a licensed Nevada real estate agent who co-founded Virtual Tours Las Vegas with her husband Mike Madsen in 2010. A Realtor with deep Las Vegas market knowledge, she helps keep the business rooted in what agents and sellers actually need.";

// NOTE on framing (per handoff/07-LEGAL-ACCURACY-GUIDELINES.md, RESOLVED section):
// Michelle is confirmed to be Mike's wife AND a real, licensed Realtor who
// co-founded the business with him. "We started this together" is explicitly
// allowed for the founding/history. "REALTOR®" (registered mark) requires
// confirmed active NAR membership, so we use "licensed real estate agent" /
// "Realtor" (common noun) unless that's separately verified.
---

<Base title={title} description={description} heroVariant="dark">
  <PageHero
    eyebrow="About"
    title="The other half of the family business."
    lead="Michelle Sproul is a licensed Nevada real estate agent and the co-founder of Virtual Tours Las Vegas. She and Mike started the business together in 2010 — she keeps it anchored to what agents and sellers actually need on the ground."
    image={asset("/images/portfolio/sierra-skye-kitchen.jpg")}
    imageAlt="Modern Las Vegas kitchen photographed for a residential listing"
  />

  {/* ===== STORY ===== */}
  <section class="section">
    <div class="container">
      <div class="michelle-grid">
        <div class="michelle-text" data-reveal>
          <p class="eyebrow">The story</p>
          <h2 class="display michelle-title">We started this together.</h2>
          <div class="michelle-body">
            <p>
              Virtual Tours Las Vegas isn't a one-person story. <strong>Mike and Michelle Sproul co-founded the
              business in {business.since}</strong>, bringing two complementary sides of real estate under one roof:
              Mike behind the camera, Michelle with a licensed agent's eye for what actually sells a listing.
            </p>
            <p>
              Michelle is a <strong>licensed Nevada real estate agent</strong> who has worked in and around the Las
              Vegas market for years. That matters because good real estate photography isn't just about a clean
              exposure — it's about knowing what a buyer's eye lands on, what MLS compliance requires, and how a
              listing package should be sequenced to earn the click. Michelle keeps the business honest on all of it.
            </p>
            <p>
              Day to day, Mike is the one on-site for every shoot, scan and flight — that part genuinely is him
              alone. But the business itself, the standards, the pricing philosophy of <em>real published prices
              and no quote-and-wait</em>, came out of conversations between two people who'd both sat on the
              agent's side of the desk. That's the partnership clients are really hiring.
            </p>
          </div>
          <div class="michelle-cta">
            <a href={asset("/about/")} class="text-link">Meet Mike Madsen →</a>
            <a href={asset("/contact/")} class="btn brass">Work with us</a>
          </div>
        </div>

        <aside class="michelle-side" data-reveal data-reveal-delay="2">
          <div class="role-card">
            <p class="eyebrow">Michelle's role</p>
            <ul class="role-list" role="list">
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span><strong>Licensed Nevada real estate agent</strong></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span><strong>Co-founded</strong> Virtual Tours Las Vegas with Mike in {business.since}</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Keeps listing packages aligned with <strong>what agents and sellers actually need</strong></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Brings the <strong>agent's perspective</strong> to every pricing and service decision</span>
              </li>
            </ul>
            <hr class="divider" style="margin-block:1.4rem" />
            <ul class="facts-list" role="list">
              <li><span>Role</span><strong>Co-founder &amp; Realtor</strong></li>
              <li><span>License</span><strong>Nevada real estate</strong></li>
              <li><span>Business since</span><strong>{business.since}</strong></li>
              <li><span>Based in</span><strong>{business.areaNote}</strong></li>
              <li><span>Serves</span><strong>{business.serviceArea.join(" · ")}</strong></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ===== WHY A REALTOR BEHIND THE BUSINESS MATTERS ===== */}
  <section class="section dark why-section">
    <div class="container">
      <SectionHeader
        eyebrow="Why it matters"
        title="A photographer who shoots listings is good. A business co-founded by an agent is better."
        lead="Michelle's license isn't a wall decoration. It's why VTLV's pricing, deliverables and turnaround all line up with how listings actually get marketed in the Las Vegas Valley."
      />
      <div class="why-grid">
        <article data-reveal>
          <h3>MLS-native thinking</h3>
          <p>An agent knows MLS formats, branded vs. unbranded rules, and how a photo gallery should be ordered. Every deliverable Mike ships is built to slot straight into a live listing.</p>
        </article>
        <article data-reveal data-reveal-delay="1">
          <h3>Pricing agents can defend</h3>
          <p>Real published prices — no quote-and-wait — exist because an agent co-founded the business. Agents know what they're quoting a seller before they pick up the phone.</p>
        </article>
        <article data-reveal data-reveal-delay="2">
          <h3>Two sides of the desk</h3>
          <p>Mike shoots. Michelle keeps the work rooted in what closes deals. Together they've covered the Las Vegas Valley from both ends of the transaction since {business.since}.</p>
        </article>
        <article data-reveal data-reveal-delay="3">
          <h3>A family business, run solo in practice</h3>
          <p>Co-founded by a married couple, but Mike is the one behind the camera on every job. No rotating crew, no outsourcing — just the standard two people set together.</p>
        </article>
      </div>
    </div>
  </section>

  {/* ===== TRUSTED BY ===== */}
  <section class="section sm">
    <div class="container">
      <TrustBar />
    </div>
  </section>

  <CTABand
    title="Work with a business built by agents, for agents."
    body={`Co-founded by a licensed Realtor. Call or text ${business.phone} to book a shoot.`}
  />
</Base>

<style>
  .michelle-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .michelle-title { font-size: var(--step-4); margin-top: 0.3rem; margin-bottom: 1.5rem; }
  .michelle-body { display: flex; flex-direction: column; gap: 1rem; color: var(--stone); line-height: 1.65; }
  .michelle-body strong { color: var(--ink); }
  .michelle-body em { font-style: italic; }
  .michelle-cta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }

  .role-card {
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    position: sticky;
    top: 100px;
  }
  .role-list { display: flex; flex-direction: column; gap: 0.85rem; margin-top: 0.8rem; }
  .role-list li {
    display: flex; gap: 0.65rem; align-items: flex-start;
    font-size: var(--step--1); color: var(--ink-2); line-height: 1.4;
  }
  .role-list svg { color: var(--brass); flex-shrink: 0; margin-top: 2px; }
  .role-list strong { color: var(--ink); }
  .facts-list { display: flex; flex-direction: column; gap: 0.7rem; }
  .facts-list li {
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: var(--step--1);
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line-light);
  }
  .facts-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .facts-list span { color: var(--stone); }
  .facts-list strong { color: var(--ink); font-weight: 600; }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    margin-top: 2.5rem;
  }
  .why-grid article { display: flex; flex-direction: column; gap: 0.6rem; }
  .why-grid h3 { color: var(--on-dark); font-size: var(--step-1); }
  .why-grid p { color: rgba(247,244,239,0.7); font-size: var(--step--1); line-height: 1.5; }

  @media (max-width: 980px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
    .role-card { position: static; }
  }
  @media (max-width: 820px) {
    .michelle-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
