---
import { asset } from "../data/site";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PricingCard from "../components/PricingCard.astro";
import PriceTable from "../components/PriceTable.astro";
import PriceCalculator from "../components/PriceCalculator.astro";
import CTABand from "../components/CTABand.astro";
import {
  vegasPackages, hdrTiers, hdrAddOns, matterportTiers, floorPlanTiers,
  floorPlanAddOns, virtualStagingTiers, videoTiers, commercialHdr,
  commercialPanoramas, googlePackage, business,
} from "../data/site";

const title = "Pricing — Las Vegas Real Estate Photography Packages | VTLV";
const description = "Real, published Las Vegas real estate photography pricing. Glitz & Glam, City Never Sleeps and Neon Skyline packages plus individual pricing for HDR, Matterport 3D, drone, floor plans, virtual staging, video and commercial work. No quote-and-wait.";

// Pricing JSON-LD: a Service carrying an OfferCatalog of the three residential
// packages, plus line-item Offers for the headline à la carte tiers. Each Offer
// uses PriceSpecification so price is unambiguous to crawlers.
const base = Astro.site?.toString().replace(/\/$/, "") ?? "";
const pricingUrl = new URL(Astro.url.pathname, base).toString();
const offers = [
  ...vegasPackages.map((p) => ({
    "@type": "Offer",
    name: p.name,
    description: p.blurb,
    price: String(p.price),
    priceCurrency: "USD",
    priceSpecification: { "@type": "PriceSpecification", price: p.price, priceCurrency: "USD" },
    url: pricingUrl,
    availability: "https://schema.org/InStock",
  })),
  {
    "@type": "Offer",
    name: "Matterport 3D tour (from)",
    price: String(matterportTiers[0].price),
    priceCurrency: "USD",
    priceSpecification: { "@type": "PriceSpecification", price: matterportTiers[0].price, priceCurrency: "USD" },
    url: pricingUrl,
  },
  {
    "@type": "Offer",
    name: "HDR photography (from)",
    price: String(hdrTiers[0].price),
    priceCurrency: "USD",
    priceSpecification: { "@type": "PriceSpecification", price: hdrTiers[0].price, priceCurrency: "USD" },
    url: pricingUrl,
  },
];
const pricingLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Las Vegas Real Estate Photography Packages",
  description: "Published pricing for Las Vegas real estate photography, 3D tours, drone, floor plans and virtual staging.",
  provider: { "@id": `${base}/#business` },
  url: pricingUrl,
  offers: { "@type": "OfferCatalog", priceCurrency: "USD", offers },
};
---
<Base title={title} description={description} heroVariant="dark">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(pricingLd)} />
  <PageHero
    eyebrow="Transparent pricing"
    title="Real prices. No quote-and-wait."
    lead="Most photographers hide their rates. Mike doesn't. These are the actual published prices for Las Vegas real estate photography, 3D tours, drone, floor plans and virtual staging. Pick a package or build your own from the full price list."
    image={asset("/images/portfolio/spitze-interior.jpg")}
    imageAlt="Elegant Las Vegas living space captured with HDR real estate photography"
  />

  {/* ===== VEGAS PACKAGES ===== */}
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Residential packages"
        title="Three Las Vegas packages."
        lead="The most-booked combinations at a glance. Each one targets a different listing need. Pick the one that matches your property, or mix and match from the full price list below."
      />
      <div class="pkg-grid">
        {vegasPackages.map((p) => <PricingCard pkg={p} />)}
      </div>
      <p class="pricing-fine" data-reveal>
        Residential resale only · Larger properties priced per package · <a href={asset("/services/residential/")}>See what's in each →</a>
      </p>
    </div>
  </section>

  {/* ===== LIVE CALCULATOR ===== */}
  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Quote builder"
        title="Build your exact shoot. See the price now."
        lead="Start from a package above or skip to à la carte. Pick services, set the square footage, add what you need — the total updates as you go, with a clear line-by-line breakdown. No quote-and-wait."
      />
      <PriceCalculator />
    </div>
  </section>

  {/* ===== FULL PRICE LIST ===== */}
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Full price list"
        title="Build your own shoot."
        lead="Prefer to read the tables? Every service Mike offers, priced individually. Add to a package, or book standalone."
      />
      <div class="ala-grid">
        <PriceTable title="HDR photography" tiers={hdrTiers} />
        <PriceTable title="Matterport 3D tours" tiers={matterportTiers} note="Includes 2 MLS links + 6 months hosting" />
        <PriceTable title="Floor plans" tiers={floorPlanTiers} />
        <PriceTable title="Walk-through video & reels" tiers={videoTiers} />
        <PriceTable title="Virtual staging" tiers={virtualStagingTiers} />
        <PriceTable title="Premium 360 panoramas (8-shot)" tiers={commercialPanoramas.premium} />
      </div>

      <div class="addons-row" data-reveal>
        <div class="addon-col">
          <h3 class="addon-h">HDR add-ons</h3>
          <ul role="list">{hdrAddOns.map((a) => <li>{a}</li>)}</ul>
        </div>
        <div class="addon-col">
          <h3 class="addon-h">Floor plan add-ons</h3>
          <ul role="list">{floorPlanAddOns.map((a) => <li>{a}</li>)}</ul>
        </div>
        <div class="addon-col">
          <h3 class="addon-h">What's always included</h3>
          <ul role="list">
            <li>Free MLS slideshow</li>
            <li>Complimentary basic floor plan</li>
            <li>24–48 hour standard delivery</li>
            <li>Cloud delivery in MLS-ready format</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ===== COMMERCIAL ===== */}
  <section class="section paper-2">
    <div class="container">
      <SectionHeader
        eyebrow="Commercial pricing"
        title="For offices, retail, restaurants & venues."
        lead="Commercial assets are licensed for longer-term advertising use, typically 1–3 years. Custom quotes for unusual spaces; the most common scopes are listed below."
      />
      <div class="ala-grid">
        <PriceTable title="Commercial HDR photos" tiers={commercialHdr} />
        <PriceTable title="Express 360 panoramas" tiers={commercialPanoramas.express} />
      </div>

      <div class="gpack" data-reveal>
        <div class="gpack-text">
          <p class="eyebrow">Most-booked commercial package</p>
          <h3 class="display">{googlePackage.name}</h3>
          <p class="gpack-price">${googlePackage.price}</p>
          <ul class="gpack-includes" role="list">
            {googlePackage.includes.map((inc) => (
              <li>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{inc}</span>
              </li>
            ))}
          </ul>
          <p class="gpack-note">{googlePackage.note}</p>
          <a href={asset("/contact/")} class="btn brass">Book this package</a>
        </div>
        <div class="gpack-img">
          <img src={asset("/images/portfolio/warehouse-drone-2.jpg")} alt="Industrial property aerial view captured by an FAA-certified drone pilot" loading="lazy" width="600" height="450" />
        </div>
      </div>
    </div>
  </section>

  {/* ===== TURNAROUND ===== */}
  <section class="section dark turnaround">
    <div class="container narrow text-center">
      <SectionHeader
        eyebrow="Turnaround"
        title="How fast you'll get your media."
        align="center"
      />
      <div class="turn-grid">
        <div data-reveal><span class="turn-time">24–48h</span><span class="turn-what">HDR photography</span></div>
        <div data-reveal data-reveal-delay="1"><span class="turn-time">24–48h</span><span class="turn-what">3D virtual tours</span></div>
        <div data-reveal data-reveal-delay="2"><span class="turn-time">48h</span><span class="turn-what">Floor plans</span></div>
        <div data-reveal data-reveal-delay="3"><span class="turn-time">12–24h</span><span class="turn-what">Zillow walk-through video</span></div>
        <div data-reveal data-reveal-delay="4"><span class="turn-time">+$40</span><span class="turn-what">Rush: next-morning</span></div>
      </div>
    </div>
  </section>

  <CTABand
    title="Not sure which option fits?"
    body={`Tell Mike about the property and the budget, and he'll recommend the right scope. Call or text ${business.phone}.`}
  />
</Base>

<style>
  .paper-2 { background: var(--paper-2); }
  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 2.5rem;
  }
  .pricing-fine {
    text-align: center;
    color: var(--stone-2);
    font-size: var(--step--1);
    margin-top: 2rem;
  }
  .pricing-fine a { color: var(--brass); font-weight: 600; }

  .ala-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .addons-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .addon-col {
    padding: clamp(1.3rem, 1rem + 1vw, 1.8rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
  }
  .addon-h {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 1rem;
  }
  .addon-col ul { display: flex; flex-direction: column; gap: 0.6rem; }
  .addon-col li { font-size: var(--step--1); color: var(--ink-2); line-height: 1.4; padding-left: 1rem; position: relative; }
  .addon-col li::before { content: "·"; position: absolute; left: 0; color: var(--brass); font-weight: 700; }

  .gpack {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--dark);
    color: var(--paper);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
  }
  .gpack-text .eyebrow { color: var(--brass-2); }
  .gpack-text h3 { color: var(--paper); font-size: var(--step-3); margin-top: 0.4rem; }
  .gpack-price { font-family: var(--font-display); font-size: var(--step-5); color: var(--brass-2); margin-top: 0.5rem; }
  .gpack-includes { display: flex; flex-direction: column; gap: 0.55rem; margin: 1.3rem 0; }
  .gpack-includes li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: var(--step--1); color: rgba(247,244,239,0.85); }
  .gpack-includes svg { color: var(--brass-2); flex-shrink: 0; margin-top: 3px; }
  .gpack-note { font-size: 0.78rem; color: rgba(247,244,239,0.55); margin-bottom: 1.3rem; }
  .gpack-img { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4/3; }
  .gpack-img img { width: 100%; height: 100%; object-fit: cover; }

  .turn-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
    margin-top: 2.5rem;
  }
  .turn-grid > div {
    display: flex; flex-direction: column; gap: 0.4rem;
    padding: 1.5rem 1rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: rgba(247,244,239,0.04);
  }
  .turn-time { font-family: var(--font-display); font-size: var(--step-3); color: var(--brass-2); line-height: 1; }
  .turn-what { font-size: 0.82rem; color: rgba(247,244,239,0.7); }

  @media (max-width: 980px) {
    .pkg-grid { grid-template-columns: 1fr; max-width: 480px; margin-inline: auto; }
    .ala-grid { grid-template-columns: repeat(2, 1fr); }
    .addons-row { grid-template-columns: 1fr; }
    .turn-grid { grid-template-columns: repeat(2, 1fr); }
    .gpack { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .ala-grid { grid-template-columns: 1fr; }
    .turn-grid { grid-template-columns: 1fr; }
  }
</style>
