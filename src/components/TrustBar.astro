---
import { clients, asset } from "../data/site";
---
<div class="trustbar" data-reveal>
  <p class="trust-label">Trusted by Las Vegas agents, brokers &amp; brands</p>
  <div class="logos">
    {clients.map((c) => (
      <div class="logo">
        <img src={asset(c.src)} alt={`${c.name} — Virtual Tours Las Vegas client`} loading="lazy" />
      </div>
    ))}
  </div>
</div>

<style>
  .trustbar { width: 100%; }
  .trust-label {
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--stone-2);
    margin-bottom: 1.8rem;
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    max-width: 1040px;
    margin-inline: auto;
  }
  /* No background boxes or chips — logos float clean on the page surface.
     Grayscale + dimmed by default; full color on hover for a professional
     "as seen with" bar. Every logo locked to the same height (40px) with
     auto width so brands read at a consistent optical size. */
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .logo:hover {
    filter: grayscale(0);
    opacity: 1;
  }
  .logo img {
    height: 40px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  /* Dark mode: client logos are designed for light backgrounds, so on dark
     paper we invert their brightness so they read as light marks without any
     boxy white chip behind them. Grayscale hover still pops to full color. */
  :global([data-theme="dark"]) .logo img {
    filter: invert(1) hue-rotate(180deg);
  }
  :global([data-theme="dark"]) .logo:hover img {
    filter: invert(1) hue-rotate(180deg) grayscale(0);
  }
  @media (max-width: 600px) {
    .logos { gap: clamp(1.4rem, 8vw, 2.5rem); }
    .logo img { height: 32px; }
  }
</style>
