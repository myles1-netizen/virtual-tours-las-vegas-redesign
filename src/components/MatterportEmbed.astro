---
// Inline Matterport 3D tour embed with a click-to-load placeholder.
// The Matterport player is heavy (WASM 3D engine), so we never set the iframe
// src until the user explicitly opts in via the "Load Tour" button — this keeps
// below-the-fold tours off the wire on gallery/portfolio pages.
//
// Based on the architecture in handoff/plugin-research/wordpress-plugin-equivalents.md
// (section 10, "Matterport Shortcode" replacement, inline-iframe mode).
import { asset } from "../data/site";

export interface Props {
  /** Matterport model SID (the `m=` param). */
  modelId: string;
  /** Accessible name / on-screen title for the embed. */
  title: string;
  /** Optional placeholder image (absolute path from public/). Defaults to a neutral gradient. */
  placeholder?: string;
  /** Aspect ratio of the embed frame. */
  aspect?: "16/9" | "4/3";
  /** MLS-compliant mode: hides certain Matterport UI elements. */
  mls?: boolean;
  /** Autoplay the tour once loaded. */
  autoplay?: boolean;
  /** Remove Matterport branding (plan-dependent). */
  hideBrand?: boolean;
  /** Contact link used by the graceful "Book a demo" fallback if the model
      fails to load (wrong ID, network, or Matterport returns an error). */
  contactHref?: string;
}

const {
  modelId,
  title,
  placeholder,
  aspect = "16/9",
  mls = false,
  autoplay = false,
  hideBrand = false,
  contactHref,
} = Astro.props;

// Build the Matterport showcase URL once. Keep params minimal & standards-based.
const params = new URLSearchParams();
if (autoplay) params.set("play", "1");
if (mls) params.set("mls", "1");
if (hideBrand) params.set("brand", "0");
const qs = params.toString() ? `&${params.toString()}` : "";
const tourUrl = `https://my.matterport.com/show/?m=${modelId}${qs}`;

const frameId = `mp-${modelId.replace(/[^a-z0-9]/gi, "").slice(0, 12)}`;
---

<div
  class="mp-embed"
  data-mp-embed
  data-tour={tourUrl}
  style={`aspect-ratio:${aspect};`}
>
  {/* Placeholder overlay — shown until the user clicks "Load Tour".
      Clicking swaps in the iframe and removes the overlay (irreversible per mount). */}
  <button
    type="button"
    class="mp-placeholder"
    data-mp-load
    aria-label={`Load 3D tour: ${title}`}
  >
    {placeholder ? (
      <img
        class="mp-ph-img"
        src={asset(placeholder)}
        alt={title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="mp-ph-fallback" aria-hidden="true"></span>
    )}
    <span class="mp-ph-veil" aria-hidden="true"></span>
    <span class="mp-ph-cta">
      <span class="mp-ph-play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
      <span class="mp-ph-text">Load 3D Tour</span>
      <span class="mp-ph-title">{title}</span>
    </span>
  </button>

  {/* The iframe is rendered with NO src; JS sets it on click. loading="lazy" is a
     belt-and-suspenders guard in case the frame is ever pre-populated. */}
  <iframe
    class="mp-frame"
    id={frameId}
    data-mp-frame
    title={title}
    src=""
    loading="lazy"
    allow="xr-spatial-tracking; gyroscope; accelerometer; fullscreen"
    allowfullscreen
  ></iframe>

  {/* Graceful fallback: if the model fails to load (wrong ID, deleted, network,
      or Matterport returns its "Oops, model not available" page), JS reveals
      this overlay with a "Book a demo" CTA instead of leaving a broken frame. */}
  <div class="mp-error" data-mp-error hidden>
    <div class="mp-error-card">
      <span class="mp-error-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
      </span>
      <p class="mp-error-title">Live demo unavailable</p>
      <p class="mp-error-body">
        This sample 3D model couldn't be loaded right now. Book a demo and I'll walk you
        through a real Las Vegas property tour — dollhouse, floor plan and measurement views included.
      </p>
      <a class="mp-error-cta" href={contactHref || asset("/contact/")} data-mp-error-cta>
        Book a 3D tour demo
      </a>
    </div>
  </div>
</div>

<style>
  .mp-embed {
    position: relative;
    width: 100%;
    max-width: 100%;
    background: var(--paper-2, #efeae1);
    border-radius: var(--radius, 8px);
    overflow: hidden;
    box-shadow: var(--shadow-card, 0 4px 24px rgba(0,0,0,0.08));
  }
  .mp-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #1a1814;
  }
  /* Hide the frame until the user opts in (src is empty anyway, but this avoids
     a flash of empty framed box behind the placeholder). */
  .mp-frame:not([src]),
  .mp-frame[src=""] { opacity: 0; pointer-events: none; }
  .mp-frame:not([src=""]) { opacity: 1; }

  /* Placeholder button fills the frame and is the click target. */
  .mp-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 2;
    transition: opacity 0.4s var(--ease, ease);
  }
  .mp-embed[data-loaded="true"] .mp-placeholder { opacity: 0; pointer-events: none; }

  .mp-ph-img,
  .mp-ph-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Gradient fallback when no placeholder image is supplied. */
  .mp-ph-fallback {
    background:
      radial-gradient(120% 120% at 30% 20%, #2a2620 0%, #1a1814 60%, #0f0e0c 100%);
  }
  .mp-ph-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15,14,12,0.6) 0%, rgba(15,14,12,0.15) 60%);
    transition: background 0.3s var(--ease, ease);
  }
  .mp-placeholder:hover .mp-ph-veil,
  .mp-placeholder:focus-visible .mp-ph-veil {
    background: linear-gradient(0deg, rgba(15,14,12,0.7) 0%, rgba(15,14,12,0.3) 60%);
  }
  .mp-placeholder:focus-visible {
    outline: 3px solid var(--brass, #b08d57);
    outline-offset: -3px;
  }

  .mp-ph-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--paper, #f7f4ef);
    text-align: center;
    padding: 0 1.5rem;
  }
  .mp-ph-play {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brass, #b08d57);
    color: #fff;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    transition: transform 0.3s var(--ease, ease), background 0.3s var(--ease, ease);
  }
  .mp-placeholder:hover .mp-ph-play,
  .mp-placeholder:focus-visible .mp-ph-play {
    transform: scale(1.08);
    background: var(--brass-btn, #8a6a3c);
  }
  .mp-ph-text {
    font-family: var(--font-body, system-ui);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .mp-ph-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: rgba(247,244,239,0.85);
    max-width: 40ch;
    line-height: 1.3;
  }

  @media (max-width: 540px) {
    .mp-ph-play { width: 54px; height: 54px; }
    .mp-ph-title { font-size: 0.95rem; }
  }

  /* ===== Graceful error fallback =====
     Shown by JS ([data-mp-error] loses [hidden]) when the model fails to load.
     Covers the broken iframe so the visitor never sees Matterport's "Oops,
     model not available" screen — they get a clean "Book a demo" CTA instead. */
  .mp-error {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    padding: clamp(1.2rem, 4vw, 2.5rem);
    background: radial-gradient(120% 120% at 30% 20%, #2a2620 0%, #1a1814 60%, #0f0e0c 100%);
    text-align: center;
  }
  .mp-error[hidden] { display: none; }
  .mp-error-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    max-width: 44ch;
  }
  .mp-error-icon {
    width: 64px; height: 64px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: rgba(176, 141, 87, 0.16);
    color: var(--brass-2, #c9a572);
    margin-bottom: 0.3rem;
  }
  .mp-error-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.25rem;
    color: var(--paper, #f7f4ef);
  }
  .mp-error-body {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(247, 244, 239, 0.7);
  }
  .mp-error-cta {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7em 1.4em;
    background: var(--brass-btn, #8a6a3c);
    color: #fff;
    font-family: var(--font-body, system-ui);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.25s var(--ease, ease), transform 0.25s var(--ease, ease);
  }
  .mp-error-cta:hover { background: var(--brass-btn-2, #7a5e34); transform: translateY(-2px); }
</style>

<script>
  // Delegate click → set iframe src, mark loaded, hand focus to the frame.
  // One listener covers every MatterportEmbed on the page.
  function initEmbed(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>("[data-mp-load]");
    const frame = root.querySelector<HTMLIFrameElement>("[data-mp-frame]");
    const err = root.querySelector<HTMLElement>("[data-mp-error]");
    if (!btn || !frame) return;

    let failed = false;
    let loaded = false;

    // Show the graceful "Book a demo" fallback. Called when we believe the
    // model didn't load (see the heuristics in load()).
    const showError = () => {
      if (failed) return;
      failed = true;
      // Stop the broken frame from rendering Matterport's error page.
      frame.src = "about:blank";
      if (err) err.hidden = false;
    };

    const load = () => {
      if (root.dataset.loaded === "true") return;
      frame.src = root.dataset.tour || "";
      root.dataset.loaded = "true";
      // Give the player a beat, then move focus inside for keyboard users.
      window.setTimeout(() => { try { frame.focus({ preventScroll: true }); } catch {} }, 200);

      // === Failure detection ===
      // The iframe is cross-origin (my.matterport.com), so we can't read its
      // document to spot the "Oops, model not available" screen. Two heuristics
      // catch the common failures without false-positiving on slow loads:
      //   1. The frame's `error` event (network/CSP block of the host).
      //   2. A generous timeout: if nothing has fired `load` after 12s, the
      //      model likely didn't resolve → show the fallback.
      // A successful `load` event cancels the timeout so real tours render.
      const failTimer = window.setTimeout(() => {
        if (!loaded) showError();
      }, 12000);
      const onLoad = () => {
        loaded = true;
        window.clearTimeout(failTimer);
        frame.removeEventListener("error", showError);
      };
      frame.addEventListener("load", onLoad, { once: true });
      frame.addEventListener("error", showError, { once: true });
    };

    btn.addEventListener("click", load);
    // Auto-load when the embed scrolls into view, if the author opted in via data
    // (kept opt-in: nothing autoplays without an explicit attribute in markup).
    if ("IntersectionObserver" in window && root.dataset.autoload === "true") {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { load(); io.disconnect(); }
          }
        },
        { rootMargin: "200px" }
      );
      io.observe(root);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-mp-embed]").forEach(initEmbed);
</script>
