---
// Lazy-loaded Google Maps embed for the business location.
//
// Like MatterportEmbed / YouTubeEmbed, the heavy map iframe is NOT loaded until
// the visitor clicks the placeholder. Google Maps embeds pull a large JS bundle
// and set tracking cookies; this facade keeps that payload off the wire for
// everyone who never interacts with the map.
//
// Uses Google's free embeddable map URL (no API key required):
//   https://maps.google.com/maps?q=<address>&output=embed
// `frame-src` in Base.astro is widened to allow this host.
import { business } from "../data/site";

export interface Props {
  /** Address or place query to display. Defaults to the business address. */
  address?: string;
  /** Map zoom level (0–21). Reasonable default for a city view. */
  zoom?: number;
  /** Accessible label for the iframe. */
  label?: string;
  /** Aspect ratio of the embed frame. */
  aspect?: "16/9" | "4/3" | "1/1";
}

const {
  address = `${business.name}, Las Vegas, NV`,
  zoom = 13,
  label = `Map showing ${business.name} service area`,
  aspect = "16/9",
} = Astro.props;

const mapUrl = `https://maps.google.com/maps?q=${encodeURIComponent(
  address
)}&z=${zoom}&output=embed`;

const frameId = `map-${Math.abs(
  address.split("").reduce((a, c) => (a << 5) - a + c.charCodeAt(0), 0)
)
  .toString(36)
  .slice(0, 8)}`;
---

<div
  class="map-embed"
  data-map-embed
  data-src={mapUrl}
  style={`aspect-ratio:${aspect};`}
>
  <button
    type="button"
    class="map-placeholder"
    data-map-load
    aria-label={`Load map of ${address}`}
  >
    <span class="map-ph-fallback" aria-hidden="true"></span>
    <span class="map-ph-veil" aria-hidden="true"></span>
    <span class="map-ph-cta">
      <span class="map-ph-pin" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </span>
      <span class="map-ph-text">Load map</span>
      <span class="map-ph-title">{address}</span>
    </span>
  </button>

  <iframe
    class="map-frame"
    id={frameId}
    data-map-frame
    title={label}
    src=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

<style>
  .map-embed {
    position: relative;
    width: 100%;
    max-width: 100%;
    background: var(--paper-2, #efeae1);
    border-radius: var(--radius, 8px);
    overflow: hidden;
    box-shadow: var(--shadow-card, 0 4px 24px rgba(0,0,0,0.08));
  }
  .map-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #e8eaed;
  }
  .map-frame:not([src]),
  .map-frame[src=""] { opacity: 0; pointer-events: none; }
  .map-frame:not([src=""]) { opacity: 1; }

  .map-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 2;
    transition: opacity 0.4s var(--ease, ease);
  }
  .map-embed[data-loaded="true"] .map-placeholder { opacity: 0; pointer-events: none; }

  /* Stylized "map" backdrop — a soft paper-toned grid that reads as a map
     without pulling any external resource before the click. */
  .map-ph-fallback {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #e8e4dc 0%, #d9d4c8 100%);
  }
  .map-ph-fallback::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(0deg, rgba(26,24,20,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26,24,20,0.06) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.7;
  }
  .map-ph-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15,14,12,0.45) 0%, rgba(15,14,12,0.05) 60%);
    transition: background 0.3s var(--ease, ease);
  }
  .map-placeholder:hover .map-ph-veil,
  .map-placeholder:focus-visible .map-ph-veil {
    background: linear-gradient(0deg, rgba(15,14,12,0.55) 0%, rgba(15,14,12,0.2) 60%);
  }
  .map-placeholder:focus-visible {
    outline: 3px solid var(--brass, #b08d57);
    outline-offset: -3px;
  }

  .map-ph-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--paper, #f7f4ef);
    text-align: center;
    padding: 0 1.5rem;
  }
  .map-ph-pin {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brass, #b08d57);
    color: #fff;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    transition: transform 0.3s var(--ease, ease), background 0.3s var(--ease, ease);
  }
  .map-placeholder:hover .map-ph-pin,
  .map-placeholder:focus-visible .map-ph-pin {
    transform: scale(1.08);
    background: var(--brass-btn, #8a6a3c);
  }
  .map-ph-text {
    font-family: var(--font-body, system-ui);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .map-ph-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: rgba(247,244,239,0.9);
    max-width: 40ch;
    line-height: 1.3;
  }

  @media (max-width: 540px) {
    .map-ph-pin { width: 54px; height: 54px; }
    .map-ph-title { font-size: 0.95rem; }
  }
</style>

<script>
  function initEmbed(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>("[data-map-load]");
    const frame = root.querySelector<HTMLIFrameElement>("[data-map-frame]");
    if (!btn || !frame) return;

    const load = () => {
      if (root.dataset.loaded === "true") return;
      frame.src = root.dataset.src || "";
      root.dataset.loaded = "true";
      window.setTimeout(() => { try { frame.focus({ preventScroll: true }); } catch {} }, 200);
    };

    btn.addEventListener("click", load);
    if ("IntersectionObserver" in window && root.dataset.autoload === "true") {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { load(); io.disconnect(); }
          }
        },
        { rootMargin: "200px" }
      );
      io.observe(root);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-map-embed]").forEach(initEmbed);
</script>
