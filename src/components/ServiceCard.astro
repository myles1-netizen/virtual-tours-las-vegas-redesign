---
import { asset, type ServiceBuyer } from "../data/site";
export interface Props { b: ServiceBuyer; index?: number; }
const { b, index = 0 } = Astro.props;
---
<a class="scard" href={asset(b.href)} data-reveal data-reveal-delay={String((index % 3) + 1)}>
  <div class="scard-img">
    <img src={asset(b.image)} alt={b.alt} loading="lazy" width="600" height="450" />
    <div class="scard-overlay"></div>
    <span class="scard-tag">{b.audience}</span>
  </div>
  <div class="scard-body">
    <h3 class="scard-name display">{b.label}</h3>
    <p class="scard-blurb">{b.blurb}</p>
    <ul class="scard-services" role="list">
      {b.services.slice(0, 5).map((s) => <li>{s}</li>)}
      {b.services.length > 5 && <li class="more">+{b.services.length - 5} more</li>}
    </ul>
    <span class="text-link scard-link">Explore {b.label.toLowerCase()} <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .scard {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
    height: 100%;
  }
  .scard:hover {
    transform: translateY(-4px) scale(1.012);
    box-shadow: var(--shadow-lift);
    border-color: transparent;
  }
  /* Lift the card surface a touch in dark mode so it reads above the paper. */
  :global([data-theme="dark"]) .scard {
    background: var(--paper-2);
    box-shadow: var(--shadow-card);
  }
  :global([data-theme="dark"]) .scard:hover { box-shadow: var(--shadow-lift); }
  .scard-img {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }
  .scard-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .scard:hover .scard-img img { transform: scale(1.05); }
  .scard-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(15,14,12,0) 40%, rgba(15,14,12,0.55) 100%);
  }
  .scard-tag {
    position: absolute;
    bottom: 0.8rem; left: 0.8rem;
    color: var(--paper);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .scard-body { padding: clamp(1.4rem, 1rem + 1.5vw, 2rem); display: flex; flex-direction: column; gap: 0.85rem; flex-grow: 1; }
  .scard-name { font-size: var(--step-3); }
  .scard-blurb { color: var(--stone); font-size: var(--step--1); line-height: 1.5; }
  .scard-services {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .scard-services li {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-2);
    padding: 0.35em 0.7em;
    border: 1px solid var(--line-light);
    border-radius: 999px;
  }
  .scard-services li.more { color: var(--brass); border-color: var(--brass-soft); }
  .scard-link { margin-top: 0.6rem; }
</style>
