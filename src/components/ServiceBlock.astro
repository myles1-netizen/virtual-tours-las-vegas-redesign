---
// Alternating image/text feature block used on service pages.
export interface Props {
  image: string;
  alt: string;
  title: string;
  body: string;
  bullets?: string[];
  reverse?: boolean;
}
const { image, alt, title, body, bullets = [], reverse = false } = Astro.props;
---
<article class="sblock" data-reverse={reverse ? "true" : "false"} data-reveal>
  <div class="sblock-img">
    <img src={image} alt={alt} loading="lazy" width="700" height="525" />
  </div>
  <div class="sblock-body">
    <h3 class="display sblock-title">{title}</h3>
    <p class="sblock-text">{body}</p>
    {bullets.length > 0 && (
      <ul class="sblock-bullets" role="list">
        {bullets.map((b) => (
          <li>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .sblock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .sblock[data-reverse="true"] .sblock-img { order: 2; }
  .sblock-img {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: var(--shadow-card);
  }
  .sblock-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .sblock:hover .sblock-img img { transform: scale(1.03); }
  .sblock-title { font-size: var(--step-3); }
  .sblock-text { color: var(--stone); margin-top: 0.9rem; line-height: 1.6; }
  .sblock-bullets { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 1.2rem; }
  .sblock-bullets li {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .sblock-bullets svg { color: var(--brass); flex-shrink: 0; margin-top: 3px; }

  @media (max-width: 820px) {
    .sblock { grid-template-columns: 1fr; gap: 1.5rem; }
    .sblock[data-reverse="true"] .sblock-img { order: 0; }
  }
</style>
