---
// Alternating image/text feature block used on service pages.
export interface Props {
  image: string;
  alt: string;
  title: string;
  body: string;
  bullets?: string[];
  reverse?: boolean;
  /** Constrain the image to a smaller max-width inside its frame. Use this when
      the source image is low-resolution (e.g. a small schematic) so it isn't
      upscaled and blurred by object-fit: cover. The image sits on a neutral
      background at its natural size instead of being stretched. */
  imgConstrain?: boolean;
}
const { image, alt, title, body, bullets = [], reverse = false, imgConstrain = false } = Astro.props;
---
<article class="sblock" data-reverse={reverse ? "true" : "false"} data-reveal>
  <div class:list={["sblock-img", { "sblock-img--constrain": imgConstrain }]}>
    {/* The feature image is click-to-enlarge via the global lightbox.
        data-lightbox-src/full alt let the viewer show the full image with a
        caption, without leaving the page. */}
    <button
      type="button"
      class="sblock-img-btn"
      data-lightbox
      data-lightbox-src={image}
      data-lightbox-alt={alt}
      aria-label={`Enlarge image: ${alt}`}
    >
      <img src={image} alt={alt} loading="lazy" width="700" height="525" />
      <span class="sblock-zoom" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
      </span>
    </button>
  </div>
  <div class="sblock-body">
    <h3 class="display sblock-title">{title}</h3>
    <p class="sblock-text">{body}</p>
    {bullets.length > 0 && (
      <ul class="sblock-bullets" role="list">
        {bullets.map((b) => (
          <li>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .sblock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .sblock[data-reverse="true"] .sblock-img { order: 2; }
  .sblock-img {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: var(--shadow-card);
  }
  /* Low-res source images: instead of letting object-fit: cover stretch and
     blur a small schematic, center it on a neutral panel at a smaller display
     size so it reads crisp. The aspect-ratio frame is preserved so the layout
     doesn't jump. */
  .sblock-img--constrain {
    background: var(--paper-2);
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .sblock-img--constrain .sblock-img-btn {
    width: auto;
    max-width: 360px;
    height: auto;
    margin-inline: auto;
  }
  .sblock-img--constrain .sblock-img-btn img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
  }
  /* Click-to-enlarge: the image is a full-size button so the whole frame is
     the tap target, with a brass zoom badge that appears on hover. */
  .sblock-img-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    line-height: 0;
  }
  .sblock-img-btn:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }
  .sblock-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
  .sblock:hover .sblock-img img { transform: scale(1.03); }
  .sblock-zoom {
    position: absolute;
    bottom: 0.7rem;
    right: 0.7rem;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--brass);
    color: #fff;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    pointer-events: none;
  }
  .sblock:hover .sblock-zoom,
  .sblock-img-btn:focus-visible .sblock-zoom { opacity: 1; transform: scale(1); }
  .sblock-title { font-size: var(--step-3); }
  .sblock-text { color: var(--stone); margin-top: 0.9rem; line-height: 1.6; }
  .sblock-bullets { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 1.2rem; }
  .sblock-bullets li {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .sblock-bullets svg { color: var(--brass); flex-shrink: 0; margin-top: 3px; }

  @media (max-width: 820px) {
    .sblock { grid-template-columns: 1fr; gap: 1.5rem; }
    .sblock[data-reverse="true"] .sblock-img { order: 0; }
  }
</style>
