---
import { business } from "../data/site";

// Formsubmit.co AJAX endpoint. Free, no signup — the first submission triggers
// a one-time confirmation email to Mike, then it forwards every submission to
// his inbox permanently. No API key, no backend, works on static hosting.
// We POST JSON to the /ajax/ variant so the page never redirects away and we
// can show inline success/error states.
const FORMSUBMIT_ENDPOINT = "https://formsubmit.co/ajax/virtualtourslasvegas@gmail.com";

// Standard HTML POST endpoint (NOT the AJAX variant). Used by the <noscript>
// fallback form so visitors with JavaScript disabled (or a blocker that kills
// fetch/AJAX) can still submit via a normal browser POST. Formsubmit shows a
// thank-you page after a successful POST.
const FORMSUBMIT_POST_ENDPOINT = "https://formsubmit.co/virtualtourslasvegas@gmail.com";

// mailto: fallback used if the fetch fails (offline, network blocked, etc.) or
// when a visitor's browser refuses the cross-origin POST. Builds a rich body.
const MAILTO_FALLBACK = business.emailHref;

// The services a visitor can request. Multi-select (checkboxes) so they can
// check as many as apply. The labels match what the pricing/services pages
// advertise. "Other" reveals a free-text field for anything not listed.
const serviceOptions: string[] = [
  "HDR Photos",
  "Matterport 3D",
  "Drone",
  "Floor Plan",
  "Virtual Staging",
  "Twilight Photos",
  "Walk-Through Video",
  "Zillow 3D Home",
];
---

<form
  class="cform cform--js"
  data-form
  data-endpoint={FORMSUBMIT_ENDPOINT}
  data-mailto={MAILTO_FALLBACK}
  novalidate
>
  <div class="grid2">
    <label class="field">
      <span class="label">Name <span class="req">*</span></span>
      <input type="text" name="name" required autocomplete="name" aria-required="true" />
      <span class="field-error" data-error-for="name"></span>
    </label>
    <label class="field">
      <span class="label">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>
  </div>

  <div class="grid2">
    <label class="field">
      <span class="label">Email <span class="req">*</span></span>
      <input type="email" name="email" required autocomplete="email" aria-required="true" />
      <span class="field-error" data-error-for="email"></span>
    </label>
    <label class="field">
      <span class="label">Preferred date</span>
      <input type="date" name="preferred_date" />
    </label>
  </div>

  {/* Property type — with an "Other" reveal field so the visitor can describe a
      property type we didn't list (boat, vehicle, product shoot, etc.). */}
  <div class="field">
    <span class="label">Property type</span>
    <select name="property_type" data-ptype-select>
      <option value="">Select…</option>
      <option>Residential listing</option>
      <option>Commercial property</option>
      <option>Vacation rental (Airbnb/Vrbo)</option>
      <option>New construction / builder</option>
      <option>As-built / documentation</option>
      <option>Insurance / Xactimate</option>
      <option>Land / lot</option>
      <option value="Other">Other</option>
    </select>
    <label class="other-field" data-ptype-other hidden>
      <span class="label">Describe the property</span>
      <input type="text" name="property_type_other" placeholder="e.g. Yacht, vehicle, 50-unit apartment building" />
    </label>
  </div>

  {/* Services needed — multi-select checkboxes. The visitor can check any
     combination, and "Other" reveals a text field. Submitting flattens the
     checked values into a single readable "Services" string for the email. */}
  <fieldset class="field services-field">
    <legend class="label">Services needed <span class="req">*</span></legend>
    <p class="services-hint">Check all that apply.</p>
    <div class="services-checks">
      {serviceOptions.map((s) => (
        <label class="svc-check">
          <input type="checkbox" name="services" value={s} data-service-check />
          <span class="svc-check-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <span class="svc-check-label">{s}</span>
        </label>
      ))}
      <label class="svc-check svc-check--other">
        <input type="checkbox" name="services" value="Other" data-service-check data-service-other />
        <span class="svc-check-box" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="svc-check-label">Other</span>
      </label>
    </div>
    <label class="other-field" data-services-other hidden>
      <span class="label">What else do you need?</span>
      <input type="text" name="services_other" placeholder="Describe the service you need" />
    </label>
    <span class="field-error" data-error-for="services"></span>
  </fieldset>

  <label class="field">
    <span class="label">Property address / area</span>
    <input type="text" name="location" placeholder="e.g. Summerlin, Henderson, specific address" />
  </label>

  <label class="field">
    <span class="label">Message</span>
    <textarea name="message" rows="4" placeholder="Tell me about the property, square footage, and what you're hoping to achieve."></textarea>
  </label>

  {/* Honeypot: bots fill this, humans don't. Visually hidden AND off-screen so
      screen readers + browsers ignore it, but bots scraping field names don't.
      Formsubmit also recognises a "_honey" honeypot field natively — we use that
      exact name so Formsubmit drops the submission server-side even if JS fails. */}
  <div class="hp-wrap" aria-hidden="true">
    <label for="company-hp">Company (leave blank)</label>
    <input
      class="hp"
      id="company-hp"
      type="text"
      name="_honey"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
  </div>

  {/* Formsubmit hidden control fields:
      - _subject: the email subject line Mike sees
      - _template: table layout for a clean, structured email
      - _captcha: disable their built-in captcha (we have the honeypot above) */}
  <input type="hidden" name="_subject" value="New booking request from your website" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />

  <div class="form-actions">
    <button type="submit" class="btn brass btn-block" data-submit>
      <span class="submit-label">Send request</span>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>

    {/* Status messages — toggled by the submit handler below. */}
    <p class="form-status form-status--success" data-status="success" role="status" hidden>
      <strong>Your request has been sent! I'll respond within 24 hours.</strong>
    </p>
    <p class="form-status form-status--error" data-status="error" role="alert" hidden>
      Something went wrong. Please call Mike directly at <a href={business.phoneHref}>{business.phone}</a>.
    </p>

    <p class="form-alt">Prefer to talk? <a href={business.phoneHref}>Call or text {business.phone}</a></p>
    <p class="form-note">
      Your message goes straight to my inbox. No middleman sees it.
    </p>
  </div>
</form>

{/* ===== No-JavaScript fallback =====
    The AJAX form above only works with JS (it has no action/method — the submit
    handler intercepts and POSTs via fetch). When JS is disabled, or a tracker
    blocker kills the fetch, this standard HTML POST form takes over: it submits
    to Formsubmit's non-AJAX endpoint, which forwards the submission to Mike's
    inbox and shows a thank-you page. The AJAX form is hidden via CSS when JS is
    off, so visitors only ever see one usable form. */}
<noscript>
  <form
    class="cform cform--nojs"
    method="POST"
    action={FORMSUBMIT_POST_ENDPOINT}
  >
    <div class="grid2">
      <label class="field">
        <span class="label">Name <span class="req">*</span></span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="field">
        <span class="label">Phone</span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
    </div>

    <div class="grid2">
      <label class="field">
        <span class="label">Email <span class="req">*</span></span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="field">
        <span class="label">Preferred date</span>
        <input type="date" name="preferred_date" />
      </label>
    </div>

    <div class="field">
      <span class="label">Property type</span>
      <select name="property_type">
        <option value="">Select…</option>
        <option>Residential listing</option>
        <option>Commercial property</option>
        <option>Vacation rental (Airbnb/Vrbo)</option>
        <option>New construction / builder</option>
        <option>As-built / documentation</option>
        <option>Insurance / Xactimate</option>
        <option>Land / lot</option>
        <option>Other</option>
      </select>
    </div>

    <fieldset class="field services-field">
      <legend class="label">Services needed</legend>
      <p class="services-hint">Check all that apply.</p>
      <div class="services-checks">
        {serviceOptions.map((s) => (
          <label class="svc-check">
            <input type="checkbox" name="services" value={s} />
            <span class="svc-check-box" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <span class="svc-check-label">{s}</span>
          </label>
        ))}
        <label class="svc-check svc-check--other">
          <input type="checkbox" name="services" value="Other" />
          <span class="svc-check-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <span class="svc-check-label">Other</span>
        </label>
      </div>
    </fieldset>

    <label class="field">
      <span class="label">Property address / area</span>
      <input type="text" name="location" placeholder="e.g. Summerlin, Henderson, specific address" />
    </label>

    <label class="field">
      <span class="label">Message</span>
      <textarea name="message" rows="4" placeholder="Tell me about the property, square footage, and what you're hoping to achieve."></textarea>
    </label>

    {/* Honeypot + Formsubmit control fields (same as the AJAX form). */}
    <div class="hp-wrap" aria-hidden="true">
      <label for="company-hp-nojs">Company (leave blank)</label>
      <input class="hp" id="company-hp-nojs" type="text" name="_honey" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="_subject" value="New booking request from your website" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />

    <div class="form-actions">
      <button type="submit" class="btn brass btn-block">Send request</button>
      <p class="form-alt">Prefer to talk? <a href={business.phoneHref}>Call or text {business.phone}</a></p>
      <p class="form-note">
        Your message goes straight to my inbox. No middleman sees it.
      </p>
    </div>
  </form>
</noscript>

<style>
  .cform { display: flex; flex-direction: column; gap: 1.1rem; }
  /* Progressive enhancement: the AJAX form (.cform--js) has no action/method
     and only works when JS is available. When JS is OFF (no html[data-js] flag,
     set by Base.astro before paint), hide it so visitors only see the working
     <noscript> HTML POST form. When JS is ON, the <noscript> form is naturally
     absent from the DOM, so only the AJAX form shows. */
  .cform--js { display: none; }
  html[data-js] .cform--js { display: flex; flex-direction: column; gap: 1.1rem; }
  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.45rem; }
  .label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .req { color: var(--brass); }
  input, select, textarea {
    width: 100%;
    padding: 10px 14px;
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: 6px;
    font-size: 16px;
    color: var(--ink);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  textarea { min-height: 120px; font-family: inherit; }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--brass);
    box-shadow: 0 0 0 3px var(--brass-soft);
  }
  /* Invalid field highlight (set by the JS validator) */
  input[aria-invalid="true"],
  select[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: #c0392b;
    box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.15);
  }
  .field-error {
    font-size: 0.75rem;
    color: #c0392b;
    min-height: 0;
  }
  .field-error:not(:empty) { margin-top: 0.15rem; }

  /* Services multi-select — checkboxes styled as tappable chips. */
  .services-field { border: none; padding: 0; margin: 0; }
  .services-hint { font-size: 0.75rem; color: var(--stone-2); margin-top: -0.2rem; margin-bottom: 0.1rem; }
  .services-checks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.55rem;
    margin-top: 0.4rem;
  }
  .svc-check {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7em 0.85em;
    border: 1.5px solid var(--line-light);
    border-radius: var(--radius-sm);
    background: var(--paper);
    min-height: 48px;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .svc-check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .svc-check-box {
    width: 20px; height: 20px;
    display: grid; place-items: center;
    border-radius: 5px;
    border: 1.5px solid var(--line-light);
    color: transparent;
    flex-shrink: 0;
    transition: all 0.2s var(--ease);
  }
  .svc-check input:checked + .svc-check-box {
    background: var(--brass);
    border-color: var(--brass);
    color: #fff;
  }
  .svc-check:has(input:checked) {
    border-color: var(--brass);
    background: var(--brass-soft);
    box-shadow: 0 0 0 2px var(--brass-soft);
  }
  .svc-check input:focus-visible + .svc-check-box { outline: 2px solid var(--brass); outline-offset: 2px; }
  .svc-check-label { font-size: var(--step--1); color: var(--ink-2); font-weight: 500; }

  /* "Other" reveal field — shown when "Other" is chosen on a selector. */
  .other-field[hidden] { display: none; }
  .other-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.6rem;
    padding: 0.7rem 0.85rem;
    background: var(--brass-soft);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--brass);
  }
  .other-field input {
    background: var(--paper);
    min-height: 48px;
  }

  /* Honeypot: visually + accessibly hidden, but present in the DOM so bots
     that fill all inputs still trip it. */
  .hp-wrap {
    position: absolute !important;
    left: -9999px !important;
    top: -9999px !important;
    width: 1px; height: 1px;
    overflow: hidden;
  }
  .hp { width: 1px; height: 1px; }

  .form-actions { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 0.4rem; }
  .form-alt { text-align: center; font-size: var(--step--1); color: var(--stone); }
  .form-alt a { color: var(--brass); font-weight: 600; }
  .form-note {
    font-size: 0.78rem;
    color: var(--stone-2);
    text-align: center;
    line-height: 1.5;
    padding: 0.8rem;
    background: var(--paper-2);
    border-radius: var(--radius-sm);
  }

  .form-status {
    font-size: var(--step--1);
    line-height: 1.5;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
  }
  .form-status a { font-weight: 600; }
  .form-status--success {
    color: #1e6b3a;
    background: rgba(46, 160, 67, 0.1);
    border-color: rgba(46, 160, 67, 0.3);
  }
  .form-status--success a { color: #1e6b3a; }
  .form-status--error {
    color: #a02817;
    background: rgba(192, 57, 43, 0.08);
    border-color: rgba(192, 57, 43, 0.3);
  }
  .form-status--error a { color: #a02817; }

  /* When submitting, show a "Sending…" state and disable the button. */
  .cform[data-busy="true"] [data-submit] {
    opacity: 0.7;
    pointer-events: none;
  }
  .cform[data-busy="true"] .submit-label::after {
    content: "…";
  }

  @media (max-width: 560px) {
    .grid2 { grid-template-columns: 1fr; gap: 1.1rem; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  if (form) {
    const endpoint = form.dataset.endpoint ?? "";
    const mailtoBase = form.dataset.mailto ?? "";
    const successEl = form.querySelector<HTMLElement>('[data-status="success"]');
    const errorEl = form.querySelector<HTMLElement>('[data-status="error"]');
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit]");

    // ---- "Other" reveal logic ----
    // Property type: when "Other" is selected, show the description field.
    const ptypeSelect = form.querySelector<HTMLSelectElement>("[data-ptype-select]");
    const ptypeOther = form.querySelector<HTMLElement>("[data-ptype-other]");
    if (ptypeSelect && ptypeOther) {
      const syncPtype = () => {
        ptypeOther.hidden = ptypeSelect.value !== "Other";
        if (ptypeOther.hidden) {
          const o = ptypeOther.querySelector<HTMLInputElement>('input[name="property_type_other"]');
          if (o) o.value = "";
        }
      };
      ptypeSelect.addEventListener("change", syncPtype);
    }

    // Services: when "Other" checkbox is checked, show the description field.
    const serviceOtherChk = form.querySelector<HTMLInputElement>("[data-service-other]");
    const servicesOther = form.querySelector<HTMLElement>("[data-services-other]");
    if (serviceOtherChk && servicesOther) {
      const syncSvc = () => {
        servicesOther.hidden = !serviceOtherChk.checked;
        if (!servicesOther.hidden) servicesOther.querySelector<HTMLInputElement>("input")?.focus();
      };
      serviceOtherChk.addEventListener("change", syncSvc);
      serviceOtherChk.addEventListener("click", syncSvc);
    }

    const showStatus = (which: "success" | "error") => {
      successEl?.setAttribute("hidden", "");
      errorEl?.setAttribute("hidden", "");
      const el = which === "success" ? successEl : errorEl;
      el?.removeAttribute("hidden");
      el?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((el) => {
        el.removeAttribute("aria-invalid");
      });
      form.querySelectorAll<HTMLElement>(".field-error").forEach((el) => {
        el.textContent = "";
      });
    };

    const setFieldError = (name: string, msg: string) => {
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      const err = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (input) input.setAttribute("aria-invalid", "true");
      if (err) err.textContent = msg;
    };

    // Lightweight client-side validation. Catches empty required fields and
    // malformed emails before the round-trip. Real validation also happens
    // server-side via Formsubmit's own filters + our honeypot.
    const validate = (): boolean => {
      clearErrors();
      let ok = true;
      const name = form.querySelector<HTMLInputElement>('[name="name"]');
      const email = form.querySelector<HTMLInputElement>('[name="email"]');
      if (name && !name.value.trim()) {
        setFieldError("name", "Please enter your name.");
        ok = false;
      }
      if (email) {
        const v = email.value.trim();
        if (!v) {
          setFieldError("email", "Please enter your email.");
          ok = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
          setFieldError("email", "That email address doesn't look right.");
          ok = false;
        }
      }
      // At least one service must be selected.
      const checked = form.querySelectorAll<HTMLInputElement>('[data-service-check]:checked');
      if (checked.length === 0) {
        setFieldError("services", "Please pick at least one service.");
        ok = false;
      }
      return ok;
    };

    // ---- Collect the checked services into one readable string, appending
    // the "Other" description when relevant. Returns e.g.
    // "HDR Photos; Matterport 3D; Other: extra drone video" ----
    const collectServices = (): string => {
      const checked = Array.from(form.querySelectorAll<HTMLInputElement>('[data-service-check]:checked'));
      const parts = checked
        .filter((c) => c.value !== "Other")
        .map((c) => c.value);
      const otherChk = checked.find((c) => c.value === "Other");
      if (otherChk) {
        const otherText = form.querySelector<HTMLInputElement>('[name="services_other"]')?.value.trim();
        parts.push(otherText ? `Other: ${otherText}` : "Other");
      }
      return parts.join("; ");
    };

    // ---- Pre-fill from query params (?package=, ?total=, ?items=, ?type=) ----
    // Lets the price calculator carry the visitor's selection straight into the
    // form so they don't re-explain it. Progressive enhancement: if JS is off,
    // the form still works empty.
    try {
      const params = new URLSearchParams(window.location.search);
      const pkg = params.get("package");
      const total = params.get("total");
      const items = params.get("items");
      const type = params.get("type");
      const addr = params.get("address");
      const sqft = params.get("sqft");
      if (pkg || total || items || type) {
        const pkgNames: Record<string, string> = {
          glitz: "Glitz & Glam",
          city: "City Never Sleeps",
          neon: "Neon Skyline",
          custom: "Custom build",
        };
        const lines: string[] = [];
        if (pkg && pkgNames[pkg]) lines.push(`Interested in the ${pkgNames[pkg]} package.`);
        if (items) lines.push("Selected from the quote builder:\n" + items.replace(/; /g, "\n  • "));
        if (total) lines.push(`Estimated total from calculator: $${total}`);
        if (type) lines.push(`Property type: ${type}`);
        if (addr) lines.push(`Address: ${addr}`);
        if (sqft) lines.push(`Square footage: ${sqft}`);

        const msg = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
        if (msg && lines.length) {
          msg.value = lines.join("\n") + "\n\n";
          msg.focus();
          msg.setSelectionRange(msg.value.length, msg.value.length);
        }
      }
    } catch {
      // Query-param prefill is a nice-to-have; never block form submission.
    }

    // Build a clean, professional plain-text body for the email Mike receives.
    // Used both for the Formsubmit POST body and the mailto: fallback.
    const buildEmailBody = (): string => {
      const data = new FormData(form);
      const name = (data.get("name") ?? "").toString().trim();
      const email = (data.get("email") ?? "").toString().trim();
      const phone = (data.get("phone") ?? "").toString().trim();
      const date = (data.get("preferred_date") ?? "").toString().trim();
      let ptype = (data.get("property_type") ?? "").toString().trim();
      const ptypeOtherVal = (data.get("property_type_other") ?? "").toString().trim();
      if (ptype === "Other" && ptypeOtherVal) ptype = ptypeOtherVal;
      const services = collectServices();
      const location = (data.get("location") ?? "").toString().trim();
      const message = (data.get("message") ?? "").toString().trim();

      const fmtDate = (iso: string): string => {
        if (!iso) return "";
        const d = new Date(iso + "T00:00:00");
        return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
      };

      const rule = "═══════════════════════════════════";
      const lines: string[] = [
        "NEW BOOKING REQUEST",
        rule,
        "",
        `From: ${name}`,
        `Email: ${email}`,
        phone ? `Phone: ${phone}` : "Phone: (not provided)",
        "",
        ptype ? `Property Type: ${ptype}` : "Property Type: (not specified)",
        location ? `Address: ${location}` : "",
        "",
        "SERVICES REQUESTED:",
        services ? "  • " + services.split("; ").join("\n  • ") : "  (none selected)",
        "",
        message ? `Additional Notes: ${message}` : "Additional Notes: (none)",
        "",
        date ? `Preferred Date: ${fmtDate(date)}` : "Preferred Date: (none)",
        "",
        rule,
        `Reply to this client: ${email}`,
        phone ? `Call them: ${phone}` : "",
      ].filter(Boolean);
      return lines.join("\n");
    };

    // Build a plain-text body for the mailto: fallback, from current field values.
    const buildMailtoBody = (): string => {
      const body = buildEmailBody();
      return `${mailtoBase}?subject=${encodeURIComponent("New booking request from your website")}&body=${encodeURIComponent(body)}`;
    };

    form.addEventListener("submit", async (e) => {
      // Honeypot — if filled, silently drop the submission.
      const hp = form.querySelector<HTMLInputElement>('input[name="_honey"]');
      if (hp && hp.value) {
        e.preventDefault();
        return;
      }

      if (!validate()) {
        e.preventDefault();
        return;
      }

      // Live submission to Formsubmit via fetch (AJAX), so we can show inline
      // success/error states instead of redirecting away.
      e.preventDefault();
      form.dataset.busy = "true";
      submitBtn?.setAttribute("aria-busy", "true");

      try {
        // Flatten multi-value service checkboxes into a single readable string
        // so the email lists them cleanly. Drop the raw checkbox fields.
        const payload: Record<string, string> = {
          name: (form.querySelector<HTMLInputElement>('[name="name"]')?.value ?? "").trim(),
          email: (form.querySelector<HTMLInputElement>('[name="email"]')?.value ?? "").trim(),
          phone: (form.querySelector<HTMLInputElement>('[name="phone"]')?.value ?? "").trim(),
          preferred_date: (form.querySelector<HTMLInputElement>('[name="preferred_date"]')?.value ?? "").trim(),
          property_type: (form.querySelector<HTMLSelectElement>('[name="property_type"]')?.value ?? "").trim(),
          services: collectServices(),
          location: (form.querySelector<HTMLInputElement>('[name="location"]')?.value ?? "").trim(),
          message: (form.querySelector<HTMLTextAreaElement>('[name="message"]')?.value ?? "").trim(),
          _subject: "New booking request from your website",
          _template: "table",
          _captcha: "false",
        };
        // Include the "Other" description fields only when filled.
        const ptypeOther = (form.querySelector<HTMLInputElement>('[name="property_type_other"]')?.value ?? "").trim();
        if (ptypeOther) payload["property_type_other"] = ptypeOther;
        const servicesOther = (form.querySelector<HTMLInputElement>('[name="services_other"]')?.value ?? "").trim();
        if (servicesOther) payload["services_other"] = servicesOther;

        const res = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          showStatus("success");
          form.reset();
          // Re-run the "Other" reveal sync so hidden fields stay hidden after reset.
          if (ptypeSelect && ptypeOther) ptypeOther.hidden = true;
          if (serviceOtherChk && servicesOther) servicesOther.hidden = true;
        } else {
          showStatus("error");
        }
      } catch {
        // Network/CORS failure (e.g. ad blocker, offline): fall back to the
        // visitor's own email client with a prefilled body. This always works.
        showStatus("error");
        try {
          window.location.href = buildMailtoBody();
        } catch {
          /* last-resort: leave the error message visible */
        }
      } finally {
        form.dataset.busy = "false";
        submitBtn?.removeAttribute("aria-busy");
      }
    });
  }
</script>
