---
// Lazy-loaded YouTube embed with a click-to-play placeholder.
//
// The YouTube player ships a large JS + CSS payload (~1MB+) the moment an
// iframe with a real src renders. To keep below-the-fold videos off the wire
// (and out of the LCP budget), we render a clickable thumbnail + play button
// instead of the iframe, and only swap in the real embed when the visitor
// opts in. This mirrors the MatterportEmbed pattern already on the site.
//
// Privacy: because no iframe loads until click, YouTube sets no cookies and
// runs no tracking until the visitor explicitly chooses to watch. This is the
// "facade" pattern recommended for privacy- and performance-conscious sites.
import { asset } from "../data/site";

export interface Props {
  /** YouTube video ID (the `?v=` param, or the tail of a youtu.be/ link). */
  videoId: string;
  /** Accessible name / on-screen title for the embed. */
  title: string;
  /**
   * Optional placeholder image (absolute path from public/). When omitted we
   * use YouTube's own thumbnail for the video (img.youtube.com) — see note in
   * the CSP: img-src already allows https:, so this works.
   */
  placeholder?: string;
  /** Start position in seconds (YouTube ?start param). */
  start?: number;
  /** Aspect ratio of the embed frame. */
  aspect?: "16/9" | "4/3" | "1/1";
}

const {
  videoId,
  title,
  placeholder,
  start,
  aspect = "16/9",
} = Astro.props;

const startParam = typeof start === "number" && start > 0 ? `&start=${Math.floor(start)}` : "";
// privacy-friendly, no-cookie domain — still served by YouTube but doesn't set
// tracking cookies until the visitor hits play.
const watchUrl = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(
  videoId
)}?rel=0&modestbranding=1${startParam}`;

const thumb = placeholder
  ? asset(placeholder)
  : `https://img.youtube.com/vi/${encodeURIComponent(videoId)}/hqdefault.jpg`;

const frameId = `yt-${videoId.replace(/[^a-z0-9]/gi, "").slice(0, 12)}`;
---

<div
  class="yt-embed"
  data-yt-embed
  data-watch={watchUrl}
  style={`aspect-ratio:${aspect};`}
>
  <button
    type="button"
    class="yt-placeholder"
    data-yt-load
    aria-label={`Play video: ${title}`}
  >
    <img
      class="yt-ph-img"
      src={thumb}
      alt={title}
      loading="lazy"
      decoding="async"
    />
    <span class="yt-ph-veil" aria-hidden="true"></span>
    <span class="yt-ph-cta">
      <span class="yt-ph-play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
      <span class="yt-ph-title">{title}</span>
    </span>
  </button>

  <iframe
    class="yt-frame"
    id={frameId}
    data-yt-frame
    title={title}
    src=""
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>

<style>
  .yt-embed {
    position: relative;
    width: 100%;
    max-width: 100%;
    background: var(--paper-2, #efeae1);
    border-radius: var(--radius, 8px);
    overflow: hidden;
    box-shadow: var(--shadow-card, 0 4px 24px rgba(0,0,0,0.08));
  }
  .yt-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #000;
  }
  .yt-frame:not([src]),
  .yt-frame[src=""] { opacity: 0; pointer-events: none; }
  .yt-frame:not([src=""]) { opacity: 1; }

  .yt-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 2;
    transition: opacity 0.4s var(--ease, ease);
  }
  .yt-embed[data-loaded="true"] .yt-placeholder { opacity: 0; pointer-events: none; }

  .yt-ph-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt-ph-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 60%);
    transition: background 0.3s var(--ease, ease);
  }
  .yt-placeholder:hover .yt-ph-veil,
  .yt-placeholder:focus-visible .yt-ph-veil {
    background: linear-gradient(0deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.3) 60%);
  }
  .yt-placeholder:focus-visible {
    outline: 3px solid var(--brass, #b08d57);
    outline-offset: -3px;
  }

  .yt-ph-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    text-align: center;
    padding: 0 1.5rem;
  }
  .yt-ph-play {
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #ff0033;
    color: #fff;
    box-shadow: 0 6px 24px rgba(0,0,0,0.4);
    transition: transform 0.3s var(--ease, ease), background 0.3s var(--ease, ease);
  }
  .yt-placeholder:hover .yt-ph-play,
  .yt-placeholder:focus-visible .yt-ph-play { transform: scale(1.08); }

  .yt-ph-title {
    font-family: var(--font-body, system-ui);
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255,255,255,0.95);
    max-width: 44ch;
    line-height: 1.3;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
  }

  @media (max-width: 540px) {
    .yt-ph-play { width: 56px; height: 56px; }
    .yt-ph-title { font-size: 0.9rem; }
  }
</style>

<script>
  // Delegate click → set iframe src, mark loaded, hand focus to the frame.
  // One listener covers every YouTubeEmbed on the page.
  function initEmbed(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>("[data-yt-load]");
    const frame = root.querySelector<HTMLIFrameElement>("[data-yt-frame]");
    if (!btn || !frame) return;

    const load = () => {
      if (root.dataset.loaded === "true") return;
      frame.src = root.dataset.watch || "";
      root.dataset.loaded = "true";
      // Autoplay once the visitor has opted in.
      if (frame.src && !/[?&]autoplay=1/.test(frame.src)) {
        frame.src += (frame.src.includes("?") ? "&" : "?") + "autoplay=1";
      }
      window.setTimeout(() => { try { frame.focus({ preventScroll: true }); } catch {} }, 200);
    };

    btn.addEventListener("click", load);
    if ("IntersectionObserver" in window && root.dataset.autoload === "true") {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { load(); io.disconnect(); }
          }
        },
        { rootMargin: "200px" }
      );
      io.observe(root);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-yt-embed]").forEach(initEmbed);
</script>
