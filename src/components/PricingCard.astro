---
import { asset } from "../data/site";
import type { Package } from "../data/site";
export interface Props { pkg: Package; }
const { pkg } = Astro.props;
---
<article class:list={["pkg", { featured: pkg.featured }]} data-reveal={pkg.featured ? undefined : ""} data-reveal-delay={pkg.featured ? "2" : undefined}>
  {pkg.featured && <span class="pkg-flag">Most popular</span>}
  <header class="pkg-head">
    <p class="pkg-tag">{pkg.tag}</p>
    <h3 class="pkg-name display">{pkg.name}</h3>
    <div class="pkg-price">
      <span class="currency">$</span><span class="amount">{pkg.price}</span>
    </div>
  </header>
  <p class="pkg-blurb">{pkg.blurb}</p>
  <ul class="pkg-includes" role="list">
    {pkg.includes.map((inc) => (
      <li>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{inc}</span>
      </li>
    ))}
  </ul>
  {pkg.sizeNote && <p class="pkg-note">{pkg.sizeNote}</p>}
  <a href={asset("/contact/")} class:list={["btn", "btn-block", pkg.featured ? "brass" : "outline"]}>
    Book {pkg.name}
  </a>
</article>

<style>
  .pkg {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: clamp(1.6rem, 1.2rem + 1.5vw, 2.2rem);
    background: var(--paper);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    height: 100%;
  }
  .pkg.featured {
    background: var(--dark);
    color: var(--paper);
    border-color: var(--dark);
    box-shadow: var(--shadow-lift);
    transform: translateY(-4px);
  }
  .pkg.featured .pkg-name,
  .pkg.featured .pkg-price,
  .pkg.featured .amount,
  .pkg.featured .currency { color: var(--paper); }

  .pkg-flag {
    position: absolute;
    top: -12px; left: 50%;
    transform: translateX(-50%);
    background: var(--brass);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45em 1em;
    border-radius: 999px;
    white-space: nowrap;
  }
  .pkg-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass-2);
  }
  .pkg-name { font-size: var(--step-3); margin-top: 0.2rem; }
  .pkg-price {
    margin-top: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    color: var(--ink);
  }
  .currency { font-size: 1.4rem; font-family: var(--font-display); }
  .amount { font-family: var(--font-display); font-size: var(--step-5); line-height: 1; }

  .pkg-blurb { color: var(--stone); font-size: var(--step--1); }
  .pkg.featured .pkg-blurb { color: rgba(247,244,239,0.72); }

  .pkg-includes {
    display: flex; flex-direction: column; gap: 0.6rem;
    margin: 0.4rem 0 0;
    flex-grow: 1;
  }
  .pkg-includes li {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.4;
  }
  .pkg-includes svg { color: var(--brass); flex-shrink: 0; margin-top: 3px; }

  .pkg-note {
    font-size: 0.78rem;
    color: var(--stone-2);
    line-height: 1.4;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-light);
  }
  .pkg.featured .pkg-note {
    color: rgba(247,244,239,0.55);
    border-top-color: var(--line-dark);
  }
</style>
