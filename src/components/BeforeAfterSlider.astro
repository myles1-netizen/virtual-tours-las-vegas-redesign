---
import { asset } from "../data/site";
export interface Props {
  before: string;
  beforeAlt: string;
  after: string;
  afterAlt: string;
  label?: string;
}
const { before, beforeAlt, after, afterAlt, label } = Astro.props;
const id = `ba-${Math.random().toString(36).slice(2, 9)}`;
---
<div class="ba" data-reveal>
  <figure
    class="ba-frame"
    data-ba={id}
    role="group"
    aria-label={label ? `Before and after: ${label}` : "Before and after comparison"}
  >
    <img class="ba-after" src={asset(after)} alt={afterAlt} loading="lazy" width="1200" height="800" />
    <div class="ba-before-clip" data-ba-clip>
      <img class="ba-before" src={asset(before)} alt={beforeAlt} loading="lazy" width="1200" height="800" aria-hidden="true" />
    </div>

    <span class="ba-tag ba-tag-before">Before</span>
    <span class="ba-tag ba-tag-after">After · Virtual Staging</span>

    <div class="ba-handle" data-ba-handle>
      <div class="ba-line"></div>
      <div class="ba-knob" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18-6-6 6-6M15 6l6 6-6 6"/></svg>
      </div>
    </div>

    <input class="ba-range" type="range" min="0" max="100" value="30" aria-label={`Reveal slider for ${label ?? "comparison"}`} />
  </figure>
  {label && <figcaption class="ba-cap">{label}</figcaption>}
</div>

<style>
  .ba { max-width: 760px; }
  .ba-frame {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    margin: 0;
    cursor: ew-resize;
    user-select: none;
    touch-action: pan-y;
    box-shadow: var(--shadow-card);
  }
  .ba-after, .ba-before {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .ba-before-clip {
    position: absolute; inset: 0;
    width: 50%;
    overflow: hidden;
    will-change: width;
  }
  .ba-before-clip .ba-before { width: 100vw; max-width: 1000%; /* counter-clip */ }

  .ba-tag {
    position: absolute;
    top: 0.9rem;
    background: rgba(15,14,12,0.8);
    color: var(--paper);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4em 0.7em;
    border-radius: 3px;
    pointer-events: none;
  }
  .ba-tag-before { left: 0.9rem; }
  .ba-tag-after { right: 0.9rem; }

  .ba-handle {
    position: absolute;
    top: 0; bottom: 0;
    left: 50%;
    width: 0;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .ba-line {
    position: absolute;
    top: 0; bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--brass);
    transform: translateX(-50%);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.1);
  }
  .ba-knob {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--brass);
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }

  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
  }

  .ba-cap {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    color: var(--stone);
    text-align: center;
  }

  @media (max-width: 520px) {
    .ba-knob { width: 38px; height: 38px; }
  }
</style>

<script>
  function initSlider(frame: HTMLElement) {
    const clip = frame.querySelector<HTMLElement>("[data-ba-clip]");
    const handle = frame.querySelector<HTMLElement>("[data-ba-handle]");
    const range = frame.querySelector<HTMLInputElement>(".ba-range");
    if (!clip || !handle || !range) return;

    const set = (pct: number) => {
      const v = Math.max(0, Math.min(100, pct));
      clip.style.width = `${v}%`;
      handle.style.left = `${v}%`;
    };
    range.value = "30";
    set(30);

    range.addEventListener("input", () => set(Number(range.value)));

    // Pointer drag fallback (covers touch + mouse on the image itself)
    let dragging = false;
    const fromEvent = (clientX: number) => {
      const r = frame.getBoundingClientRect();
      set(((clientX - r.left) / r.width) * 100);
    };
    frame.addEventListener("pointerdown", (e) => {
      // Only initiate drag when not on the native range thumb interaction
      dragging = true;
      frame.setPointerCapture(e.pointerId);
      fromEvent(e.clientX);
    });
    frame.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      fromEvent(e.clientX);
    });
    const end = (e: PointerEvent) => {
      dragging = false;
      try { frame.releasePointerCapture(e.pointerId); } catch {}
    };
    frame.addEventListener("pointerup", end);
    frame.addEventListener("pointercancel", end);
  }

  document.querySelectorAll<HTMLElement>("[data-ba]").forEach(initSlider);
</script>
