---
import { business, nav, asset } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "");
---
<header class="site-header" data-header>
  {/* CSS-only mobile menu (no JS required). Checkbox sits at top of header so it
      can drive the sibling mobile-nav drawer via :checked. */}
  <input type="checkbox" id="menu-toggle" class="menu-checkbox" aria-hidden="true" />
  <div class="bar">
    <a href={asset("/")} class="brand" aria-label={`${business.name} — home`}>
      <img class="brand-logo logo-light" src={asset("/images/logo-navy.png")} alt={`${business.name}`} width="220" height="75" />
      <img class="brand-logo logo-dark" src={asset("/images/logo-white.png")} alt="" aria-hidden="true" width="220" height="75" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {nav.map((item) => {
        const itemPath = asset(item.href).replace(/\/$/, "");
        const active = path === itemPath || (itemPath !== "" && path.startsWith(itemPath));
        return (
          <a href={asset(item.href)} class:list={["nav-link", { active }]}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="actions">
      <a href={business.phoneHref} class="phone-link" aria-label={`Call ${business.phone}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="num">{business.phone}</span>
      </a>
      <a href={asset("/contact/")} class="btn brass cta-book">Book a shoot</a>
      <a href={business.phoneHref} class="phone-fab" aria-label={`Call ${business.phone}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </a>

      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode" title="Toggle theme">
        {/* Sun (shown in dark mode → click for light) */}
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        {/* Moon (shown in light mode → click for dark) */}
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <label for="menu-toggle" class="menu-toggle" aria-label="Open menu" title="Menu">
        <span class="menu-icon" aria-hidden="true"></span>
      </label>
    </div>
  </div>

  {/* Mobile drawer — driven entirely by the checkbox :checked state */}
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    <nav aria-label="Mobile">
      {nav.map((item) => (
        <a href={asset(item.href)} class="mobile-link">{item.label}</a>
      ))}
    </nav>
    <div class="mobile-cta">
      <a href={business.phoneHref} class="btn outline btn-block">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call {business.phone}
      </a>
      <a href={business.smsHref} class="btn outline btn-block">Text Mike</a>
      <a href={asset("/contact/")} class="btn brass btn-block">Book a shoot</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--line-light);
    transition: box-shadow 0.3s var(--ease);
  }
  .site-header.scrolled {
    box-shadow: 0 1px 0 var(--line-light), 0 4px 16px rgba(15, 14, 12, 0.08);
  }

  .bar {
    max-width: var(--container);
    margin-inline: auto;
    padding: 0.55rem var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
    height: 50px;
    line-height: 0;
  }
  .brand-logo {
    height: 46px;
    width: auto;
    display: block;
  }
  /* Dual logo variants: navy wordmark on light header, white on dark header.
     Both render in markup (with the deployment base path baked in via asset()),
     and CSS toggles visibility by theme — no hardcoded paths in CSS. */
  .logo-dark { display: none; }
  :global([data-theme="dark"]) .logo-light { display: none; }
  :global([data-theme="dark"]) .logo-dark { display: block; }

  .primary-nav {
    display: flex;
    gap: 0.3rem;
  }
  .nav-link {
    padding: 0.5rem 0.85rem;
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: var(--radius-sm);
    position: relative;
    transition: color 0.2s var(--ease), opacity 0.2s var(--ease);
    opacity: 0.95;
  }
  .nav-link:hover { opacity: 1; color: var(--brass); }
  .nav-link.active { opacity: 1; }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0.85rem; right: 0.85rem;
    bottom: 0.2rem;
    height: 1.5px;
    background: var(--brass);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    opacity: 0.9;
  }
  .phone-link:hover { color: var(--brass); border-color: var(--brass); opacity: 1; }

  .cta-book { padding: 0.6em 1.1em; font-size: 0.74rem; }

  /* Theme toggle — icon-only, compact, sits with the other actions. Shows the
     sun in dark mode (click → light) and the moon in light mode (click → dark). */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    color: var(--ink);
    flex-shrink: 0;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .theme-toggle:hover { color: var(--brass); border-color: var(--brass); transform: rotate(-15deg); }
  .theme-toggle:active { transform: rotate(-15deg) scale(0.94); }
  .theme-toggle .icon-sun { display: none; }
  :global([data-theme="dark"]) .theme-toggle { color: var(--paper); border-color: var(--line-light); }
  :global([data-theme="dark"]) .theme-toggle .icon-sun { display: block; }
  :global([data-theme="dark"]) .theme-toggle .icon-moon { display: none; }

  .phone-fab {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid currentColor;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .phone-fab:hover { color: var(--brass); border-color: var(--brass); }

  /* ===== Mobile menu — pure CSS checkbox hack, no JS required ===== */
  .menu-checkbox { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .menu-toggle {
    display: none;
    width: 44px; height: 44px;
    position: relative;
    color: currentColor;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .menu-icon, .menu-icon::before, .menu-icon::after {
    content: "";
    position: absolute;
    left: 50%; top: 50%;
    width: 22px; height: 2px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  .menu-icon::before { transform: translate(-50%, -7px); }
  .menu-icon::after { transform: translate(-50%, 7px); }
  /* When checked: morph icon to X. Checkbox is a sibling-before of .bar (which holds the label). */
  .menu-checkbox:checked ~ .bar .menu-toggle .menu-icon { background: transparent; }
  .menu-checkbox:checked ~ .bar .menu-toggle .menu-icon::before { transform: translate(-50%, 0) rotate(45deg); }
  .menu-checkbox:checked ~ .bar .menu-toggle .menu-icon::after { transform: translate(-50%, 0) rotate(-45deg); }

  .mobile-nav {
    display: none;
    background: var(--paper);
    border-top: 1px solid var(--line-light);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s var(--ease);
    color: var(--ink);
  }
  .mobile-link {
    display: block;
    padding: 0.95rem 0.3rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    border-bottom: 1px solid var(--line-light);
    color: var(--ink);
  }
  .mobile-cta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-bottom: 0.5rem;
  }

  @media (max-width: 980px) {
    .primary-nav, .phone-link { display: none; }
    .menu-toggle { display: block; }
    .mobile-nav { display: block; }
    .bar { gap: 1rem; }
    .cta-book { padding: 0.6em 1em; font-size: 0.72rem; }
    /* CSS-only open: when checkbox is checked, expand the sibling drawer. */
    .menu-checkbox:checked ~ .mobile-nav {
      max-height: 80vh;
      overflow-y: auto;
      padding: 0.8rem var(--gutter) 1.5rem;
    }
  }
  @media (max-width: 480px) {
    .cta-book { display: none; }
    .phone-fab { display: inline-flex; }
  }
</style>

<script>
  // Toggle solid background + ink text once the page scrolls past the hero,
  // so header text stays readable after it's no longer overlaying a dark image.
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 40);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Progressive enhancement only — closes drawer on link click + locks scroll.
  // The drawer OPENS without JS (via CSS :checked); this just improves UX.
  const checkbox = document.getElementById("menu-toggle") as HTMLInputElement | null;
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");
  if (checkbox && mobileNav) {
    mobileNav.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        checkbox.checked = false;
        document.body.style.overflow = "";
      })
    );
    checkbox.addEventListener("change", () => {
      document.body.style.overflow = checkbox.checked ? "hidden" : "";
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && checkbox.checked) {
        checkbox.checked = false;
        document.body.style.overflow = "";
      }
    });
  }

  // Theme toggle — flips data-theme on <html>, persists to localStorage, and
  // wraps the change in a transient .theme-transitioning class so the global
  // 0.3s bg/color transition kicks in for this switch only (not on scroll).
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeToggle) {
    const apply = (next: "light" | "dark") => {
      const root = document.documentElement;
      root.classList.add("theme-transitioning");
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch (_) { /* private mode etc. */ }
      // Dispatch a generic event so Base.astro can update <meta name="theme-color">.
      document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: next } }));
      window.setTimeout(() => root.classList.remove("theme-transitioning"), 320);
    };
    themeToggle.addEventListener("click", () => {
      const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      apply(current === "dark" ? "light" : "dark");
    });
  }
</script>
