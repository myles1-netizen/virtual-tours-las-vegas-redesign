---
// Matterport tour lightbox using the native <dialog> element.
//
// Replaces the WordPress "Matterport Shortcode" + Magnific Popup pattern described
// in handoff/plugin-research/wordpress-plugin-equivalents.md (section 10).
//
// Design goals (all satisfied):
//  - The iframe src is set ONLY when the dialog opens, and cleared on close, so
//    we never load N heavy Matterport players simultaneously on a gallery page.
//  - Native <dialog> gives free focus-trapping, Esc-to-close, and ::backdrop —
//    no jQuery / Magnific Popup dependency.
//  - Click-outside-to-close + an explicit close button both work.
//  - Full-screen on mobile, contained modal on desktop.
//
// Two usage modes:
//  1. Provide `triggers` to render a grid of tour thumbnails here (gallery mode).
//  2. Provide no `triggers` and use the exported <slot /> to drop your own
//     trigger markup anywhere on the page — any element with
//     `data-matterport-trigger` + `data-matterport-id` (optional data-matterport-title)
//     will open this dialog.
import { asset } from "../data/site";

export interface TourTrigger {
  modelId: string;
  thumbnail: string;
  title: string;
}

export interface Props {
  /** Optional grid of tour thumbnails to render inside this component. */
  triggers?: TourTrigger[];
  /** MLS-compliant player mode (hides some Matterport UI). */
  mls?: boolean;
  /** Autoplay once the dialog opens. */
  autoplay?: boolean;
  /** Hide Matterport branding (plan-dependent). */
  hideBrand?: boolean;
}

const { triggers, mls = false, autoplay = true, hideBrand = false } = Astro.props;

// We don't bake the URL into the frame — JS builds it on open so a single dialog
// can play any model. But we do serialize the query params once for the client.
const params = new URLSearchParams();
if (autoplay) params.set("play", "1");
if (mls) params.set("mls", "1");
if (hideBrand) params.set("brand", "0");
const query = params.toString();
---

{/* Optional thumbnail grid (gallery mode). Each button carries the model id. */}
{triggers && triggers.length > 0 && (
  <div class="mp-grid">
    {triggers.map((t) => (
      <button
        type="button"
        class="mp-trigger"
        data-matterport-trigger
        data-matterport-id={t.modelId}
        data-matterport-title={t.title}
        aria-label={`Open 3D tour: ${t.title}`}
      >
        <img
          class="mp-trigger-img"
          src={asset(t.thumbnail)}
          alt={t.title}
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
        />
        <span class="mp-trigger-veil" aria-hidden="true"></span>
        <span class="mp-trigger-cta">
          <span class="mp-trigger-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <span class="mp-trigger-label">3D Tour</span>
        </span>
        <span class="mp-trigger-title">{t.title}</span>
      </button>
    ))}
  </div>
)}

{/* Author-supplied triggers go here. Any descendant with data-matterport-trigger works. */}
<slot />

{/* The single shared lightbox. One per page is enough — src is swapped per open. */}
<dialog
  class="mp-dialog"
  data-matterport-dialog
  data-query={query}
  aria-label="3D virtual tour viewer"
>
  <div class="mp-dialog-bar">
    <span class="mp-dialog-title" data-mp-dialog-title></span>
    <button
      type="button"
      class="mp-dialog-close"
      data-mp-dialog-close
      aria-label="Close tour (Escape)"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  {/* No src here. Set on open, cleared on close to stop audio/rendering. */}
  <iframe
    class="mp-dialog-frame"
    data-mp-dialog-frame
    title="Matterport 3D tour"
    src=""
    allow="xr-spatial-tracking; gyroscope; accelerometer; fullscreen"
    allowfullscreen
  ></iframe>
</dialog>

<style>
  /* ===== Thumbnail grid (gallery mode) ===== */
  .mp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .mp-trigger {
    position: relative;
    aspect-ratio: 4 / 3;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: var(--radius, 8px);
    overflow: hidden;
    background: var(--paper-2, #efeae1);
    cursor: pointer;
    box-shadow: var(--shadow-card, 0 4px 24px rgba(0,0,0,0.08));
    transition: transform 0.3s var(--ease, ease), box-shadow 0.3s var(--ease, ease);
  }
  .mp-trigger:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(0,0,0,0.18); }
  .mp-trigger:focus-visible { outline: 3px solid var(--brass, #b08d57); outline-offset: 2px; }
  .mp-trigger-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease, ease);
  }
  .mp-trigger:hover .mp-trigger-img { transform: scale(1.05); }
  .mp-trigger-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15,14,12,0.7) 0%, rgba(15,14,12,0.05) 55%);
    transition: background 0.3s var(--ease, ease);
  }
  .mp-trigger:hover .mp-trigger-veil { background: linear-gradient(0deg, rgba(15,14,12,0.78) 0%, rgba(15,14,12,0.2) 55%); }
  .mp-trigger-cta {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
  }
  .mp-trigger-play {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brass, #b08d57);
    box-shadow: 0 4px 18px rgba(0,0,0,0.35);
    transition: transform 0.3s var(--ease, ease), background 0.3s var(--ease, ease);
  }
  .mp-trigger:hover .mp-trigger-play { transform: scale(1.1); background: var(--brass-btn, #8a6a3c); }
  .mp-trigger-label {
    font-family: var(--font-body, system-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .mp-trigger-title {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    right: 0.9rem;
    color: var(--paper, #f7f4ef);
    font-family: var(--font-display, Georgia, serif);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
    text-shadow: 0 1px 6px rgba(0,0,0,0.6);
    text-align: left;
  }

  /* ===== Dialog (lightbox) ===== */
  .mp-dialog {
    width: min(1100px, 94vw);
    max-width: 94vw;
    height: min(86vh, 760px);
    max-height: 86vh;
    padding: 0;
    margin: auto;
    border: 0;
    background: transparent;
    color: var(--paper, #f7f4ef);
    overflow: hidden;
    border-radius: var(--radius-lg, 14px);
    /* Native backdrop gets its own treatment below. */
  }
  .mp-dialog::backdrop {
    background: rgba(15,14,12,0.92);
    backdrop-filter: blur(2px);
  }
  /* Older browsers w/o ::backdrop support — the dialog fills the top layer anyway. */
  @supports not selector(::backdrop) {
    .mp-dialog { background: rgba(15,14,12,0.97); }
  }
  .mp-dialog[open] { animation: mp-pop 0.25s var(--ease, ease); }
  @keyframes mp-pop {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }

  .mp-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    background: rgba(15,14,12,0.85);
    border-bottom: 1px solid rgba(247,244,239,0.12);
  }
  .mp-dialog-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--paper, #f7f4ef);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mp-dialog-close {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(247,244,239,0.1);
    color: var(--paper, #f7f4ef);
    cursor: pointer;
    transition: background 0.2s var(--ease, ease), transform 0.2s var(--ease, ease);
  }
  .mp-dialog-close:hover { background: rgba(247,244,239,0.2); transform: rotate(90deg); }
  .mp-dialog-close:focus-visible { outline: 2px solid var(--brass, #b08d57); outline-offset: 2px; }

  .mp-dialog-frame {
    display: block;
    width: 100%;
    height: calc(100% - 53px); /* bar height */
    border: 0;
    background: #1a1814;
  }

  /* Full-screen on small screens — tours need the room. */
  @media (max-width: 720px) {
    .mp-dialog {
      width: 100vw;
      max-width: 100vw;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
    }
    .mp-dialog-frame { height: calc(100% - 53px); }
  }
</style>

<script>
  type MpDialog = HTMLDialogElement & { _mpBound?: boolean };

  function openTour(dialog: MpDialog, id: string, title: string, query: string) {
    const frame = dialog.querySelector<HTMLIFrameElement>("[data-mp-dialog-frame]");
    const titleEl = dialog.querySelector<HTMLElement>("[data-mp-dialog-title]");
    // Build the URL fresh on every open so the dialog can serve many tours.
    const base = `https://my.matterport.com/show/?m=${encodeURIComponent(id)}`;
    const url = query ? `${base}&${query}` : base;
    if (titleEl) titleEl.textContent = title || "3D Virtual Tour";
    if (frame) {
      frame.setAttribute("title", title ? `Matterport 3D tour: ${title}` : "Matterport 3D tour");
      frame.src = url;
    }
    if (typeof dialog.showModal === "function") {
      if (dialog.open) dialog.close();
      dialog.showModal();
    }
    document.body.style.overflow = "hidden";
  }

  function closeTour(dialog: MpDialog) {
    const frame = dialog.querySelector<HTMLIFrameElement>("[data-mp-dialog-frame]");
    // Clearing src stops playback (audio + rendering) immediately on close.
    if (frame) frame.src = "";
    if (dialog.open) dialog.close();
    document.body.style.overflow = "";
  }

  function initPopup() {
    const dialog = document.querySelector<MpDialog>("[data-matterport-dialog]");
    if (!dialog || dialog._mpBound) return;
    dialog._mpBound = true;

    // Read the serialized query params once (authored server-side above).
    const query = dialog.dataset.query || "";

    // Any [data-matterport-trigger] on the page opens the dialog.
    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement)?.closest<HTMLElement>("[data-matterport-trigger]");
      if (!trigger) return;
      const id = trigger.dataset.matterportId;
      if (!id) return;
      e.preventDefault();
      const title = trigger.dataset.matterportTitle || trigger.getAttribute("aria-label") || "3D Virtual Tour";
      openTour(dialog, id, title, query);
    });

    // Keyboard activation for slotted/custom triggers that aren't <button>.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      const trigger = (e.target as HTMLElement)?.closest<HTMLElement>("[data-matterport-trigger]");
      if (!trigger) return;
      const id = trigger.dataset.matterportId;
      if (!id) return;
      e.preventDefault();
      const title = trigger.dataset.matterportTitle || "3D Virtual Tour";
      openTour(dialog, id, title, query);
    });

    // Close button.
    dialog.querySelector("[data-mp-dialog-close]")?.addEventListener("click", () => closeTour(dialog));

    // Click outside (on the dialog element itself, not its children) closes.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeTour(dialog);
    });

    // Esc is handled natively by <dialog>; we just sync body overflow + clear src.
    dialog.addEventListener("close", () => {
      const frame = dialog.querySelector<HTMLIFrameElement>("[data-mp-dialog-frame]");
      if (frame) frame.src = "";
      document.body.style.overflow = "";
    });
  }

  initPopup();
</script>
