---
// PriceCalculator — interactive, live-updating quote builder.
//
// All pricing is sourced from src/data/site.ts (single source of truth) and
// serialized to the client as a JSON config. The client script reads that config
// only — it never hardcodes a price. If site.ts changes, the calculator changes.
//
// Scope: residential, commercial, vacation rental and land/lot. The property
// type chosen first drives which services are offered, then the visitor picks
// any combination. The running total + sticky "Book This" button sit beside the
// controls (and stick to the viewport on desktop).
//
// Progressive enhancement: a <noscript> fallback note is shown and the static
// price tables elsewhere on the page remain visible without JS. Nevada does not
// tax photography services, so no tax line is added — the summary shows the
// plain estimated total with no fine-print disclaimers.

import { asset } from "../data/site";
import {
  vegasPackages,
  hdrTiers,
  matterportTiers,
  floorPlanTiers,
  virtualStagingTiers,
  videoTiers,
  zillowTiers,
  commercialHdr,
  commercialPanoramas,
  googlePackage,
  hdrAddOns,
  floorPlanAddOns,
} from "../data/site";

// ---- Build the client config from the real data ----
// Every number below traces back to a row in src/data/site.ts.

// HDR tier brackets, ordered by ascending photo count, expressed as numeric
// upper bounds so the client can bracket a chosen quantity.
// hdrTiers labels: "10 HDR photos", "11–30 photos", "31–50 photos", "51–70 photos", "71–90 photos"
const hdrBrackets = [
  { max: 10, price: hdrTiers[0].price, label: hdrTiers[0].count },
  { max: 30, price: hdrTiers[1].price, label: hdrTiers[1].count },
  { max: 50, price: hdrTiers[2].price, label: hdrTiers[2].count },
  { max: 70, price: hdrTiers[3].price, label: hdrTiers[3].count },
  { max: 90, price: hdrTiers[4].price, label: hdrTiers[4].count },
];

// Commercial HDR: same shape, brackets by photo count.
const commercialHdrBrackets = [
  { max: 5, price: commercialHdr[0].price, label: commercialHdr[0].count },
  { max: 10, price: commercialHdr[1].price, label: commercialHdr[1].count },
  { max: 15, price: commercialHdr[2].price, label: commercialHdr[2].count },
  { max: 20, price: commercialHdr[3].price, label: commercialHdr[3].count },
];

// Matterport tier brackets: matterportTiers are size strings with numeric prices.
// matterportTiers[0..3] are absolute sqft caps; [4] is "+$55 / additional 1000 sqft".
const matterportBrackets = [
  { maxSqft: 1500, price: matterportTiers[0].price, label: matterportTiers[0].size },
  { maxSqft: 2000, price: matterportTiers[1].price, label: matterportTiers[1].size },
  { maxSqft: 3000, price: matterportTiers[2].price, label: matterportTiers[2].size },
  { maxSqft: 4000, price: matterportTiers[3].price, label: matterportTiers[3].size },
];
const matterportOveragePer1000 = matterportTiers[4].price; // 55

// Floor plan tiers: tier 4 ("Over 5,000 sq ft") is null price (custom quote).
const floorPlanBrackets = [
  { stories: 1, minSqft: 0, maxSqft: 2500, price: floorPlanTiers[0].price, label: floorPlanTiers[0].size },
  { stories: 2, minSqft: 0, maxSqft: 2500, price: floorPlanTiers[1].price, label: floorPlanTiers[1].size },
  { stories: 1, minSqft: 3000, maxSqft: 5000, price: floorPlanTiers[2].price, label: floorPlanTiers[2].size },
  { stories: 2, minSqft: 3000, maxSqft: 5000, price: floorPlanTiers[3].price, label: floorPlanTiers[3].size },
];
const floorPlanCustomNote = floorPlanTiers[4].note ?? "Custom quote";

// Virtual staging: flat per-photo price.
const virtualStagingPerPhoto = virtualStagingTiers[0].price; // 25

// Walk-through video tiers (stand-alone items).
const videoItems = videoTiers.map((v, i) => ({ id: `video-${i}`, label: v.item, price: v.price }));

// Zillow add-ons.
const zillowItems = zillowTiers.map((z, i) => ({ id: `zillow-${i}`, label: z.item, price: z.price }));

// Commercial 360 panoramas — premium (8-shot DSLR) and express tiers.
const premiumPanoramaBrackets = commercialPanoramas.premium.map((p, i) => ({
  id: `pano-prem-${i}`,
  label: p.count,
  price: p.price,
}));
const expressPanoramaBrackets = commercialPanoramas.express.map((p, i) => ({
  id: `pano-exp-${i}`,
  label: p.count,
  price: p.price,
}));

// Packages — slugs map to the contact form pre-fill (?package=glitz etc.)
const packageSlugs: Record<string, string> = {
  "Glitz & Glam": "glitz",
  "City Never Sleeps": "city",
  "Neon Skyline": "neon",
};
const packages = vegasPackages.map((p) => {
  return {
    slug: packageSlugs[p.name] ?? p.name.toLowerCase().replace(/[^a-z]+/g, "-").replace(/^-|-$/g, ""),
    name: p.name,
    tag: p.tag,
    price: p.price,
    blurb: p.blurb,
    includes: p.includes,
    sizeNote: p.sizeNote ?? "",
    featured: !!p.featured,
  };
});

// Google "Get Me On Google" package — most-booked commercial bundle.
const googlePkg = {
  name: googlePackage.name,
  price: googlePackage.price,
  includes: googlePackage.includes,
  note: googlePackage.note ?? "",
};

// Add-ons drawn from the real add-on strings. Parse the dollar amount out of
// the published add-on line so the price always tracks the source string.
type AddOn = { id: string; label: string; price: number };
function parseAddOn(raw: string, id: string): AddOn {
  const m = raw.match(/\+\$(\d+)/);
  const price = m ? Number(m[1]) : 0;
  const label = raw.replace(/\s*—\s*\+\$\d+.*$/, "");
  return { id, label, price };
}
const addOns: AddOn[] = [
  parseAddOn(hdrAddOns[2], "rush"),
  parseAddOn(hdrAddOns[3], "twilight"),
  parseAddOn(hdrAddOns[4], "sky"),
  parseAddOn(floorPlanAddOns[0], "colored"),
  parseAddOn(floorPlanAddOns[2], "3d-floorplan"),
];

// ---- Property types ----
// Each defines which services are offered and sensible default photo counts.
const propertyTypes = [
  {
    id: "residential",
    label: "Residential Home",
    icon: "home",
    blurb: "Listings, resale & new construction.",
        services: ["package", "hdr", "matterport", "floorplan", "staging", "video", "zillow", "addon"],
    defaultPhotos: 30,
    sqftLabel: "Living area (sq ft)",
  },
  {
    id: "commercial",
    label: "Commercial Property",
    icon: "building",
    blurb: "Offices, retail, restaurants & venues.",
    services: ["chdr", "matterport", "pano-prem", "pano-exp", "google", "floorplan"],
    defaultPhotos: 10,
    sqftLabel: "Property size (sq ft)",
  },
  {
    id: "vacation",
    label: "Vacation Rental",
    icon: "bed",
    blurb: "Airbnb, Vrbo & short-term stays.",
    services: ["hdr", "matterport", "floorplan", "staging", "pano-exp"],
    defaultPhotos: 20,
    sqftLabel: "Rental size (sq ft)",
  },
  {
    id: "land",
    label: "Land / Lot",
    icon: "map",
    blurb: "Vacant land, lots & acreage.",
    // Land primarily needs aerial + a Google tour; HDR interiors don't apply.
    services: ["google", "pano-prem", "pano-exp", "matterport"],
    defaultPhotos: 5,
    sqftLabel: "Lot size (sq ft)",
  },
];

const config = {
  propertyTypes,
  hdrBrackets,
  commercialHdrBrackets,
  matterportBrackets,
  matterportOveragePer1000,
  floorPlanBrackets,
  floorPlanCustomNote,
  virtualStagingPerPhoto,
  packages,
  googlePkg,
  videoItems,
  zillowItems,
  premiumPanoramaBrackets,
  expressPanoramaBrackets,
  addOns,
  taxApplies: false,
  contactHref: asset("/contact/"),
};

const configJson = JSON.stringify(config);
---

<section class="calc" data-calculator aria-labelledby="calc-title" data-reveal>
  <header class="calc-head">
    <p class="eyebrow">Build your quote</p>
    <h2 id="calc-title" class="display calc-title">Price it yourself. Instantly.</h2>
    <p class="calc-sub">
      Pick the property type, add the services you need, and watch the total update as you go — no waiting on a quote.
      Every number is the real published price.
    </p>
  </header>

  {/* ===== STEP 1: Property type ===== */}
  <fieldset class="calc-step">
    <legend class="step-legend"><span class="step-n">1</span> What are you photographing?</legend>
    <div class="ptypes" role="radiogroup" aria-label="Property type">
      {propertyTypes.map((t, i) => (
        <label class:list={["ptype", { "is-active": i === 0 }]}>
          <input
            type="radio"
            name="calc-ptype"
            value={t.id}
            data-ptype-radio
            checked={i === 0}
            aria-label={t.label}
          />
          <span class="ptype-inner">
            <span class="ptype-icon" aria-hidden="true">
              {t.icon === "home" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
              )}
              {t.icon === "building" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16"/><path d="M14 8h5a2 2 0 0 1 2 2v11"/><path d="M6 7h4M6 11h4M6 15h4"/></svg>
              )}
              {t.icon === "bed" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18v-6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v6"/><path d="M2 14h20"/><path d="M6 10V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3"/></svg>
              )}
              {t.icon === "map" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
              )}
            </span>
            <span class="ptype-text">
              <span class="ptype-name">{t.label}</span>
              <span class="ptype-blurb">{t.blurb}</span>
            </span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>

  {/* ===== STEP 2: Property details ===== */}
  <fieldset class="calc-step">
    <legend class="step-legend"><span class="step-n">2</span> Property details</legend>
    <div class="details-grid">
      <label class="detail-field" data-field="address">
        <span class="detail-label">Address <span class="opt">optional</span></span>
        <input type="text" data-address placeholder="e.g. 123 Main St, Las Vegas, NV" autocomplete="off" />
      </label>
      <label class="detail-field">
        <span class="detail-label" data-sqft-label>Square footage</span>
        <div class="sqft-input">
          <input type="number" inputmode="numeric" min="0" step="100" value="2000" data-sqft aria-describedby="sqft-note" />
          <span class="sqft-unit">sq ft</span>
        </div>
      </label>
      <label class="detail-field">
        <span class="detail-label">Stories</span>
        <input type="number" class="stories-input" inputmode="numeric" min="1" max="10" step="1" value="1" data-stories-input aria-describedby="sqft-note" />
      </label>
    </div>
    <p id="sqft-note" class="ctrl-note">Square footage drives 3D tour &amp; floor plan tier pricing.</p>
  </fieldset>

  {/* ===== STEP 3: Services ===== */}
  <fieldset class="calc-step">
    <legend class="step-legend"><span class="step-n">3</span> Add services</legend>
    <p class="step-hint">Select any combination — the total updates live.</p>

    {/* RESIDENTIAL PACKAGES */}
    <div class="svc-group" data-svc-for="package">
      <h3 class="svc-group-title">Residential packages</h3>
      <div class="svc-cards">
        {packages.map((p) => (
          <label class:list={["svc-card", { featured: p.featured }]}>
            <input type="checkbox" data-svc="package" data-slug={p.slug} />
            <span class="svc-card-inner">
              <span class="svc-card-head">
                <span class="svc-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span class="svc-card-name">{p.name}</span>
                {p.featured && <span class="svc-flag">Popular</span>}
              </span>
              <span class="svc-card-price">${p.price}</span>
              <span class="svc-card-blurb">{p.blurb}</span>
              <span class="svc-card-size">{p.sizeNote}</span>
            </span>
          </label>
        ))}
      </div>
      <p class="svc-note" data-package-note hidden>Resale packages can't combine with à la carte services — picking both keeps the higher-value option.</p>
    </div>

    {/* HDR PHOTOGRAPHY */}
    <div class="svc-group" data-svc-for="hdr">
      <h3 class="svc-group-title">HDR photography</h3>
      <label class="svc-toggle">
        <input type="checkbox" data-service="hdr" />
        <span class="svc-toggle-text">
          <span class="svc-toggle-name">Add HDR photos</span>
          <span class="svc-toggle-tier" data-hdr-tier></span>
        </span>
      </label>
      <div class="qty-row" data-hdr-ctrl hidden>
        <span class="qty-label">Number of photos</span>
        <div class="num-spin">
          <button type="button" class="spin-btn" data-dec-for="hdr-count" aria-label="Fewer photos">−</button>
          <input id="hdr-count" type="number" min="1" max="90" value={propertyTypes[0].defaultPhotos} data-hdr-count />
          <button type="button" class="spin-btn" data-inc-for="hdr-count" aria-label="More photos">+</button>
        </div>
      </div>
    </div>

    {/* COMMERCIAL HDR */}
    <div class="svc-group" data-svc-for="chdr">
      <h3 class="svc-group-title">Commercial HDR photography</h3>
      <div class="svc-cards">
        {commercialHdrBrackets.map((b, i) => (
          <label class="svc-card">
            <input type="checkbox" data-svc="chdr" data-chdr-max={b.max} />
            <span class="svc-card-inner">
              <span class="svc-card-head">
                <span class="svc-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span class="svc-card-name">{b.label}</span>
              </span>
              <span class="svc-card-price">${b.price}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    {/* MATTERPORT 3D */}
    <div class="svc-group" data-svc-for="matterport">
      <h3 class="svc-group-title">Matterport 3D tour</h3>
      <label class="svc-toggle">
        <input type="checkbox" data-service="matterport" />
        <span class="svc-toggle-text">
          <span class="svc-toggle-name">Add a Matterport 3D walkthrough</span>
          <span class="svc-toggle-tier" data-matterport-tier></span>
        </span>
      </label>
      <p class="svc-note" data-matterport-note>Includes 2 MLS links + 6 months of hosting. Dollhouse, floor plan &amp; measurement views.</p>
    </div>

    {/* FLOOR PLAN */}
    <div class="svc-group" data-svc-for="floorplan">
      <h3 class="svc-group-title">Floor plan</h3>
      <label class="svc-toggle">
        <input type="checkbox" data-service="floorplan" />
        <span class="svc-toggle-text">
          <span class="svc-toggle-name">Add a schematic floor plan</span>
          <span class="svc-toggle-tier" data-floorplan-tier></span>
        </span>
      </label>
    </div>

    {/* VIRTUAL STAGING */}
    <div class="svc-group" data-svc-for="staging">
      <h3 class="svc-group-title">Virtual staging</h3>
      <label class="svc-toggle">
        <input type="checkbox" data-service="staging" />
        <span class="svc-toggle-text">
          <span class="svc-toggle-name">Add virtual staging</span>
          <span class="svc-toggle-tier" data-staging-tier></span>
        </span>
      </label>
      <div class="qty-row" data-staging-ctrl hidden>
        <span class="qty-label">Photos to stage</span>
        <div class="num-spin">
          <button type="button" class="spin-btn" data-dec-for="staging-count" aria-label="Fewer photos">−</button>
          <input id="staging-count" type="number" min="1" max="50" value="1" data-staging-count />
          <button type="button" class="spin-btn" data-inc-for="staging-count" aria-label="More photos">+</button>
        </div>
      </div>
    </div>

    {/* WALK-THROUGH VIDEO */}
    <div class="svc-group" data-svc-for="video">
      <h3 class="svc-group-title">Walk-through video &amp; reels</h3>
      <div class="svc-cards">
        {videoItems.map((v) => (
          <label class="svc-card">
            <input type="checkbox" data-svc="video" data-vlabel={v.label} data-vprice={v.price} />
            <span class="svc-card-inner">
              <span class="svc-card-head">
                <span class="svc-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span class="svc-card-name">{v.label}</span>
              </span>
              <span class="svc-card-price">${v.price}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    {/* ZILLOW 3D */}
    <div class="svc-group" data-svc-for="zillow">
      <h3 class="svc-group-title">Zillow 3D Home</h3>
      <div class="svc-cards">
        {zillowItems.map((z) => (
          <label class="svc-card">
            <input type="checkbox" data-svc="zillow" data-zlabel={z.label} data-zprice={z.price} />
            <span class="svc-card-inner">
              <span class="svc-card-head">
                <span class="svc-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span class="svc-card-name">{z.label}</span>
              </span>
              <span class="svc-card-price">${z.price}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    {/* PREMIUM 360 PANORAMAS (commercial / land) */}
    <div class="svc-group" data-svc-for="pano-prem">
      <h3 class="svc-group-title">Premium 360 panoramas (8-shot DSLR/HDR)</h3>
      <div class="svc-cards">
        {premiumPanoramaBrackets.map((p) => (
          <label class="svc-card">
            <input type="checkbox" data-svc="pano-prem" data-plabel={p.label} data-pprice={p.price} />
            <span class="svc-card-inner">
              <span class="svc-card-head">
                <span class="svc-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span class="svc-card-name">{p.label}</span>
              </span>
              <span class="svc-card-price">${p.price}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    {/* EXPRESS 360 / VR */}
    <div class="svc-group" data-svc-for="pano-exp">
      <h3 class="svc-group-title">Express 360 / VR</h3>
      <div class="svc-cards">
        {expressPanoramaBrackets.map((p) => (
          <label class="svc-card">
            <input type="checkbox" data-svc="pano-exp" data-plabel={p.label} data-pprice={p.price} />
            <span class="svc-card-inner">
              <span class="svc-card-head">
                <span class="svc-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span class="svc-card-name">{p.label}</span>
              </span>
              <span class="svc-card-price">${p.price}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    {/* GOOGLE "GET ME ON GOOGLE" PACKAGE */}
    <div class="svc-group" data-svc-for="google">
      <h3 class="svc-group-title">Commercial packages</h3>
      <div class="svc-cards">
        <label class="svc-card featured">
          <input type="checkbox" data-svc="google" />
          <span class="svc-card-inner">
            <span class="svc-card-head">
              <span class="svc-card-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="svc-card-name">{googlePkg.name}</span>
              <span class="svc-flag">Most booked</span>
            </span>
            <span class="svc-card-price">${googlePkg.price}</span>
            <span class="svc-card-blurb">{googlePkg.includes.join(" · ")}</span>
            <span class="svc-card-size">{googlePkg.note}</span>
          </span>
        </label>
      </div>
    </div>

    {/* ADD-ONS */}
    <div class="svc-group" data-svc-for="addon">
      <h3 class="svc-group-title">Add-ons</h3>
      <div class="addon-grid">
        {addOns.map((a) => (
          <label class="addon-chip">
            <input type="checkbox" data-addon={a.id} />
            <span class="addon-chip-inner">
              <span class="addon-name">{a.label}</span>
              <span class="addon-price">+${a.price}</span>
            </span>
          </label>
        ))}
      </div>
    </div>
  </fieldset>

  {/* ===== LIVE SUMMARY (sticky) ===== */}
  <aside class="calc-summary" aria-live="polite" aria-atomic="true">
    <div class="summary-card">
      <p class="eyebrow">Your quote</p>
      <p class="summary-type" data-summary-type>Residential Home</p>

      <ul class="breakdown" role="list" data-breakdown>
        <li class="bd-empty">Pick a service to see your total.</li>
      </ul>

      <div class="summary-total">
        <span class="total-label">Estimated total</span>
        <span class="total-amount" data-total>$0</span>
      </div>

      <a class="btn brass btn-block summary-cta" data-book href={asset("/contact/")}>
        Book this
      </a>
      <p class="summary-alt">Or <a href={asset("/contact/")}>ask Mike to confirm the scope →</a></p>
    </div>
  </aside>

  {/* No-JS fallback */}
  <noscript>
    <p class="calc-noscript">
      The live calculator needs JavaScript, but every price is listed in the tables on this page —
      you can build your total manually, or just <a href={asset("/contact/")}>call Mike</a> for a quote.
    </p>
  </noscript>
</section>

<style>
