<script is:inline define:vars={{ config: configJson }}>
  (() => {
    const CONFIG = JSON.parse(config);
    const calc = document.currentScript?.closest("[data-calculator]") || document.querySelector("[data-calculator]");
    if (!calc) return;

    // Elements
    const ptypeRadios = calc.querySelectorAll("[data-ptype-radio]");
    const ptypeLabels = calc.querySelectorAll(".ptype");
    const svcGroups = calc.querySelectorAll("[data-svc-for]");
    const sqftInput = calc.querySelector("[data-sqft]");
    const sqftLabel = calc.querySelector("[data-sqft-label]");
    const summaryType = calc.querySelector("[data-summary-type]");
    const breakdown = calc.querySelector("[data-breakdown]");
    const totalEl = calc.querySelector("[data-total]");
    const bookBtn = calc.querySelector("[data-book]");

    let ptype = CONFIG.propertyTypes[0];
    let stories = 1;

    // All selectable inputs that contribute to the quote.
    const svcChecks = calc.querySelectorAll('[data-svc]');
    const serviceChecks = calc.querySelectorAll('[data-service]');
    const addonChecks = calc.querySelectorAll("[data-addon]");
    const hdrCount = calc.querySelector("[data-hdr-count]");
    const stagingCount = calc.querySelector("[data-staging-count]");
    const hdrCtrl = calc.querySelector("[data-hdr-ctrl]");
    const stagingCtrl = calc.querySelector("[data-staging-ctrl]");
    // Individual service toggle checkboxes (HDR / staging) so their qty rows can
    // be shown/hidden. serviceChecks is the NodeList of every [data-service].
    const hdrCheck = calc.querySelector('[data-service="hdr"]');
    const stagingCheck = calc.querySelector('[data-service="staging"]');
    // Stories is now a plain number input (was a segmented control).
    const storiesInput = calc.querySelector("[data-stories-input]");

    // ---- Pricing helpers (mirror the real bracket logic) ----
    // All prices are coerced with Number() so a future hand-edit of pricing.json
    // (e.g. a value accidentally quoted as a string) can NEVER turn the total
    // into "$111230" via string concatenation — every price is a real number.
    function sqft() { return Math.max(0, parseInt(sqftInput.value, 10) || 0); }

    function hdrPriceFor(count) {
      const c = Math.max(0, count | 0);
      const b = CONFIG.hdrBrackets.find((x) => c <= x.max) || CONFIG.hdrBrackets[CONFIG.hdrBrackets.length - 1];
      return { price: Number(b.price), label: b.label };
    }

    function commercialHdrPriceFor(count) {
      const c = Math.max(0, count | 0);
      const b = CONFIG.commercialHdrBrackets.find((x) => c <= x.max) || CONFIG.commercialHdrBrackets[CONFIG.commercialHdrBrackets.length - 1];
      return { price: Number(b.price), label: b.label };
    }

    function matterportPriceFor(sqftVal) {
      if (sqftVal <= 0) {
        const b = CONFIG.matterportBrackets[0];
        return { price: Number(b.price), label: b.label, overage: 0 };
      }
      const b = CONFIG.matterportBrackets.find((x) => sqftVal <= x.maxSqft);
      if (b) return { price: Number(b.price), label: b.label, overage: 0 };
      const last = CONFIG.matterportBrackets[CONFIG.matterportBrackets.length - 1];
      const cap = Number(last.maxSqft);
      const base = Number(last.price);
      const extra = sqftVal - cap;
      const additional1000s = Math.ceil(extra / 1000);
      const overage = additional1000s * Number(CONFIG.matterportOveragePer1000);
      // Group the addition so it can never concatenate strings: (base + overage)
      return { price: (base + overage), label: `Over ${cap.toLocaleString()} sq ft (+$${Number(CONFIG.matterportOveragePer1000)}/1000)`, overage };
    }

    function floorPlanPriceFor(sqftVal, stor) {
      if (sqftVal > 5000) return { price: null, label: CONFIG.floorPlanCustomNote, custom: true };
      const b = CONFIG.floorPlanBrackets.find(
        (x) => x.stories === stor && sqftVal >= x.minSqft && sqftVal <= x.maxSqft
      );
      if (b) return { price: Number(b.price), label: b.label };
      const fb = CONFIG.floorPlanBrackets.find((x) => x.stories === stor && x.maxSqft === 2500);
      return fb ? { price: Number(fb.price), label: fb.label } : { price: null, label: CONFIG.floorPlanCustomNote, custom: true };
    }

    // Turn pricing.json's "Up to 2,000 sq ft" into a compact "≤2,000 sq ft"
    // bracket label for the breakdown, and shorten HDR's "11–30 photos" too.
    function matterportSubLabel(raw) {
      return String(raw).replace(/^Up to\s+/i, "≤ ").replace(/^Over\s+/i, "> ");
    }
    function hdrSubLabel(raw) {
      return String(raw).replace(/\s*HDR\s*photos?/i, "").trim();
    }

    // ---- Compute the current quote ----
    function computeQuote() {
      const lines = [];
      const sqftVal = sqft();

      // Service toggles (checkbox rows with a single price).
      serviceChecks.forEach((chk) => {
        if (!chk.checked) return;
        const svc = chk.dataset.service;
        if (svc === "hdr") {
          const count = Math.max(1, parseInt(hdrCount.value, 10) || 0);
          const { price, label } = hdrPriceFor(count);
          lines.push({ name: `HDR photography (${count} photo${count === 1 ? "" : "s"})`, sub: hdrSubLabel(label), price });
        } else if (svc === "matterport") {
          const { price, label } = matterportPriceFor(sqftVal);
          lines.push({ name: "Matterport 3D tour", sub: matterportSubLabel(label), price });
        } else if (svc === "floorplan") {
          const fp = floorPlanPriceFor(sqftVal, stories);
          lines.push({ name: "Floor plan", sub: fp.label, price: fp.price, custom: !!fp.custom });
        } else if (svc === "staging") {
          const count = Math.max(1, parseInt(stagingCount.value, 10) || 1);
          lines.push({ name: `Virtual staging (${count} photo${count === 1 ? "" : "s"})`, sub: `$${CONFIG.virtualStagingPerPhoto} / photo`, price: count * CONFIG.virtualStagingPerPhoto });
        }
      });

      // Card-based multi-select services (packages, commercial HDR, video, zillow, panoramas, google).
      svcChecks.forEach((chk) => {
        if (!chk.checked) return;
        const svc = chk.dataset.svc;
        if (svc === "package") {
          const pkg = CONFIG.packages.find((p) => p.slug === chk.dataset.slug);
          if (pkg) lines.push({ name: pkg.name + " package", sub: pkg.includes.slice(0, 2).join(" · "), price: pkg.price });
        } else if (svc === "chdr") {
          const max = parseInt(chk.dataset.chdrMax, 10);
          const ch = commercialHdrPriceFor(max);
          lines.push({ name: `Commercial HDR (${ch.label})`, price: ch.price });
        } else if (svc === "video") {
          lines.push({ name: chk.dataset.vlabel, price: parseInt(chk.dataset.vprice, 10) });
        } else if (svc === "zillow") {
          lines.push({ name: chk.dataset.zlabel, price: parseInt(chk.dataset.zprice, 10) });
        } else if (svc === "pano-prem" || svc === "pano-exp") {
          const kind = svc === "pano-prem" ? "Premium 360" : "Express 360";
          lines.push({ name: `${kind} (${chk.dataset.plabel})`, price: parseInt(chk.dataset.pprice, 10) });
        } else if (svc === "google") {
          const g = CONFIG.googlePkg;
          lines.push({ name: g.name, sub: g.includes.slice(0, 2).join(" · "), price: g.price });
        }
      });

      // Add-ons
      addonChecks.forEach((chk) => {
        if (chk.checked) {
          const a = CONFIG.addOns.find((x) => x.id === chk.dataset.addon);
          if (a) lines.push({ name: a.label, price: a.price });
        }
      });

      // Force every price to a real number before summing so a stray string
      // anywhere can NEVER concatenate into something like "$111230".
      lines.forEach((l) => { if (l.price != null) l.price = Number(l.price) || 0; });
      const total = lines.reduce((sum, l) => sum + (l.custom ? 0 : (Number(l.price) || 0)), 0);
      return { lines, total };
    }

    // ---- Render ----
    function render() {
      const { lines, total } = computeQuote();
      if (lines.length === 0) {
        breakdown.innerHTML = '<li class="bd-empty">Pick a service to see your total.</li>';
      } else {
        breakdown.innerHTML = lines.map((l) => {
          const priceTxt = l.custom
            ? '<span class="bd-custom">Custom</span>'
            : `$${Number(l.price).toLocaleString()}`;
          const sub = l.sub ? `<span class="bd-sub">${l.sub}</span>` : "";
          return `<li class="bd-item"><span class="bd-name">${l.name}${sub}</span><span class="bd-price">${priceTxt}</span></li>`;
        }).join("");
      }
      totalEl.textContent = "$" + total.toLocaleString();

      // Build the booking link with full context for the contact form.
      const params = new URLSearchParams();
      params.set("type", ptype.label);
      params.set("total", String(total));
      const addr = calc.querySelector("[data-address]")?.value.trim();
      if (addr) params.set("address", addr);
      if (sqft()) params.set("sqft", String(sqft()));
      if (lines.length) {
        params.set("items", lines.map((l) => `${l.name}${typeof l.price === "number" ? " $" + l.price : ""}`).join("; "));
      }
      const base = CONFIG.contactHref.replace(/\/$/, "");
      bookBtn.setAttribute("href", base + "/?" + params.toString());
    }

    // ---- Tier labels for the toggle rows ----
    function renderTierLabels() {
      const sqftVal = sqft();
      const hc = Math.max(1, parseInt(hdrCount.value, 10) || 0);
      const h = hdrPriceFor(hc);
      const ht = calc.querySelector("[data-hdr-tier]");
      if (ht) ht.textContent = `$${h.price} · ${h.label}`;
      const m = matterportPriceFor(sqftVal);
      const mt = calc.querySelector("[data-matterport-tier]");
      if (mt) mt.textContent = `$${m.price} · ${m.label}`;
      const f = floorPlanPriceFor(sqftVal, stories);
      const ft = calc.querySelector("[data-floorplan-tier]");
      if (ft) ft.textContent = (f.custom ? f.label : `$${f.price} · ${f.label}`);
      const sc = Math.max(1, parseInt(stagingCount.value, 10) || 1);
      const stEl = calc.querySelector("[data-staging-tier]");
      if (stEl) stEl.textContent = `$${sc * CONFIG.virtualStagingPerPhoto}`;
    }

    // ---- Property type switching ----
    function setPtype(next) {
      ptype = next;
      ptypeLabels.forEach((lbl) => lbl.classList.remove("is-active"));
      const active = calc.querySelector(`[data-ptype-radio][value="${next.id}"]`);
      if (active) {
        active.checked = true;
        active.closest(".ptype")?.classList.add("is-active");
      }
      // Show only the service groups relevant to this property type.
      svcGroups.forEach((g) => {
        const key = g.getAttribute("data-svc-for");
        g.hidden = !next.services.includes(key);
      });
      // Update sqft label wording (living area vs lot size etc.).
      if (sqftLabel && next.sqftLabel) sqftLabel.textContent = next.sqftLabel;
      // Update the summary header.
      if (summaryType) summaryType.textContent = next.label;
      renderTierLabels();
      render();
    }
    ptypeRadios.forEach((r) => r.addEventListener("change", () => {
      const t = CONFIG.propertyTypes.find((p) => p.id === r.value);
      if (t) setPtype(t);
    }));

    // ---- Stories (number input) — live-updates floor plan tier ----
    if (storiesInput) {
      storiesInput.addEventListener("input", () => {
        let n = parseInt(storiesInput.value, 10);
        if (isNaN(n) || n < 1) n = 1;
        if (n > 10) n = 10;
        storiesInput.value = n;
        // Floor-plan brackets only distinguish 1 vs 2 stories; 3+ behaves like 2.
        stories = n >= 2 ? 2 : 1;
        renderTierLabels();
        render();
      });
    }

    // ---- Number spinners ----
    calc.querySelectorAll("[data-inc-for], [data-dec-for]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = document.getElementById(btn.dataset.incFor || btn.dataset.decFor);
        if (!target) return;
        const step = parseInt(target.step, 10) || 1;
        const cur = parseInt(target.value, 10) || 0;
        if (btn.dataset.incFor) target.value = Math.min(parseInt(target.max, 10) || 9999, cur + step);
        else target.value = Math.max(parseInt(target.min, 10) || 0, cur - step);
        target.dispatchEvent(new Event("input", { bubbles: true }));
      });
    });

    // ---- Service toggle reveal + recompute ----
    function wireService(check, ctrl) {
      if (!check || !ctrl) return;
      const sync = () => { ctrl.hidden = !check.checked; };
      sync();
      // Listen to both change (keyboard) and click (mouse on label) so the
      // total updates the instant the toggle is flipped, either way.
      const onToggle = () => { sync(); renderTierLabels(); render(); };
      check.addEventListener("change", onToggle);
      check.addEventListener("click", onToggle);
    }
    wireService(hdrCheck, hdrCtrl);
    wireService(stagingCheck, stagingCtrl);

    // ---- Live updates on EVERY interaction ----
    // Number inputs update on `input` (keystroke / spinner / paste).
    [sqftInput, hdrCount, stagingCount, storiesInput].forEach((el) => {
      if (el) el.addEventListener("input", () => { renderTierLabels(); render(); });
    });
    // Cards (packages, commercial HDR, video, zillow, panoramas, google) and
    // add-on chips: `change` for keyboard + `click` for the whole label tap.
    const onCardChange = () => { renderTierLabels(); render(); };
    svcChecks.forEach((c) => { c.addEventListener("change", onCardChange); c.addEventListener("click", onCardChange); });
    serviceChecks.forEach((c) => { c.addEventListener("change", onCardChange); });
    addonChecks.forEach((c) => { c.addEventListener("change", onCardChange); c.addEventListener("click", onCardChange); });
    const addrInput = calc.querySelector("[data-address]");
    if (addrInput) addrInput.addEventListener("input", render);

    // Initial paint — start on the first property type.
    setPtype(CONFIG.propertyTypes[0]);
  })();
</script>
