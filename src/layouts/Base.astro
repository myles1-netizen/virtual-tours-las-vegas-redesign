---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { business, asset, testimonials } from "../data/site";

export interface Props {
  title: string;
  description: string;
  /** OG image path (absolute from site root, before base path resolution) */
  image?: string;
  /** mark the page's body so header knows it's a dark-hero context */
  heroVariant?: "dark" | "light";
  noindex?: boolean;
  /** Optional full CSP string override. When set, replaces the default public-site
      CSP entirely. The /admin page doesn't use this layout — it ships its own
      standalone, self-contained CSP. If omitted here, the strict default below is used. */
  cspOverride?: string;
}

const { title, description, image = "/images/portfolio/sierra-skye-living.jpg", heroVariant = "light", noindex = false, cspOverride } = Astro.props;

// ----- Google Analytics 4 (optional) -----
// Enabled only when GA4_MEASUREMENT_ID (e.g. "G-XXXXXXXXXX") is set at build time.
// Uses Google Consent Mode v2: consent is DENIED by default, so the gtag.js
// script loads but writes NO cookies and sends NO identifying pings until a
// visitor affirmatively grants consent (call gtag('consent','update',...) from
// your own consent banner). This is the privacy-first, cookieless-by-default
// approach recommended by Google for EEA/GDPR compliance and is the closest
// static-site equivalent to Site Kit's privacy-friendly Analytics embed.
// With no banner wired up, GA4 still runs in "cookieless pings" mode: it reports
// only aggregated, modelled traffic without setting ID cookies.
const GA4_ID = import.meta.env.GA4_MEASUREMENT_ID ?? "";
const ga4Enabled = /^G-[A-Z0-9]{6,}$/.test(GA4_ID);

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://mylesthepro1.github.io";
const base = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = new URL(Astro.url.pathname, base).toString();
// OG image needs a fully-qualified URL including the deployment base path.
const ogImage = new URL(asset(image), base).toString();

// ----- SEO length guards: clamp to recommended maxima so the SERP never
// truncates mid-word. Title < 60 chars, description < 160 chars.
const TITLE_MAX = 60;
const DESC_MAX = 160;
const seoTitle = title.length > TITLE_MAX ? title.slice(0, TITLE_MAX - 1).trimEnd() + "…" : title;
const seoDescription =
  description.length > DESC_MAX ? description.slice(0, DESC_MAX - 1).trimEnd() + "…" : description;

// ----- Auto BreadcrumbList from the current path. Home = no breadcrumb. Each
// deeper segment becomes a crumb; the final segment is the current page (linked
// only on intermediate levels). Labels map known slugs to friendly names.
const crumbLabel = (seg: string): string => {
  const map: Record<string, string> = {
    work: "Work",
    services: "Services",
    pricing: "Pricing",
    about: "About",
    contact: "Contact",
    faq: "FAQ",
    "3d-tours": "3D & Virtual Tours",
    "hdr-photography": "HDR Photography",
    "drone-photography": "Drone Photography",
    "floor-plans": "Floor Plans",
    "virtual-staging": "Virtual Staging",
    "twilight-photography": "Twilight Photography",
    "google-business-view": "Google Business View",
    residential: "Residential",
    commercial: "Commercial",
    "vacation-rentals": "Vacation Rentals",
    "as-built": "Builders & Docs",
    terms: "Terms",
    privacy: "Privacy",
  };
  if (map[seg]) return map[seg];
  return seg.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
};
const rawPath = Astro.url.pathname.replace(/\/+/g, "/").replace(/\/$/, "");
const segs = rawPath ? rawPath.split("/").filter(Boolean) : [];
// Strip the deployment base path prefix so breadcrumbs reflect logical structure.
const basePathName = (import.meta.env.BASE_URL ?? "/").replace(/^\/|\/$/g, "");
const logicalSegs = basePathName && segs[0] === basePathName ? segs.slice(1) : segs;

let breadcrumbLd: object | null = null;
if (logicalSegs.length > 0) {
  const itemList: object[] = [
    { "@type": "ListItem", position: 1, name: "Home", item: `${base}/` },
  ];
  let acc = base;
  logicalSegs.forEach((seg, i) => {
    acc += `/${seg}`;
    const isLast = i === logicalSegs.length - 1;
    const item: { "@type": "ListItem"; position: number; name: string; item?: string } = {
      "@type": "ListItem",
      position: i + 2,
      name: crumbLabel(seg),
    };
    if (!isLast) item.item = `${acc}/`;
    itemList.push(item);
  });
  breadcrumbLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: itemList,
  };
}

// ----- AggregateRating + Reviews, derived from the real testimonials in site.ts.
// ratingValue is honest (5.0 across the published testimonials) and reviewCount
// matches the verbatim testimonials we surface — no fabricated ratings.
const reviewCount = testimonials.length;
const ratingValue = 5.0;
const reviews = testimonials.map((t) => ({
  "@type": "Review",
  author: { "@type": "Person", name: t.name },
  reviewBody: t.quote,
  reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService", "Photographer"],
  "@id": `${base}/#business`,
  name: business.name,
  description:
    "Las Vegas real estate photographer Mike Madsen — HDR photography, Matterport 3D virtual tours, Zillow 3D Home, drone, floor plans and virtual staging. Serving Las Vegas, Henderson and the greater Las Vegas Valley.",
  url: base,
  telephone: business.phone,
  email: business.email,
  image: ogImage,
  logo: new URL(asset("/favicon.svg"), base).toString(),
  priceRange: "$$",
  founder: { "@type": "Person", name: business.owner, jobTitle: "Real Estate Photographer" },
  areaServed: business.serviceArea.map((a) => ({ "@type": "City", name: a })),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Las Vegas",
    addressRegion: "NV",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 36.1699,
    longitude: -115.1398,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    opens: "08:00",
    closes: "18:00",
  },
  sameAs: [business.social.facebook],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue,
    reviewCount,
    bestRating: "5",
    worstRating: "1",
  },
  review: reviews,
};

// Compress JSON-LD output (drop insignificant whitespace) — these blocks are
// large and inline; minifying saves bytes on every page.
const json = (o: object) => JSON.stringify(o);

// ----- Content Security Policy -----
// Strict by default. Allows only the resources the public site actually uses:
//   - script-src 'self' 'unsafe-inline'  (inline theme/JSON-LD scripts; Astro's processing needs 'unsafe-inline' for now)
//   - Google Fonts (display + body typefaces)
//   - Matterport 3D embeds (already used by MatterportEmbed/Popup)
//   - formsubmit.co (the contact + booking forms POST their AJAX submissions there)
//   - mailto: fallback for the forms
// The /admin page ships its own self-contained CSP (no external sources at all).
const DEFAULT_CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: https:",
  // Matterport 3D embeds load from my.matterport.com (already used by MatterportEmbed/Popup).
  "frame-src https://my.matterport.com",
  // formsubmit.co receives the contact + booking form submissions (AJAX POST).
  "connect-src 'self' https://formsubmit.co",
  // form-action covers the formsubmit.co POST + the mailto: fallback.
  "form-action 'self' https://formsubmit.co mailto:",
  // frame-ancestors 'none' = clickjacking protection (also enforced via X-Frame-Options below).
  "frame-ancestors 'none'",
  "base-uri 'self'",
  "object-src 'none'",
  "upgrade-insecure-requests",
].join("; ");
const csp = cspOverride ?? DEFAULT_CSP;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Security headers via meta (GitHub Pages can't set HTTP response headers directly,
        so the most critical ones are duplicated here). On Cloudflare Pages these same
        headers can additionally be enforced via the dashboard / _headers file. */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-us" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Geo signals for local search (Las Vegas, NV). */}
    <meta name="geo.region" content="US-NV" />
    <meta name="geo.placename" content="Las Vegas" />
    <meta name="geo.position" content="36.1699;-115.1398" />
    <meta name="ICBM" content="36.1699, -115.1398" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={business.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#1a1814" />

    <link rel="icon" type="image/svg+xml" href={asset("/favicon.svg")} />
    <link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")} />

    {/* Progressive enhancement flag: set BEFORE first paint so reveal-elements
        start hidden only when JS is actually available. No-JS = fully visible. */}
    <script is:inline set:html="document.documentElement.dataset.js=''" />

    {/* Theme bootstrap — runs before first paint to prevent FOUC.
        Priority: saved preference > light. Light is the site default (the
        professional photographer look), independent of the OS preference, so
        first-time visitors always land on the bright cream paper theme. Dark
        mode is one toggle away and persists once chosen. */}
    <script is:inline set:html={`(function(){try{var s=localStorage.getItem('theme');var t=(s==='dark'||s==='light')?s:'light';document.documentElement.dataset.theme=t;}catch(e){document.documentElement.dataset.theme='light';}})();`} />

    {/* Fonts: Fraunces (display serif) + Inter (body). Preload the critical
        stylesheet so font CSS is in flight early; the onload swap turns the
        preload into the live stylesheet. display=swap avoids FOIT, protecting
        LCP. A <noscript> fallback covers no-JS clients. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <script type="application/ld+json" is:inline set:html={json(jsonLd)} />
    {breadcrumbLd && (
      <script type="application/ld+json" is:inline set:html={json(breadcrumbLd)} />
    )}
    {/* Per-page additional JSON-LD (Service, FAQPage, Offer, etc.) goes here. */}
    <slot name="head" />
  </head>
  <body data-hero={heroVariant}>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Scroll reveal — progressive, respects reduced motion
      const els = document.querySelectorAll("[data-reveal]");
      if (els.length && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Keep the <meta name="theme-color"> in sync with the active theme so
      // mobile browser chrome matches the page. The site defaults to light
      // regardless of OS preference; the visitor's explicit toggle persists.
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const THEME_COLORS = { light: "#f7f4ef", dark: "#0f0e0c" };
      const syncMeta = () => {
        const t = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        if (themeMeta) themeMeta.setAttribute("content", THEME_COLORS[t]);
      };
      syncMeta();
      // Re-sync after the toggle in the header runs (it dispatches this event).
      document.addEventListener("themechange", syncMeta);
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -100px;
        background: var(--ink);
        color: var(--on-dark);
        padding: 0.7em 1.1em;
        border-radius: 4px;
        z-index: 200;
        font-size: var(--step--1);
        font-weight: 600;
        transition: top 0.2s var(--ease);
      }
      .skip-link:focus { top: 1rem; }

      /* Header is position:fixed (solid, always on top). Light-hero pages have no
         hero image reserving space behind it, so push content down to clear it.
         Reduced to match the slimmer header bar. */
      :global(body[data-hero="light"]) main { padding-top: clamp(84px, 12vh, 104px); }
    </style>
  </body>
</html>
